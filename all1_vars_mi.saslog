120950     /****************************** GUTS1 ********************************************/
120951     data all1;
120952     	merge gutsmoms1 (in=master) grav09guts1 bmibpregdt end=_end_;
120953       	by id; exrec=1;
120954       	if master; if cohort=1 ;
120955       	if chbmi96 >0 ; *keep only children without missing baseline BMI;
120956       	if first.id then exrec=0;
120957       	
120958       	if white=. then white=0;
120959       	
120960       	*maternal age at birth - 1980-1987;
120961      	agebirth = age89 - (retmo89 /12 - (chyob-1900));
120962      		
120963     	if chage97=. then chage97=chage96+1; if chage98=. then chage98=chage97+1;
120964     	if chage99=. then chage99=chage98+1; if chage00=. then chage00=chage99+1;
120965     	if chage01=. then chage01=chage00+1; if chage03=. then chage03=chage01+2; if chage05=. then chage05=chage03+2;
120966     
120967         moagebase=age95+1; if moagebase=. then moagebase=age89+7;
120968         if age97=. then age97=moagebase+1; if age98=. then age98=age97+1;
120969     	if age99=. then age99=age98+1; if age00=. then age00=age99+1;
120970     	if age01=. then age01=age00+1; if age03=. then age03=age01+2; if age05=. then age05=age03+2;
120971     				
120972     	array region{6} region10_95 region10_97 region10_99 region10_01 region10_03 region10_05;
120973     	array mid{6} midwest95 midwest97 midwest99 midwest01 midwest03 midwest05;
120974     	array south{6} south95 south97 south99 south01 south03 south05;
120975     	array west{6} west95 west97 west99 west01 west03 west05;
120976     	
120977     	do i = 1 to 6;
120978       	if missing(region{i}) then do;
120979        		 mid{i}   = .;
120980         	south{i} = .;
120981         	west{i}  = .;
120982       	end;
120983       	else do;
120984       	  mid{i}   = (region{i} = 2);  /* => 1 if region{i}=2, else 0 */
120985        	  south{i} = (region{i} = 3);  /* => 1 if region{i}=3, else 0 */
120986           west{i}  = (region{i} = 4);  /* => 1 if region{i}=4, else 0 */
120987       	end;
120988     	end; drop i;
120989     	
120990     	keep  id momid cohort ch_birthday natal_sex birthday
