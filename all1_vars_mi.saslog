117740     /****************************** GUTS1 ********************************************/
117741     data all1;
117742     	merge gutsmoms1 (in=master) grav09guts1 bmibpregdt end=_end_;
117743       	by id; exrec=1;
117744       	if master; if cohort=1 ;
117745       	if chbmi96 >0 ; *keep only children without missing baseline BMI;
117746       	if first.id then exrec=0;
117747       	
117748       	if white=. then white=0;
117749       	
117750       	*maternal age at birth - 1980-1987;
117751      	agebirth = age89 - (retmo89 /12 - (chyob-1900));
117752      		
117753     	if chage97=. then chage97=chage96+1; if chage98=. then chage98=chage97+1;
117754     	if chage99=. then chage99=chage98+1; if chage00=. then chage00=chage99+1;
117755     	if chage01=. then chage01=chage00+1; if chage03=. then chage03=chage01+2; if chage05=. then chage05=chage03+2;
117756     
117757         moagebase=age95+1; if moagebase=. then moagebase=age89+7;
117758         if age97=. then age97=moagebase+1; if age98=. then age98=age97+1;
117759     	if age99=. then age99=age98+1; if age00=. then age00=age99+1;
117760     	if age01=. then age01=age00+1; if age03=. then age03=age01+2; if age05=. then age05=age03+2;
117761     				
117762     	array region{6} region10_95 region10_97 region10_99 region10_01 region10_03 region10_05;
117763     	array mid{6} midwest95 midwest97 midwest99 midwest01 midwest03 midwest05;
117764     	array south{6} south95 south97 south99 south01 south03 south05;
117765     	array west{6} west95 west97 west99 west01 west03 west05;
117766     	
117767     	do i = 1 to 6;
117768       	if missing(region{i}) then do;
117769        		 mid{i}   = .;
117770         	south{i} = .;
117771         	west{i}  = .;
117772       	end;
117773       	else do;
117774       	  mid{i}   = (region{i} = 2);  /* => 1 if region{i}=2, else 0 */
117775        	  south{i} = (region{i} = 3);  /* => 1 if region{i}=3, else 0 */
117776           west{i}  = (region{i} = 4);  /* => 1 if region{i}=4, else 0 */
117777       	end;
117778     	end; drop i;
117779     	
117780     	keep  id momid cohort ch_birthday natal_sex birthday
117781     			retmo95 retmo97 retmo99 retmo01 retmo03 retmo05
117782     			irt96   irt97   irt98   irt99   irt00 irt01    irt03  irt05
117783     			agebirth moagebase age97 age98 age99 age00 age01 age03 age05
117784     			bmi95v bmi97v bmi99v bmi01v bmi03v bmi05v
