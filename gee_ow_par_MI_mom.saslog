1061       
1062       data betas;
1063         set mom ;
1064         by _imputation_;
1065         _type_ = 'PARM';
1066       	retain intercept mowestq1 mowestq2 mowestq3 mocalq1 mocalq2 mocalq3
1067       					 mopaq0 mopaq1 mopaq2 mosmk2 mosmk3
1068       					moshiftq1 moshiftq2 moshiftq3
1069       					moage cohort chage white sex moow;
1070       	
1071       	* 'i' counts rows within each _imputation_ group ;
1072         	if first._imputation_ then i=1;
1073         	else i+1;
1074       	
1075       	select (i);
1076           when (1) intercept = estimate;
1077           when (2) mowestq1  = estimate;
1078           when (3) mowestq2  = estimate;
1079           when (4) mowestq3  = estimate;
1080           when (5) mocalq1   = estimate;
1081           when (6) mocalq2   = estimate;
1082       	when (7) mocalq3   = estimate;
1083       	when (8) mopaq0   = estimate;
1084       	when (9) mopaq1   = estimate;
1085       	when (10) mopaq2   = estimate;
1086       	when (11) mosmk2  = estimate;
1087       	when (12) mosmk3  = estimate;
1088       	when (13) moshiftq1= estimate;
1089       	when (14) moshiftq2= estimate;
1090       	when (15) moshiftq3= estimate;
1091           when (16) moage    = estimate;
1092           when (17) cohort   = estimate;
1093           when (18) chage    = estimate;
1094           when (19) white    = estimate;
1095           when (20) sex      = estimate;
1096           when (21) moow     = estimate;
1097           otherwise;
1098         end;
1099       	
1100         * Only OUTPUT once per _imputation_, after we've assigned all param columns ;
1101         if last._imputation_ then output;
1102       
1103         if mowestq1 <0 then  mowestq1 =0;    if mowestq2 <0 then  mowestq2 =0;
1104         if mowestq3 <0 then  mowestq3 =0;    if mopaq0 <0 then  mopaq0 =0;
1105         if mopaq1 <0 then  mopaq1 =0;        if mopaq2 <0 then  mopaq2 =0;
1106       run;

