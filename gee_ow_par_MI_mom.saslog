878        title ' maternal modifiable factors - moow ';
879        proc genmod data = all descending;
880        	by _imputation_ ;
881         class id momid ;
882           model chow = &mowestq_ &mocalq_ &mopaq_ mosmk2 mosmk3 &moshiftq_
883          			    moage &covar1 moow
884             / dist = Poisson link = log;
885             repeated subject=id(momid)/type=unstr PRINTMLE ecovb;
886             ods output GEERCov=covmom GEEEmpPEst = mom;
887         run;

