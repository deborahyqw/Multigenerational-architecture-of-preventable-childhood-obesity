580        data all;
581          set all end=_end_;
582          cohort=cohort-1;
583        
584        	%indic3(vbl=mowestq, reflev=0, missing=., min=1, max=3, prefix=mowestq, usemiss=0,
585                    label1='Q2',label2='Q3', label3='Q4');
586             %indic3(vbl=mocalq, reflev=0, missing=., min=1, max=3, prefix=mocalq, usemiss=0,
587                    label1='Q2',label2='Q3', label3='Q4');
588             %indic3(vbl=mopaq, reflev=3, missing=., min=0, max=2, prefix=mopaq, usemiss=0,
589                    label0='Q1',label1='Q2', label2='Q3');
590             %indic3(vbl=moshiftq, reflev=0, missing=., min=1, max=3, prefix=moshiftq, usemiss=0,
591                    label1='Q2',label2='Q3', label3='Q4');
592        
593        run;

