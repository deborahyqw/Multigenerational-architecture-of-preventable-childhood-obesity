889        data betas;
890          set mom ;
891          by _imputation_;
892          _type_ = 'PARM';
893        	retain intercept mowestq1 mowestq2 mowestq3 mocalq1 mocalq2 mocalq3
894        					 mopaq0 mopaq1 mopaq2 mosmk2 mosmk3
895        					moshiftq1 moshiftq2 moshiftq3
896        					moage cohort chage white sex moow;
897        	
898        	* 'i' counts rows within each _imputation_ group ;
899          	if first._imputation_ then i=1;
900          	else i+1;
901        	
902        	select (i);
903            when (1) intercept = estimate;
904            when (2) mowestq1  = estimate;
905            when (3) mowestq2  = estimate;
906            when (4) mowestq3  = estimate;
907            when (5) mocalq1   = estimate;
908            when (6) mocalq2   = estimate;
909        	when (7) mocalq3   = estimate;
910        	when (8) mopaq0   = estimate;
911        	when (9) mopaq1   = estimate;
912        	when (10) mopaq2   = estimate;
913        	when (11) mosmk2  = estimate;
914        	when (12) mosmk3  = estimate;
915        	when (13) moshiftq1= estimate;
916        	when (14) moshiftq2= estimate;
917        	when (15) moshiftq3= estimate;
918            when (16) moage    = estimate;
919            when (17) cohort   = estimate;
920            when (18) chage    = estimate;
921            when (19) white    = estimate;
922            when (20) sex      = estimate;
923            when (21) moow     = estimate;
924            otherwise;
925          end;
926        	
927          * Only OUTPUT once per _imputation_, after we've assigned all param columns ;
928          if last._imputation_ then output;
