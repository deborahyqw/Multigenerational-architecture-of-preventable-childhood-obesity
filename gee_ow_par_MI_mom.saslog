1230       
1231       /*************************************************************************************/
1232       /**************** combine using mianalyze ********************************************/
1233       
1234       %macro MIPAR(dat1=, dat2=, dat3=, dat4=, dat5=);
1235       
1236       data temp;
1237       	length _Imputation_ 3;
1238       	set &dat1(in=a) &dat2(in=b) &dat3(in=c) &dat4(in=d) &dat5(in=e);
1239       	if a then _Imputation_=1;
1240         		else if b then _Imputation_=2;
1241        		else if c then _Imputation_=3;
1242         		else if d then _Imputation_=4;
1243         		else if e then _Imputation_=5;
1244         		  	
1245         	/* approximate standard error from the half-width of the CI */
1246         	StdErr = (uclpartialx - lclpartialx) / (2 * 1.96);
1247         	Estimate = partlparx;
1248         	Parameter = 'PartialPAR';
1249         	
1250         	keep _Imputation_ Estimate StdErr Parameter;
1251       run;
1252       
1253       proc mianalyze data=temp;
1254          modeleffects Estimate;
1255          stderr StdErr;
1256       run;
1257       
1258       %mend MIPAR;
1259       
1260       %MIPAR(dat1=mwest1,   dat2=mwest2,   dat3=mwest3,   dat4=mwest4,   dat5=mwest5 );

