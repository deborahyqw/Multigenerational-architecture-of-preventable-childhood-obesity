755        data all;
756          set all end=_end_;
757          cohort=cohort-1;
758        
759        	%indic3(vbl=mowestq, reflev=0, missing=., min=1, max=3, prefix=mowestq, usemiss=0,
760                    label1='Q2',label2='Q3', label3='Q4');
761             %indic3(vbl=mocalq, reflev=0, missing=., min=1, max=3, prefix=mocalq, usemiss=0,
762                    label1='Q2',label2='Q3', label3='Q4');
763             %indic3(vbl=mopaq, reflev=3, missing=., min=0, max=2, prefix=mopaq, usemiss=0,
764                    label0='Q1',label1='Q2', label2='Q3');
765             %indic3(vbl=moshiftq, reflev=0, missing=., min=1, max=3, prefix=moshiftq, usemiss=0,
766                    label1='Q2',label2='Q3', label3='Q4');
767        
