949        	n_or_p=N,
950        	n_or_pname=FQ,
951        	modvar= &modmod  ,
952        	missvarlist=NONE,
953        	partialpar= T,
954        	outdat= &outpref.&i,
955        	fixedvar= &fixfix );
956        	%end;
957        %mend runPAR;
