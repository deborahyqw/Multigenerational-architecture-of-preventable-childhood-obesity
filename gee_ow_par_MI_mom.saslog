838        
839        	rename  Prm1=intercept   Prm2=mowestq1   Prm3=mowestq2   Prm4=mowestq3   Prm5=mocalq1
840        			Prm6=mocalq2     Prm7=mocalq3
841        			Prm8=mopaq0     Prm9=mopaq1    Prm10=mopaq2    Prm11=mosmk2   Prm12=mosmk3
842        			Prm13=moshiftq1  Prm14=moshiftq2  Prm15=moshiftq3   Prm16=moage
843        			Prm17=cohort     Prm18=chage      Prm19=white       Prm20=sex   ;
844        
845        	length _name_ $10;
846        	
847        	*i counts rows within each _imputation_;
848        	if first._imputation_ then i=1;
849         		 else i+1;
850        
851        	* Assign which row this is (the row "label" in the covariance matrix) ;
852        	select(i);
853        		when(1)  _name_ = 'INTERCEPT';
854        		when(2)  _name_ = 'mowestq1';
855        		when(3)  _name_ = 'mowestq2';
856        		when(4)  _name_ = 'mowestq3';
857        		when(5)  _name_ = 'mocalq1';
858        		when(6)  _name_ = 'mocalq2';
859        		when(7)  _name_ = 'mocalq3';
860        		when(8)  _name_ = 'mopaq0';
861        		when(9)  _name_ = 'mopaq1';
862        		when(10)  _name_ = 'mopaq2';
863        		when(11)  _name_ = 'mosmk2';
864        		when(12)  _name_ = 'mosmk3';
865        		when(13)  _name_ = 'moshiftq1';
866        		when(14)  _name_ = 'moshiftq2';
867        		when(15)  _name_ = 'moshiftq3';
868        		when(16)  _name_ = 'moage';
869        		when(17)  _name_ = 'cohort';
870        		when(18)  _name_ = 'chage';
871        		when(19)  _name_ = 'white';
872        		when(20)  _name_ = 'sex';
873        		otherwise;
874        	end;
