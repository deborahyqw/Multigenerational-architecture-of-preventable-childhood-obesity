658        *proc print data=betas;
659        
660        data covparms;
661        	set covmom;
662        	by _imputation_;
663        	length _type_ $4;
664        	 _type_ = 'COV';
665        
666        	rename  Prm1=intercept   Prm2=mowestq1   Prm3=mowestq2   Prm4=mowestq3   Prm5=mocalq1
667        			Prm6=mocalq2     Prm7=mocalq3
668        			Prm8=mopaq0     Prm9=mopaq1    Prm10=mopaq2    Prm11=mosmk2   Prm12=mosmk3
669        			Prm13=moshiftq1  Prm14=moshiftq2  Prm15=moshiftq3   Prm16=moage
670        			Prm17=cohort     Prm18=chage      Prm19=white       Prm20=sex   ;
671        
672        	length _name_ $10;
673        	
674        	*i counts rows within each _imputation_;
675        	if first._imputation_ then i=1;
676         		 else i+1;
677        
678        	* Assign which row this is (the row "label" in the covariance matrix) ;
679        	select(i);
680        		when(1)  _name_ = 'INTERCEPT';
681        		when(2)  _name_ = 'mowestq1';
682        		when(3)  _name_ = 'mowestq2';
683        		when(4)  _name_ = 'mowestq3';
684        		when(5)  _name_ = 'mocalq1';
685        		when(6)  _name_ = 'mocalq2';
686        		when(7)  _name_ = 'mocalq3';
687        		when(8)  _name_ = 'mopaq0';
688        		when(9)  _name_ = 'mopaq1';
689        		when(10)  _name_ = 'mopaq2';
690        		when(11)  _name_ = 'mosmk2';
691        		when(12)  _name_ = 'mosmk3';
692        		when(13)  _name_ = 'moshiftq1';
693        		when(14)  _name_ = 'moshiftq2';
694        		when(15)  _name_ = 'moshiftq3';
695        		when(16)  _name_ = 'moage';
696        		when(17)  _name_ = 'cohort';
697        		when(18)  _name_ = 'chage';
698        		when(19)  _name_ = 'white';
699        		when(20)  _name_ = 'sex';
700        		otherwise;
701        	end;
702        	
703        	* Output EVERY row;
704          	output;
705        
706        keep _imputation_ _type_ _name_ prm1-prm20 ;
707        
708        run;

