1049               		  		 		 		 		 		 		
1050       /**********************************************************************/
1051       title ' maternal modifiable factors - moow ';
1052       proc genmod data = all descending;
1053       	by _imputation_ ;
1054        class id momid ;
1055          model chow = &mowestq_ &mocalq_ &mopaq_ mosmk2 mosmk3 &moshiftq_
1056         			    moage &covar1 moow
1057            / dist = Poisson link = log;
1058            repeated subject=id(momid)/type=unstr PRINTMLE ecovb;
1059            ods output GEERCov=covmom GEEEmpPEst = mom;
1060        run;

NOTE: The DESCENDING option applies only to the multinomial distribution with ordinal response.
