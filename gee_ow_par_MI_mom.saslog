612        
613        data betas;
614          set mom ;
615          by _imputation_;
616          _type_ = 'PARM';
617        	retain intercept mowestq1 mowestq2 mowestq3 mocalq1 mocalq2 mocalq3
618        					 mopaq0 mopaq1 mopaq2 mosmk2 mosmk3
619        					moshiftq1 moshiftq2 moshiftq3
620        					moage cohort chage white sex;
621        	
622        	* 'i' counts rows within each _imputation_ group ;
623          	if first._imputation_ then i=1;
624          	else i+1;
625        	
626        	select (i);
627            when (1) intercept = estimate;
628            when (2) mowestq1  = estimate;
629            when (3) mowestq2  = estimate;
630            when (4) mowestq3  = estimate;
631            when (5) mocalq1   = estimate;
632            when (6) mocalq2   = estimate;
633        	when (7) mocalq3   = estimate;
634        	when (8) mopaq0   = estimate;
635        	when (9) mopaq1   = estimate;
636        	when (10) mopaq2   = estimate;
637        	when (11) mosmk2  = estimate;
638        	when (12) mosmk3  = estimate;
639        	when (13) moshiftq1= estimate;
640        	when (14) moshiftq2= estimate;
641        	when (15) moshiftq3= estimate;
642            when (16) moage    = estimate;
643            when (17) cohort   = estimate;
644            when (18) chage    = estimate;
645            when (19) white    = estimate;
646            when (20) sex      = estimate;
647            otherwise;
648          end;
649        	
650          * Only OUTPUT once per _imputation_, after we've assigned all param columns ;
651          if last._imputation_ then output;
652        
653          if mowestq1 <0 then  mowestq1 =0;    if mowestq2 <0 then  mowestq2 =0;
13                                                                  The SAS System                                     22:37 Friday, November 14, 2025

654          if mopaq0 <0 then  mopaq0 =0;
655          if mopaq1 <0 then  mopaq1 =0;        if mopaq2 <0 then  mopaq2 =0;
656        
657        run;

