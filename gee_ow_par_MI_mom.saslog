600        
601        /**********************************************************************/
602        title ' maternal modifiable factors - not adjusting for moow because it may be on the causal pathways ';
603        proc genmod data = all descending;
604        	by _imputation_ ;
605         class id momid ;
606           model chow = &mowestq_ &mocalq_ &mopaq_ mosmk2 mosmk3 &moshiftq_
607          			    moage &covar1
608             / dist = Poisson link = log;
609             repeated subject=id(momid)/type=unstr PRINTMLE ecovb;
610             ods output GEERCov=covmom GEEEmpPEst = mom;
611         run;

NOTE: The DESCENDING option applies only to the multinomial distribution with ordinal response.
