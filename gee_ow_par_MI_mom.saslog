771        
772        %LET covar1= cohort chage white sex ;
773        
774        run;
775        
776        /**********************************************************************/
777        title ' maternal modifiable factors - not adjusting for moow because it may be on the causal pathways ';
778        proc genmod data = all descending;
779        	by _imputation_ ;
780         class id momid ;
781           model chow = &mowestq_ &mocalq_ &mopaq_ mosmk2 mosmk3 &moshiftq_
782          			    moage &covar1
783             / dist = Poisson link = log;
784             repeated subject=id(momid)/type=unstr PRINTMLE ecovb;
785             ods output GEERCov=covmom GEEEmpPEst = mom;
786         run;

NOTE: The DESCENDING option applies only to the multinomial distribution with ordinal response.
