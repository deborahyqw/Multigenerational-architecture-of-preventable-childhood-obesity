787        
788        data betas;
789          set mom ;
790          by _imputation_;
791          _type_ = 'PARM';
792        	retain intercept mowestq1 mowestq2 mowestq3 mocalq1 mocalq2 mocalq3
793        					 mopaq0 mopaq1 mopaq2 mosmk2 mosmk3
794        					moshiftq1 moshiftq2 moshiftq3
795        					moage cohort chage white sex;
796        	
797        	* 'i' counts rows within each _imputation_ group ;
798          	if first._imputation_ then i=1;
799          	else i+1;
800        	
801        	select (i);
802            when (1) intercept = estimate;
803            when (2) mowestq1  = estimate;
804            when (3) mowestq2  = estimate;
805            when (4) mowestq3  = estimate;
806            when (5) mocalq1   = estimate;
807            when (6) mocalq2   = estimate;
808        	when (7) mocalq3   = estimate;
809        	when (8) mopaq0   = estimate;
810        	when (9) mopaq1   = estimate;
811        	when (10) mopaq2   = estimate;
812        	when (11) mosmk2  = estimate;
813        	when (12) mosmk3  = estimate;
814        	when (13) moshiftq1= estimate;
815        	when (14) moshiftq2= estimate;
816        	when (15) moshiftq3= estimate;
817            when (16) moage    = estimate;
818            when (17) cohort   = estimate;
819            when (18) chage    = estimate;
820            when (19) white    = estimate;
821            when (20) sex      = estimate;
822            otherwise;
823          end;
824        	
825          * Only OUTPUT once per _imputation_, after we've assigned all param columns ;
826          if last._imputation_ then output;
827        
828          if mopaq0 <0 then  mopaq0 =0;  if mopaq1 <0 then  mopaq1 =0;  if mopaq2 <0 then  mopaq2 =0;
829        
830        run;

