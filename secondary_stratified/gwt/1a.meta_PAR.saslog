121        /**********************************************************************
122        CREATE MACRO TO METANALYZE ALL OF THE EXPOSURES FOR EACH GROUP
123        **********************************************************************/
124        
125        
126        /*have to metaanalyze each exposure separately, will create macro that can be used to run through each of the stratification groups
126      ! (sex/age/materinal BMI)*/
127        
128        
129        %macro metaanal_allexp (data=, group=);
130        
131        
132        	/* gotweight exposure */
133        	data gotweight_&group.; set &data; if exposure = 'gotweight'; run;
134        	%metaanal(data=gotweight_&group., beta=beta, se_or_var=s, se=SE, studylab=group, loglinear=F,
135        		explabel=gotweight, outcomelabel=ob,
136        			outdat= "PAR_gwt_gotweight_&group");
137        
138        	
139        
140        %mend metaanal_allexp;
141        
142        
143        /**********************************************************************
144        RUN MACRO
145        **********************************************************************/
146        
147        %let newpath = /udd/nhywa/GUTSOB/secondary_stratified/1.data;
148        x "cd &newpath"
148      !                ;
149        
150        
151        %metaanal_allexp(data=meta_PAR_sex, group=sex);

