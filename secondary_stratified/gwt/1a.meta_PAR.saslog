134        /**********************************************************************
135        CREATE MACRO TO METANALYZE ALL OF THE EXPOSURES FOR EACH GROUP
136        **********************************************************************/
137        
138        
139        /*have to metaanalyze each exposure separately, will create macro that can be used to run through each of the stratification groups
139      ! (sex/age/materinal BMI)*/
140        
141        
142        %macro metaanal_allexp (data=, group=);
143        
144        
145        	/* gotweight exposure */
146        	data gotweight_&group.; set &data; if exposure = 'gotweight'; run;
147        	%metaanal(data=gotweight_&group., beta=beta, se_or_var=s, se=SE, studylab=group, loglinear=F,
148        		explabel=gotweight, outcomelabel=ob,
149        			outdat= "PAR_gwt_gotweight_&group");
150        
151        	
152        
153        %mend metaanal_allexp;
154        
155        
156        /**********************************************************************
157        RUN MACRO
158        **********************************************************************/
159        
160        %let newpath = /udd/nhywa/GUTSOB/secondary_stratified/1.data;
161        x "cd &newpath"
161      !                ;
