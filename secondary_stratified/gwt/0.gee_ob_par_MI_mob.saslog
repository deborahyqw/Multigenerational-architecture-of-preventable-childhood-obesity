336        	%macro runPAR(prefixBeta=, prefixFreq=, outpref=, modmod=, fixfix=);
337        		%local i;
338        		%do i=1 %to 5;
339        	%par(
340        		bdata=&prefixBeta.&i,
341        		pdata=&prefixFreq.&i,
342        		n_or_p=N,
343        		n_or_pname=FQ,
344        		modvar= &modmod  ,
345        		missvarlist=NONE,
346        		partialpar= T,
347        		outdat= &outpref.&i,
348        		fixedvar= &fixfix );
349        		%end;
350        	%mend runPAR;
351        
352        	%runPAR(prefixBeta=betacov, prefixFreq=freqs, outpref=gwt,
353        			modmod = gotweight,
354        			fixfix = agebirth bpregob prev_preg1 prev_preg2 prev_preg3
355        					&covar1                   );
356        
357        	;
358        	
359        	/*************************************************************************************/
360        	/**************** combine using mianalyze ********************************************/
361        
362        
363        	%macro MIPAR(dat1=, dat2=, dat3=, dat4=, dat5=, exposure=);
364        
365        		data temp;
366        			length _Imputation_ 3;
367        			set &dat1(in=a) &dat2(in=b) &dat3(in=c) &dat4(in=d) &dat5(in=e);
368        			if a then _Imputation_=1;
369        				else if b then _Imputation_=2;
370        				else if c then _Imputation_=3;
371        				else if d then _Imputation_=4;
372        				else if e then _Imputation_=5;
373        					
374        			/* approximate standard error from the half-width of the CI */
375        			StdErr = (uclpartialx - lclpartialx) / (2 * 1.96);
376        			Estimate = partlparx;
377        			Parameter = 'PartialPAR';
378        			
379        			keep _Imputation_ Estimate StdErr Parameter;
6                                                                   The SAS System                                     12:06 Monday, November 17, 2025

380        		run;
381        
382        		ods output ParameterEstimates=&exposure._PAR;
383        		proc mianalyze data=temp;
384        			modeleffects Estimate;
385        			stderr StdErr;
386        		run;
387        
388        		data &exposure._PAR;
389        			set &exposure._PAR;
390        			length exposure $ 15;
391        			exposure="&exposure.";
392        		run;
393        			
394        
395        	%mend MIPAR;
