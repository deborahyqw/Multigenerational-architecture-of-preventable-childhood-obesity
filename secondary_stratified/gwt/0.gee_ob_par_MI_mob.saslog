315        
316        	%macro runPAR(prefixBeta=, prefixFreq=, outpref=, modmod=, fixfix=);
317        		%local i;
318        		%do i=1 %to 5;
319        	%par(
320        		bdata=&prefixBeta.&i,
321        		pdata=&prefixFreq.&i,
322        		n_or_p=N,
323        		n_or_pname=FQ,
324        		modvar= &modmod  ,
325        		missvarlist=NONE,
326        		partialpar= T,
327        		outdat= &outpref.&i,
328        		fixedvar= &fixfix );
329        		%end;
330        	%mend runPAR;
331        
332        	%runPAR(prefixBeta=betacov, prefixFreq=freqs, outpref=gwt,
333        			modmod = gotweight,
334        			fixfix = agebirth bpregob prev_preg1 prev_preg2 prev_preg3
335        					&covar1                   );
336        
337        	;
338        	
339        	/*************************************************************************************/
340        	/**************** combine using mianalyze ********************************************/
341        
342        
343        	%macro MIPAR(dat1=, dat2=, dat3=, dat4=, dat5=, exposure=);
344        
345        		data temp;
346        			length _Imputation_ 3;
347        			set &dat1(in=a) &dat2(in=b) &dat3(in=c) &dat4(in=d) &dat5(in=e);
348        			if a then _Imputation_=1;
349        				else if b then _Imputation_=2;
350        				else if c then _Imputation_=3;
351        				else if d then _Imputation_=4;
352        				else if e then _Imputation_=5;
353        					
354        			/* approximate standard error from the half-width of the CI */
355        			StdErr = (uclpartialx - lclpartialx) / (2 * 1.96);
356        			Estimate = partlparx;
357        			Parameter = 'PartialPAR';
358        			
359        			keep _Imputation_ Estimate StdErr Parameter;
360        		run;
361        
362        		ods output ParameterEstimates=&exposure._PAR;
363        		proc mianalyze data=temp;
364        			modeleffects Estimate;
365        			stderr StdErr;
366        		run;
367        
368        		data &exposure._PAR;
369        			set &exposure._PAR;
370        			length exposure $ 15;
371        			exposure="&exposure.";
372        		run;
373        			
374        
375        	%mend MIPAR;
376        
