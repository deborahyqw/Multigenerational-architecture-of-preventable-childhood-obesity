142        /**********************************************************************
143        	CREATE MACRO TO RUN OVER THE STRATIFIED DATASETS
144        **********************************************************************/
145        
146        
147        %macro ob_par_MI_strat (data=, group=);
148        
149        
150        	/**********************************************************************
151        	RUN THE RR, WITH METANALYSIS BY IMPUTATION
152        	**********************************************************************/
153        
154        	title "HEADING: gotweight regression, &group.";
155        	proc genmod data = &data descending;
156        		by _imputation_ ;
157        	class id momid ;
158        	model chob = gotweight agebirth bpregob prev_preg1 prev_preg2 prev_preg3 &covar1
159        		/ dist = Poisson link = log;
160        		repeated subject=id(momid)/type=unstr PRINTMLE ecovb;
161        		ods output GEERCov=covuter GEEEmpPEst = uter;
162        	run;
163        
4                                                                   The SAS System                                     12:06 Monday, November 17, 2025

164        	TITLE "HEADER: multiple imputation - gotweight, &group.";
165        	ods output ParameterEstimates=mi_gweight;
166        	PROC MIANALYZE parms=uter;
167        	MODELEFFECTS INTERCEPT
168        				gotweight agebirth bpregob prev_preg1 prev_preg2 prev_preg3 &covar1 ;
169        	RUN;
170        	title "";
171        
172        
173        	/*MANUAL SPECIFICATION OF DATASET NAME AND GROUP*/
174        		data dat_lb.gwt_&group._RR;
175        			length Parm $ 15;
176        			length mod $ 40;
177        			length group $ 40;
178        
179        			set mi_gweight(in=a)  ;
180        			
181        			if a then mod="gwt";
182        			if Parm in ("gotweight"); *only keep main exposures when exporting;
183        
184        			group="&group.";
185        
186        			RR=exp(Estimate); LCI=exp(LCLMean); UCI=exp(UCLMean);
187        		run;
188        
189        		title "HEADER: proc print for the first regression analysis for &group";
190        		proc print data=dat_lb.gwt_&group._RR; run;
191        		title "";
192        
193        
194        	/**********************************************************************
195        	PREPARE DATA FOR PAR
196        	**********************************************************************/
197        
198        	title "HEADER: proc print for uter for &group";
199        	proc print data=uter; run;
200        	title "";
201        
202        
203        	data betas;
204        	set uter ;
205        	by _imputation_;
206        	_type_ = 'PARM';
207        		retain intercept gotweight agebirth bpregob prev_preg1 prev_preg2 prev_preg3
208        					&covar1;
209        		
210        		* 'i' counts rows within each _imputation_ group ;
211        		if first._imputation_ then i=1;
212        		else i+1;
213        		
214        		/*MANUAL SPECIFICATION OF VARIABLES*/
215        		select (i);
216        		when (1) intercept = estimate;
217        		when (2) gotweight  = estimate;
218        		when (3) agebirth  = estimate;
219        		when (4) bpregob   = estimate;
220        		when (5) prev_preg1= estimate;
221        		when (6) prev_preg2  = estimate;
222        		when (7) prev_preg3  = estimate;
223        		when (8) chage    = estimate;
224        		when (9) white    = estimate;
225        		when (10) sex      = estimate;
226        		otherwise;
227        	end;
228        		
229        	/*Only OUTPUT once per _imputation_, after we've assigned all param columns*/
230        	if last._imputation_ then output;
231        
232        	run;
233        
234        	title "HEADER: proc print for betas for &group";
235        	proc print data=betas; run;
236        	title "";
237        
238        	/*MANUALLY SPECIFICATION OF PARAMS*/
239        	data covparms;
240        		set covuter;
241        		by _imputation_;
242        		length _type_ $4;
243        		_type_ = 'COV';
244        
245        		rename  Prm1=intercept   Prm2=gotweight  Prm3=agebirth   Prm4=bpregob    Prm5=prev_preg1    Prm6=prev_preg2
246        				Prm7=prev_preg3  Prm8=chage     Prm9=white        Prm10=sex   ;
247        
248        		length _name_ $10;
249        		
250        		*i counts rows within each _imputation_;
251        		if first._imputation_ then i=1;
252        			else i+1;
253        
254        		* Assign which row this is (the row "label" in the covariance matrix) ;
255        		select(i);
256        			when(1)  _name_ = 'INTERCEPT';
257        			when(2)  _name_ = 'gotweight';
258        			when(3)  _name_ = 'agebirth';
259        			when(4)  _name_ = 'bpregob';
260        			when(5)  _name_ = 'prev_preg1';
261        			when(6)  _name_ = 'prev_preg2';
262        			when(7)  _name_ = 'prev_preg3';
263        			when(8)  _name_ = 'chage';
264        			when(9)  _name_ = 'white';
265        			when(10)  _name_ = 'sex';
266        			otherwise;
267        		end;
268        		
269        		* Output EVERY row;
270        		output;
271        
