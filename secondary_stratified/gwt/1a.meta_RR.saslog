78         
79         /**SEX************************************/
80         
81         
82         data meta_RR_sex;
83            set dat_lb.gwt_female_RR  dat_lb.gwt_male_RR ;
84            	length  HRCI2 $ 18;
85         	HRCI2=.;
86         	SE=StdErr*1;
87             beta=Estimate*1;
88         	keep Parm mod group beta SE HRCI2;
89         
90         run;

