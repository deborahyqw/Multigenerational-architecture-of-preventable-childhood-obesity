124        /**********************************************************************
125        CREATE MACRO TO METANALYZE ALL OF THE EXPOSURES FOR EACH GROUP
126        **********************************************************************/
127        
128        
129        /*have to metaanalyze each exposure separately, will create macro that can be used to run through each of the stratification groups
129      ! (sex/age/materinal BMI)*/
130        
131        %macro metaanal_allexp (data=, group=);
132        
133        	/* gotweight exposure */
134        	data gotweight_&group.; set &data; if Parm = 'gotweight'; run;
135        	%metaanal(data=gotweight_&group., beta=beta, se_or_var=s, se=SE, studylab=group, loglinear=T,
136        		explabel=gotweight, outcomelabel=ob,
137        		outdat= "RR_gwt_gotweight_&group");
138        
139        	
140        %mend metaanal_allexp;
141        
142        
143        /**********************************************************************
144        RUN MACRO
145        **********************************************************************/
146        
147        %let newpath = /udd/nhywa/GUTSOB/secondary_stratified/1.data;
148        x "cd &newpath"
148      !                ;
149        
150        
151        %metaanal_allexp(data=meta_RR_sex, group=sex);

