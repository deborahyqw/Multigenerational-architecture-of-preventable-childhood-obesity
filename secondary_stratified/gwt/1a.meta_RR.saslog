136        /**********************************************************************
137        CREATE MACRO TO METANALYZE ALL OF THE EXPOSURES FOR EACH GROUP
138        **********************************************************************/
139        
140        
141        /*have to metaanalyze each exposure separately, will create macro that can be used to run through each of the stratification groups
141      ! (sex/age/materinal BMI)*/
142        
143        %macro metaanal_allexp (data=, group=);
144        
145        	/* gotweight exposure */
146        	data gotweight_&group.; set &data; if Parm = 'gotweight'; run;
147        	%metaanal(data=gotweight_&group., beta=beta, se_or_var=s, se=SE, studylab=group, loglinear=T,
148        		explabel=gotweight, outcomelabel=ob,
149        		outdat= "RR_gwt_gotweight_&group");
150        
151        	
152        %mend metaanal_allexp;
153        
154        
155        /**********************************************************************
156        RUN MACRO
157        **********************************************************************/
158        
159        %let newpath = /udd/nhywa/GUTSOB/secondary_stratified/1.data;
160        x "cd &newpath"
160      !                ;
161        
162        
163        %metaanal_allexp(data=meta_RR_sex, group=sex);
