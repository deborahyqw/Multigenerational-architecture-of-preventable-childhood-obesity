313        
314        	%macro runPAR(prefixBeta=, prefixFreq=, outpref=, modmod=, fixfix=);
315        		%local i;
316        		%do i=1 %to 5;
317        	%par(
318        		bdata=&prefixBeta.&i,
319        		pdata=&prefixFreq.&i,
320        		n_or_p=N,
321        		n_or_pname=FQ,
322        		modvar= &modmod  ,
323        		missvarlist=NONE,
324        		partialpar= T,
325        		outdat= &outpref.&i,
326        		fixedvar= &fixfix );
327        		%end;
328        	%mend runPAR;
329        
330        	%runPAR(prefixBeta=betacov, prefixFreq=freqs, outpref=gwt,
331        			modmod = gotweight,
332        			fixfix = agebirth bpregob prev_preg1 prev_preg2 prev_preg3
333        					&covar1                   );
334        
335        	;
336        	
337        	/*************************************************************************************/
338        	/**************** combine using mianalyze ********************************************/
339        
340        
341        	%macro MIPAR(dat1=, dat2=, dat3=, dat4=, dat5=, exposure=);
342        
343        		data temp;
344        			length _Imputation_ 3;
345        			set &dat1(in=a) &dat2(in=b) &dat3(in=c) &dat4(in=d) &dat5(in=e);
346        			if a then _Imputation_=1;
347        				else if b then _Imputation_=2;
348        				else if c then _Imputation_=3;
349        				else if d then _Imputation_=4;
350        				else if e then _Imputation_=5;
351        					
352        			/* approximate standard error from the half-width of the CI */
353        			StdErr = (uclpartialx - lclpartialx) / (2 * 1.96);
354        			Estimate = partlparx;
355        			Parameter = 'PartialPAR';
356        			
357        			keep _Imputation_ Estimate StdErr Parameter;
358        		run;
359        
360        		ods output ParameterEstimates=&exposure._PAR;
361        		proc mianalyze data=temp;
362        			modeleffects Estimate;
363        			stderr StdErr;
364        		run;
365        
366        		data &exposure._PAR;
367        			set &exposure._PAR;
368        			length exposure $ 15;
369        			exposure="&exposure.";
370        		run;
371        			
372        
373        	%mend MIPAR;
374        
375        
376        
377        	%MIPAR(dat1=gwt1,   dat2=gwt2,   dat3=gwt3,   dat4=gwt4,   dat5=gwt5, exposure=gotweight );
