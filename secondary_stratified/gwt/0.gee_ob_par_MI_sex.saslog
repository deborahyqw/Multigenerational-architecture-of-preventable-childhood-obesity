122        /**********************************************************************
123        	CREATE MACRO TO RUN OVER THE STRATIFIED DATASETS
124        **********************************************************************/
125        
126        
127        %macro ob_par_MI_strat (data=, group=);
128        
129        
130        	/**********************************************************************
131        	RUN THE RR, WITH METANALYSIS BY IMPUTATION
132        	**********************************************************************/
133        
134        	title "HEADING: gotweight regression, &group.";
135        	proc genmod data = &data descending;
136        		by _imputation_ ;
137        	class id momid ;
138        	model chob = gotweight agebirth bpregob prev_preg1 prev_preg2 prev_preg3 &covar1
139        		/ dist = Poisson link = log;
140        		repeated subject=id(momid)/type=unstr PRINTMLE ecovb;
141        		ods output GEERCov=covuter GEEEmpPEst = uter;
142        	run;
143        
144        	TITLE "HEADER: multiple imputation - gotweight, &group.";
145        	ods output ParameterEstimates=mi_gweight;
146        	PROC MIANALYZE parms=uter;
147        	MODELEFFECTS INTERCEPT
148        				gotweight agebirth bpregob prev_preg1 prev_preg2 prev_preg3 &covar1 ;
149        	RUN;
150        	title "";
151        
152        
153        	/*MANUAL SPECIFICATION OF DATASET NAME AND GROUP*/
154        		data dat_lb.gwt_&group._RR;
155        			length Parm $ 15;
156        			length mod $ 40;
157        			length group $ 40;
158        
159        			set mi_gweight(in=a)  ;
160        			
161        			if a then mod="gwt";
162        			if Parm in ("gotweight"); *only keep main exposures when exporting;
163        
164        			group="&group.";
4                                                                   The SAS System                                          16:08 Monday, July 7, 2025

165        
166        			RR=exp(Estimate); LCI=exp(LCLMean); UCI=exp(UCLMean);
167        		run;
168        
169        		title "HEADER: proc print for the first regression analysis for &group";
170        		proc print data=dat_lb.gwt_&group._RR; run;
171        		title "";
172        
173        
174        	/**********************************************************************
175        	PREPARE DATA FOR PAR
176        	**********************************************************************/
177        
178        	title "HEADER: proc print for uter for &group";
179        	proc print data=uter; run;
180        	title "";
181        
182        
183        	data betas;
184        	set uter ;
185        	by _imputation_;
186        	_type_ = 'PARM';
187        		retain intercept gotweight agebirth bpregob prev_preg1 prev_preg2 prev_preg3
188        					&covar1;
189        		
190        		* 'i' counts rows within each _imputation_ group ;
191        		if first._imputation_ then i=1;
192        		else i+1;
193        		
194        		/*MANUAL SPECIFICATION OF VARIABLES*/
195        		select (i);
196        		when (1) intercept = estimate;
197        		when (2) gotweight  = estimate;
198        		when (3) agebirth  = estimate;
199        		when (4) bpregob   = estimate;
200        		when (5) prev_preg1= estimate;
201        		when (6) prev_preg2  = estimate;
202        		when (7) prev_preg3  = estimate;
203        		when (8) chage    = estimate;
204        		when (9) white    = estimate;
205        		otherwise;
206        	end;
207        		
208        	/*Only OUTPUT once per _imputation_, after we've assigned all param columns*/
209        	if last._imputation_ then output;
210        
211        	run;
212        
213        	title "HEADER: proc print for betas for &group";
214        	proc print data=betas; run;
215        	title "";
216        
217        	/*MANUALLY SPECIFICATION OF PARAMS*/
218        	data covparms;
219        		set covuter;
220        		by _imputation_;
221        		length _type_ $4;
222        		_type_ = 'COV';
223        
224        		rename  Prm1=intercept   Prm2=gotweight  Prm3=agebirth   Prm4=bpregob    Prm5=prev_preg1    Prm6=prev_preg2
225        				Prm7=prev_preg3  Prm8=chage     Prm9=white        ;
226        
227        		length _name_ $10;
228        		
229        		*i counts rows within each _imputation_;
230        		if first._imputation_ then i=1;
231        			else i+1;
232        
233        		* Assign which row this is (the row "label" in the covariance matrix) ;
234        		select(i);
235        			when(1)  _name_ = 'INTERCEPT';
236        			when(2)  _name_ = 'gotweight';
237        			when(3)  _name_ = 'agebirth';
238        			when(4)  _name_ = 'bpregob';
239        			when(5)  _name_ = 'prev_preg1';
240        			when(6)  _name_ = 'prev_preg2';
241        			when(7)  _name_ = 'prev_preg3';
242        			when(8)  _name_ = 'chage';
243        			when(9)  _name_ = 'white';
244        			otherwise;
245        		end;
246        		
247        		* Output EVERY row;
248        		output;
249        
250        	keep _imputation_ _type_ _name_ prm1-prm9 ;  /*MANUAL SPECIFICATION OF PARAMETER RANGE*/
251        
252        	run;
253        
254        	title "HEADER: proc print for covparms for &group";
255        	proc print data=covparms; run;
256        	title "";
257        
258        	data betacov;
259        		set betas covparms;
260        		by _imputation_ ;
261        		keep _imputation_ _type_ _name_
262        				intercept  gotweight agebirth bpregob prev_preg1 prev_preg2 prev_preg3
263        					&covar1;
264        	run;
265        
266        	data betacov1(drop=_imputation_)
267        			betacov2(drop=_imputation_)
268        			betacov3(drop=_imputation_)
269        			betacov4(drop=_imputation_)
270        			betacov5(drop=_imputation_);
271        	set betacov;
272        	select (_imputation_);
5                                                                   The SAS System                                          16:08 Monday, July 7, 2025

273        		when (1) output betacov1;
274        		when (2) output betacov2;
275        		when (3) output betacov3;
276        		when (4) output betacov4;
277        		when (5) output betacov5;
278        		otherwise;
279        	end;
280        	run;
281        
282        	title "HEADER: proc print for first betacov1 for &group";
283        	proc print data=betacov1; run;
284        	title ""; 	
