144        /**********************************************************************
145        	CREATE MACRO TO RUN OVER THE STRATIFIED DATASETS
146        **********************************************************************/
147        
148        
149        %macro ob_par_MI_strat (data=, group=);
150        
151        
152        	/**********************************************************************
153        	RUN THE RR, WITH METANALYSIS BY IMPUTATION
154        	**********************************************************************/
155        
156        	title "HEADING: gotweight regression, &group.";
157        	proc genmod data = &data descending;
158        		by _imputation_ ;
159        	class id momid ;
160        	model chob = gotweight agebirth bpregob prev_preg1 prev_preg2 prev_preg3 &covar1
161        		/ dist = Poisson link = log;
162        		repeated subject=id(momid)/type=unstr PRINTMLE ecovb;
163        		ods output GEERCov=covuter GEEEmpPEst = uter;
164        	run;
165        
166        	TITLE "HEADER: multiple imputation - gotweight, &group.";
167        	ods output ParameterEstimates=mi_gweight;
168        	PROC MIANALYZE parms=uter;
169        	MODELEFFECTS INTERCEPT
170        				gotweight agebirth bpregob prev_preg1 prev_preg2 prev_preg3 &covar1 ;
4                                                                   The SAS System                                     12:06 Monday, November 17, 2025

171        	RUN;
172        	title "";
173        
174        
175        	/*MANUAL SPECIFICATION OF DATASET NAME AND GROUP*/
176        		data dat_lb.gwt_&group._RR;
177        			length Parm $ 15;
178        			length mod $ 40;
179        			length group $ 40;
180        
181        			set mi_gweight(in=a)  ;
182        			
183        			if a then mod="gwt";
184        			if Parm in ("gotweight"); *only keep main exposures when exporting;
185        
186        			group="&group.";
187        
188        			RR=exp(Estimate); LCI=exp(LCLMean); UCI=exp(UCLMean);
189        		run;
190        
191        		title "HEADER: proc print for the first regression analysis for &group";
192        		proc print data=dat_lb.gwt_&group._RR; run;
193        		title "";
194        
195        
196        	/**********************************************************************
197        	PREPARE DATA FOR PAR
198        	**********************************************************************/
199        
200        	title "HEADER: proc print for uter for &group";
201        	proc print data=uter; run;
202        	title "";
203        
204        
205        	data betas;
206        	set uter ;
207        	by _imputation_;
208        	_type_ = 'PARM';
209        		retain intercept gotweight agebirth bpregob prev_preg1 prev_preg2 prev_preg3
210        					&covar1;
211        		
212        		* 'i' counts rows within each _imputation_ group ;
213        		if first._imputation_ then i=1;
214        		else i+1;
215        		
216        		/*MANUAL SPECIFICATION OF VARIABLES*/
217        		select (i);
218        		when (1) intercept = estimate;
219        		when (2) gotweight  = estimate;
220        		when (3) agebirth  = estimate;
221        		when (4) bpregob   = estimate;
222        		when (5) prev_preg1= estimate;
223        		when (6) prev_preg2  = estimate;
224        		when (7) prev_preg3  = estimate;
225        		when (8) chage    = estimate;
226        		when (9) white    = estimate;
227        		otherwise;
228        	end;
229        		
230        	/*Only OUTPUT once per _imputation_, after we've assigned all param columns*/
231        	if last._imputation_ then output;
232        
233        	run;
234        
235        	title "HEADER: proc print for betas for &group";
236        	proc print data=betas; run;
237        	title "";
238        
239        	/*MANUALLY SPECIFICATION OF PARAMS*/
240        	data covparms;
241        		set covuter;
242        		by _imputation_;
243        		length _type_ $4;
244        		_type_ = 'COV';
245        
246        		rename  Prm1=intercept   Prm2=gotweight  Prm3=agebirth   Prm4=bpregob    Prm5=prev_preg1    Prm6=prev_preg2
247        				Prm7=prev_preg3  Prm8=chage     Prm9=white        ;
248        
249        		length _name_ $10;
250        		
251        		*i counts rows within each _imputation_;
252        		if first._imputation_ then i=1;
253        			else i+1;
254        
255        		* Assign which row this is (the row "label" in the covariance matrix) ;
256        		select(i);
257        			when(1)  _name_ = 'INTERCEPT';
258        			when(2)  _name_ = 'gotweight';
259        			when(3)  _name_ = 'agebirth';
260        			when(4)  _name_ = 'bpregob';
261        			when(5)  _name_ = 'prev_preg1';
262        			when(6)  _name_ = 'prev_preg2';
263        			when(7)  _name_ = 'prev_preg3';
264        			when(8)  _name_ = 'chage';
265        			when(9)  _name_ = 'white';
266        			otherwise;
267        		end;
268        		
269        		* Output EVERY row;
270        		output;
271        
272        	keep _imputation_ _type_ _name_ prm1-prm9 ;  /*MANUAL SPECIFICATION OF PARAMETER RANGE*/
273        
274        	run;
275        
276        	title "HEADER: proc print for covparms for &group";
277        	proc print data=covparms; run;
278        	title "";
5                                                                   The SAS System                                     12:06 Monday, November 17, 2025

279        
280        	data betacov;
281        		set betas covparms;
282        		by _imputation_ ;
283        		keep _imputation_ _type_ _name_
284        				intercept  gotweight agebirth bpregob prev_preg1 prev_preg2 prev_preg3
285        					&covar1;
286        	run;
287        
288        	data betacov1(drop=_imputation_)
289        			betacov2(drop=_imputation_)
290        			betacov3(drop=_imputation_)
291        			betacov4(drop=_imputation_)
292        			betacov5(drop=_imputation_);
293        	set betacov;
294        	select (_imputation_);
295        		when (1) output betacov1;
296        		when (2) output betacov2;
