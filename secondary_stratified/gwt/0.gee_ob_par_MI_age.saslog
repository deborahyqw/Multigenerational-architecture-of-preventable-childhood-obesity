678        
679        %LET covar1=  white sex; /*MANUAL SPECIFICATION OF VARIABLES*/
680        
681        
682        
683        /**********************************************************************
684        	CREATE MACRO TO RUN OVER THE STRATIFIED DATASETS
685        **********************************************************************/
686        
687        
688        %macro ob_par_MI_strat (data=, group=);
689        
690        
691        	/**********************************************************************
692        	RUN THE RR, WITH METANALYSIS BY IMPUTATION
693        	**********************************************************************/
694        
695        	title "HEADING: gotweight regression, &group.";
696        	proc genmod data = &data descending;
697        		by _imputation_ ;
698        	class id momid ;
699        	model chob = gotweight agebirth bpregob prev_preg1 prev_preg2 prev_preg3 &covar1
700        		/ dist = Poisson link = log;
701        		repeated subject=id(momid)/type=unstr PRINTMLE ecovb;
702        		ods output GEERCov=covuter GEEEmpPEst = uter;
703        	run;
704        
705        	TITLE "HEADER: multiple imputation - gotweight, &group.";
706        	ods output ParameterEstimates=mi_gweight;
707        	PROC MIANALYZE parms=uter;
708        	MODELEFFECTS INTERCEPT
709        				gotweight agebirth bpregob prev_preg1 prev_preg2 prev_preg3 &covar1 ;
710        	RUN;
711        	title "";
712        
713        
714        	/*MANUAL SPECIFICATION OF DATASET NAME AND GROUP*/
715        		data dat_lb.gwt_&group._RR;
716        			length Parm $ 15;
717        			length mod $ 40;
718        			length group $ 40;
719        
720        			set mi_gweight(in=a)  ;
721        			
722        			if a then mod="gwt";
723        			if Parm in ("gotweight"); *only keep main exposures when exporting;
724        
725        			group="&group.";
726        
727        			RR=exp(Estimate); LCI=exp(LCLMean); UCI=exp(UCLMean);
728        		run;
729        
730        		title "HEADER: proc print for the first regression analysis for &group";
731        		proc print data=dat_lb.gwt_&group._RR; run;
732        		title "";
733        
734        
735        	/**********************************************************************
736        	PREPARE DATA FOR PAR
737        	**********************************************************************/
738        
739        	title "HEADER: proc print for uter for &group";
740        	proc print data=uter; run;
741        	title "";
742        
743        
744        	data betas;
745        	set uter ;
746        	by _imputation_;
747        	_type_ = 'PARM';
748        		retain intercept gotweight agebirth bpregob prev_preg1 prev_preg2 prev_preg3
749        					&covar1;
750        		
751        		* 'i' counts rows within each _imputation_ group ;
752        		if first._imputation_ then i=1;
753        		else i+1;
754        		
755        		/*MANUAL SPECIFICATION OF VARIABLES*/
756        		select (i);
757        		when (1) intercept = estimate;
758        		when (2) gotweight  = estimate;
759        		when (3) agebirth  = estimate;
760        		when (4) bpregob   = estimate;
761        		when (5) prev_preg1= estimate;
762        		when (6) prev_preg2  = estimate;
763        		when (7) prev_preg3  = estimate;
764        		when (8) white    = estimate;
765        		when (9) sex      = estimate;
766        		otherwise;
767        	end;
768        		
769        	/*Only OUTPUT once per _imputation_, after we've assigned all param columns*/
770        	if last._imputation_ then output;
771        
772        	run;
773        
774        	title "HEADER: proc print for betas for &group";
775        	proc print data=betas; run;
776        	title "";
777        
778        	/*MANUALLY SPECIFICATION OF PARAMS*/
779        	data covparms;
780        		set covuter;
781        		by _imputation_;
782        		length _type_ $4;
783        		_type_ = 'COV';
14                                                                  The SAS System                                     11:40 Monday, November 17, 2025

784        
785        		rename  Prm1=intercept   Prm2=gotweight  Prm3=agebirth   Prm4=bpregob    Prm5=prev_preg1    Prm6=prev_preg2
786        				Prm7=prev_preg3  Prm8=white        Prm9=sex   ;
787        
788        		length _name_ $10;
789        		
790        		*i counts rows within each _imputation_;
791        		if first._imputation_ then i=1;
792        			else i+1;
793        
794        		* Assign which row this is (the row "label" in the covariance matrix) ;
795        		select(i);
796        			when(1)  _name_ = 'INTERCEPT';
797        			when(2)  _name_ = 'gotweight';
798        			when(3)  _name_ = 'agebirth';
799        			when(4)  _name_ = 'bpregob';
800        			when(5)  _name_ = 'prev_preg1';
801        			when(6)  _name_ = 'prev_preg2';
802        			when(7)  _name_ = 'prev_preg3';
803        			when(8)  _name_ = 'white';
804        			when(9)  _name_ = 'sex';
805        			otherwise;
806        		end;
807        		
808        		* Output EVERY row;
809        		output;
810        
811        	keep _imputation_ _type_ _name_ prm1-prm9 ;  /*MANUAL SPECIFICATION OF PARAMETER RANGE*/
812        
813        	run;
814        
815        	title "HEADER: proc print for covparms for &group";
816        	proc print data=covparms; run;
817        	title "";
818        
819        	data betacov;
820        		set betas covparms;
821        		by _imputation_ ;
822        		keep _imputation_ _type_ _name_
823        				intercept  gotweight agebirth bpregob prev_preg1 prev_preg2 prev_preg3
824        					&covar1;
825        	run;
826        
827        	data betacov1(drop=_imputation_)
828        			betacov2(drop=_imputation_)
829        			betacov3(drop=_imputation_)
830        			betacov4(drop=_imputation_)
831        			betacov5(drop=_imputation_);
832        	set betacov;
833        	select (_imputation_);
834        		when (1) output betacov1;
835        		when (2) output betacov2;
836        		when (3) output betacov3;
837        		when (4) output betacov4;
838        		when (5) output betacov5;
839        		otherwise;
