875        	%macro runPAR(prefixBeta=, prefixFreq=, outpref=, modmod=, fixfix=);
876        		%local i;
877        		%do i=1 %to 5;
878        	%par(
879        		bdata=&prefixBeta.&i,
880        		pdata=&prefixFreq.&i,
881        		n_or_p=N,
882        		n_or_pname=FQ,
883        		modvar= &modmod  ,
884        		missvarlist=NONE,
885        		partialpar= T,
886        		outdat= &outpref.&i,
887        		fixedvar= &fixfix );
888        		%end;
889        	%mend runPAR;
