895        
896        	;
897        	
898        	/*************************************************************************************/
899        	/**************** combine using mianalyze ********************************************/
900        
901        
902        	%macro MIPAR(dat1=, dat2=, dat3=, dat4=, dat5=, exposure=);
903        
904        		data temp;
905        			length _Imputation_ 3;
906        			set &dat1(in=a) &dat2(in=b) &dat3(in=c) &dat4(in=d) &dat5(in=e);
907        			if a then _Imputation_=1;
908        				else if b then _Imputation_=2;
909        				else if c then _Imputation_=3;
910        				else if d then _Imputation_=4;
911        				else if e then _Imputation_=5;
912        					
913        			/* approximate standard error from the half-width of the CI */
914        			StdErr = (uclpartialx - lclpartialx) / (2 * 1.96);
915        			Estimate = partlparx;
916        			Parameter = 'PartialPAR';
917        			
918        			keep _Imputation_ Estimate StdErr Parameter;
919        		run;
920        
921        		ods output ParameterEstimates=&exposure._PAR;
922        		proc mianalyze data=temp;
923        			modeleffects Estimate;
924        			stderr StdErr;
925        		run;
926        
927        		data &exposure._PAR;
928        			set &exposure._PAR;
929        			length exposure $ 15;
930        			exposure="&exposure.";
931        		run;
932        			
933        
934        	%mend MIPAR;
935        
936        
937        
938        	%MIPAR(dat1=gwt1,   dat2=gwt2,   dat3=gwt3,   dat4=gwt4,   dat5=gwt5, exposure=gotweight );
939        
