2          /********************************************************************************
3          CODE DOCUMENTATION
4          ********************************************************************************/
5          /*
6          Program name: /udd/nhywa/GUTSOB/secondary_stratified/gwt
7          Pogrammer: Bethsaida Cardona (n2bca)
8          Date started: 07/2025
9          Program Purpose: Calculate RRs and PARs for the association between gestational weight gain and obesity
10         stratified by age
11         Exposures: GOTWEIGHT [binary]
12         Stratifiers: age (child <13 or child >=13)
13         Statistical Analyses:
14         	1) proc genmod to calculate multivariable log-binomial model with generalized estimating equations (GEE),
15         	a Poisson distribution, and an unstructured correlation structure, accounting for correlations across
16         	time for the same child and between siblings born to the same mother
17         	2) population attributable fraction with %par macro
18         
19         */
20         
21         /********************************************************************************
22         Set Up
23         ********************************************************************************/
24         
25         libname dat_lb '/udd/nhywa/GUTSOB/secondary_stratified/1.data';
NOTE: Libref DAT_LB was successfully assigned as follows: 
      Engine:        V9 
      Physical Name: /udd/nhywa/GUTSOB/secondary_stratified/1.data
26         
27         /*call in sas file that has our study population data (includes multiple imputation, is specific to the obesity
27       ! outcome)*/
28         %include '/udd/nhywa/GUTSOB/merge_ob_MI.sas';
