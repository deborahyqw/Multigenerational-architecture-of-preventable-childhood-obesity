316        
317        	%macro runPAR(prefixBeta=, prefixFreq=, outpref=, modmod=, fixfix=);
318        		%local i;
319        		%do i=1 %to 5;
320        	%par(
321        		bdata=&prefixBeta.&i,
322        		pdata=&prefixFreq.&i,
323        		n_or_p=N,
324        		n_or_pname=FQ,
325        		modvar= &modmod  ,
326        		missvarlist=NONE,
327        		partialpar= T,
328        		outdat= &outpref.&i,
329        		fixedvar= &fixfix );
330        		%end;
331        	%mend runPAR;
332        
333        	%runPAR(prefixBeta=betacov, prefixFreq=freqs, outpref=gwt,
334        			modmod = gotweight,
335        			fixfix = agebirth bpregob prev_preg1 prev_preg2 prev_preg3
336        					&covar1                   );
337        
338        	;
339        	
340        	/*************************************************************************************/
341        	/**************** combine using mianalyze ********************************************/
342        
343        
344        	%macro MIPAR(dat1=, dat2=, dat3=, dat4=, dat5=, exposure=);
345        
346        		data temp;
347        			length _Imputation_ 3;
348        			set &dat1(in=a) &dat2(in=b) &dat3(in=c) &dat4(in=d) &dat5(in=e);
349        			if a then _Imputation_=1;
350        				else if b then _Imputation_=2;
351        				else if c then _Imputation_=3;
352        				else if d then _Imputation_=4;
353        				else if e then _Imputation_=5;
354        					
355        			/* approximate standard error from the half-width of the CI */
356        			StdErr = (uclpartialx - lclpartialx) / (2 * 1.96);
357        			Estimate = partlparx;
358        			Parameter = 'PartialPAR';
359        			
360        			keep _Imputation_ Estimate StdErr Parameter;
361        		run;
362        
363        		ods output ParameterEstimates=&exposure._PAR;
364        		proc mianalyze data=temp;
365        			modeleffects Estimate;
366        			stderr StdErr;
367        		run;
368        
369        		data &exposure._PAR;
370        			set &exposure._PAR;
371        			length exposure $ 15;
372        			exposure="&exposure.";
373        		run;
374        			
375        
376        	%mend MIPAR;
377        
378        
379        
380        	%MIPAR(dat1=gwt1,   dat2=gwt2,   dat3=gwt3,   dat4=gwt4,   dat5=gwt5, exposure=gotweight );
