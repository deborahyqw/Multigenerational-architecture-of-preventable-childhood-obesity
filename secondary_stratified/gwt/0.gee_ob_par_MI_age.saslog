293        	run;
294        	proc means noprint data=&data;
295        		by _imputation_  gotweight agebirth bpregob prev_preg1 prev_preg2 prev_preg3
296        					&covar1  ;
297        		var momid;
298        		output out=freqs n=fq;
299        	run;
300        	data freqs1(drop=_imputation_)
