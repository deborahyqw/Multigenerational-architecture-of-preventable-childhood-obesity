124        
125        /**********************************************************************
126        	CREATE MACRO TO RUN OVER THE STRATIFIED DATASETS
127        **********************************************************************/
128        
129        
130        %macro ob_par_MI_strat (data=, group=);
131        
132        
133        	/**********************************************************************
134        	RUN THE RR, WITH METANALYSIS BY IMPUTATION
135        	**********************************************************************/
136        
137        	title "HEADING: gotweight regression, &group.";
138        	proc genmod data = &data descending;
139        		by _imputation_ ;
140        	class id momid ;
141        	model chob = gotweight agebirth bpregob prev_preg1 prev_preg2 prev_preg3 &covar1
142        		/ dist = Poisson link = log;
143        		repeated subject=id(momid)/type=unstr PRINTMLE ecovb;
144        		ods output GEERCov=covuter GEEEmpPEst = uter;
145        	run;
146        
147        	TITLE "HEADER: multiple imputation - gotweight, &group.";
148        	ods output ParameterEstimates=mi_gweight;
149        	PROC MIANALYZE parms=uter;
150        	MODELEFFECTS INTERCEPT
151        				gotweight agebirth bpregob prev_preg1 prev_preg2 prev_preg3 &covar1 ;
152        	RUN;
153        	title "";
154        
155        
156        	/*MANUAL SPECIFICATION OF DATASET NAME AND GROUP*/
157        		data dat_lb.gwt_&group._RR;
158        			length Parm $ 15;
159        			length mod $ 40;
160        			length group $ 40;
161        
162        			set mi_gweight(in=a)  ;
163        			
164        			if a then mod="gwt";
165        			if Parm in ("gotweight"); *only keep main exposures when exporting;
166        
167        			group="&group.";
168        
169        			RR=exp(Estimate); LCI=exp(LCLMean); UCI=exp(UCLMean);
170        		run;
171        
4                                                                   The SAS System                                          16:08 Monday, July 7, 2025

172        		title "HEADER: proc print for the first regression analysis for &group";
173        		proc print data=dat_lb.gwt_&group._RR; run;
174        		title "";
175        
176        
177        	/**********************************************************************
178        	PREPARE DATA FOR PAR
179        	**********************************************************************/
180        
181        	title "HEADER: proc print for uter for &group";
182        	proc print data=uter; run;
183        	title "";
184        
185        
186        	data betas;
187        	set uter ;
188        	by _imputation_;
189        	_type_ = 'PARM';
190        		retain intercept gotweight agebirth bpregob prev_preg1 prev_preg2 prev_preg3
191        					&covar1;
192        		
193        		* 'i' counts rows within each _imputation_ group ;
194        		if first._imputation_ then i=1;
195        		else i+1;
196        		
197        		/*MANUAL SPECIFICATION OF VARIABLES*/
198        		select (i);
199        		when (1) intercept = estimate;
200        		when (2) gotweight  = estimate;
201        		when (3) agebirth  = estimate;
202        		when (4) bpregob   = estimate;
203        		when (5) prev_preg1= estimate;
204        		when (6) prev_preg2  = estimate;
205        		when (7) prev_preg3  = estimate;
206        		when (8) white    = estimate;
207        		when (9) sex      = estimate;
208        		otherwise;
209        	end;
210        		
211        	/*Only OUTPUT once per _imputation_, after we've assigned all param columns*/
212        	if last._imputation_ then output;
213        
214        	run;
215        
216        	title "HEADER: proc print for betas for &group";
217        	proc print data=betas; run;
218        	title "";
219        
220        	/*MANUALLY SPECIFICATION OF PARAMS*/
221        	data covparms;
222        		set covuter;
223        		by _imputation_;
224        		length _type_ $4;
225        		_type_ = 'COV';
226        
227        		rename  Prm1=intercept   Prm2=gotweight  Prm3=agebirth   Prm4=bpregob    Prm5=prev_preg1    Prm6=prev_preg2
228        				Prm7=prev_preg3  Prm8=white        Prm9=sex   ;
229        
230        		length _name_ $10;
231        		
232        		*i counts rows within each _imputation_;
233        		if first._imputation_ then i=1;
234        			else i+1;
235        
236        		* Assign which row this is (the row "label" in the covariance matrix) ;
237        		select(i);
238        			when(1)  _name_ = 'INTERCEPT';
239        			when(2)  _name_ = 'gotweight';
240        			when(3)  _name_ = 'agebirth';
241        			when(4)  _name_ = 'bpregob';
242        			when(5)  _name_ = 'prev_preg1';
243        			when(6)  _name_ = 'prev_preg2';
244        			when(7)  _name_ = 'prev_preg3';
245        			when(8)  _name_ = 'white';
246        			when(9)  _name_ = 'sex';
247        			otherwise;
248        		end;
249        		
250        		* Output EVERY row;
251        		output;
252        
253        	keep _imputation_ _type_ _name_ prm1-prm9 ;  /*MANUAL SPECIFICATION OF PARAMETER RANGE*/
254        
255        	run;
256        
257        	title "HEADER: proc print for covparms for &group";
258        	proc print data=covparms; run;
259        	title "";
260        
261        	data betacov;
262        		set betas covparms;
263        		by _imputation_ ;
264        		keep _imputation_ _type_ _name_
265        				intercept  gotweight agebirth bpregob prev_preg1 prev_preg2 prev_preg3
266        					&covar1;
267        	run;
268        
269        	data betacov1(drop=_imputation_)
270        			betacov2(drop=_imputation_)
271        			betacov3(drop=_imputation_)
272        			betacov4(drop=_imputation_)
273        			betacov5(drop=_imputation_);
274        	set betacov;
275        	select (_imputation_);
276        		when (1) output betacov1;
277        		when (2) output betacov2;
278        		when (3) output betacov3;
279        		when (4) output betacov4;
