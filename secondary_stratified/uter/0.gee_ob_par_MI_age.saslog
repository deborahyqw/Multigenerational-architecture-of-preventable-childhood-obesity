143        /**********************************************************************
144        	CREATE MACRO TO RUN OVER THE STRATIFIED DATASETS
145        **********************************************************************/
146        
147        
148        %macro ob_par_MI_strat (data=, group=);
149        
150        	/**********************************************************************
151        	RUN THE RR, WITH METANALYSIS BY IMPUTATION
152        	**********************************************************************/
153        
154        	title "HEADER: in-uterine factors - adjusting for bpregob & agebirth, &group";
155        	proc genmod data = &data descending;
156        		by _imputation_ ;
157        	class id momid ;
158        	model chob = agebirth abwt1 abwt3 gweek1 gweek3 Delivery pregcomp2
159        					bpregob prev_preg1 prev_preg2 prev_preg3 &covar1
160        		/ dist = Poisson link = log;
161        		repeated subject=id(momid)/type=unstr PRINTMLE ecovb;
162        		ods output GEERCov=covuter GEEEmpPEst = uter;
163        	run;
164        	title "";
165        
166        
167        	TITLE "HEADER: multiple imputation - in-uterine factors, &group";
168        	ods output ParameterEstimates=mi_uter;
169        	PROC MIANALYZE parms=uter;
170        	MODELEFFECTS INTERCEPT
171        			agebirth abwt1 abwt3 gweek1 gweek3 Delivery pregcomp2
172        					bpregob prev_preg1 prev_preg2 prev_preg3
173        					&covar1  ;
174        	RUN;
175        	title "";
176        
177        
178        	/*MANUAL SPECIFICATION OF DATASET NAME AND GROUP*/
179        	data dat_lb.uter_&group._RR;
180        		length Parm $ 15;
181        		length mod $ 40;
182        		length group $ 40;
183        
