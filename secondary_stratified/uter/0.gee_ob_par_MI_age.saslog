255        	title "HEADER: proc print first betas for &group";
256        	proc print data=betas;
257        	title "";
258        
259        
260        	/*MANUALLY SPECIFICATION OF PARAMS*/
261        	data covparms;
262        		set covuter;
263        		by _imputation_;
264        		length _type_ $4;
265        		_type_ = 'COV';
266        
267        		rename  Prm1=intercept   Prm2=agebirth   Prm3=abwt1      Prm4=abwt3         Prm5=gweek1
268        				Prm6=gweek3      Prm7=Delivery   Prm8=pregcomp2   Prm9=bpregob
269        				Prm10=prev_preg1    Prm11=prev_preg2    Prm12=prev_preg3
270        				Prm13=cohort    Prm14=white        Prm15=sex   ;
271        
272        		length _name_ $10;
273        		
274        		*i counts rows within each _imputation_;
275        		if first._imputation_ then i=1;
276        			else i+1;
277        
278        		* Assign which row this is (the row "label" in the covariance matrix) ;
279        		select(i);
280        			when(1)  _name_ = 'INTERCEPT';
281        			when(2)  _name_ = 'agebirth';
282        			when(3)  _name_ = 'abwt1';
283        			when(4)  _name_ = 'abwt3';
284        			when(5)  _name_ = 'gweek1';
