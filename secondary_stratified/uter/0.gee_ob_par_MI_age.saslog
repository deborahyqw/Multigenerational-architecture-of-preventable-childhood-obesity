184        		set mi_uter(in=a) ;
185        		
186        		if a then mod="uter";
187        
188        		if Parm in ("abwt1", "abwt3", "gweek1", "gweek3", "Delivery", "pregcomp2"); *only keep main exposures when exporting;
189        
190        		group="&group.";
191        
192        		RR=exp(Estimate); LCI=exp(LCLMean); UCI=exp(UCLMean);
193        	run;
