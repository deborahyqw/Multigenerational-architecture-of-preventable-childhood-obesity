206        	title "";
207        
208        	data betas;
209        	set uter ;
210        	by _imputation_;
211        	_type_ = 'PARM';
212        		retain intercept agebirth abwt1 abwt3 gweek1 gweek3 Delivery pregcomp2
213        					bpregob prev_preg1 prev_preg2 prev_preg3
214        					&covar1;
215        		
216        		* 'i' counts rows within each _imputation_ group ;
217        		if first._imputation_ then i=1;
218        		else i+1;
219        		
220        		/*MANUAL SPECIFICATION OF VARIABLES*/
221        		select (i);
222        		when (1) intercept = estimate;
223        		when (2) agebirth  = estimate;
224        		when (3) abwt1     = estimate;
225        		when (4) abwt3     = estimate;
226        		when (5) gweek1    = estimate;
227        		when (6) gweek3    = estimate;
228        		when (7) Delivery  = estimate;
229        		when (8) pregcomp2  = estimate;
230        		when (9) bpregob   = estimate;
231        		when (10) prev_preg1= estimate;
232        		when (11) prev_preg2  = estimate;
233        		when (12) prev_preg3  = estimate;
234        		when (13) cohort   = estimate;
235        		when (14) white    = estimate;
236        		when (15) sex      = estimate;
237        		otherwise;
238        	end;
239        		
240        	/*Only OUTPUT once per _imputation_, after we've assigned all param columns */
241        	if last._imputation_ then output;
242        	
243        		/*set negative beta to 0 to avoid errors in PAR, only main exposures*/
244        
245        		if abwt1 <0 then abwt1=0;
246        		if abwt3 <0 then abwt3=0;
247        		if gweek1 <0 then gweek1=0;
248        		if gweek3 <0 then gweek3=0;
249        		if Delivery <0 then Delivery=0;
250        		if pregcomp2 <0 then pregcomp2=0;
251        		if bpregob <0 then bpregob=0;
252        
253        	run;
