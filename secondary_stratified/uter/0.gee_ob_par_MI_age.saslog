603        	/*************************************************************************************/
604        	/**************** combine using mianalyze ********************************************/
605        
606        	%macro MIPAR(dat1=, dat2=, dat3=, dat4=, dat5=, exposure=);
607        
608        		data temp;
609        			length _Imputation_ 3;
610        			set &dat1(in=a) &dat2(in=b) &dat3(in=c) &dat4(in=d) &dat5(in=e);
611        			if a then _Imputation_=1;
612        				else if b then _Imputation_=2;
613        				else if c then _Imputation_=3;
614        				else if d then _Imputation_=4;
615        				else if e then _Imputation_=5;
616        					
617        			/* approximate standard error from the half-width of the CI */
618        			StdErr = (uclpartialx - lclpartialx) / (2 * 1.96);
619        			Estimate = partlparx;
620        			Parameter = 'PartialPAR';
621        			
622        			keep _Imputation_ Estimate StdErr Parameter;
623        		run;
624        
625        		ods output ParameterEstimates=&exposure._PAR;
626        		proc mianalyze data=temp;
627        			modeleffects Estimate;
628        			stderr StdErr;
629        		run;
630        
631        		data &exposure._PAR;
632        			set &exposure._PAR;
633        			length exposure $ 15;
634        			exposure="&exposure.";
635        		run;
636        			
637        
638        	%mend MIPAR;
