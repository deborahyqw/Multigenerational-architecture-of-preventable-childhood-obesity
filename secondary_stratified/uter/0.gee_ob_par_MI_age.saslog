133        	**********************************************************************/
134        
135        	title "HEADER: in-uterine factors - adjusting for bpregob & agebirth, &group";
136        	proc genmod data = &data descending;
137        		by _imputation_ ;
138        	class id momid ;
139        	model chob = agebirth abwt1 abwt3 gweek1 gweek3 Delivery pregcomp2
140        					bpregob prev_preg1 prev_preg2 prev_preg3 &covar1
141        		/ dist = Poisson link = log;
142        		repeated subject=id(momid)/type=unstr PRINTMLE ecovb;
143        		ods output GEERCov=covuter GEEEmpPEst = uter;
144        	run;
145        	title "";
146        
147        
148        	TITLE "HEADER: multiple imputation - in-uterine factors, &group";
149        	ods output ParameterEstimates=mi_uter;
150        	PROC MIANALYZE parms=uter;
151        	MODELEFFECTS INTERCEPT
152        			agebirth abwt1 abwt3 gweek1 gweek3 Delivery pregcomp2
153        					bpregob prev_preg1 prev_preg2 prev_preg3
154        					&covar1  ;
155        	RUN;
156        	title "";
157        
158        
159        	/*MANUAL SPECIFICATION OF DATASET NAME AND GROUP*/
160        	data dat_lb.uter_&group._RR;
161        		length Parm $ 15;
162        		length mod $ 40;
163        		length group $ 40;
164        
165        		set mi_uter(in=a) ;
166        		
167        		if a then mod="uter";
168        
169        		if Parm in ("abwt1", "abwt3", "gweek1", "gweek3", "Delivery", "pregcomp2"); *only keep main exposures when exporting;
170        
171        		group="&group.";
172        
173        		RR=exp(Estimate); LCI=exp(LCLMean); UCI=exp(UCLMean);
174        	run;
175        
176        	title "HEADER: proc print first regression results for &group";
177        	proc print data=dat_lb.uter_&group._RR; run;
178        	title "";
