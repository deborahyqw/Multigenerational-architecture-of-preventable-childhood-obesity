504        		when (7) cohort   = estimate;
505        		when (8) white    = estimate;
506        		when (9) sex     = estimate;
507        		otherwise;
7                                                                   The SAS System                                     13:46 Monday, November 17, 2025

508        	end;
509        		
510        	/*Only OUTPUT once per _imputation_, after we've assigned all param columns */
511        	if last._imputation_ then output;
512        
513        	if bpregob<0 then bpregob=0;
514        
515        	run;
516        
517        	title "HEADER: proc print second betas for &group";
518        	proc print data=betas;
519        	title "";
520        
521        	/*MANUAL SPECIFICATION OF PARAMETERS*/
522        	data covparms;
523        		set covuter;
524        		by _imputation_;
525        		length _type_ $4;
526        		_type_ = 'COV';
527        
528        		rename  Prm1=intercept   Prm2=agebirth   Prm3=bpregob   Prm4=prev_preg1   Prm5=prev_preg2
529        				Prm6=prev_preg3  Prm7=cohort     Prm8=white        Prm9=sex   ;
530        
531        		length _name_ $10;
532        		
533        		*i counts rows within each _imputation_;
534        		if first._imputation_ then i=1;
535        			else i+1;
536        
537        		* Assign which row this is (the row "label" in the covariance matrix) ;
538        		select(i);
539        			when(1)  _name_ = 'INTERCEPT';
540        			when(2)  _name_ = 'agebirth';
541        			when(3)  _name_ = 'bpregob';
542        			when(4)  _name_ = 'prev_preg1';
543        			when(5)  _name_ = 'prev_preg2';
544        			when(6)  _name_ = 'prev_preg3';
545        			when(7)  _name_ = 'cohort';
546        			when(8)  _name_ = 'white';
547        			when(9) _name_ = 'sex';
548        			otherwise;
549        		end;
550        		
551        		* Output EVERY row;
552        		output;
553        
554        		keep _imputation_ _type_ _name_ prm1-prm9 ; /*MANUAL SPECIFICATION OF PARAMETER RANGE*/
555        	run;
556        
557        	title "HEADER: proc print second covparms for &group";
558        	proc print data=covparms;
559        	title "";
560        
561        	data betacov;
562        		set betas covparms;
563        		by _imputation_ ;
564        		keep _imputation_ _type_ _name_
565        				intercept agebirth  bpregob prev_preg1 prev_preg2 prev_preg3
566        					&covar1 ;
567        	run;
568        
569        	data betacov1(drop=_imputation_)
570        			betacov2(drop=_imputation_)
571        			betacov3(drop=_imputation_)
572        			betacov4(drop=_imputation_)
573        			betacov5(drop=_imputation_);
574        	set betacov;
575        	select (_imputation_);
576        		when (1) output betacov1;
577        		when (2) output betacov2;
578        		when (3) output betacov3;
579        		when (4) output betacov4;
580        		when (5) output betacov5;
581        		otherwise;
582        	end;
583        	run;
584        
585        	title "HEADER: proc print second betacov1 for &group";
586        	proc print data=betacov1; run;
587        	title "";
588        
589        	*frequency/prevalence dataset;
590        	proc sort data=&data;
591        		by _imputation_ agebirth  bpregob prev_preg1 prev_preg2 prev_preg3
592        					&covar1;
593        	run;
594        	proc means noprint data=&data;
595        		by _imputation_ agebirth  bpregob prev_preg1 prev_preg2 prev_preg3
596        					&covar1 ;
597        		var momid;
598        		output out=freqs n=fq;
599        	run;
600        	data freqs1(drop=_imputation_)
601        		freqs2(drop=_imputation_)
602        		freqs3(drop=_imputation_)
603        		freqs4(drop=_imputation_)
604        		freqs5(drop=_imputation_);
605        	set freqs;
606        	select (_imputation_);
607        		when (1) output freqs1;
608        		when (2) output freqs2;
609        		when (3) output freqs3;
610        		when (4) output freqs4;
611        		when (5) output freqs5;
612        		otherwise;
613        	end;
614        	run;
615        	*proc print data=freqs1 (obs=10); run;
