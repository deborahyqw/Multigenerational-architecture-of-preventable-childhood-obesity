502        	/*MANUAL SPECIFICATION OF PARAMETERS*/
503        	data covparms;
504        		set covuter;
505        		by _imputation_;
506        		length _type_ $4;
507        		_type_ = 'COV';
508        
509        		rename  Prm1=intercept   Prm2=agebirth   Prm3=bpregob   Prm4=prev_preg1   Prm5=prev_preg2
510        				Prm6=prev_preg3  Prm7=cohort     Prm8=white        Prm9=sex   ;
511        
512        		length _name_ $10;
513        		
514        		*i counts rows within each _imputation_;
515        		if first._imputation_ then i=1;
516        			else i+1;
517        
518        		* Assign which row this is (the row "label" in the covariance matrix) ;
519        		select(i);
520        			when(1)  _name_ = 'INTERCEPT';
521        			when(2)  _name_ = 'agebirth';
522        			when(3)  _name_ = 'bpregob';
523        			when(4)  _name_ = 'prev_preg1';
524        			when(5)  _name_ = 'prev_preg2';
525        			when(6)  _name_ = 'prev_preg3';
526        			when(7)  _name_ = 'cohort';
527        			when(8)  _name_ = 'white';
528        			when(9) _name_ = 'sex';
529        			otherwise;
530        		end;
531        		
532        		* Output EVERY row;
533        		output;
534        
535        		keep _imputation_ _type_ _name_ prm1-prm9 ; /*MANUAL SPECIFICATION OF PARAMETER RANGE*/
536        	run;
