499        	/*MANUAL SPECIFICATION OF PARAMETERS*/
500        	data covparms;
501        		set covuter;
502        		by _imputation_;
503        		length _type_ $4;
504        		_type_ = 'COV';
505        
506        		rename  Prm1=intercept   Prm2=agebirth   Prm3=bpregob   Prm4=prev_preg1   Prm5=prev_preg2
507        				Prm6=prev_preg3  Prm7=cohort     Prm8=chage     Prm9=white        ;
508        
509        		length _name_ $10;
510        		
511        		*i counts rows within each _imputation_;
512        		if first._imputation_ then i=1;
513        			else i+1;
514        
515        		* Assign which row this is (the row "label" in the covariance matrix) ;
516        		select(i);
517        			when(1)  _name_ = 'INTERCEPT';
518        			when(2)  _name_ = 'agebirth';
519        			when(3)  _name_ = 'bpregob';
520        			when(4)  _name_ = 'prev_preg1';
521        			when(5)  _name_ = 'prev_preg2';
522        			when(6)  _name_ = 'prev_preg3';
523        			when(7)  _name_ = 'cohort';
524        			when(8)  _name_ = 'chage';
525        			when(9)  _name_ = 'white';
526        			otherwise;
527        		end;
528        		
529        		* Output EVERY row;
530        		output;
531        
532        		keep _imputation_ _type_ _name_ prm1-prm9 ; /*MANUAL SPECIFICATION OF PARAMETER RANGE*/
533        	run;
