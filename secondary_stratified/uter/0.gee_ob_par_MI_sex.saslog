184        		if Parm in ("abwt1", "abwt3", "gweek1", "gweek3", "Delivery", "pregcomp2"); *only keep main exposures when exporting;
185        
186        		group="&group.";
187        
188        		RR=exp(Estimate); LCI=exp(LCLMean); UCI=exp(UCLMean);
189        	run;
