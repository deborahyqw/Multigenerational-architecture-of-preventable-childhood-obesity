127        
128        	/**********************************************************************
129        	RUN THE RR, WITH METANALYSIS BY IMPUTATION
130        	**********************************************************************/
131        
132        	title "HEADER: in-uterine factors - adjusting for bpregob & agebirth, &group";
133        	proc genmod data = &data descending;
134        		by _imputation_ ;
135        	class id momid ;
136        	model chob = agebirth abwt1 abwt3 gweek1 gweek3 Delivery pregcomp2
137        					bpregob prev_preg1 prev_preg2 prev_preg3 &covar1
138        		/ dist = Poisson link = log;
139        		repeated subject=id(momid)/type=unstr PRINTMLE ecovb;
140        		ods output GEERCov=covuter GEEEmpPEst = uter;
141        	run;
142        	title "";
143        
144        
145        	TITLE "HEADER: multiple imputation - in-uterine factors, &group";
146        	ods output ParameterEstimates=mi_uter;
147        	PROC MIANALYZE parms=uter;
148        	MODELEFFECTS INTERCEPT
149        			agebirth abwt1 abwt3 gweek1 gweek3 Delivery pregcomp2
150        					bpregob prev_preg1 prev_preg2 prev_preg3
151        					&covar1  ;
152        	RUN;
153        	title "";
154        
155        
156        	/*MANUAL SPECIFICATION OF DATASET NAME AND GROUP*/
157        	data dat_lb.uter_&group._RR;
158        		length Parm $ 15;
159        		length mod $ 40;
160        		length group $ 40;
161        
162        		set mi_uter(in=a) ;
163        		
164        		if a then mod="uter";
165        
166        		if Parm in ("abwt1", "abwt3", "gweek1", "gweek3", "Delivery", "pregcomp2"); *only keep main exposures when exporting;
167        
168        		group="&group.";
169        
170        		RR=exp(Estimate); LCI=exp(LCLMean); UCI=exp(UCLMean);
171        	run;
172        
173        	title "HEADER: proc print first regression results for &group";
174        	proc print data=dat_lb.uter_&group._RR; run;
175        	title "";
