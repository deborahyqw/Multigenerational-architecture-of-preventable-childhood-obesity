618        	/*************************************************************************************/
619        	/**************** combine using mianalyze ********************************************/
620        
621        	%macro MIPAR(dat1=, dat2=, dat3=, dat4=, dat5=, exposure=);
622        
623        		data temp;
624        			length _Imputation_ 3;
625        			set &dat1(in=a) &dat2(in=b) &dat3(in=c) &dat4(in=d) &dat5(in=e);
626        			if a then _Imputation_=1;
627        				else if b then _Imputation_=2;
628        				else if c then _Imputation_=3;
629        				else if d then _Imputation_=4;
630        				else if e then _Imputation_=5;
631        					
632        			/* approximate standard error from the half-width of the CI */
633        			StdErr = (uclpartialx - lclpartialx) / (2 * 1.96);
634        			Estimate = partlparx;
635        			Parameter = 'PartialPAR';
636        			
637        			keep _Imputation_ Estimate StdErr Parameter;
638        		run;
639        
640        		ods output ParameterEstimates=&exposure._PAR;
641        		proc mianalyze data=temp;
642        			modeleffects Estimate;
643        			stderr StdErr;
644        		run;
