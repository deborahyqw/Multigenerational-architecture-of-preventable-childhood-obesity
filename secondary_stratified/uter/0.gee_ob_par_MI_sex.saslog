600        	/*************************************************************************************/
601        	/**************** combine using mianalyze ********************************************/
602        
603        	%macro MIPAR(dat1=, dat2=, dat3=, dat4=, dat5=, exposure=);
604        
605        		data temp;
606        			length _Imputation_ 3;
607        			set &dat1(in=a) &dat2(in=b) &dat3(in=c) &dat4(in=d) &dat5(in=e);
608        			if a then _Imputation_=1;
609        				else if b then _Imputation_=2;
610        				else if c then _Imputation_=3;
611        				else if d then _Imputation_=4;
612        				else if e then _Imputation_=5;
613        					
614        			/* approximate standard error from the half-width of the CI */
615        			StdErr = (uclpartialx - lclpartialx) / (2 * 1.96);
616        			Estimate = partlparx;
617        			Parameter = 'PartialPAR';
618        			
619        			keep _Imputation_ Estimate StdErr Parameter;
620        		run;
621        
622        		ods output ParameterEstimates=&exposure._PAR;
623        		proc mianalyze data=temp;
624        			modeleffects Estimate;
625        			stderr StdErr;
626        		run;
627        
628        		data &exposure._PAR;
629        			set &exposure._PAR;
630        			length exposure $ 15;
631        			exposure="&exposure.";
632        		run;
633        			
634        
635        	%mend MIPAR;
