288        			when(12)  _name_ = 'prev_preg3';
289        			when(13)  _name_ = 'cohort';
290        			when(14)  _name_ = 'chage';
291        			when(15)  _name_ = 'white';
292        			when(16)  _name_ = 'sex';
293        			otherwise;
294        		end;
295        		
296        		* Output EVERY row;
297        		output;
