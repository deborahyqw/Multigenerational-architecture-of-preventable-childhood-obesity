139        /**********************************************************************
140        	CREATE MACRO TO RUN OVER THE STRATIFIED DATASETS
141        **********************************************************************/
142        
143        
144        %macro ob_par_MI_strat (data=, group=);
145        
146        	/**********************************************************************
147        	RUN THE RR, WITH METANALYSIS BY IMPUTATION
148        	**********************************************************************/
149        
150        	title "HEADER: in-uterine factors - adjusting for bpregob & agebirth, &group";
151        	proc genmod data = &data descending;
152        		by _imputation_ ;
153        	class id momid ;
154        	model chob = agebirth abwt1 abwt3 gweek1 gweek3 Delivery pregcomp2
155        					bpregob prev_preg1 prev_preg2 prev_preg3 &covar1
156        		/ dist = Poisson link = log;
157        		repeated subject=id(momid)/type=unstr PRINTMLE ecovb;
158        		ods output GEERCov=covuter GEEEmpPEst = uter;
159        	run;
160        	title "";
161        
162        
163        	TITLE "HEADER: multiple imputation - in-uterine factors, &group";
164        	ods output ParameterEstimates=mi_uter;
165        	PROC MIANALYZE parms=uter;
166        	MODELEFFECTS INTERCEPT
167        			agebirth abwt1 abwt3 gweek1 gweek3 Delivery pregcomp2
168        					bpregob prev_preg1 prev_preg2 prev_preg3
169        					&covar1  ;
170        	RUN;
171        	title "";
172        
173        
174        	/*MANUAL SPECIFICATION OF DATASET NAME AND GROUP*/
175        	data dat_lb.uter_&group._RR;
176        		length Parm $ 15;
177        		length mod $ 40;
178        		length group $ 40;
179        
180        		set mi_uter(in=a) ;
181        		
182        		if a then mod="uter";
183        
184        		if Parm in ("abwt1", "abwt3", "gweek1", "gweek3", "Delivery", "pregcomp2"); *only keep main exposures when exporting;
185        
186        		group="&group.";
187        
188        		RR=exp(Estimate); LCI=exp(LCLMean); UCI=exp(UCLMean);
189        	run;
190        
