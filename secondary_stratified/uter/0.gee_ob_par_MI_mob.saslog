515        
516        	title "HEADER: proc print second betas for &group";
517        	proc print data=betas;
518        	title "";
519        
520        	/*MANUAL SPECIFICATION OF PARAMETERS*/
521        	data covparms;
522        		set covuter;
523        		by _imputation_;
524        		length _type_ $4;
525        		_type_ = 'COV';
526        
527        		rename  Prm1=intercept   Prm2=agebirth   Prm3=bpregob   Prm4=prev_preg1   Prm5=prev_preg2
528        				Prm6=prev_preg3  Prm7=cohort     Prm8=chage     Prm9=white        Prm10=sex   ;
529        
530        		length _name_ $10;
531        		
532        		*i counts rows within each _imputation_;
533        		if first._imputation_ then i=1;
534        			else i+1;
535        
536        		* Assign which row this is (the row "label" in the covariance matrix) ;
537        		select(i);
538        			when(1)  _name_ = 'INTERCEPT';
539        			when(2)  _name_ = 'agebirth';
540        			when(3)  _name_ = 'bpregob';
541        			when(4)  _name_ = 'prev_preg1';
542        			when(5)  _name_ = 'prev_preg2';
543        			when(6)  _name_ = 'prev_preg3';
544        			when(7)  _name_ = 'cohort';
545        			when(8)  _name_ = 'chage';
546        			when(9)  _name_ = 'white';
547        			when(10) _name_ = 'sex';
548        			otherwise;
549        		end;
550        		
551        		* Output EVERY row;
552        		output;
553        
554        		keep _imputation_ _type_ _name_ prm1-prm10 ; /*MANUAL SPECIFICATION OF PARAMETER RANGE*/
555        	run;
556        
557        	title "HEADER: proc print second covparms for &group";
558        	proc print data=covparms;
559        	title "";
560        
561        	data betacov;
562        		set betas covparms;
563        		by _imputation_ ;
564        		keep _imputation_ _type_ _name_
565        				intercept agebirth  bpregob prev_preg1 prev_preg2 prev_preg3
566        					&covar1 ;
567        	run;
568        
569        	data betacov1(drop=_imputation_)
570        			betacov2(drop=_imputation_)
571        			betacov3(drop=_imputation_)
572        			betacov4(drop=_imputation_)
573        			betacov5(drop=_imputation_);
574        	set betacov;
575        	select (_imputation_);
576        		when (1) output betacov1;
577        		when (2) output betacov2;
578        		when (3) output betacov3;
579        		when (4) output betacov4;
580        		when (5) output betacov5;
581        		otherwise;
582        	end;
583        	run;
584        
585        	title "HEADER: proc print second betacov1 for &group";
586        	proc print data=betacov1; run;
587        	title "";
588        
589        	*frequency/prevalence dataset;
590        	proc sort data=&data;
591        		by _imputation_ agebirth  bpregob prev_preg1 prev_preg2 prev_preg3
592        					&covar1;
593        	run;
594        	proc means noprint data=&data;
595        		by _imputation_ agebirth  bpregob prev_preg1 prev_preg2 prev_preg3
596        					&covar1 ;
597        		var momid;
598        		output out=freqs n=fq;
599        	run;
600        	data freqs1(drop=_imputation_)
601        		freqs2(drop=_imputation_)
602        		freqs3(drop=_imputation_)
603        		freqs4(drop=_imputation_)
604        		freqs5(drop=_imputation_);
605        	set freqs;
606        	select (_imputation_);
607        		when (1) output freqs1;
608        		when (2) output freqs2;
609        		when (3) output freqs3;
610        		when (4) output freqs4;
611        		when (5) output freqs5;
612        		otherwise;
613        	end;
614        	run;
615        	*proc print data=freqs1 (obs=10); run;
616        
617        	%runPAR(prefixBeta=betacov, prefixFreq=freqs, outpref=mob,
618        			modmod = bpregob,
619        			fixfix = agebirth  prev_preg1 prev_preg2 prev_preg3
620        					&covar1   );
621        
622        	/*************************************************************************************/
8                                                                   The SAS System                                     13:46 Monday, November 17, 2025

623        	/**************** combine using mianalyze ********************************************/
624        
625        	%macro MIPAR(dat1=, dat2=, dat3=, dat4=, dat5=, exposure=);
626        
627        		data temp;
628        			length _Imputation_ 3;
629        			set &dat1(in=a) &dat2(in=b) &dat3(in=c) &dat4(in=d) &dat5(in=e);
630        			if a then _Imputation_=1;
631        				else if b then _Imputation_=2;
632        				else if c then _Imputation_=3;
633        				else if d then _Imputation_=4;
634        				else if e then _Imputation_=5;
635        					
636        			/* approximate standard error from the half-width of the CI */
637        			StdErr = (uclpartialx - lclpartialx) / (2 * 1.96);
638        			Estimate = partlparx;
639        			Parameter = 'PartialPAR';
640        			
641        			keep _Imputation_ Estimate StdErr Parameter;
642        		run;
643        
644        		ods output ParameterEstimates=&exposure._PAR;
645        		proc mianalyze data=temp;
646        			modeleffects Estimate;
647        			stderr StdErr;
648        		run;
649        
650        		data &exposure._PAR;
651        			set &exposure._PAR;
652        			length exposure $ 15;
653        			exposure="&exposure.";
654        		run;
655        			
656        
657        	%mend MIPAR;
658        
659        	%MIPAR(dat1=birthw1,    dat2=birthw2,       dat3=birthw3,       dat4=birthw4,       dat5=birthw5,       exposure=abwt);
660        	%MIPAR(dat1=birthw11,   dat2=birthw12,      dat3=birthw13,      dat4=birthw14,      dat5=birthw15,      exposure=abwt1);
661        	%MIPAR(dat1=birthw31,   dat2=birthw32,      dat3=birthw33,      dat4=birthw34,      dat5=birthw35,      exposure=abwt3);
662        	%MIPAR(dat1=week1,      dat2=week2,         dat3=week3,         dat4=week4,         dat5=week5,         exposure=gweek);
663        	%MIPAR(dat1=week11,     dat2=week12,        dat3=week13,        dat4=week14,        dat5=week15,        exposure=gweek1);
664        	%MIPAR(dat1=week31,     dat2=week32,        dat3=week33,        dat4=week34,        dat5=week35,        exposure=gweek3);
665        	%MIPAR(dat1=csec1,      dat2=csec2,         dat3=csec3,         dat4=csec4,         dat5=csec5,         exposure=Delivery);
666        	%MIPAR(dat1=comp1,      dat2=comp2,         dat3=comp3,         dat4=comp4,         dat5=comp5,         exposure=pregcomp2);
667        	%MIPAR(dat1=uter1,      dat2=uter2,         dat3=uter3,         dat4=uter4,         dat5=uter5,         exposure=uter);
668        	%MIPAR(dat1=mob1,       dat2=mob2,          dat3=mob3,          dat4=mob4,          dat5=mob5,          exposure=bpregob);
669        
670        
671        
672        	/*MANUAL SPECIFICATION OF DATA NAME*/
673        	data dat_lb.uter_&group._par;
674        		set
675        		abwt_PAR abwt1_PAR abwt3_PAR
676        		gweek_PAR gweek1_PAR gweek3_PAR
677        		Delivery_PAR
678        		pregcomp2_PAR
679        		bpregob_PAR
680        		uter_PAR
681        		;
682        
683        		length group $ 40;
684        		group="&group.";
685        	run;
686        
687        	title "HEADER: final output for &group";
688        	proc print data=dat_lb.uter_&group._par;
689        	run;
690        	title "";
