252        	title "HEADER: proc print first betas for &group";
253        	proc print data=betas;
254        	title "";
255        
256        
257        	/*MANUALLY SPECIFICATION OF PARAMS*/
258        	data covparms;
259        		set covuter;
260        		by _imputation_;
261        		length _type_ $4;
262        		_type_ = 'COV';
263        
264        		rename  Prm1=intercept   Prm2=agebirth   Prm3=abwt1      Prm4=abwt3         Prm5=gweek1
265        				Prm6=gweek3      Prm7=Delivery   Prm8=pregcomp2   Prm9=bpregob
266        				Prm10=prev_preg1    Prm11=prev_preg2    Prm12=prev_preg3
267        				Prm13=cohort    Prm14=chage     Prm15=white        Prm16=sex   ;
268        
269        		length _name_ $10;
270        		
271        		*i counts rows within each _imputation_;
272        		if first._imputation_ then i=1;
273        			else i+1;
274        
275        		* Assign which row this is (the row "label" in the covariance matrix) ;
276        		select(i);
277        			when(1)  _name_ = 'INTERCEPT';
278        			when(2)  _name_ = 'agebirth';
279        			when(3)  _name_ = 'abwt1';
280        			when(4)  _name_ = 'abwt3';
281        			when(5)  _name_ = 'gweek1';
282        			when(6)  _name_ = 'gweek3';
283        			when(7)  _name_ = 'Delivery';
284        			when(8)  _name_ = 'pregcomp2';
285        			when(9)  _name_ = 'bpregob';
286        			when(10)  _name_ = 'prev_preg1';
