203        
204        	data betas;
205        	set uter ;
206        	by _imputation_;
207        	_type_ = 'PARM';
208        		retain intercept agebirth abwt1 abwt3 gweek1 gweek3 Delivery pregcomp2
209        					bpregob prev_preg1 prev_preg2 prev_preg3
210        					&covar1;
211        		
212        		* 'i' counts rows within each _imputation_ group ;
213        		if first._imputation_ then i=1;
214        		else i+1;
215        		
216        		/*MANUAL SPECIFICATION OF VARIABLES*/
217        		select (i);
218        		when (1) intercept = estimate;
219        		when (2) agebirth  = estimate;
220        		when (3) abwt1     = estimate;
221        		when (4) abwt3     = estimate;
222        		when (5) gweek1    = estimate;
223        		when (6) gweek3    = estimate;
224        		when (7) Delivery  = estimate;
225        		when (8) pregcomp2  = estimate;
226        		when (9) bpregob   = estimate;
227        		when (10) prev_preg1= estimate;
228        		when (11) prev_preg2  = estimate;
229        		when (12) prev_preg3  = estimate;
230        		when (13) cohort   = estimate;
231        		when (14) chage    = estimate;
232        		when (15) white    = estimate;
233        		when (16) sex      = estimate;
234        		otherwise;
235        	end;
236        		
237        	/* Only OUTPUT once per _imputation_, after we've assigned all param columns */
238        	if last._imputation_ then output;
239        	
240        		/*set negative beta to 0 to avoid errors in PAR, only main exposures*/
241        
242        		if abwt1 <0 then abwt1=0;
243        		if abwt3 <0 then abwt3=0;
244        		if gweek1 <0 then gweek1=0;
245        		if gweek3 <0 then gweek3=0;
246        		if Delivery <0 then Delivery=0;
247        		if pregcomp2 <0 then pregcomp2=0;
248        		if bpregob <0 then bpregob=0;
249        
250        	run;
