604        	/*************************************************************************************/
605        	/**************** combine using mianalyze ********************************************/
606        
607        	%macro MIPAR(dat1=, dat2=, dat3=, dat4=, dat5=, exposure=);
608        
609        		data temp;
610        			length _Imputation_ 3;
611        			set &dat1(in=a) &dat2(in=b) &dat3(in=c) &dat4(in=d) &dat5(in=e);
612        			if a then _Imputation_=1;
613        				else if b then _Imputation_=2;
614        				else if c then _Imputation_=3;
615        				else if d then _Imputation_=4;
616        				else if e then _Imputation_=5;
617        					
618        			/* approximate standard error from the half-width of the CI */
619        			StdErr = (uclpartialx - lclpartialx) / (2 * 1.96);
620        			Estimate = partlparx;
621        			Parameter = 'PartialPAR';
622        			
623        			keep _Imputation_ Estimate StdErr Parameter;
624        		run;
625        
626        		ods output ParameterEstimates=&exposure._PAR;
627        		proc mianalyze data=temp;
628        			modeleffects Estimate;
629        			stderr StdErr;
630        		run;
631        
632        		data &exposure._PAR;
633        			set &exposure._PAR;
634        			length exposure $ 15;
635        			exposure="&exposure.";
636        		run;
637        			
638        
639        	%mend MIPAR;
