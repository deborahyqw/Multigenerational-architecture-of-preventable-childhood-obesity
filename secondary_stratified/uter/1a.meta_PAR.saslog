133        /**********************************************************************
134        CREATE MACRO TO METANALYZE ALL OF THE EXPOSURES FOR EACH GROUP
135        **********************************************************************/
136        
137        
138        /*have to metaanalyze each exposure separately, will create macro that can be used to run through each of the stratification groups
138      ! (sex/age/materinal BMI)*/
139        
140        
141        
142        %macro metaanal_allexp (data=, group=);
143        
144        	/* abwt exposure */
145        	data abwt_&group.; set &data; if exposure = 'abwt'; run;
146        	%metaanal(data=abwt_&group., beta=beta, se_or_var=s, se=SE, studylab=group, loglinear=F,
147        		explabel=abwt, outcomelabel=ob,
148        			outdat= "PAR_uter_abwt_&group");
149        
150        	/* abwt1 exposure */
151        	data abwt1_&group.; set &data; if exposure = 'abwt1'; run;
152        	%metaanal(data=abwt1_&group., beta=beta, se_or_var=s, se=SE, studylab=group, loglinear=F,
153        		explabel=abwt1, outcomelabel=ob,
154        			outdat= "PAR_uter_abwt1_&group");
155        
156        	/* abwt3 exposure */
157        	data abwt3_&group.; set &data; if exposure = 'abwt3'; run;
158        	%metaanal(data=abwt3_&group., beta=beta, se_or_var=s, se=SE, studylab=group, loglinear=F,
159        		explabel=abwt3, outcomelabel=ob,
160        		outdat= "PAR_uter_abwt3_&group");
161        
162        	/* gweek exposure */
163        	data gweek_&group.; set &data; if exposure = 'gweek'; run;
164        	%metaanal(data=gweek_&group., beta=beta, se_or_var=s, se=SE, studylab=group, loglinear=F,
4                                                                   The SAS System                                    11:18 Tuesday, November 18, 2025

