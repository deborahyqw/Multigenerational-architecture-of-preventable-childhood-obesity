91         /**SEX************************************/
92         
93         data meta_PAR_sex;
94            set dat_lb.uter_female_PAR dat_lb.uter_male_PAR;
95         	length  HRCI2 $ 18;
96         	HRCI2=.;
97         	SE=StdErr*1;
98             beta=Estimate*1;
99         	keep beta SE group exposure HRCI2;
100        run;

