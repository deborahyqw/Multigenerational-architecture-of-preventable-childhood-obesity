190        	%metaanal(data=uter_&group., beta=beta, se_or_var=s, se=SE, studylab=group, loglinear=F,
191        		explabel=uter, outcomelabel=ob,
192        		outdat= "PAR_uter_uter_&group");
193        
194        
195        %mend metaanal_allexp;
