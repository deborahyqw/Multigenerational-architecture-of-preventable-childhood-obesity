122        /**********************************************************************
123        CREATE MACRO TO METANALYZE ALL OF THE EXPOSURES FOR EACH GROUP
124        **********************************************************************/
125        
126        
127        /*have to metaanalyze each exposure separately, will create macro that can be used to run through each of the stratification groups
127      ! (sex/age/materinal BMI)*/
128        
129        
130        
131        %macro metaanal_allexp (data=, group=);
132        
133        	/* abwt exposure */
134        	data abwt_&group.; set &data; if exposure = 'abwt'; run;
135        	%metaanal(data=abwt_&group., beta=beta, se_or_var=s, se=SE, studylab=group, loglinear=F,
136        		explabel=abwt, outcomelabel=ob,
137        			outdat= "PAR_uter_abwt_&group");
138        
139        	/* abwt1 exposure */
140        	data abwt1_&group.; set &data; if exposure = 'abwt1'; run;
141        	%metaanal(data=abwt1_&group., beta=beta, se_or_var=s, se=SE, studylab=group, loglinear=F,
142        		explabel=abwt1, outcomelabel=ob,
143        			outdat= "PAR_uter_abwt1_&group");
144        
145        	/* abwt3 exposure */
146        	data abwt3_&group.; set &data; if exposure = 'abwt3'; run;
147        	%metaanal(data=abwt3_&group., beta=beta, se_or_var=s, se=SE, studylab=group, loglinear=F,
148        		explabel=abwt3, outcomelabel=ob,
149        		outdat= "PAR_uter_abwt3_&group");
150        
151        	/* gweek exposure */
152        	data gweek_&group.; set &data; if exposure = 'gweek'; run;
153        	%metaanal(data=gweek_&group., beta=beta, se_or_var=s, se=SE, studylab=group, loglinear=F,
154        		explabel=gweek, outcomelabel=ob,
155        		outdat= "PAR_uter_gweek_&group");
156        
157        
158        	/* gweek1 exposure */
159        	data gweek1_&group.; set &data; if exposure = 'gweek1'; run;
160        	%metaanal(data=gweek1_&group., beta=beta, se_or_var=s, se=SE, studylab=group, loglinear=F,
161        		explabel=gweek1, outcomelabel=ob,
162        		outdat= "PAR_uter_gweek1_&group");
163        
164        	/* gweek3 exposure */
165        	data gweek3_&group.; set &data; if exposure = 'gweek3'; run;
166        	%metaanal(data=gweek3_&group., beta=beta, se_or_var=s, se=SE, studylab=group, loglinear=F,
167        		explabel=gweek3, outcomelabel=ob,
168        		outdat= "PAR_uter_gweek3_&group");
169        
170        	/* Delivery exposure */
171        	data Delivery_&group.; set &data; if exposure = 'Delivery'; run;
172        	%metaanal(data=Delivery_&group., beta=beta, se_or_var=s, se=SE, studylab=group, loglinear=F,
173        		explabel=Delivery, outcomelabel=ob,
174        		outdat= "PAR_uter_Delivery_&group");
175        
176        	/* pregcomp2 exposure */
177        	data pregcomp2_&group.; set &data; if exposure = 'pregcomp2'; run;
178        	%metaanal(data=pregcomp2_&group., beta=beta, se_or_var=s, se=SE, studylab=group, loglinear=F,
179        		explabel=pregcomp2, outcomelabel=ob,
180        		outdat= "PAR_uter_pregcomp2_&group");	
181        
182        	/* bpregob exposure */
183        	data bpregob_&group.; set &data; if exposure = 'bpregob'; run;
184        	%metaanal(data=bpregob_&group., beta=beta, se_or_var=s, se=SE, studylab=group, loglinear=F,
185        		explabel=bpregob, outcomelabel=ob,
186        		outdat= "PAR_uter_bpregob_&group");		
187        
188        	/* uter exposure */
189        	data uter_&group.; set &data; if exposure = 'uter'; run;
