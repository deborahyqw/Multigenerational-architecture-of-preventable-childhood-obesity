137        /**********************************************************************
138        CREATE MACRO TO METANALYZE ALL OF THE EXPOSURES FOR EACH GROUP
139        **********************************************************************/
140        
141        
142        /*have to metaanalyze each exposure separately, will create macro that can be used to run through each of the stratification groups
142      ! (sex/age/materinal BMI)*/
143        
144        %macro metaanal_allexp (data=, group=);
145        
146        	/* abwt1 exposure */
147        	data abwt1_&group.; set &data; if Parm = 'abwt1'; run;
148        	%metaanal(data=abwt1_&group., beta=beta, se_or_var=s, se=SE, studylab=group, loglinear=T,
149        		explabel=abwt1, outcomelabel=ob,
150        			outdat= "RR_uter_abwt1_&group");
151        
4                                                                   The SAS System                                    11:18 Tuesday, November 18, 2025

152        	/* abwt3 exposure */
153        	data abwt3_&group.; set &data; if Parm = 'abwt3'; run;
154        	%metaanal(data=abwt3_&group., beta=beta, se_or_var=s, se=SE, studylab=group, loglinear=T,
155        		explabel=abwt3, outcomelabel=ob,
156        		outdat= "RR_uter_abwt3_&group");
157        
158        	
159        	/* gweek1 exposure */
160        	data gweek1_&group.; set &data; if Parm = 'gweek1'; run;
161        	%metaanal(data=gweek1_&group., beta=beta, se_or_var=s, se=SE, studylab=group, loglinear=T,
162        		explabel=gweek1, outcomelabel=ob,
163        		outdat= "RR_uter_gweek1_&group");
164        
165        	/* gweek3 exposure */
166        	data gweek3_&group.; set &data; if Parm = 'gweek3'; run;
167        	%metaanal(data=gweek3_&group., beta=beta, se_or_var=s, se=SE, studylab=group, loglinear=T,
168        		explabel=gweek3, outcomelabel=ob,
169        		outdat= "RR_uter_gweek3_&group");
170        
171        	/* Delivery exposure */
172        	data Delivery_&group.; set &data; if Parm = 'Delivery'; run;
173        	%metaanal(data=Delivery_&group., beta=beta, se_or_var=s, se=SE, studylab=group, loglinear=T,
174        		explabel=Delivery, outcomelabel=ob,
175        		outdat= "RR_uter_Delivery_&group");
176        
177        	/* pregcomp2 exposure */
178        	data pregcomp2_&group.; set &data; if Parm = 'pregcomp2'; run;
179        	%metaanal(data=pregcomp2_&group., beta=beta, se_or_var=s, se=SE, studylab=group, loglinear=T,
180        		explabel=pregcomp2, outcomelabel=ob,
181        		outdat= "RR_uter_pregcomp2_&group");	
182        
183        	/* bpregob exposure */
184        	data bpregob_&group.; set &data; if Parm = 'bpregob'; run;
185        	%metaanal(data=bpregob_&group., beta=beta, se_or_var=s, se=SE, studylab=group, loglinear=T,
186        		explabel=bpregob, outcomelabel=ob,
187        		outdat= "RR_uter_bpregob_&group");		
188        
189        
190        %mend metaanal_allexp;
191        
