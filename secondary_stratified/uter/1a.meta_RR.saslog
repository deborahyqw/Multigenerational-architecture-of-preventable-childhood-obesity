126        /**********************************************************************
127        CREATE MACRO TO METANALYZE ALL OF THE EXPOSURES FOR EACH GROUP
128        **********************************************************************/
129        
130        
131        /*have to metaanalyze each exposure separately, will create macro that can be used to run through each of the stratification groups
131      ! (sex/age/materinal BMI)*/
132        
133        %macro metaanal_allexp (data=, group=);
134        
135        	/* abwt1 exposure */
136        	data abwt1_&group.; set &data; if Parm = 'abwt1'; run;
137        	%metaanal(data=abwt1_&group., beta=beta, se_or_var=s, se=SE, studylab=group, loglinear=T,
138        		explabel=abwt1, outcomelabel=ob,
139        			outdat= "RR_uter_abwt1_&group");
140        
141        	/* abwt3 exposure */
142        	data abwt3_&group.; set &data; if Parm = 'abwt3'; run;
143        	%metaanal(data=abwt3_&group., beta=beta, se_or_var=s, se=SE, studylab=group, loglinear=T,
144        		explabel=abwt3, outcomelabel=ob,
145        		outdat= "RR_uter_abwt3_&group");
146        
147        	
148        	/* gweek1 exposure */
149        	data gweek1_&group.; set &data; if Parm = 'gweek1'; run;
150        	%metaanal(data=gweek1_&group., beta=beta, se_or_var=s, se=SE, studylab=group, loglinear=T,
151        		explabel=gweek1, outcomelabel=ob,
152        		outdat= "RR_uter_gweek1_&group");
153        
154        	/* gweek3 exposure */
155        	data gweek3_&group.; set &data; if Parm = 'gweek3'; run;
156        	%metaanal(data=gweek3_&group., beta=beta, se_or_var=s, se=SE, studylab=group, loglinear=T,
157        		explabel=gweek3, outcomelabel=ob,
158        		outdat= "RR_uter_gweek3_&group");
159        
160        	/* Delivery exposure */
161        	data Delivery_&group.; set &data; if Parm = 'Delivery'; run;
162        	%metaanal(data=Delivery_&group., beta=beta, se_or_var=s, se=SE, studylab=group, loglinear=T,
163        		explabel=Delivery, outcomelabel=ob,
164        		outdat= "RR_uter_Delivery_&group");
165        
166        	/* pregcomp2 exposure */
167        	data pregcomp2_&group.; set &data; if Parm = 'pregcomp2'; run;
168        	%metaanal(data=pregcomp2_&group., beta=beta, se_or_var=s, se=SE, studylab=group, loglinear=T,
169        		explabel=pregcomp2, outcomelabel=ob,
170        		outdat= "RR_uter_pregcomp2_&group");	
171        
172        	/* bpregob exposure */
173        	data bpregob_&group.; set &data; if Parm = 'bpregob'; run;
174        	%metaanal(data=bpregob_&group., beta=beta, se_or_var=s, se=SE, studylab=group, loglinear=T,
175        		explabel=bpregob, outcomelabel=ob,
176        		outdat= "RR_uter_bpregob_&group");		
177        
178        
179        %mend metaanal_allexp;
180        
