91         /**SEX************************************/
92         
93         data meta_RR_sex;
94            set dat_lb.uter_female_RR  dat_lb.uter_male_RR
95            		dat_lb.uter2_female_RR  dat_lb.uter2_male_RR;
96         	length  HRCI2 $ 18;
97         	HRCI2=.;
98         	SE=StdErr*1;
99             beta=Estimate*1;
100        	keep Parm mod group beta SE HRCI2;
101        
102        run;

