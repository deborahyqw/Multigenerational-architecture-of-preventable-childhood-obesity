80         /**SEX************************************/
81         
82         data meta_RR_sex;
83            set dat_lb.uter_female_RR  dat_lb.uter_male_RR
84            		dat_lb.uter2_female_RR  dat_lb.uter2_male_RR;
85         	length  HRCI2 $ 18;
86         	HRCI2=.;
87         	SE=StdErr*1;
88             beta=Estimate*1;
89         	keep Parm mod group beta SE HRCI2;
90         
91         run;

