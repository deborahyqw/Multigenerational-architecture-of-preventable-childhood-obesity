525        					
526        	/*************************************************************************************/
527        	/**************** combine using mianalyze ********************************************/
528        
529        	/*combine the PAR and errors from each of the imputations*/
530        
531        	%macro MIPAR(dat1=, dat2=, dat3=, dat4=, dat5=, exposure=);
532        
533        		data temp;
534        			length _Imputation_ 3;
535        			set &dat1(in=a) &dat2(in=b) &dat3(in=c) &dat4(in=d) &dat5(in=e);
536        			if a then _Imputation_=1;
537        				else if b then _Imputation_=2;
538        				else if c then _Imputation_=3;
539        				else if d then _Imputation_=4;
540        				else if e then _Imputation_=5;
541        					
542        			/* approximate standard error from the half-width of the CI */
543        			StdErr = (uclpartialx - lclpartialx) / (2 * 1.96);
544        			Estimate = partlparx;
545        			Parameter = 'PartialPAR';
546        			
547        			keep _Imputation_ Estimate StdErr Parameter;
548        		run;
549        
550        		ods output ParameterEstimates=&exposure._PAR;
551        		proc mianalyze data=temp;
552        			modeleffects Estimate;
553        			stderr StdErr;
554        		run;
555        
556        		data &exposure._PAR;
557        			set &exposure._PAR;
558        			length exposure $ 15;
559        			exposure="&exposure.";
560        		run;
561        			
562        
563        	%mend MIPAR;
564        
565        
566        	%MIPAR(dat1=west1,    dat2=west2,    dat3=west3,    dat4=west4,    dat5=west5,  exposure=chwest);
567        	%MIPAR(dat1=west11,   dat2=west12,   dat3=west13,   dat4=west14,   dat5=west15, exposure=chwestq1);
568        	%MIPAR(dat1=west21,   dat2=west22,   dat3=west23,   dat4=west24,   dat5=west25, exposure=chwestq2);
569        	%MIPAR(dat1=west31,   dat2=west32,   dat3=west33,   dat4=west34,   dat5=west35, exposure=chwestq3);
570        
571        	%MIPAR(dat1=sed1,     dat2=sed2,     dat3=sed3,     dat4=sed4,     dat5=sed5,  	exposure=chst);
572        	%MIPAR(dat1=sed11,    dat2=sed12,    dat3=sed13,    dat4=sed14,    dat5=sed15, 	exposure=chstq1);
573        	%MIPAR(dat1=sed21,    dat2=sed22,    dat3=sed23,    dat4=sed24,    dat5=sed25, 	exposure=chstq2);
574        	%MIPAR(dat1=sed31,    dat2=sed32,    dat3=sed33,    dat4=sed34,    dat5=sed35, 	exposure=chstq3);
575        
576        	%MIPAR(dat1=pa1,      dat2=pa2,      dat3=pa3,      dat4=pa4,      dat5=pa5,  	exposure=chpa);
577        	%MIPAR(dat1=pa01,     dat2=pa02,     dat3=pa03,     dat4=pa04,     dat5=pa05, 	exposure=chpaq0 );
578        	%MIPAR(dat1=pa11,     dat2=pa12,     dat3=pa13,     dat4=pa14,     dat5=pa15, 	exposure=chpaq1 );
579        	%MIPAR(dat1=pa21,     dat2=pa22,     dat3=pa23,     dat4=pa24,     dat5=pa25, 	exposure=chpaq2 );
580        
581        	%MIPAR(dat1=life1,    dat2=life2,    dat3=life3,    dat4=life4,    dat5=life5,  exposure=life );
582        
583        
584        	/*MANUAL SPECIFICATION OF DATA NAME*/
585        	data dat_lb.life_&group._par;
586        		set
587        		chwest_PAR chwestq1_PAR chwestq2_PAR chwestq3_PAR
588        		chst_PAR   chstq1_PAR   chstq2_PAR   chstq3_PAR
589        		chpa_PAR   chpaq0_PAR   chpaq1_PAR   chpaq2_PAR
590        		life_PAR
591        		;
592        
593        		length group $ 40;
594        		group="&group.";
595        
596        	run;
597        
598        
599        
600        	title "HEADER: final output for &group";
601        	proc print data=dat_lb.life_&group._par;
602        	run;
603        	title "";
604        
605        %mend ob_par_MI_strat;
