202        	/*MANUAL SPECIFICATION OF DATASET NAME AND GROUP*/
203        	data dat_lb.life_&group._RR;
204        		length Parm $ 15;
205        		length mod $ 40;
206        		length group $ 40;
207        
208        		set mi_life(in=a) mi_lifet(in=b) ;
209        		
210        		if a then mod="life";
211        		if b then mod="life trend";
212        
213        		if Parm in ("chwestq1", "chwestq2", "chwestq3", "chstq1", "chstq2", "chstq3", "chpaq0",
214        				"chpaq1", "chpaq2", "chcalq1", "chcalq2", "chcalq3"); *only keep main exposures when exporting;
215        
216        		group="&group.";
217        
218        		RR=exp(Estimate); LCI=exp(LCLMean); UCI=exp(UCLMean);
219        	run;
220        
221        	title "HEADER: proc print regression results for &group.";
222        	proc print data=dat_lb.life_&group._RR; run;
223        	title "";
