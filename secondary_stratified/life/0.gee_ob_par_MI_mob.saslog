418        	/*run the par macro over each of the imputated datasets*/
419        	%macro runPAR(prefixBeta=, prefixFreq=, outpref=, modmod=, fixfix=);
420        		%local i;
421        		%do i=1 %to 5;
422        			%par(
423        				bdata=&prefixBeta.&i, /*name of dataset containing coefficients and their variance-covariance matrix*/
424        				pdata=&prefixFreq.&i, /*name of dataset condtaining variable combinations and their frequences*/
425        				n_or_p=N, 			  /*whether the pdata dataset contains counts (N) or prevalences (P)*/
426        				n_or_pname=FQ, 		  /*the name of the variable in Pdata that is the count or the prevalence for the stratum*/
427        				modvar= &modmod,	  /*the list of modifiable variables*/
428        				missvarlist=NONE,     /*list of missing indicators in original model*/
429        				partialpar= T,
430        				outdat= &outpref.&i,
431        				fixedvar= &fixfix  	  /*the list of variables to be held fixed in computing a partial PAR*/
432        				);
433        		%end;
434        	%mend runPAR;
