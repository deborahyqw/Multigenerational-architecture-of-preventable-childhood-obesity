155        
156        	/*MANUAL SPECIFICATION OF DATASET NAME*/
157        
158        	title "HEADER: personal modifiable factors, &group.";
159        	proc genmod data = &data. descending;
160        		by _imputation_ ;
161        	class id momid ;
162        	model chob = &chwestq_ &chstq_ &chpaq_ &chcalq_ &covar1
163        		/ dist = Poisson link = log;
164        		repeated subject=id(momid)/type=unstr PRINTMLE ecovb;
165        		ods output GEERCov=covlife GEEEmpPEst = life;
166        	run;
167        	title "";
168        	
169        	proc genmod data = &data. descending;
170        		by _imputation_ ;
171        		class id momid ;
172        		model chob = chwest_m chst_m chpa_m chcal_m &covar1
173        		/ dist = Poisson link = log;
174        		repeated subject=id(momid)/type=unstr PRINTMLE ecovb;
175        		ods output GEEEmpPEst =life_t;
176        	run;
177        
178        	TITLE "HEADER: multiple imputation - personal modifiable factors, &group.";
179        	ods output ParameterEstimates=mi_life;
180        	PROC MIANALYZE parms=life;
