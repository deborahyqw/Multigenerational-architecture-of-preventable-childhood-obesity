223        	title "HEADER: proc print life for &group.";
224        	proc print data=life; run;
225        	title "";
226        
227        
228        	/*transposing the dataset so that each row corresponds to an imputation and each variable has its effect estimate*/
229        
230        	data betas;
231        	set life ;
232        	by _imputation_;
233        	_type_ = 'PARM';
234        		retain intercept chwestq1 chwestq2 chwestq3 chstq1 chstq2 chstq3
235        				chpaq0 chpaq1 chpaq2 chcalq1 chcalq2 chcalq3
236        				&covar1;
237        		
238        		* 'i' counts rows within each _imputation_ group ;
239        		if first._imputation_ then i=1;
240        		else i+1;
241        
242        		/*MANUAL SPECIFICATION OF VARIABLES*/
243        		select (i);
244        		when (1) intercept = estimate;
245        		when (2) chwestq1  = estimate;
246        		when (3) chwestq2  = estimate;
247        		when (4) chwestq3  = estimate;
248        		when (5) chstq1   = estimate;
249        		when (6) chstq2   = estimate;
250        		when (7) chstq3   = estimate;
251        		when (8) chpaq0   = estimate;
252        		when (9) chpaq1   = estimate;
253        		when (10) chpaq2  = estimate;
254        		when (11) chcalq1   = estimate;
255        		when (12) chcalq2   = estimate;
256        		when (13) chcalq3   = estimate;
257        		when (14) chbmibase = estimate;
258        		when (15) cohort   = estimate;
259        		when (16) chage    = estimate;
260        		when (17) white    = estimate;
261        		when (18) sex     = estimate;
262        
263        		otherwise;
264        	end;
265        		
266        	/*Only OUTPUT once per _imputation_, after we've assigned all param columns*/
267        	if last._imputation_ then output;
268        
269        		/*set negative beta to 0 to avoid errors in PAR, only main exposures*/
270        
271        		if chwestq1 <0 then chwestq1=0;
272        		if chwestq2 <0 then chwestq2=0;
273        		if chwestq3 <0 then chwestq3=0;
274        		if chstq1 <0 then chstq1=0;
275        		if chstq2 <0 then chstq2=0;
276        		if chstq3 <0 then chstq3=0;
277        		if chpaq0 <0 then chpaq0=0;
278        		if chpaq1 <0 then chpaq1=0;
279        		if chpaq2 <0 then chpaq2=0;
280        
281        	run;
