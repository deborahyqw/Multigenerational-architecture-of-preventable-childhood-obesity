151        /**********************************************************************
152        	CREATE MACRO TO RUN OVER THE STRATIFIED DATASETS
153        **********************************************************************/
154        
155        
156        %macro ob_par_MI_strat (data=, group=);
157        
158        
159        	/**********************************************************************
160        	RUN THE RR, WITH METANALYSIS BY IMPUTATION
161        	**********************************************************************/
162        
163        	/*MANUAL SPECIFICATION OF DATASET NAME*/
164        
165        	title "HEADER: personal modifiable factors, &group.";
166        	proc genmod data = &data. descending;
167        		by _imputation_ ;
168        	class id momid ;
169        	model chob = &chwestq_ &chstq_ &chpaq_ &chcalq_ &covar1
170        		/ dist = Poisson link = log;
171        		repeated subject=id(momid)/type=unstr PRINTMLE ecovb;
172        		ods output GEERCov=covlife GEEEmpPEst = life;
173        	run;
174        	title "";
175        	
176        	proc genmod data = &data. descending;
177        		by _imputation_ ;
178        		class id momid ;
179        		model chob = chwest_m chst_m chpa_m chcal_m &covar1
180        		/ dist = Poisson link = log;
181        		repeated subject=id(momid)/type=unstr PRINTMLE ecovb;
4                                                                   The SAS System                                     12:06 Monday, November 17, 2025

182        		ods output GEEEmpPEst =life_t;
183        	run;
184        
185        	TITLE "HEADER: multiple imputation - personal modifiable factors, &group.";
186        	ods output ParameterEstimates=mi_life;
187        	PROC MIANALYZE parms=life;
188        	MODELEFFECTS INTERCEPT
189        			chwestq1 chwestq2 chwestq3 chstq1 chstq2 chstq3 chpaq0 chpaq1 chpaq2
190        			chcalq1 chcalq2 chcalq3 &covar1;
191        	run;
192        	title "";
