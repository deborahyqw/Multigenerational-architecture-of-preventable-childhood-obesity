411        	/*run the par macro over each of the imputated datasets*/
412        	%macro runPAR(prefixBeta=, prefixFreq=, outpref=, modmod=, fixfix=);
413        		%local i;
414        		%do i=1 %to 5;
415        			%par(
416        				bdata=&prefixBeta.&i, /*name of dataset containing coefficients and their variance-covariance matrix*/
417        				pdata=&prefixFreq.&i, /*name of dataset condtaining variable combinations and their frequences*/
418        				n_or_p=N, 			  /*whether the pdata dataset contains counts (N) or prevalences (P)*/
419        				n_or_pname=FQ, 		  /*the name of the variable in Pdata that is the count or the prevalence for the stratum*/
420        				modvar= &modmod,	  /*the list of modifiable variables*/
421        				missvarlist=NONE,     /*list of missing indicators in original model*/
422        				partialpar= T,
423        				outdat= &outpref.&i,
424        				fixedvar= &fixfix  	  /*the list of variables to be held fixed in computing a partial PAR*/
425        				);
426        		%end;
427        	%mend runPAR;
