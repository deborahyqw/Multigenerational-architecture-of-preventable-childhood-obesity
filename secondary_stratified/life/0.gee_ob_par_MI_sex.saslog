230        
231        	title "HEADER: proc print life for &group";
232        	proc print data=life; run;
233        	title "";
234        
235        
236        	/*transposing the dataset so that each row corresponds to an imputation and each variable has its effect estimate*/
237        
238        	data betas;
239        	set life ;
240        	by _imputation_;
241        	_type_ = 'PARM';
242        		retain intercept chwestq1 chwestq2 chwestq3 chstq1 chstq2 chstq3
243        				chpaq0 chpaq1 chpaq2 chcalq1 chcalq2 chcalq3
244        				&covar1;
245        		
246        		* 'i' counts rows within each _imputation_ group ;
247        		if first._imputation_ then i=1;
248        		else i+1;
249        
250        		/*MANUAL SPECIFICATION OF VARIABLES*/
251        		select (i);
252        		when (1) intercept = estimate;
253        		when (2) chwestq1  = estimate;
254        		when (3) chwestq2  = estimate;
255        		when (4) chwestq3  = estimate;
256        		when (5) chstq1   = estimate;
257        		when (6) chstq2   = estimate;
258        		when (7) chstq3   = estimate;
259        		when (8) chpaq0   = estimate;
260        		when (9) chpaq1   = estimate;
261        		when (10) chpaq2  = estimate;
262        		when (11) chcalq1   = estimate;
263        		when (12) chcalq2   = estimate;
264        		when (13) chcalq3   = estimate;
265        		when (14) chbmibase = estimate;
266        		when (15) cohort   = estimate;
267        		when (16) chage    = estimate;
268        		when (17) white    = estimate;
269        
270        		otherwise;
271        	end;
272        		
273        	/*Only OUTPUT once per _imputation_, after we've assigned all param columns*/
274        	if last._imputation_ then output;
275        
276        		/*set negative beta to 0 to avoid errors in PAR, only main exposures*/
277        
278        		if chwestq1 <0 then chwestq1=0;
279        		if chwestq2 <0 then chwestq2=0;
280        		if chwestq3 <0 then chwestq3=0;
281        		if chstq1 <0 then chstq1=0;
282        		if chstq2 <0 then chstq2=0;
283        		if chstq3 <0 then chstq3=0;
284        		if chpaq0 <0 then chpaq0=0;
285        		if chpaq1 <0 then chpaq1=0;
286        		if chpaq2 <0 then chpaq2=0;
287        
288        	run;
