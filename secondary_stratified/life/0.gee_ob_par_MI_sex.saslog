161        	RUN THE RR, WITH METANALYSIS BY IMPUTATION
162        	**********************************************************************/
163        
164        	/*MANUAL SPECIFICATION OF DATASET NAME*/
165        
166        	title "HEADER: personal modifiable factors, &group.";
167        	proc genmod data = &data. descending;
168        		by _imputation_ ;
169        	class id momid ;
170        	model chob = &chwestq_ &chstq_ &chpaq_ &chcalq_ &covar1
171        		/ dist = Poisson link = log;
172        		repeated subject=id(momid)/type=unstr PRINTMLE ecovb;
173        		ods output GEERCov=covlife GEEEmpPEst = life;
174        	run;
175        	title "";
176        	
177        	proc genmod data = &data. descending;
178        		by _imputation_ ;
179        		class id momid ;
180        		model chob = chwest_m chst_m chpa_m chcal_m &covar1
181        		/ dist = Poisson link = log;
