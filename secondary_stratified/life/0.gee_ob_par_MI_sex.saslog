518        					
519        	/*************************************************************************************/
520        	/**************** combine using mianalyze ********************************************/
521        
522        	/*combine the PAR and errors from each of the imputations*/
523        
524        	%macro MIPAR(dat1=, dat2=, dat3=, dat4=, dat5=, exposure=);
525        
526        		data temp;
527        			length _Imputation_ 3;
528        			set &dat1(in=a) &dat2(in=b) &dat3(in=c) &dat4(in=d) &dat5(in=e);
529        			if a then _Imputation_=1;
530        				else if b then _Imputation_=2;
531        				else if c then _Imputation_=3;
532        				else if d then _Imputation_=4;
533        				else if e then _Imputation_=5;
534        					
535        			/* approximate standard error from the half-width of the CI */
536        			StdErr = (uclpartialx - lclpartialx) / (2 * 1.96);
537        			Estimate = partlparx;
538        			Parameter = 'PartialPAR';
539        			
540        			keep _Imputation_ Estimate StdErr Parameter;
541        		run;
542        
543        		ods output ParameterEstimates=&exposure._PAR;
544        		proc mianalyze data=temp;
545        			modeleffects Estimate;
546        			stderr StdErr;
547        		run;
548        
549        		data &exposure._PAR;
550        			set &exposure._PAR;
551        			length exposure $ 15;
552        			exposure="&exposure.";
553        		run;
554        			
555        
556        	%mend MIPAR;
557        
558        
559        	%MIPAR(dat1=west1,    dat2=west2,    dat3=west3,    dat4=west4,    dat5=west5,  exposure=chwest);
560        	%MIPAR(dat1=west11,   dat2=west12,   dat3=west13,   dat4=west14,   dat5=west15, exposure=chwestq1);
561        	%MIPAR(dat1=west21,   dat2=west22,   dat3=west23,   dat4=west24,   dat5=west25, exposure=chwestq2);
562        	%MIPAR(dat1=west31,   dat2=west32,   dat3=west33,   dat4=west34,   dat5=west35, exposure=chwestq3);
563        
564        	%MIPAR(dat1=sed1,     dat2=sed2,     dat3=sed3,     dat4=sed4,     dat5=sed5,  	exposure=chst);
565        	%MIPAR(dat1=sed11,    dat2=sed12,    dat3=sed13,    dat4=sed14,    dat5=sed15, 	exposure=chstq1);
566        	%MIPAR(dat1=sed21,    dat2=sed22,    dat3=sed23,    dat4=sed24,    dat5=sed25, 	exposure=chstq2);
567        	%MIPAR(dat1=sed31,    dat2=sed32,    dat3=sed33,    dat4=sed34,    dat5=sed35, 	exposure=chstq3);
568        
569        	%MIPAR(dat1=pa1,      dat2=pa2,      dat3=pa3,      dat4=pa4,      dat5=pa5,  	exposure=chpa);
570        	%MIPAR(dat1=pa01,     dat2=pa02,     dat3=pa03,     dat4=pa04,     dat5=pa05, 	exposure=chpaq0 );
571        	%MIPAR(dat1=pa11,     dat2=pa12,     dat3=pa13,     dat4=pa14,     dat5=pa15, 	exposure=chpaq1 );
572        	%MIPAR(dat1=pa21,     dat2=pa22,     dat3=pa23,     dat4=pa24,     dat5=pa25, 	exposure=chpaq2 );
573        
574        	%MIPAR(dat1=life1,    dat2=life2,    dat3=life3,    dat4=life4,    dat5=life5,  exposure=life );
575        
576        
577        	/*MANUAL SPECIFICATION OF DATA NAME*/
578        	data dat_lb.life_&group._par;
579        		set
580        		chwest_PAR chwestq1_PAR chwestq2_PAR chwestq3_PAR
581        		chst_PAR   chstq1_PAR   chstq2_PAR   chstq3_PAR
582        		chpa_PAR   chpaq0_PAR   chpaq1_PAR   chpaq2_PAR
583        		life_PAR
584        		;
585        
586        		length group $ 40;
587        		group="&group.";
588        
589        	run;
590        
591        
592        
593        	title "HEADER: final output for &group";
594        	proc print data=dat_lb.life_&group._par;
595        	run;
596        	title "";
597        
598        %mend ob_par_MI_strat;
