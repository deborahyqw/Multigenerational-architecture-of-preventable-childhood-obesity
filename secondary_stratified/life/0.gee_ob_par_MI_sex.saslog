524        					
525        	/*************************************************************************************/
526        	/**************** combine using mianalyze ********************************************/
527        
528        	/*combine the PAR and errors from each of the imputations*/
529        
530        	%macro MIPAR(dat1=, dat2=, dat3=, dat4=, dat5=, exposure=);
531        
532        		data temp;
533        			length _Imputation_ 3;
534        			set &dat1(in=a) &dat2(in=b) &dat3(in=c) &dat4(in=d) &dat5(in=e);
535        			if a then _Imputation_=1;
536        				else if b then _Imputation_=2;
537        				else if c then _Imputation_=3;
538        				else if d then _Imputation_=4;
539        				else if e then _Imputation_=5;
540        					
541        			/* approximate standard error from the half-width of the CI */
542        			StdErr = (uclpartialx - lclpartialx) / (2 * 1.96);
543        			Estimate = partlparx;
544        			Parameter = 'PartialPAR';
545        			
546        			keep _Imputation_ Estimate StdErr Parameter;
547        		run;
548        
549        		ods output ParameterEstimates=&exposure._PAR;
550        		proc mianalyze data=temp;
551        			modeleffects Estimate;
552        			stderr StdErr;
553        		run;
554        
555        		data &exposure._PAR;
556        			set &exposure._PAR;
557        			length exposure $ 15;
558        			exposure="&exposure.";
559        		run;
560        			
561        
562        	%mend MIPAR;
563        
564        
565        	%MIPAR(dat1=west1,    dat2=west2,    dat3=west3,    dat4=west4,    dat5=west5,  exposure=chwest);
566        	%MIPAR(dat1=west11,   dat2=west12,   dat3=west13,   dat4=west14,   dat5=west15, exposure=chwestq1);
567        	%MIPAR(dat1=west21,   dat2=west22,   dat3=west23,   dat4=west24,   dat5=west25, exposure=chwestq2);
568        	%MIPAR(dat1=west31,   dat2=west32,   dat3=west33,   dat4=west34,   dat5=west35, exposure=chwestq3);
569        
570        	%MIPAR(dat1=sed1,     dat2=sed2,     dat3=sed3,     dat4=sed4,     dat5=sed5,  	exposure=chst);
571        	%MIPAR(dat1=sed11,    dat2=sed12,    dat3=sed13,    dat4=sed14,    dat5=sed15, 	exposure=chstq1);
572        	%MIPAR(dat1=sed21,    dat2=sed22,    dat3=sed23,    dat4=sed24,    dat5=sed25, 	exposure=chstq2);
573        	%MIPAR(dat1=sed31,    dat2=sed32,    dat3=sed33,    dat4=sed34,    dat5=sed35, 	exposure=chstq3);
574        
575        	%MIPAR(dat1=pa1,      dat2=pa2,      dat3=pa3,      dat4=pa4,      dat5=pa5,  	exposure=chpa);
576        	%MIPAR(dat1=pa01,     dat2=pa02,     dat3=pa03,     dat4=pa04,     dat5=pa05, 	exposure=chpaq0 );
577        	%MIPAR(dat1=pa11,     dat2=pa12,     dat3=pa13,     dat4=pa14,     dat5=pa15, 	exposure=chpaq1 );
578        	%MIPAR(dat1=pa21,     dat2=pa22,     dat3=pa23,     dat4=pa24,     dat5=pa25, 	exposure=chpaq2 );
579        
580        	%MIPAR(dat1=life1,    dat2=life2,    dat3=life3,    dat4=life4,    dat5=life5,  exposure=life );
581        
582        
583        	/*MANUAL SPECIFICATION OF DATA NAME*/
584        	data dat_lb.life_&group._par;
585        		set
586        		chwest_PAR chwestq1_PAR chwestq2_PAR chwestq3_PAR
587        		chst_PAR   chstq1_PAR   chstq2_PAR   chstq3_PAR
588        		chpa_PAR   chpaq0_PAR   chpaq1_PAR   chpaq2_PAR
589        		life_PAR
590        		;
591        
592        		length group $ 40;
593        		group="&group.";
594        
595        	run;
596        
597        
598        
599        	title "HEADER: final output for &group";
600        	proc print data=dat_lb.life_&group._par;
601        	run;
602        	title "";
603        
604        %mend ob_par_MI_strat;
