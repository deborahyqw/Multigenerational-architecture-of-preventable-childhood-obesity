150        
151        %macro ob_par_MI_strat (data=, group=);
152        
153        
154        	/**********************************************************************
155        	RUN THE RR, WITH METANALYSIS BY IMPUTATION
156        	**********************************************************************/
157        
158        	/*MANUAL SPECIFICATION OF DATASET NAME*/
159        
160        	title "HEADER: personal modifiable factors, &group.";
161        	proc genmod data = &data. descending;
162        		by _imputation_ ;
163        	class id momid ;
164        	model chob = &chwestq_ &chstq_ &chpaq_ &chcalq_ &covar1
165        		/ dist = Poisson link = log;
166        		repeated subject=id(momid)/type=unstr PRINTMLE ecovb;
167        		ods output GEERCov=covlife GEEEmpPEst = life;
168        	run;
169        	title "";
170        	
171        	proc genmod data = &data. descending;
172        		by _imputation_ ;
173        		class id momid ;
174        		model chob = chwest_m chst_m chpa_m chcal_m &covar1
175        		/ dist = Poisson link = log;
176        		repeated subject=id(momid)/type=unstr PRINTMLE ecovb;
177        		ods output GEEEmpPEst =life_t;
178        	run;
179        
180        	TITLE "HEADER: multiple imputation - personal modifiable factors, &group.";
