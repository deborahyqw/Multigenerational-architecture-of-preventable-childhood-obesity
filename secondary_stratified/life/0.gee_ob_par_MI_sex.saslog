204        	data dat_lb.life_&group._RR;
205        		length Parm $ 15;
206        		length mod $ 40;
207        		length group $ 40;
208        
209        		set mi_life(in=a) mi_lifet(in=b) ;
210        		
211        		if a then mod="life";
212        		if b then mod="life trend";
213        
214        		if Parm in ("chwestq1", "chwestq2", "chwestq3", "chstq1", "chstq2", "chstq3", "chpaq0",
215        				"chpaq1", "chpaq2", "chcalq1", "chcalq2", "chcalq3"); *only keep main exposures when exporting;
216        
217        		group="&group.";
218        
219        		RR=exp(Estimate); LCI=exp(LCLMean); UCI=exp(UCLMean);
220        	run;
221        
222        	title "HEADER: proc print regression results for &group";
223        	proc print data=dat_lb.life_&group._RR; run;
224        	title "";
