304        				Prm6=chstq2      Prm7=chstq3     Prm8=chpaq0     Prm9=chpaq1     Prm10=chpaq2
305        				Prm11=chcalq1    Prm12=chcalq2   Prm13=chcalq3   Prm14=chbmibase
