185        
186        	TITLE "HEADER: multiple imputation - personal modifiable factors, &group.";
187        	ods output ParameterEstimates=mi_life;
188        	PROC MIANALYZE parms=life;
189        	MODELEFFECTS INTERCEPT
190        			chwestq1 chwestq2 chwestq3 chstq1 chstq2 chstq3 chpaq0 chpaq1 chpaq2
191        			chcalq1 chcalq2 chcalq3 &covar1;
