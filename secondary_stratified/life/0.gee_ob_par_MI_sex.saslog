289        	/*specify which PRM corresponds with which variable
290        	MANUALLY SPECIFICATION OF PARAMS*/
291        	data covparms;
292        		set covlife;
293        		by _imputation_;
294        		length _type_ $4;
295        		_type_ = 'COV';
296        
297        		rename  Prm1=intercept   Prm2=chwestq1   Prm3=chwestq2   Prm4=chwestq3   Prm5=chstq1
298        				Prm6=chstq2      Prm7=chstq3     Prm8=chpaq0     Prm9=chpaq1     Prm10=chpaq2
299        				Prm11=chcalq1    Prm12=chcalq2   Prm13=chcalq3   Prm14=chbmibase
300        				Prm15=cohort     Prm16=chage     Prm17=white     ;
301        
302        		length _name_ $10;
303        		
304        		*i counts rows within each _imputation_;
305        		if first._imputation_ then i=1;
306        			else i+1;
307        
308        		* Assign which row this is (the row "label" in the covariance matrix) ;
309        		select(i);
310        			when(1)  _name_ = 'INTERCEPT';
311        			when(2)  _name_ = 'chwestq1';
312        			when(3)  _name_ = 'chwestq2';
313        			when(4)  _name_ = 'chwestq3';
314        			when(5)  _name_ = 'chstq1';
315        			when(6)  _name_ = 'chstq2';
316        			when(7)  _name_ = 'chstq3';
317        			when(8)  _name_ = 'chpaq0';
318        			when(9)  _name_ = 'chpaq1';
319        			when(10)  _name_ = 'chpaq2';
320        			when(11)  _name_ = 'chcalq1';
321        			when(12)  _name_ = 'chcalq2';
322        			when(13)  _name_ = 'chcalq3';
323        			when(14)  _name_ = 'chbmibase';
324        			when(15)  _name_ = 'cohort';
325        			when(16)  _name_ = 'chage';
326        			when(17)  _name_ = 'white';
327        
328        			otherwise;
329        		end;
330        		
331        		* Output EVERY row;
332        		output;
