417        	/*run the par macro over each of the imputated datasets*/
418        	%macro runPAR(prefixBeta=, prefixFreq=, outpref=, modmod=, fixfix=);
419        		%local i;
420        		%do i=1 %to 5;
421        			%par(
422        				bdata=&prefixBeta.&i, /*name of dataset containing coefficients and their variance-covariance matrix*/
423        				pdata=&prefixFreq.&i, /*name of dataset condtaining variable combinations and their frequences*/
424        				n_or_p=N, 			  /*whether the pdata dataset contains counts (N) or prevalences (P)*/
425        				n_or_pname=FQ, 		  /*the name of the variable in Pdata that is the count or the prevalence for the stratum*/
426        				modvar= &modmod,	  /*the list of modifiable variables*/
427        				missvarlist=NONE,     /*list of missing indicators in original model*/
428        				partialpar= T,
429        				outdat= &outpref.&i,
430        				fixedvar= &fixfix  	  /*the list of variables to be held fixed in computing a partial PAR*/
431        				);
432        		%end;
433        	%mend runPAR;
