224        
225        	title "HEADER: proc print life for &group";
226        	proc print data=life; run;
227        	title "";
228        
229        
230        	/*transposing the dataset so that each row corresponds to an imputation and each variable has its effect estimate*/
231        
232        	data betas;
233        	set life ;
234        	by _imputation_;
235        	_type_ = 'PARM';
236        		retain intercept chwestq1 chwestq2 chwestq3 chstq1 chstq2 chstq3
237        				chpaq0 chpaq1 chpaq2 chcalq1 chcalq2 chcalq3
238        				&covar1;
239        		
240        		* 'i' counts rows within each _imputation_ group ;
241        		if first._imputation_ then i=1;
242        		else i+1;
243        
244        		/*MANUAL SPECIFICATION OF VARIABLES*/
245        		select (i);
246        		when (1) intercept = estimate;
247        		when (2) chwestq1  = estimate;
248        		when (3) chwestq2  = estimate;
249        		when (4) chwestq3  = estimate;
250        		when (5) chstq1   = estimate;
251        		when (6) chstq2   = estimate;
252        		when (7) chstq3   = estimate;
253        		when (8) chpaq0   = estimate;
254        		when (9) chpaq1   = estimate;
255        		when (10) chpaq2  = estimate;
256        		when (11) chcalq1   = estimate;
257        		when (12) chcalq2   = estimate;
258        		when (13) chcalq3   = estimate;
259        		when (14) chbmibase = estimate;
260        		when (15) cohort   = estimate;
261        		when (16) chage    = estimate;
262        		when (17) white    = estimate;
263        
264        		otherwise;
265        	end;
266        		
267        	/*Only OUTPUT once per _imputation_, after we've assigned all param columns*/
268        	if last._imputation_ then output;
269        
270        		/*set negative beta to 0 to avoid errors in PAR, only main exposures*/
271        
272        		if chwestq1 <0 then chwestq1=0;
273        		if chwestq2 <0 then chwestq2=0;
274        		if chwestq3 <0 then chwestq3=0;
275        		if chstq1 <0 then chstq1=0;
276        		if chstq2 <0 then chstq2=0;
277        		if chstq3 <0 then chstq3=0;
278        		if chpaq0 <0 then chpaq0=0;
279        		if chpaq1 <0 then chpaq1=0;
280        		if chpaq2 <0 then chpaq2=0;
281        
282        	run;
