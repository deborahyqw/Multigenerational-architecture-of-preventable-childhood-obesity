124        /**********************************************************************
125        CREATE MACRO TO METANALYZE ALL OF THE EXPOSURES FOR EACH GROUP
126        **********************************************************************/
127        
128        /*have to metaanalyze each exposure separately, will create macro that can be used to run through each of the stratification groups
128      ! (sex/age/materinal BMI)*/
129        
130        
131        %macro metaanal_allexp (data=, group=);
132        
133        	/* chwestq1 exposure */
134        	data chwestq1_&group.; set &data; if Parm = 'chwestq1'; run;
135        	%metaanal(data=chwestq1_&group., beta=beta, se_or_var=s, se=SE, studylab=group, loglinear=T,
136        		explabel=chwestq1, outcomelabel=ob,
137        			outdat= "RR_life_chwestq1_&group");
138        
139        	/* chwestq2 exposure */
140        	data chwestq2_&group.; set &data; if Parm = 'chwestq2'; run;
141        	%metaanal(data=chwestq2_&group., beta=beta, se_or_var=s, se=SE, studylab=group, loglinear=T,
142        		explabel=chwestq2, outcomelabel=ob,
143        		outdat= "RR_life_chwestq2_&group");
144        
145        	/* chwestq3 exposure */
146        	data chwestq3_&group.; set &data; if Parm = 'chwestq3'; run;
147        	%metaanal(data=chwestq3_&group., beta=beta, se_or_var=s, se=SE, studylab=group, loglinear=T,
148        		explabel=chwestq3, outcomelabel=ob,
149        		outdat= "RR_life_chwestq3_&group");
150        
151        	/* chstq1 exposure */
152        	data chstq1_&group.; set &data; if Parm = 'chstq1'; run;
153        	%metaanal(data=chstq1_&group., beta=beta, se_or_var=s, se=SE, studylab=group, loglinear=T,
154        		explabel=chstq1, outcomelabel=ob,
155        		outdat= "RR_life_chstq1_&group");
156        
157        	/* chstq2 exposure */
158        	data chstq2_&group.; set &data; if Parm = 'chstq2'; run;
159        	%metaanal(data=chstq2_&group., beta=beta, se_or_var=s, se=SE, studylab=group, loglinear=T,
160        		explabel=chstq2, outcomelabel=ob,
161        		outdat= "RR_life_chstq2_&group");
162        
163        	/* chstq3 exposure */
164        	data chstq3_&group.; set &data; if Parm = 'chstq3'; run;
165        	%metaanal(data=chstq3_&group., beta=beta, se_or_var=s, se=SE, studylab=group, loglinear=T,
166        		explabel=chstq3, outcomelabel=ob,
167        		outdat= "RR_life_chstq3_&group");		
168        
169        	/* chpaq0 exposure */
170        	data chpaq0_&group.; set &data; if Parm = 'chpaq0'; run;
171        	%metaanal(data=chpaq0_&group., beta=beta, se_or_var=s, se=SE, studylab=group, loglinear=T,
172        		explabel=chpaq0, outcomelabel=ob,
173        		outdat= "RR_life_chpaq0_&group");
174        
175        	/* chpaq1 exposure */
176        	data chpaq1_&group.; set &data; if Parm = 'chpaq1'; run;
177        	%metaanal(data=chpaq1_&group., beta=beta, se_or_var=s, se=SE, studylab=group, loglinear=T,
178        		explabel=chpaq1, outcomelabel=ob,
179        		outdat= "RR_life_chpaq1_&group");
180        
181        	/* chpaq2 exposure */
