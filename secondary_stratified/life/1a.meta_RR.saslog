77         
78         /**SEX************************************/
79         
80         data meta_RR_sex;
81            set dat_lb.life_female_rr  dat_lb.life_male_rr;;
82            length  HRCI2 $ 18;
83            HRCI2=.;
84            SE=StdErr*1;
85            beta=Estimate*1;
86            if mod="life";
87            keep Parm mod group beta SE HRCI2;
88         run;

