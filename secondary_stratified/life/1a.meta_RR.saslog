90         /**SEX************************************/
91         
92         data meta_RR_sex;
93            set dat_lb.life_female_rr  dat_lb.life_male_rr;;
94            length  HRCI2 $ 18;
95            HRCI2=.;
96            SE=StdErr*1;
97            beta=Estimate*1;
98            if mod="life";
99            keep Parm mod group beta SE HRCI2;
100        run;

