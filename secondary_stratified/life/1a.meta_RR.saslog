136        /**********************************************************************
137        CREATE MACRO TO METANALYZE ALL OF THE EXPOSURES FOR EACH GROUP
138        **********************************************************************/
139        
140        /*have to metaanalyze each exposure separately, will create macro that can be used to run through each of the stratification groups
140      ! (sex/age/materinal BMI)*/
141        
142        
143        %macro metaanal_allexp (data=, group=);
144        
145        	/* chwestq1 exposure */
146        	data chwestq1_&group.; set &data; if Parm = 'chwestq1'; run;
147        	%metaanal(data=chwestq1_&group., beta=beta, se_or_var=s, se=SE, studylab=group, loglinear=T,
148        		explabel=chwestq1, outcomelabel=ob,
149        			outdat= "RR_life_chwestq1_&group");
150        
151        	/* chwestq2 exposure */
152        	data chwestq2_&group.; set &data; if Parm = 'chwestq2'; run;
153        	%metaanal(data=chwestq2_&group., beta=beta, se_or_var=s, se=SE, studylab=group, loglinear=T,
154        		explabel=chwestq2, outcomelabel=ob,
155        		outdat= "RR_life_chwestq2_&group");
156        
157        	/* chwestq3 exposure */
4                                                                   The SAS System                                    11:16 Tuesday, November 18, 2025

