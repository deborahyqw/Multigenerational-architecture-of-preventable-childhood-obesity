134        /**********************************************************************
135        CREATE MACRO TO METANALYZE ALL OF THE EXPOSURES FOR EACH GROUP
136        **********************************************************************/
137        
138        /*have to metaanalyze each exposure separately, will create macro that can be used to run through each of the stratification groups
138      ! (sex/age/materinal BMI)*/
139        
140        
141        %macro metaanal_allexp (data=, group=);
142        
143        
144        	/* chwest exposure */
145        	data chwest_&group.; set &data; if exposure = 'chwest'; run;
146        	%metaanal(data=chwest_&group., beta=beta, se_or_var=s, se=SE, studylab=group, loglinear=F,
147        		explabel=chwest, outcomelabel=ob,
148        			outdat= "PAR_life_chwest_&group");
149        
150        	/* chwestq1 exposure */
151        	data chwestq1_&group.; set &data; if exposure = 'chwestq1'; run;
152        	%metaanal(data=chwestq1_&group., beta=beta, se_or_var=s, se=SE, studylab=group, loglinear=F,
153        		explabel=chwestq1, outcomelabel=ob,
154        			outdat= "PAR_life_chwestq1_&group");
155        
156        	/* chwestq2 exposure */
157        	data chwestq2_&group.; set &data; if exposure = 'chwestq2'; run;
