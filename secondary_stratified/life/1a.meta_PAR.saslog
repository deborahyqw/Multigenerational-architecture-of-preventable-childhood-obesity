122        /**********************************************************************
123        CREATE MACRO TO METANALYZE ALL OF THE EXPOSURES FOR EACH GROUP
124        **********************************************************************/
125        
126        /*have to metaanalyze each exposure separately, will create macro that can be used to run through each of the stratification groups
126      ! (sex/age/materinal BMI)*/
127        
128        
129        %macro metaanal_allexp (data=, group=);
130        
131        
132        	/* chwest exposure */
133        	data chwest_&group.; set &data; if exposure = 'chwest'; run;
134        	%metaanal(data=chwest_&group., beta=beta, se_or_var=s, se=SE, studylab=group, loglinear=F,
135        		explabel=chwest, outcomelabel=ob,
136        			outdat= "PAR_life_chwest_&group");
137        
138        	/* chwestq1 exposure */
139        	data chwestq1_&group.; set &data; if exposure = 'chwestq1'; run;
140        	%metaanal(data=chwestq1_&group., beta=beta, se_or_var=s, se=SE, studylab=group, loglinear=F,
141        		explabel=chwestq1, outcomelabel=ob,
142        			outdat= "PAR_life_chwestq1_&group");
143        
144        	/* chwestq2 exposure */
145        	data chwestq2_&group.; set &data; if exposure = 'chwestq2'; run;
146        	%metaanal(data=chwestq2_&group., beta=beta, se_or_var=s, se=SE, studylab=group, loglinear=F,
147        		explabel=chwestq2, outcomelabel=ob,
148        		outdat= "PAR_life_chwestq2_&group");
149        
150        	/* chwestq3 exposure */
151        	data chwestq3_&group.; set &data; if exposure = 'chwestq3'; run;
152        	%metaanal(data=chwestq3_&group., beta=beta, se_or_var=s, se=SE, studylab=group, loglinear=F,
153        		explabel=chwestq3, outcomelabel=ob,
154        		outdat= "PAR_life_chwestq3_&group");
155        
