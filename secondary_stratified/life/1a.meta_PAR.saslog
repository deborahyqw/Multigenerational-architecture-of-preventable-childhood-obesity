90         /**SEX************************************/
91         data meta_PAR_sex;
92         	set dat_lb.life_female_PAR dat_lb.life_male_PAR;
93         	length  HRCI2 $ 18;
94         	SE=StdErr*1;
95             beta=Estimate*1;
96         	HRCI2=.;
97         	keep beta SE group exposure HRCI2;
98         run;

