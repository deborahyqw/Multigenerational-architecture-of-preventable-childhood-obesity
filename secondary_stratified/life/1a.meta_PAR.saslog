78         /**SEX************************************/
79         data meta_PAR_sex;
80         	set dat_lb.life_female_PAR dat_lb.life_male_PAR;
81         	length  HRCI2 $ 18;
82         	SE=StdErr*1;
83             beta=Estimate*1;
84         	HRCI2=.;
85         	keep beta SE group exposure HRCI2;
86         run;

