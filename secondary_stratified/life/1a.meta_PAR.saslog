159        		explabel=chwestq2, outcomelabel=ob,
160        		outdat= "PAR_life_chwestq2_&group");
161        
162        	/* chwestq3 exposure */
163        	data chwestq3_&group.; set &data; if exposure = 'chwestq3'; run;
164        	%metaanal(data=chwestq3_&group., beta=beta, se_or_var=s, se=SE, studylab=group, loglinear=F,
165        		explabel=chwestq3, outcomelabel=ob,
166        		outdat= "PAR_life_chwestq3_&group");
167        
168        	/* chst exposure */
