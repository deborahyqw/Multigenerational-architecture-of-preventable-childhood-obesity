168        
169        	/*MANUAL SPECIFICATION OF DATASET NAME*/
170        
171        	title "HEADER: personal modifiable factors, &group.";
172        	proc genmod data = &data. descending;
173        		by _imputation_ ;
174        	class id momid ;
175        	model chob = &chwestq_ &chstq_ &chpaq_ &chcalq_ &covar1
176        		/ dist = Poisson link = log;
177        		repeated subject=id(momid)/type=unstr PRINTMLE ecovb;
178        		ods output GEERCov=covlife GEEEmpPEst = life;
179        	run;
180        	title "";
181        	
