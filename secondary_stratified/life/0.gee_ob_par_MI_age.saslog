517        	%runPAR(prefixBeta=betacov, prefixFreq=freqs, outpref=life,
518        			modmod = chwestq1 chwestq2 chwestq3 chstq1 chstq2 chstq3
519        					chpaq0 chpaq1 chpaq2  ,
520        			fixfix =  chcalq1 chcalq2 chcalq3
521        				&covar1);
522        
523        					
524        	/*************************************************************************************/
525        	/**************** combine using mianalyze ********************************************/
526        
527        	/*combine the PAR and errors from each of the imputations*/
528        
529        	%macro MIPAR(dat1=, dat2=, dat3=, dat4=, dat5=, exposure=);
530        
531        		data temp;
532        			length _Imputation_ 3;
533        			set &dat1(in=a) &dat2(in=b) &dat3(in=c) &dat4(in=d) &dat5(in=e);
534        			if a then _Imputation_=1;
535        				else if b then _Imputation_=2;
536        				else if c then _Imputation_=3;
537        				else if d then _Imputation_=4;
538        				else if e then _Imputation_=5;
539        					
540        			/* approximate standard error from the half-width of the CI */
541        			StdErr = (uclpartialx - lclpartialx) / (2 * 1.96);
542        			Estimate = partlparx;
543        			Parameter = 'PartialPAR';
544        			
545        			keep _Imputation_ Estimate StdErr Parameter;
546        		run;
547        
548        		ods output ParameterEstimates=&exposure._PAR;
549        		proc mianalyze data=temp;
550        			modeleffects Estimate;
551        			stderr StdErr;
552        		run;
553        
554        		data &exposure._PAR;
555        			set &exposure._PAR;
556        			length exposure $ 15;
557        			exposure="&exposure.";
558        		run;
559        			
560        
561        	%mend MIPAR;
562        
563        
564        	%MIPAR(dat1=west1,    dat2=west2,    dat3=west3,    dat4=west4,    dat5=west5,  exposure=chwest);
565        	%MIPAR(dat1=west11,   dat2=west12,   dat3=west13,   dat4=west14,   dat5=west15, exposure=chwestq1);
566        	%MIPAR(dat1=west21,   dat2=west22,   dat3=west23,   dat4=west24,   dat5=west25, exposure=chwestq2);
567        	%MIPAR(dat1=west31,   dat2=west32,   dat3=west33,   dat4=west34,   dat5=west35, exposure=chwestq3);
568        
569        	%MIPAR(dat1=sed1,     dat2=sed2,     dat3=sed3,     dat4=sed4,     dat5=sed5,  	exposure=chst);
570        	%MIPAR(dat1=sed11,    dat2=sed12,    dat3=sed13,    dat4=sed14,    dat5=sed15, 	exposure=chstq1);
571        	%MIPAR(dat1=sed21,    dat2=sed22,    dat3=sed23,    dat4=sed24,    dat5=sed25, 	exposure=chstq2);
572        	%MIPAR(dat1=sed31,    dat2=sed32,    dat3=sed33,    dat4=sed34,    dat5=sed35, 	exposure=chstq3);
573        
574        	%MIPAR(dat1=pa1,      dat2=pa2,      dat3=pa3,      dat4=pa4,      dat5=pa5,  	exposure=chpa);
575        	%MIPAR(dat1=pa01,     dat2=pa02,     dat3=pa03,     dat4=pa04,     dat5=pa05, 	exposure=chpaq0 );
576        	%MIPAR(dat1=pa11,     dat2=pa12,     dat3=pa13,     dat4=pa14,     dat5=pa15, 	exposure=chpaq1 );
577        	%MIPAR(dat1=pa21,     dat2=pa22,     dat3=pa23,     dat4=pa24,     dat5=pa25, 	exposure=chpaq2 );
578        
579        	%MIPAR(dat1=life1,    dat2=life2,    dat3=life3,    dat4=life4,    dat5=life5,  exposure=life );
580        
581        
582        	/*MANUAL SPECIFICATION OF DATA NAME*/
583        	data dat_lb.life_&group._par;
584        		set
585        		chwest_PAR chwestq1_PAR chwestq2_PAR chwestq3_PAR
586        		chst_PAR   chstq1_PAR   chstq2_PAR   chstq3_PAR
587        		chpa_PAR   chpaq0_PAR   chpaq1_PAR   chpaq2_PAR
588        		life_PAR
589        		;
590        
591        		length group $ 40;
592        		group="&group.";
593        
594        	run;
595        
596        
597        	title "HEADER: final output for &group";
598        	proc print data=dat_lb.life_&group._par;
599        	run;
600        	title "";
601        
602        %mend ob_par_MI_strat;
