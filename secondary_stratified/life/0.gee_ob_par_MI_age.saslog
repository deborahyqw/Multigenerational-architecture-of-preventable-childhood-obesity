416        	/*run the par macro over each of the imputated datasets*/
417        	%macro runPAR(prefixBeta=, prefixFreq=, outpref=, modmod=, fixfix=);
418        		%local i;
419        		%do i=1 %to 5;
420        			%par(
421        				bdata=&prefixBeta.&i, /*name of dataset containing coefficients and their variance-covariance matrix*/
422        				pdata=&prefixFreq.&i, /*name of dataset condtaining variable combinations and their frequences*/
423        				n_or_p=N, 			  /*whether the pdata dataset contains counts (N) or prevalences (P)*/
424        				n_or_pname=FQ, 		  /*the name of the variable in Pdata that is the count or the prevalence for the stratum*/
425        				modvar= &modmod,	  /*the list of modifiable variables*/
426        				missvarlist=NONE,     /*list of missing indicators in original model*/
427        				partialpar= T,
428        				outdat= &outpref.&i,
429        				fixedvar= &fixfix  	  /*the list of variables to be held fixed in computing a partial PAR*/
430        				);
431        		%end;
432        	%mend runPAR;
