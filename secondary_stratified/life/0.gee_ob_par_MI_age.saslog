213        
214        		set mi_life(in=a) mi_lifet(in=b) ;
215        		
216        		if a then mod="life";
217        		if b then mod="life trend";
218        
219        		if Parm in ("chwestq1", "chwestq2", "chwestq3", "chstq1", "chstq2", "chstq3", "chpaq0",
220        				"chpaq1", "chpaq2", "chcalq1", "chcalq2", "chcalq3"); *only keep main exposures when exporting;
221        
222        		group="&group.";
223        
224        		RR=exp(Estimate); LCI=exp(LCLMean); UCI=exp(UCLMean);
225        	run;
