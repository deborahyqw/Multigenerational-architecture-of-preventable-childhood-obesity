422        	/*run the par macro over each of the imputated datasets*/
423        	%macro runPAR(prefixBeta=, prefixFreq=, outpref=, modmod=, fixfix=);
424        		%local i;
425        		%do i=1 %to 5;
426        			%par(
427        				bdata=&prefixBeta.&i, /*name of dataset containing coefficients and their variance-covariance matrix*/
428        				pdata=&prefixFreq.&i, /*name of dataset condtaining variable combinations and their frequences*/
429        				n_or_p=N, 			  /*whether the pdata dataset contains counts (N) or prevalences (P)*/
430        				n_or_pname=FQ, 		  /*the name of the variable in Pdata that is the count or the prevalence for the stratum*/
431        				modvar= &modmod,	  /*the list of modifiable variables*/
432        				missvarlist=NONE,     /*list of missing indicators in original model*/
433        				partialpar= T,
434        				outdat= &outpref.&i,
435        				fixedvar= &fixfix  	  /*the list of variables to be held fixed in computing a partial PAR*/
436        				);
437        		%end;
438        	%mend runPAR;
