235        
236        	title "HEADER: proc print life for &group";
237        	proc print data=life; run;
238        	title "";
239        
240        
241        	/*transposing the dataset so that each row corresponds to an imputation and each variable has its effect estimate*/
242        
243        	data betas;
244        	set life ;
245        	by _imputation_;
246        	_type_ = 'PARM';
247        		retain intercept chwestq1 chwestq2 chwestq3 chstq1 chstq2 chstq3
248        				chpaq0 chpaq1 chpaq2 chcalq1 chcalq2 chcalq3
249        				&covar1;
250        		
251        		* 'i' counts rows within each _imputation_ group ;
252        		if first._imputation_ then i=1;
253        		else i+1;
254        
255        		/*MANUAL SPECIFICATION OF VARIABLES*/
256        		select (i);
257        		when (1) intercept = estimate;
258        		when (2) chwestq1  = estimate;
259        		when (3) chwestq2  = estimate;
260        		when (4) chwestq3  = estimate;
261        		when (5) chstq1   = estimate;
262        		when (6) chstq2   = estimate;
263        		when (7) chstq3   = estimate;
264        		when (8) chpaq0   = estimate;
265        		when (9) chpaq1   = estimate;
266        		when (10) chpaq2  = estimate;
267        		when (11) chcalq1   = estimate;
268        		when (12) chcalq2   = estimate;
269        		when (13) chcalq3   = estimate;
270        		when (14) chbmibase = estimate;
271        		when (15) cohort   = estimate;
272        		when (16) white    = estimate;
273        		when (17) sex     = estimate;
274        
275        		otherwise;
276        	end;
277        		
278        	/*Only OUTPUT once per _imputation_, after we've assigned all param columns*/
279        	if last._imputation_ then output;
280        
281        		/*set negative beta to 0 to avoid errors in PAR, only main exposures*/
282        
283        		if chwestq1 <0 then chwestq1=0;
284        		if chwestq2 <0 then chwestq2=0;
285        		if chwestq3 <0 then chwestq3=0;
286        		if chstq1 <0 then chstq1=0;
287        		if chstq2 <0 then chstq2=0;
288        		if chstq3 <0 then chstq3=0;
289        		if chpaq0 <0 then chpaq0=0;
