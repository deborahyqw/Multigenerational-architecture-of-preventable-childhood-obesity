529        					
530        	/*************************************************************************************/
531        	/**************** combine using mianalyze ********************************************/
532        
533        	/*combine the PAR and errors from each of the imputations*/
534        
535        	%macro MIPAR(dat1=, dat2=, dat3=, dat4=, dat5=, exposure=);
536        
537        		data temp;
538        			length _Imputation_ 3;
539        			set &dat1(in=a) &dat2(in=b) &dat3(in=c) &dat4(in=d) &dat5(in=e);
540        			if a then _Imputation_=1;
541        				else if b then _Imputation_=2;
542        				else if c then _Imputation_=3;
543        				else if d then _Imputation_=4;
544        				else if e then _Imputation_=5;
545        					
546        			/* approximate standard error from the half-width of the CI */
547        			StdErr = (uclpartialx - lclpartialx) / (2 * 1.96);
548        			Estimate = partlparx;
549        			Parameter = 'PartialPAR';
550        			
551        			keep _Imputation_ Estimate StdErr Parameter;
552        		run;
553        
554        		ods output ParameterEstimates=&exposure._PAR;
555        		proc mianalyze data=temp;
556        			modeleffects Estimate;
557        			stderr StdErr;
558        		run;
559        
560        		data &exposure._PAR;
561        			set &exposure._PAR;
562        			length exposure $ 15;
563        			exposure="&exposure.";
564        		run;
565        			
566        
567        	%mend MIPAR;
568        
569        
570        	%MIPAR(dat1=west1,    dat2=west2,    dat3=west3,    dat4=west4,    dat5=west5,  exposure=chwest);
571        	%MIPAR(dat1=west11,   dat2=west12,   dat3=west13,   dat4=west14,   dat5=west15, exposure=chwestq1);
572        	%MIPAR(dat1=west21,   dat2=west22,   dat3=west23,   dat4=west24,   dat5=west25, exposure=chwestq2);
573        	%MIPAR(dat1=west31,   dat2=west32,   dat3=west33,   dat4=west34,   dat5=west35, exposure=chwestq3);
574        
575        	%MIPAR(dat1=sed1,     dat2=sed2,     dat3=sed3,     dat4=sed4,     dat5=sed5,  	exposure=chst);
576        	%MIPAR(dat1=sed11,    dat2=sed12,    dat3=sed13,    dat4=sed14,    dat5=sed15, 	exposure=chstq1);
577        	%MIPAR(dat1=sed21,    dat2=sed22,    dat3=sed23,    dat4=sed24,    dat5=sed25, 	exposure=chstq2);
578        	%MIPAR(dat1=sed31,    dat2=sed32,    dat3=sed33,    dat4=sed34,    dat5=sed35, 	exposure=chstq3);
579        
580        	%MIPAR(dat1=pa1,      dat2=pa2,      dat3=pa3,      dat4=pa4,      dat5=pa5,  	exposure=chpa);
581        	%MIPAR(dat1=pa01,     dat2=pa02,     dat3=pa03,     dat4=pa04,     dat5=pa05, 	exposure=chpaq0 );
582        	%MIPAR(dat1=pa11,     dat2=pa12,     dat3=pa13,     dat4=pa14,     dat5=pa15, 	exposure=chpaq1 );
583        	%MIPAR(dat1=pa21,     dat2=pa22,     dat3=pa23,     dat4=pa24,     dat5=pa25, 	exposure=chpaq2 );
584        
585        	%MIPAR(dat1=life1,    dat2=life2,    dat3=life3,    dat4=life4,    dat5=life5,  exposure=life );
586        
587        
588        	/*MANUAL SPECIFICATION OF DATA NAME*/
589        	data dat_lb.life_&group._par;
590        		set
591        		chwest_PAR chwestq1_PAR chwestq2_PAR chwestq3_PAR
592        		chst_PAR   chstq1_PAR   chstq2_PAR   chstq3_PAR
593        		chpa_PAR   chpaq0_PAR   chpaq1_PAR   chpaq2_PAR
594        		life_PAR
595        		;
596        
597        		length group $ 40;
598        		group="&group.";
599        
600        	run;
601        
602        
603        	title "HEADER: final output for &group";
604        	proc print data=dat_lb.life_&group._par;
605        	run;
606        	title "";
607        
608        %mend ob_par_MI_strat;
