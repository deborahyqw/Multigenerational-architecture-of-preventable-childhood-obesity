300        		_type_ = 'COV';
301        
302        		rename  Prm1=intercept   Prm2=chwestq1   Prm3=chwestq2   Prm4=chwestq3   Prm5=chstq1
303        				Prm6=chstq2      Prm7=chstq3     Prm8=chpaq0     Prm9=chpaq1     Prm10=chpaq2
304        				Prm11=chcalq1    Prm12=chcalq2   Prm13=chcalq3   Prm14=chbmibase
305        				Prm15=cohort     Prm16=white     Prm17=sex ;
306        
307        		length _name_ $10;
308        		
309        		*i counts rows within each _imputation_;
310        		if first._imputation_ then i=1;
311        			else i+1;
312        
313        		* Assign which row this is (the row "label" in the covariance matrix) ;
