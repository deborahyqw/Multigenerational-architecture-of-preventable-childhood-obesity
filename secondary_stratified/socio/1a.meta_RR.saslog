81         /**SEX************************************/
82         
83         
84         data meta_RR_sex;
85            set dat_lb.soc_female_RR  dat_lb.soc_male_RR
86                 dat_lb.nses_female_RR dat_lb.nses_male_RR;
87         	length  HRCI2 $ 18;
88         	HRCI2=.;
89         	SE=StdErr*1;
90             beta=Estimate*1;
91         	keep Parm mod group beta SE HRCI2;
92         
93         run;

