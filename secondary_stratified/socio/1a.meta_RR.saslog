88         
89         /* note that for each group we are calling in two datsets, one with the income/education and
90         the other with the nses */
91         
92         /**SEX************************************/
93         
94         
95         data meta_RR_sex;
96            set dat_lb.soc_female_RR  dat_lb.soc_male_RR
97                 dat_lb.nses_female_RR dat_lb.nses_male_RR;
98         	length  HRCI2 $ 18;
99         	HRCI2=.;
100        	SE=StdErr*1;
101            beta=Estimate*1;
102        	keep Parm mod group beta SE HRCI2;
103        
104        run;

