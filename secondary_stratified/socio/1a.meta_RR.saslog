129        /**********************************************************************
130        CREATE MACRO TO METANALYZE ALL OF THE EXPOSURES FOR EACH GROUP
131        **********************************************************************/
132        
133        
134        /*have to metaanalyze each exposure separately, will create macro that can be used to run through each of the stratification groups
134      ! (sex/age/materinal BMI)*/
135        
136        %macro metaanal_allexp (data=, group=);
137        
138        	/* sesq0 exposure */
139        	data sesq0_&group.; set &data; if Parm = 'sesq0'; run;
140        	%metaanal(data=sesq0_&group., beta=beta, se_or_var=s, se=SE, studylab=group, loglinear=T,
141        		explabel=sesq0, outcomelabel=ob,
142        			outdat= "RR_socio_sesq0_&group");
143        
144        	/* sesq1 exposure */
145        	data sesq1_&group.; set &data; if Parm = 'sesq1'; run;
146        	%metaanal(data=sesq1_&group., beta=beta, se_or_var=s, se=SE, studylab=group, loglinear=T,
147        		explabel=sesq1, outcomelabel=ob,
148        		outdat= "RR_socio_sesq1_&group");
149        
150        	/* sesq2 exposure */
151        	data sesq2_&group.; set &data; if Parm = 'sesq2'; run;
152        	%metaanal(data=sesq2_&group., beta=beta, se_or_var=s, se=SE, studylab=group, loglinear=T,
153        		explabel=sesq2, outcomelabel=ob,
154        		outdat= "RR_socio_sesq2_&group");
155        
156        	/* heduc1 exposure */
157        	data heduc1_&group.; set &data; if Parm = 'heduc1'; run;
158        	%metaanal(data=heduc1_&group., beta=beta, se_or_var=s, se=SE, studylab=group, loglinear=T,
159        		explabel=heduc1, outcomelabel=ob,
160        		outdat= "RR_socio_heduc1_&group");
161        
162        	/* heduc2 exposure */
163        	data heduc2_&group.; set &data; if Parm = 'heduc2'; run;
164        	%metaanal(data=heduc2_&group., beta=beta, se_or_var=s, se=SE, studylab=group, loglinear=T,
165        		explabel=heduc2, outcomelabel=ob,
166        		outdat= "RR_socio_heduc2_&group");
167        
168        	/* fincome1 exposure */
169        	data fincome1_&group.; set &data; if Parm = 'fincome1'; run;
170        	%metaanal(data=fincome1_&group., beta=beta, se_or_var=s, se=SE, studylab=group, loglinear=T,
171        		explabel=fincome1, outcomelabel=ob,
172        		outdat= "RR_socio_fincome1_&group");		
173        
174        	/* fincome2 exposure */
175        	data fincome2_&group.; set &data; if Parm = 'fincome2'; run;
176        	%metaanal(data=fincome2_&group., beta=beta, se_or_var=s, se=SE, studylab=group, loglinear=T,
177        		explabel=fincome2, outcomelabel=ob,
178        		outdat= "RR_socio_fincome2_&group");
179        
180        	/* fincome3 exposure */
181        	data fincome3_&group.; set &data; if Parm = 'fincome3'; run;
182        	%metaanal(data=fincome3_&group., beta=beta, se_or_var=s, se=SE, studylab=group, loglinear=T,
183        		explabel=fincome3, outcomelabel=ob,
4                                                                   The SAS System                                          13:05 Monday, July 7, 2025

184        		outdat= "RR_socio_fincome3_&group");
185        
186        
187        %mend metaanal_allexp;
