140        /**********************************************************************
141        CREATE MACRO TO METANALYZE ALL OF THE EXPOSURES FOR EACH GROUP
142        **********************************************************************/
143        
144        
145        /*have to metaanalyze each exposure separately, will create macro that can be used to run through each of the stratification groups
145      ! (sex/age/materinal BMI)*/
146        
147        %macro metaanal_allexp (data=, group=);
148        
149        	/* sesq0 exposure */
150        	data sesq0_&group.; set &data; if Parm = 'sesq0'; run;
151        	%metaanal(data=sesq0_&group., beta=beta, se_or_var=s, se=SE, studylab=group, loglinear=T,
4                                                                   The SAS System                                    11:17 Tuesday, November 18, 2025

152        		explabel=sesq0, outcomelabel=ob,
153        			outdat= "RR_socio_sesq0_&group");
154        
155        	/* sesq1 exposure */
156        	data sesq1_&group.; set &data; if Parm = 'sesq1'; run;
157        	%metaanal(data=sesq1_&group., beta=beta, se_or_var=s, se=SE, studylab=group, loglinear=T,
158        		explabel=sesq1, outcomelabel=ob,
159        		outdat= "RR_socio_sesq1_&group");
160        
161        	/* sesq2 exposure */
162        	data sesq2_&group.; set &data; if Parm = 'sesq2'; run;
163        	%metaanal(data=sesq2_&group., beta=beta, se_or_var=s, se=SE, studylab=group, loglinear=T,
164        		explabel=sesq2, outcomelabel=ob,
165        		outdat= "RR_socio_sesq2_&group");
166        
167        	/* heduc1 exposure */
168        	data heduc1_&group.; set &data; if Parm = 'heduc1'; run;
169        	%metaanal(data=heduc1_&group., beta=beta, se_or_var=s, se=SE, studylab=group, loglinear=T,
170        		explabel=heduc1, outcomelabel=ob,
171        		outdat= "RR_socio_heduc1_&group");
172        
173        	/* heduc2 exposure */
174        	data heduc2_&group.; set &data; if Parm = 'heduc2'; run;
175        	%metaanal(data=heduc2_&group., beta=beta, se_or_var=s, se=SE, studylab=group, loglinear=T,
176        		explabel=heduc2, outcomelabel=ob,
177        		outdat= "RR_socio_heduc2_&group");
178        
179        	/* fincome1 exposure */
180        	data fincome1_&group.; set &data; if Parm = 'fincome1'; run;
181        	%metaanal(data=fincome1_&group., beta=beta, se_or_var=s, se=SE, studylab=group, loglinear=T,
182        		explabel=fincome1, outcomelabel=ob,
183        		outdat= "RR_socio_fincome1_&group");		
184        
185        	/* fincome2 exposure */
186        	data fincome2_&group.; set &data; if Parm = 'fincome2'; run;
187        	%metaanal(data=fincome2_&group., beta=beta, se_or_var=s, se=SE, studylab=group, loglinear=T,
188        		explabel=fincome2, outcomelabel=ob,
189        		outdat= "RR_socio_fincome2_&group");
190        
191        	/* fincome3 exposure */
192        	data fincome3_&group.; set &data; if Parm = 'fincome3'; run;
193        	%metaanal(data=fincome3_&group., beta=beta, se_or_var=s, se=SE, studylab=group, loglinear=T,
194        		explabel=fincome3, outcomelabel=ob,
195        		outdat= "RR_socio_fincome3_&group");
196        
197        
198        %mend metaanal_allexp;
