121        /**********************************************************************
122        CREATE MACRO TO METANALYZE ALL OF THE EXPOSURES FOR EACH GROUP
123        **********************************************************************/
124        
125        
126        /*have to metaanalyze each exposure separately, will create macro that can be used to run through each of the stratification groups
126      ! (sex/age/materinal BMI)*/
127        
128        
129        %macro metaanal_allexp (data=, group=);
130        
131        	/* ses exposure */
132        	data ses_&group.; set &data; if exposure = 'ses'; run;
133        	%metaanal(data=ses_&group., beta=beta, se_or_var=s, se=SE, studylab=group, loglinear=F,
134        		explabel=ses, outcomelabel=ob,
135        			outdat= "PAR_socio_ses_&group");
136        
137        	/* sesq0 exposure */
138        	data sesq0_&group.; set &data; if exposure = 'sesq0'; run;
139        	%metaanal(data=sesq0_&group., beta=beta, se_or_var=s, se=SE, studylab=group, loglinear=F,
140        		explabel=sesq0, outcomelabel=ob,
141        			outdat= "PAR_socio_sesq0_&group");
142        
143        	/* sesq1 exposure */
144        	data sesq1_&group.; set &data; if exposure = 'sesq1'; run;
145        	%metaanal(data=sesq1_&group., beta=beta, se_or_var=s, se=SE, studylab=group, loglinear=F,
146        		explabel=sesq1, outcomelabel=ob,
147        		outdat= "PAR_socio_sesq1_&group");
148        
149        	/* sesq2 exposure */
150        	data sesq2_&group.; set &data; if exposure = 'sesq2'; run;
