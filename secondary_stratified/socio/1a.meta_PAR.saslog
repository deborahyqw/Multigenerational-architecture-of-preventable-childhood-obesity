80         /**SEX************************************/
81         
82         data meta_PAR_sex;
83            set dat_lb.socio_female_PAR dat_lb.socio_male_PAR;
84         	length  HRCI2 $ 18;
85         	HRCI2=.;
86         	SE=StdErr*1;
87             beta=Estimate*1;
88         	keep beta SE group exposure HRCI2;
89         run;

