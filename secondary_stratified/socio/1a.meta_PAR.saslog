133        /**********************************************************************
134        CREATE MACRO TO METANALYZE ALL OF THE EXPOSURES FOR EACH GROUP
135        **********************************************************************/
136        
137        
138        /*have to metaanalyze each exposure separately, will create macro that can be used to run through each of the stratification groups
138      ! (sex/age/materinal BMI)*/
139        
140        
141        %macro metaanal_allexp (data=, group=);
142        
143        	/* ses exposure */
144        	data ses_&group.; set &data; if exposure = 'ses'; run;
145        	%metaanal(data=ses_&group., beta=beta, se_or_var=s, se=SE, studylab=group, loglinear=F,
146        		explabel=ses, outcomelabel=ob,
147        			outdat= "PAR_socio_ses_&group");
148        
149        	/* sesq0 exposure */
150        	data sesq0_&group.; set &data; if exposure = 'sesq0'; run;
151        	%metaanal(data=sesq0_&group., beta=beta, se_or_var=s, se=SE, studylab=group, loglinear=F,
152        		explabel=sesq0, outcomelabel=ob,
153        			outdat= "PAR_socio_sesq0_&group");
154        
155        	/* sesq1 exposure */
156        	data sesq1_&group.; set &data; if exposure = 'sesq1'; run;
157        	%metaanal(data=sesq1_&group., beta=beta, se_or_var=s, se=SE, studylab=group, loglinear=F,
158        		explabel=sesq1, outcomelabel=ob,
159        		outdat= "PAR_socio_sesq1_&group");
160        
161        	/* sesq2 exposure */
162        	data sesq2_&group.; set &data; if exposure = 'sesq2'; run;
163        	%metaanal(data=sesq2_&group., beta=beta, se_or_var=s, se=SE, studylab=group, loglinear=F,
164        		explabel=sesq2, outcomelabel=ob,
