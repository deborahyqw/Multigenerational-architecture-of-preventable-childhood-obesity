92         /**SEX************************************/
93         
94         data meta_PAR_sex;
95            set dat_lb.socio_female_PAR dat_lb.socio_male_PAR;
96         	length  HRCI2 $ 18;
97         	HRCI2=.;
98         	SE=StdErr*1;
99             beta=Estimate*1;
100        	keep beta SE group exposure HRCI2;
101        run;

