245        		when (11) white    = estimate;
246        		when (12) sex     = estimate;
247        		otherwise;
248        	end;
249        		
250        	* Only OUTPUT once per _imputation_, after we've assigned all param columns ;
251        	if last._imputation_ then output;
252        	
