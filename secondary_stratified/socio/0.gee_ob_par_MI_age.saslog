709        	/*************************************************************************************/
710        	/**************** combine using mianalyze ********************************************/
711        
712        
713        	%macro MIPAR(dat1=, dat2=, dat3=, dat4=, dat5=, exposure=);
714        
715        		data temp;
716        			length _Imputation_ 3;
717        			set &dat1(in=a) &dat2(in=b) &dat3(in=c) &dat4(in=d) &dat5(in=e);
718        			if a then _Imputation_=1;
719        				else if b then _Imputation_=2;
720        				else if c then _Imputation_=3;
721        				else if d then _Imputation_=4;
722        				else if e then _Imputation_=5;
723        					
724        			/* approximate standard error from the half-width of the CI */
725        			StdErr = (uclpartialx - lclpartialx) / (2 * 1.96);
726        			Estimate = partlparx;
727        			Parameter = 'PartialPAR';
728        			
729        			keep _Imputation_ Estimate StdErr Parameter;
730        		run;
731        
732        		ods output ParameterEstimates=&exposure._PAR;
733        		proc mianalyze data=temp;
734        			modeleffects Estimate;
735        			stderr StdErr;
736        		run;
737        
738        		data &exposure._PAR;
739        			set &exposure._PAR;
740        			length exposure $ 15;
741        			exposure="&exposure.";
742        		run;
743        			
744        
745        	%mend MIPAR;
