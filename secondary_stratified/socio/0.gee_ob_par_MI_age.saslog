692        	/*************************************************************************************/
693        	/**************** combine using mianalyze ********************************************/
694        
695        
696        	%macro MIPAR(dat1=, dat2=, dat3=, dat4=, dat5=, exposure=);
697        
698        		data temp;
699        			length _Imputation_ 3;
700        			set &dat1(in=a) &dat2(in=b) &dat3(in=c) &dat4(in=d) &dat5(in=e);
701        			if a then _Imputation_=1;
702        				else if b then _Imputation_=2;
703        				else if c then _Imputation_=3;
704        				else if d then _Imputation_=4;
705        				else if e then _Imputation_=5;
706        					
707        			/* approximate standard error from the half-width of the CI */
708        			StdErr = (uclpartialx - lclpartialx) / (2 * 1.96);
709        			Estimate = partlparx;
710        			Parameter = 'PartialPAR';
711        			
712        			keep _Imputation_ Estimate StdErr Parameter;
713        		run;
714        
715        		ods output ParameterEstimates=&exposure._PAR;
716        		proc mianalyze data=temp;
717        			modeleffects Estimate;
718        			stderr StdErr;
719        		run;
720        
721        		data &exposure._PAR;
722        			set &exposure._PAR;
723        			length exposure $ 15;
724        			exposure="&exposure.";
725        		run;
726        			
727        
728        	%mend MIPAR;
729        
