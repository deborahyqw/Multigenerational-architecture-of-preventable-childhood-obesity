230        		if first._imputation_ then i=1;
231        		else i+1;
232        
233        		/*MANUAL SPECIFICATION OF VARIABLES*/
234        		select (i);
235        		when (1) intercept = estimate;
236        		when (2) heduc1   = estimate;
237        		when (3) heduc2   = estimate;
238        		when (4) fincome1   = estimate;
