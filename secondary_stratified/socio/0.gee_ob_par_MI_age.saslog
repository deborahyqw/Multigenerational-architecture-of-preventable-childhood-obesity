649        		%local i;
650        		%do i=1 %to 5;
651        	%par(
652        		bdata=&prefixBeta.&i,
653        		pdata=&prefixFreq.&i,
654        		n_or_p=N,
655        		n_or_pname=FQ,
656        		modvar= &modmod  ,
657        		missvarlist=NONE,
