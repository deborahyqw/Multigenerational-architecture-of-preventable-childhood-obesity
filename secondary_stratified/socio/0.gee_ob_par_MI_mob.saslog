134        
135        	title "HEADER: education & income for &group";
136        	proc genmod data = &data. descending;
137        		by _imputation_ ;
138        		class id momid ;
139        	model chob = heduc1 heduc2 fincome1 fincome2 fincome3
140        					&covar1
141        		/ dist = Poisson link = log;
142        		repeated subject=id(momid)/type=unstr PRINTMLE ecovb;
143        		ods output GEERCov=covsoc GEEEmpPEst = soc;
144        	run;
145        	title "";
146        
147        	proc genmod data = &data. descending;
