693        	/*************************************************************************************/
694        	/**************** combine using mianalyze ********************************************/
695        
696        
697        	%macro MIPAR(dat1=, dat2=, dat3=, dat4=, dat5=, exposure=);
698        
699        		data temp;
700        			length _Imputation_ 3;
701        			set &dat1(in=a) &dat2(in=b) &dat3(in=c) &dat4(in=d) &dat5(in=e);
702        			if a then _Imputation_=1;
703        				else if b then _Imputation_=2;
704        				else if c then _Imputation_=3;
705        				else if d then _Imputation_=4;
706        				else if e then _Imputation_=5;
707        					
708        			/* approximate standard error from the half-width of the CI */
709        			StdErr = (uclpartialx - lclpartialx) / (2 * 1.96);
710        			Estimate = partlparx;
711        			Parameter = 'PartialPAR';
712        			
713        			keep _Imputation_ Estimate StdErr Parameter;
714        		run;
715        
716        		ods output ParameterEstimates=&exposure._PAR;
717        		proc mianalyze data=temp;
718        			modeleffects Estimate;
719        			stderr StdErr;
720        		run;
721        
722        		data &exposure._PAR;
723        			set &exposure._PAR;
724        			length exposure $ 15;
725        			exposure="&exposure.";
726        		run;
727        			
728        
729        	%mend MIPAR;
