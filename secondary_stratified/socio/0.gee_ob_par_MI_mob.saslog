152        
153        	title "HEADER: education & income for &group";
154        	proc genmod data = &data. descending;
155        		by _imputation_ ;
156        		class id momid ;
157        	model chob = heduc1 heduc2 fincome1 fincome2 fincome3
158        					&covar1
159        		/ dist = Poisson link = log;
160        		repeated subject=id(momid)/type=unstr PRINTMLE ecovb;
161        		ods output GEERCov=covsoc GEEEmpPEst = soc;
162        	run;
163        	title "";
164        
165        	proc genmod data = &data. descending;
166        		by _imputation_ ;
167        		class id momid ;
168        	model chob = husbeduc income
169        					&covar1
170        		/ dist = Poisson link = log;
171        		repeated subject=id(momid)/type=unstr PRINTMLE ecovb;
172        		ods output GEEEmpPEst =soc_t;
173        	run;
174        
