711        	/*************************************************************************************/
712        	/**************** combine using mianalyze ********************************************/
713        
714        
715        	%macro MIPAR(dat1=, dat2=, dat3=, dat4=, dat5=, exposure=);
716        
717        		data temp;
718        			length _Imputation_ 3;
719        			set &dat1(in=a) &dat2(in=b) &dat3(in=c) &dat4(in=d) &dat5(in=e);
720        			if a then _Imputation_=1;
721        				else if b then _Imputation_=2;
722        				else if c then _Imputation_=3;
723        				else if d then _Imputation_=4;
724        				else if e then _Imputation_=5;
725        					
726        			/* approximate standard error from the half-width of the CI */
727        			StdErr = (uclpartialx - lclpartialx) / (2 * 1.96);
728        			Estimate = partlparx;
729        			Parameter = 'PartialPAR';
730        			
731        			keep _Imputation_ Estimate StdErr Parameter;
732        		run;
733        
734        		ods output ParameterEstimates=&exposure._PAR;
735        		proc mianalyze data=temp;
736        			modeleffects Estimate;
737        			stderr StdErr;
738        		run;
739        
740        		data &exposure._PAR;
741        			set &exposure._PAR;
742        			length exposure $ 15;
743        			exposure="&exposure.";
744        		run;
745        			
746        
747        	%mend MIPAR;
