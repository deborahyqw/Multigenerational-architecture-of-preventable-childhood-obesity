667        	%macro runPAR(prefixBeta=, prefixFreq=, outpref=, modmod=, fixfix=);
668        		%local i;
669        		%do i=1 %to 5;
670        	%par(
671        		bdata=&prefixBeta.&i,
672        		pdata=&prefixFreq.&i,
673        		n_or_p=N,
674        		n_or_pname=FQ,
675        		modvar= &modmod  ,
676        		missvarlist=NONE,
677        		partialpar= T,
678        		outdat= &outpref.&i,
679        		fixedvar= &fixfix );
680        		%end;
681        	%mend runPAR;
