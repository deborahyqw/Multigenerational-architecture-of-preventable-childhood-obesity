556        	/*MANUAL SPECIFICATION OF PARAMETERS*/
557        	data covparms;
558        		set covnses;
559        		by _imputation_;
560        		length _type_ $4;
561        		_type_ = 'COV';
562        
563        		rename  Prm1=intercept   Prm2=heduc1    Prm3=heduc2
564        				Prm4=fincome1    Prm5=fincome2     Prm6=fincome3
565        				Prm7=midwest     Prm8=south     Prm9=west
566        				Prm10=cohort     Prm11=chage     Prm12=white     Prm13=sex
567        				Prm14=sesq0      Prm15=sesq1     Prm16=sesq2;
568        
569        		length _name_ $10;
570        		
571        		*i counts rows within each _imputation_;
572        		if first._imputation_ then i=1;
573        			else i+1;
574        
575        		* Assign which row this is (the row "label" in the covariance matrix) ;
576        		select(i);
577        			when(1)  _name_ = 'INTERCEPT';
578        			when(2)  _name_ = 'heduc1';
579        			when(3)  _name_ = 'heduc2';
580        			when(4)  _name_ = 'fincome1';
581        			when(5)  _name_ = 'fincome2';
582        			when(6)  _name_ = 'fincome3';
583        			when(7)  _name_ = 'midwest';
584        			when(8)  _name_ = 'south';
585        			when(9)  _name_ = 'west';
586        			when(10)  _name_ = 'cohort';
587        			when(11)  _name_ = 'chage';
588        			when(12)  _name_ = 'white';
589        			when(13)  _name_ = 'sex';
590        			when(14)  _name_ = 'sesq0';
591        			when(15)  _name_ = 'sesq1';
592        			when(16)  _name_ = 'sesq2';
593        			otherwise;
594        		end;
595        		
596        		* Output EVERY row;
597        		output;
598        
599        		keep _imputation_ _type_ _name_ prm1-prm16 ; /*MANUAL SPECIFICATION OF PARAMETER RANGE*/
600        	run;
