555        	/*MANUAL SPECIFICATION OF PARAMETERS*/
556        	data covparms;
557        		set covnses;
558        		by _imputation_;
559        		length _type_ $4;
560        		_type_ = 'COV';
561        
562        		rename  Prm1=intercept   Prm2=heduc1    Prm3=heduc2
563        				Prm4=fincome1    Prm5=fincome2     Prm6=fincome3
564        				Prm7=midwest     Prm8=south     Prm9=west
565        				Prm10=cohort     Prm11=chage     Prm12=white
566        				Prm13=sesq0      Prm14=sesq1     Prm15=sesq2;
567        
568        		length _name_ $10;
569        		
570        		*i counts rows within each _imputation_;
571        		if first._imputation_ then i=1;
572        			else i+1;
573        
574        		* Assign which row this is (the row "label" in the covariance matrix) ;
575        		select(i);
576        			when(1)  _name_ = 'INTERCEPT';
577        			when(2)  _name_ = 'heduc1';
578        			when(3)  _name_ = 'heduc2';
579        			when(4)  _name_ = 'fincome1';
580        			when(5)  _name_ = 'fincome2';
581        			when(6)  _name_ = 'fincome3';
582        			when(7)  _name_ = 'midwest';
583        			when(8)  _name_ = 'south';
584        			when(9)  _name_ = 'west';
585        			when(10)  _name_ = 'cohort';
586        			when(11)  _name_ = 'chage';
587        			when(12)  _name_ = 'white';
588        			when(13)  _name_ = 'sesq0';
589        			when(14)  _name_ = 'sesq1';
590        			when(15)  _name_ = 'sesq2';
591        			otherwise;
592        		end;
593        		
594        		* Output EVERY row;
595        		output;
596        
597        		keep _imputation_ _type_ _name_ prm1-prm15 ; /*MANUAL SPECIFICATION OF PARAMETER RANGE*/
598        	run;
