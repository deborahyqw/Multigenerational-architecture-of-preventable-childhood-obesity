690        	/**************** combine using mianalyze ********************************************/
691        
692        
693        	%macro MIPAR(dat1=, dat2=, dat3=, dat4=, dat5=, exposure=);
694        
695        		data temp;
696        			length _Imputation_ 3;
697        			set &dat1(in=a) &dat2(in=b) &dat3(in=c) &dat4(in=d) &dat5(in=e);
698        			if a then _Imputation_=1;
699        				else if b then _Imputation_=2;
700        				else if c then _Imputation_=3;
701        				else if d then _Imputation_=4;
702        				else if e then _Imputation_=5;
703        					
704        			/* approximate standard error from the half-width of the CI */
705        			StdErr = (uclpartialx - lclpartialx) / (2 * 1.96);
706        			Estimate = partlparx;
707        			Parameter = 'PartialPAR';
708        			
709        			keep _Imputation_ Estimate StdErr Parameter;
710        		run;
711        
712        		ods output ParameterEstimates=&exposure._PAR;
713        		proc mianalyze data=temp;
714        			modeleffects Estimate;
715        			stderr StdErr;
716        		run;
717        
718        		data &exposure._PAR;
719        			set &exposure._PAR;
720        			length exposure $ 15;
721        			exposure="&exposure.";
722        		run;
723        			
724        
725        	%mend MIPAR;
