665        	%macro runPAR(prefixBeta=, prefixFreq=, outpref=, modmod=, fixfix=);
666        		%local i;
667        		%do i=1 %to 5;
668        	%par(
669        		bdata=&prefixBeta.&i,
670        		pdata=&prefixFreq.&i,
671        		n_or_p=N,
672        		n_or_pname=FQ,
673        		modvar= &modmod  ,
674        		missvarlist=NONE,
675        		partialpar= T,
676        		outdat= &outpref.&i,
677        		fixedvar= &fixfix );
678        		%end;
679        	%mend runPAR;
