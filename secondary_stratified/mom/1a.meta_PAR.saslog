121        /**********************************************************************
122        CREATE MACRO TO METANALYZE ALL OF THE EXPOSURES FOR EACH GROUP
123        **********************************************************************/
124        
125        
126        /*have to metaanalyze each exposure separately, will create macro that can be used to run through each of the stratification groups
126      ! (sex/age/materinal BMI)*/
127        
128        
129        %macro metaanal_allexp (data=, group=);
130        
131        	/* mowest exposure */
132        	data mowest_&group.; set &data; if exposure = 'mowest'; run;
133        	%metaanal(data=mowest_&group., beta=beta, se_or_var=s, se=SE, studylab=group, loglinear=F,
134        		explabel=mowest, outcomelabel=ob,
135        			outdat= "PAR_mom_mowest_&group");
136        
137        	/* mowestq1 exposure */
138        	data mowestq1_&group.; set &data; if exposure = 'mowestq1'; run;
