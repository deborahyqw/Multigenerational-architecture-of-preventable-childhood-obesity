140        		explabel=mowestq1, outcomelabel=ob,
141        			outdat= "PAR_mom_mowestq1_&group");
142        
143        	/* mowestq2 exposure */
144        	data mowestq2_&group.; set &data; if exposure = 'mowestq2'; run;
