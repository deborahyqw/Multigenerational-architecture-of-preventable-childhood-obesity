134        /**********************************************************************
135        CREATE MACRO TO METANALYZE ALL OF THE EXPOSURES FOR EACH GROUP
136        **********************************************************************/
137        
138        
139        /*have to metaanalyze each exposure separately, will create macro that can be used to run through each of the stratification groups
139      ! (sex/age/materinal BMI)*/
140        
141        
142        %macro metaanal_allexp (data=, group=);
143        
144        	/* mowest exposure */
145        	data mowest_&group.; set &data; if exposure = 'mowest'; run;
146        	%metaanal(data=mowest_&group., beta=beta, se_or_var=s, se=SE, studylab=group, loglinear=F,
147        		explabel=mowest, outcomelabel=ob,
148        			outdat= "PAR_mom_mowest_&group");
149        
150        	/* mowestq1 exposure */
151        	data mowestq1_&group.; set &data; if exposure = 'mowestq1'; run;
152        	%metaanal(data=mowestq1_&group., beta=beta, se_or_var=s, se=SE, studylab=group, loglinear=F,
153        		explabel=mowestq1, outcomelabel=ob,
154        			outdat= "PAR_mom_mowestq1_&group");
155        
156        	/* mowestq2 exposure */
157        	data mowestq2_&group.; set &data; if exposure = 'mowestq2'; run;
