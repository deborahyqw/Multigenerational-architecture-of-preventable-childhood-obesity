773        	/*************************************************************************************/
774        	/**************** combine using mianalyze ********************************************/
775        
776        	%macro MIPAR(dat1=, dat2=, dat3=, dat4=, dat5=, exposure=);
777        
778        		data temp;
779        			length _Imputation_ 3;
780        			set &dat1(in=a) &dat2(in=b) &dat3(in=c) &dat4(in=d) &dat5(in=e);
781        			if a then _Imputation_=1;
782        				else if b then _Imputation_=2;
783        				else if c then _Imputation_=3;
784        				else if d then _Imputation_=4;
785        				else if e then _Imputation_=5;
786        					
787        			/* approximate standard error from the half-width of the CI */
788        			StdErr = (uclpartialx - lclpartialx) / (2 * 1.96);
789        			Estimate = partlparx;
790        			Parameter = 'PartialPAR';
791        			
792        			keep _Imputation_ Estimate StdErr Parameter;
793        		run;
794        
795        		ods output ParameterEstimates=&exposure._PAR;
796        		proc mianalyze data=temp;
797        			modeleffects Estimate;
798        			stderr StdErr;
799        		run;
800        
801        		data &exposure._PAR;
802        			set &exposure._PAR;
803        			length exposure $ 15;
804        			exposure="&exposure.";
805        		run;
806        			
807        
808        	%mend MIPAR;
