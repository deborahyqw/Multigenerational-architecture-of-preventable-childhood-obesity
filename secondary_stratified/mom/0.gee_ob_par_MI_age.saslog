645        	/*MANUAL SPECIFICATION OF PARAMETERS*/
646        	data covparms;
647        		set covmom;
648        		by _imputation_;
649        		length _type_ $4;
650        		_type_ = 'COV';
651        
652        		rename  Prm1=intercept   Prm2=mowestq1   Prm3=mowestq2   Prm4=mowestq3   Prm5=mocalq1
653        				Prm6=mocalq2     Prm7=mocalq3
654        				Prm8=mopaq0      Prm9=mopaq1     Prm10=mopaq2    Prm11=mosmk2  Prm12=mosmk3
655        				Prm13=moshiftq1  Prm14=moshiftq2  Prm15=moshiftq3 Prm16=moage
656        				Prm17=cohort     Prm18=white     Prm19=sex   Prm20=moob ;
657        
658        		length _name_ $10;
659        		
660        		*i counts rows within each _imputation_;
661        		if first._imputation_ then i=1;
662        			else i+1;
663        
664        		* Assign which row this is (the row "label" in the covariance matrix) ;
665        		select(i);
666        			when(1)  _name_ = 'INTERCEPT';
667        			when(2)  _name_ = 'mowestq1';
668        			when(3)  _name_ = 'mowestq2';
669        			when(4)  _name_ = 'mowestq3';
670        			when(5)  _name_ = 'mocalq1';
671        			when(6)  _name_ = 'mocalq2';
672        			when(7)  _name_ = 'mocalq3';
673        			when(8)  _name_ = 'mopaq0';
674        			when(9)  _name_ = 'mopaq1';
675        			when(10)  _name_ = 'mopaq2';
676        			when(11)  _name_ = 'mosmk2';
677        			when(12)  _name_ = 'mosmk3';
678        			when(13)  _name_ = 'moshiftq1';
679        			when(14)  _name_ = 'moshiftq2';
680        			when(15)  _name_ = 'moshiftq3';
681        			when(16)  _name_ = 'moage';
682        			when(17)  _name_ = 'cohort';
683        			when(18)  _name_ = 'white';
684        			when(19)  _name_ = 'sex';
685        			when(20)  _name_ = 'moob';
686        			otherwise;
687        		end;
