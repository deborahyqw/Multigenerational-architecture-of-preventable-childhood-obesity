756        	/**************** combine using mianalyze ********************************************/
757        
758        	%macro MIPAR(dat1=, dat2=, dat3=, dat4=, dat5=, exposure=);
759        
760        		data temp;
761        			length _Imputation_ 3;
762        			set &dat1(in=a) &dat2(in=b) &dat3(in=c) &dat4(in=d) &dat5(in=e);
763        			if a then _Imputation_=1;
764        				else if b then _Imputation_=2;
765        				else if c then _Imputation_=3;
766        				else if d then _Imputation_=4;
767        				else if e then _Imputation_=5;
768        					
769        			/* approximate standard error from the half-width of the CI */
770        			StdErr = (uclpartialx - lclpartialx) / (2 * 1.96);
771        			Estimate = partlparx;
772        			Parameter = 'PartialPAR';
773        			
774        			keep _Imputation_ Estimate StdErr Parameter;
775        		run;
776        
777        		ods output ParameterEstimates=&exposure._PAR;
778        		proc mianalyze data=temp;
779        			modeleffects Estimate;
780        			stderr StdErr;
781        		run;
782        
783        		data &exposure._PAR;
784        			set &exposure._PAR;
785        			length exposure $ 15;
786        			exposure="&exposure.";
787        		run;
788        			
789        
790        	%mend MIPAR;
