145        	RUN THE RR, WITH METANALYSIS BY IMPUTATION
146        	**********************************************************************/
147        
148        	title "HEADER: maternal modifiable factors, &group.";
149        	proc genmod data = &data descending;
150        		by _imputation_ ;
151        	class id momid ;
152        	model chob = &mowestq_ &mocalq_ &mopaq_ mosmk2 mosmk3 &moshiftq_
153        					&covar1
154        		/ dist = Poisson link = log;
155        		repeated subject=id(momid)/type=unstr PRINTMLE ecovb;
156        		ods output GEERCov=covmom GEEEmpPEst = mom;
157        	run;
158        	title "";
159        
160        	proc genmod data = &data descending;
161        		by _imputation_ ;
162        	class id momid ;
163        	model chob = mowest_m mocal_m mopa_m mosmk2 mosmk3
164        					moshift_m
165        					moage &covar1
166        		/ dist = Poisson link = log;
167        		repeated subject=id(momid)/type=unstr PRINTMLE ecovb;
168        		ods output GEEEmpPEst =mom_t;
169        	run;
170        	
171        
172        	TITLE "HEADER: multiple imputation - maternal modifiable factors - no moob, &group";
173        	ods output ParameterEstimates=mi_mom;
