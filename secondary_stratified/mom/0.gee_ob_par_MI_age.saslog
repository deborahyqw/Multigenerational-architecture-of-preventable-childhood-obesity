404        	%macro runPAR(prefixBeta=, prefixFreq=, outpref=, modmod=, fixfix=);
405        		%local i;
406        		%do i=1 %to 5;
407        		%par(
408        			bdata=&prefixBeta.&i,
409        			pdata=&prefixFreq.&i,
410        			n_or_p=N,
411        			n_or_pname=FQ,
412        			modvar= &modmod  ,
413        			missvarlist=NONE,
414        			partialpar= T,
415        			outdat= &outpref.&i,
416        			fixedvar= &fixfix );
417        			%end;
418        	%mend runPAR;
