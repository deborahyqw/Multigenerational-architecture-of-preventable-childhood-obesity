162        	/**********************************************************************
163        	RUN THE RR, WITH METANALYSIS BY IMPUTATION
164        	**********************************************************************/
165        
166        	title "HEADER: maternal modifiable factors, &group.";
167        	proc genmod data = &data descending;
168        		by _imputation_ ;
169        	class id momid ;
170        	model chob = &mowestq_ &mocalq_ &mopaq_ mosmk2 mosmk3 &moshiftq_
171        					&covar1
172        		/ dist = Poisson link = log;
173        		repeated subject=id(momid)/type=unstr PRINTMLE ecovb;
174        		ods output GEERCov=covmom GEEEmpPEst = mom;
175        	run;
176        	title "";
177        
178        	proc genmod data = &data descending;
179        		by _imputation_ ;
180        	class id momid ;
181        	model chob = mowest_m mocal_m mopa_m mosmk2 mosmk3
4                                                                   The SAS System                                     12:07 Monday, November 17, 2025

182        					moshift_m
183        					moage &covar1
184        		/ dist = Poisson link = log;
185        		repeated subject=id(momid)/type=unstr PRINTMLE ecovb;
186        		ods output GEEEmpPEst =mom_t;
187        	run;
