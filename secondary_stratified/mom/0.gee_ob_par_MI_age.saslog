516        	title "maternal modifiable factors - moob, &group.";
517        	proc genmod data = &data descending;
518        		by _imputation_ ;
519        	class id momid ;
520        	model chob = &mowestq_ &mocalq_ &mopaq_ mosmk2 mosmk3 &moshiftq_
521        					&covar1 moob
522        		/ dist = Poisson link = log;
523        		repeated subject=id(momid)/type=unstr PRINTMLE ecovb;
524        		ods output GEERCov=covmom GEEEmpPEst = mom;
525        	run;
526        	title "";
