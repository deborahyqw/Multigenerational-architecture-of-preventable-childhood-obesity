530        
531        	/*************************************************************************************/
532        	/**************** combine using mianalyze ********************************************/
533        
534        	%macro MIPAR(dat1=, dat2=, dat3=, dat4=, dat5=, exposure=);
535        
536        		data temp;
537        			length _Imputation_ 3;
538        			set &dat1(in=a) &dat2(in=b) &dat3(in=c) &dat4(in=d) &dat5(in=e);
539        			if a then _Imputation_=1;
540        				else if b then _Imputation_=2;
541        				else if c then _Imputation_=3;
542        				else if d then _Imputation_=4;
543        				else if e then _Imputation_=5;
544        					
545        			/* approximate standard error from the half-width of the CI */
546        			StdErr = (uclpartialx - lclpartialx) / (2 * 1.96);
547        			Estimate = partlparx;
548        			Parameter = 'PartialPAR';
549        			
550        			keep _Imputation_ Estimate StdErr Parameter;
551        		run;
552        
553        		ods output ParameterEstimates=&exposure._PAR;
554        		proc mianalyze data=temp;
555        			modeleffects Estimate;
556        			stderr StdErr;
557        		run;
558        
559        		data &exposure._PAR;
560        			set &exposure._PAR;
561        			length exposure $ 15;
562        			exposure="&exposure.";
563        		run;
564        			
565        
566        	%mend MIPAR;
567        
568        	%MIPAR(dat1=mwest1,     dat2=mwest2,    dat3=mwest3,    dat4=mwest4,    dat5=mwest5,    exposure=mowest);
