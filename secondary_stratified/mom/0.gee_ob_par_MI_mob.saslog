298        	/*MANUALLY SPECIFICATION OF PARAMS*/
299        	data covparms;
300        		set covmom;
301        		by _imputation_;
302        		length _type_ $4;
303        		_type_ = 'COV';
304        
305        		rename  Prm1=intercept   Prm2=mowestq1   Prm3=mowestq2   Prm4=mowestq3   Prm5=mocalq1
306        				Prm6=mocalq2     Prm7=mocalq3
307        				Prm8=mopaq0     Prm9=mopaq1    Prm10=mopaq2    Prm11=mosmk2   Prm12=mosmk3
308        				Prm13=moshiftq1  Prm14=moshiftq2  Prm15=moshiftq3   Prm16=moage
309        				Prm17=cohort     Prm18=chage      Prm19=white       Prm20=sex   ;
310        
311        		length _name_ $10;
312        		
313        		*i counts rows within each _imputation_;
314        		if first._imputation_ then i=1;
315        			else i+1;
316        
317        		* Assign which row this is (the row "label" in the covariance matrix) ;
318        		select(i);
319        			when(1)  _name_ = 'INTERCEPT';
320        			when(2)  _name_ = 'mowestq1';
321        			when(3)  _name_ = 'mowestq2';
322        			when(4)  _name_ = 'mowestq3';
323        			when(5)  _name_ = 'mocalq1';
324        			when(6)  _name_ = 'mocalq2';
325        			when(7)  _name_ = 'mocalq3';
326        			when(8)  _name_ = 'mopaq0';
327        			when(9)  _name_ = 'mopaq1';
328        			when(10)  _name_ = 'mopaq2';
329        			when(11)  _name_ = 'mosmk2';
330        			when(12)  _name_ = 'mosmk3';
331        			when(13)  _name_ = 'moshiftq1';
332        			when(14)  _name_ = 'moshiftq2';
333        			when(15)  _name_ = 'moshiftq3';
334        			when(16)  _name_ = 'moage';
335        			when(17)  _name_ = 'cohort';
336        			when(18)  _name_ = 'chage';
337        			when(19)  _name_ = 'white';
338        			when(20)  _name_ = 'sex';
339        			otherwise;
340        		end;
341        		
342        		* Output EVERY row;
343        		output;
344        
