148        /**********************************************************************
149        	CREATE MACRO TO RUN OVER THE STRATIFIED DATASETS
150        **********************************************************************/
151        
152        
153        %macro ob_par_MI_strat (data=, group=);
154        
155        
156        	/**********************************************************************
157        	RUN THE RR, WITH METANALYSIS BY IMPUTATION
158        	**********************************************************************/
159        
160        	title "HEADER: maternal modifiable factors for &group.";
161        	proc genmod data = &data descending;
162        		by _imputation_ ;
163        	class id momid ;
164        	model chob = &mowestq_ &mocalq_ &mopaq_ mosmk2 mosmk3 &moshiftq_
165        					&covar1
166        		/ dist = Poisson link = log;
167        		repeated subject=id(momid)/type=unstr PRINTMLE ecovb;
168        		ods output GEERCov=covmom GEEEmpPEst = mom;
169        	run;
170        	title "";
171        
172        	proc genmod data = &data descending;
173        		by _imputation_ ;
174        	class id momid ;
175        	model chob = mowest_m mocal_m mopa_m mosmk2 mosmk3
176        					moshift_m
177        					moage &covar1
178        		/ dist = Poisson link = log;
179        		repeated subject=id(momid)/type=unstr PRINTMLE ecovb;
180        		ods output GEEEmpPEst =mom_t;
181        	run;
182        	
183        
184        	TITLE "HEADER: multiple imputation - maternal modifiable factors for &group";
185        	ods output ParameterEstimates=mi_mom;
186        	PROC MIANALYZE parms=mom;
187        	MODELEFFECTS INTERCEPT mowestq1 mowestq2 mowestq3 mocalq1 mocalq2 mocalq3
188        			mopaq0 mopaq1 mopaq2 mosmk2 mosmk3
4                                                                   The SAS System                                    13:15 Tuesday, November 18, 2025

189        			moshiftq1 moshiftq2 moshiftq3
190        			&covar1  ;
191        	RUN;
192        	title "";
193        
194        	/*
195        	ods output ParameterEstimates=mi_momt;
196        	PROC MIANALYZE parms=mom_t;
197        	MODELEFFECTS INTERCEPT mowest_m mocal_m mopa_m mosmk2 mosmk3
198        			moshift_m
199        			&covar1  ;
200        	RUN;
201        	*/
202        
203        
204        
205        	/*MANUAL SPECIFICATION OF DATASET NAME AND GROUP*/
206        	data dat_lb.mom_&group._RR;
207        		length Parm $ 15;
208        		length mod $ 40;
209        		length group $ 40;
210        
211        		set mi_mom(in=a) /*mi_momt(in=b)*/ ;
212        		
213        		if a then mod="mom";
214        		/*if b then mod="mom trend";*/
215        		if Parm in ("mowestq1", "mowestq2", "mowestq3", "mocalq1", "mocalq2", "mocalq3"
216        						"mopaq0", "mopaq1", "mopaq2", "mosmk2" "mosmk3" "moshiftq1" "moshiftq2" "moshiftq3"); *only keep main exposures when exporting;
217        
218        		group="&group.";
219        
220        		RR=exp(Estimate); LCI=exp(LCLMean); UCI=exp(UCLMean);
221        	run;
222        
223        	title "HEADER: proc print for the first regression analysis for &group";
224        	proc print data=dat_lb.mom_&group._RR; run;
225        	title "";
226        
227        	/**********************************************************************
228        	PREPARE DATA FOR PAR
229        	**********************************************************************/
230        	title "HEADER: proc print for mom for &group";
231        	proc print data=mom; run;
232        	title "";
233        
234        
235        	/*MANUAL SPECIFICATION OF VARIABLES*/
236        	data betas;
237        	set mom ;
238        	by _imputation_;
239        	_type_ = 'PARM';
240        		retain intercept mowestq1 mowestq2 mowestq3 mocalq1 mocalq2 mocalq3
241        						mopaq0 mopaq1 mopaq2 mosmk2 mosmk3
242        						moshiftq1 moshiftq2 moshiftq3
243        						&covar1;
244        		
245        		* 'i' counts rows within each _imputation_ group ;
246        		if first._imputation_ then i=1;
247        		else i+1;
248        		
249        		select (i);
250        		when (1) intercept = estimate;
251        		when (2) mowestq1  = estimate;
252        		when (3) mowestq2  = estimate;
253        		when (4) mowestq3  = estimate;
254        		when (5) mocalq1   = estimate;
255        		when (6) mocalq2   = estimate;
256        		when (7) mocalq3   = estimate;
257        		when (8) mopaq0   = estimate;
258        		when (9) mopaq1   = estimate;
259        		when (10) mopaq2   = estimate;
260        		when (11) mosmk2  = estimate;
261        		when (12) mosmk3  = estimate;
262        		when (13) moshiftq1= estimate;
263        		when (14) moshiftq2= estimate;
264        		when (15) moshiftq3= estimate;
265        		when (16) moage    = estimate;
266        		when (17) cohort   = estimate;
267        		when (18) chage    = estimate;
268        		when (19) white    = estimate;
269        		when (20) sex      = estimate;
270        		otherwise;
271        	end;
272        		
273        	/*Only OUTPUT once per _imputation_, after we've assigned all param columns*/
274        	if last._imputation_ then output;
275        
276        		/*set negative beta to 0 to avoid errors in PAR, only main exposures*/
277        
278        		if mowestq1 <0 then mowestq1=0;
279        		if mowestq2 <0 then mowestq2=0;
280        		if mowestq3 <0 then mowestq3=0;
281        		if mocalq1 <0 then mocalq1=0;
282        		if mocalq2 <0 then mocalq2=0;
283        		if mocalq3 <0 then mocalq3=0;
284        		if mopaq0 <0 then mopaq0=0;
285        		if mopaq1 <0 then mopaq1=0;
286        		if mopaq2 <0 then mopaq2=0;
287        		if moshiftq1 <0 then moshiftq1=0;
288        		if mosmk2 <0 then mosmk2=0;
289        		if mosmk3 <0 then mosmk3=0;
290        		if moshiftq2 <0 then moshiftq2=0;
291        		if moshiftq3 <0 then moshiftq3=0;
292        	run;
293        
294        	title "HEADER: proc print for first betas for &group";
295        	proc print data=betas;
296        	title "";
