216        
217        	/*MANUAL SPECIFICATION OF VARIABLES*/
218        	data betas;
219        	set mom ;
220        	by _imputation_;
221        	_type_ = 'PARM';
222        		retain intercept mowestq1 mowestq2 mowestq3 mocalq1 mocalq2 mocalq3
223        						mopaq0 mopaq1 mopaq2 mosmk2 mosmk3
224        						moshiftq1 moshiftq2 moshiftq3
225        						&covar1;
226        		
227        		* 'i' counts rows within each _imputation_ group ;
228        		if first._imputation_ then i=1;
229        		else i+1;
230        		
231        		select (i);
232        		when (1) intercept = estimate;
233        		when (2) mowestq1  = estimate;
234        		when (3) mowestq2  = estimate;
235        		when (4) mowestq3  = estimate;
236        		when (5) mocalq1   = estimate;
237        		when (6) mocalq2   = estimate;
238        		when (7) mocalq3   = estimate;
239        		when (8) mopaq0   = estimate;
240        		when (9) mopaq1   = estimate;
241        		when (10) mopaq2   = estimate;
242        		when (11) mosmk2  = estimate;
243        		when (12) mosmk3  = estimate;
244        		when (13) moshiftq1= estimate;
245        		when (14) moshiftq2= estimate;
246        		when (15) moshiftq3= estimate;
247        		when (16) moage    = estimate;
248        		when (17) cohort   = estimate;
249        		when (18) chage    = estimate;
250        		when (19) white    = estimate;
251        		when (20) sex      = estimate;
252        		otherwise;
253        	end;
254        		
255        	/*Only OUTPUT once per _imputation_, after we've assigned all param columns*/
256        	if last._imputation_ then output;
257        
258        		/*set negative beta to 0 to avoid errors in PAR, only main exposures*/
259        
260        		if mowestq1 <0 then mowestq1=0;
261        		if mowestq2 <0 then mowestq2=0;
262        		if mowestq3 <0 then mowestq3=0;
263        		if mocalq1 <0 then mocalq1=0;
264        		if mocalq2 <0 then mocalq2=0;
265        		if mocalq3 <0 then mocalq3=0;
266        		if mopaq0 <0 then mopaq0=0;
267        		if mopaq1 <0 then mopaq1=0;
268        		if mopaq2 <0 then mopaq2=0;
269        		if moshiftq1 <0 then moshiftq1=0;
270        		if mosmk2 <0 then mosmk2=0;
271        		if mosmk3 <0 then mosmk3=0;
272        		if moshiftq2 <0 then moshiftq2=0;
273        		if moshiftq3 <0 then moshiftq3=0;
274        	run;
