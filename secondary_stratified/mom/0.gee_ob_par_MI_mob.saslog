513        	/*************************************************************************************/
514        	/**************** combine using mianalyze ********************************************/
515        
516        	%macro MIPAR(dat1=, dat2=, dat3=, dat4=, dat5=, exposure=);
517        
518        		data temp;
519        			length _Imputation_ 3;
520        			set &dat1(in=a) &dat2(in=b) &dat3(in=c) &dat4(in=d) &dat5(in=e);
521        			if a then _Imputation_=1;
522        				else if b then _Imputation_=2;
523        				else if c then _Imputation_=3;
524        				else if d then _Imputation_=4;
525        				else if e then _Imputation_=5;
526        					
527        			/* approximate standard error from the half-width of the CI */
528        			StdErr = (uclpartialx - lclpartialx) / (2 * 1.96);
529        			Estimate = partlparx;
530        			Parameter = 'PartialPAR';
531        			
532        			keep _Imputation_ Estimate StdErr Parameter;
533        		run;
534        
535        		ods output ParameterEstimates=&exposure._PAR;
536        		proc mianalyze data=temp;
537        			modeleffects Estimate;
538        			stderr StdErr;
539        		run;
540        
541        		data &exposure._PAR;
542        			set &exposure._PAR;
543        			length exposure $ 15;
544        			exposure="&exposure.";
545        		run;
546        			
547        
548        	%mend MIPAR;
549        
550        	%MIPAR(dat1=mwest1,     dat2=mwest2,    dat3=mwest3,    dat4=mwest4,    dat5=mwest5,    exposure=mowest);
551        	%MIPAR(dat1=mwestq11,   dat2=mwestq12,  dat3=mwestq13,  dat4=mwestq14,  dat5=mwestq15,  exposure=mowestq1);
552        	%MIPAR(dat1=mwestq21,   dat2=mwestq22,  dat3=mwestq23,  dat4=mwestq24,  dat5=mwestq25,  exposure=mowestq2);
553        	%MIPAR(dat1=mwestq31,   dat2=mwestq32,  dat3=mwestq33,  dat4=mwestq34,  dat5=mwestq35,  exposure=mowestq3);
554        	%MIPAR(dat1=mpa1,       dat2=mpa2,      dat3=mpa3,      dat4=mpa4,      dat5=mpa5,      exposure=mopa);
555        	%MIPAR(dat1=mpaq01,     dat2=mpaq02,    dat3=mpaq03,    dat4=mpaq04,    dat5=mpaq05,    exposure=mopaq0);
556        	%MIPAR(dat1=mpaq11,     dat2=mpaq12,    dat3=mpaq13,    dat4=mpaq14,    dat5=mpaq15,    exposure=mopaq1);
557        	%MIPAR(dat1=mpaq21,     dat2=mpaq22,    dat3=mpaq23,    dat4=mpaq24,    dat5=mpaq25,    exposure=mopaq2);
558        	%MIPAR(dat1=msmk1,      dat2=msmk2,     dat3=msmk3,     dat4=msmk4,     dat5=msmk5,     exposure=mosmk);
559        	%MIPAR(dat1=msmk21,     dat2=msmk22,    dat3=msmk23,    dat4=msmk24,    dat5=msmk25,    exposure=mosmk2);
560        	%MIPAR(dat1=msmk31,     dat2=msmk32,    dat3=msmk33,    dat4=msmk34,    dat5=msmk35,    exposure=mosmk3);
561        	%MIPAR(dat1=mshift1,    dat2=mshift2,   dat3=mshift3,   dat4=mshift4,   dat5=mshift5,   exposure=moshift);
562        	%MIPAR(dat1=mshiftq11,  dat2=mshiftq12, dat3=mshiftq13, dat4=mshiftq14, dat5=mshiftq15, exposure=moshiftq1);
563        	%MIPAR(dat1=mshiftq21,  dat2=mshiftq22, dat3=mshiftq23, dat4=mshiftq24, dat5=mshiftq25, exposure=moshiftq2);
564        	%MIPAR(dat1=mshiftq31,  dat2=mshiftq32, dat3=mshiftq33, dat4=mshiftq34, dat5=mshiftq35, exposure=moshiftq3);
