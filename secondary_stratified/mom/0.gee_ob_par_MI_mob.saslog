570        	%MIPAR(dat1=mwestq21,   dat2=mwestq22,  dat3=mwestq23,  dat4=mwestq24,  dat5=mwestq25,  exposure=mowestq2);
571        	%MIPAR(dat1=mwestq31,   dat2=mwestq32,  dat3=mwestq33,  dat4=mwestq34,  dat5=mwestq35,  exposure=mowestq3);
572        	%MIPAR(dat1=mpa1,       dat2=mpa2,      dat3=mpa3,      dat4=mpa4,      dat5=mpa5,      exposure=mopa);
573        	%MIPAR(dat1=mpaq01,     dat2=mpaq02,    dat3=mpaq03,    dat4=mpaq04,    dat5=mpaq05,    exposure=mopaq0);
574        	%MIPAR(dat1=mpaq11,     dat2=mpaq12,    dat3=mpaq13,    dat4=mpaq14,    dat5=mpaq15,    exposure=mopaq1);
575        	%MIPAR(dat1=mpaq21,     dat2=mpaq22,    dat3=mpaq23,    dat4=mpaq24,    dat5=mpaq25,    exposure=mopaq2);
576        	%MIPAR(dat1=msmk1,      dat2=msmk2,     dat3=msmk3,     dat4=msmk4,     dat5=msmk5,     exposure=mosmk);
577        	%MIPAR(dat1=msmk21,     dat2=msmk22,    dat3=msmk23,    dat4=msmk24,    dat5=msmk25,    exposure=mosmk2);
578        	%MIPAR(dat1=msmk31,     dat2=msmk32,    dat3=msmk33,    dat4=msmk34,    dat5=msmk35,    exposure=mosmk3);
579        	%MIPAR(dat1=mshift1,    dat2=mshift2,   dat3=mshift3,   dat4=mshift4,   dat5=mshift5,   exposure=moshift);
580        	%MIPAR(dat1=mshiftq11,  dat2=mshiftq12, dat3=mshiftq13, dat4=mshiftq14, dat5=mshiftq15, exposure=moshiftq1);
581        	%MIPAR(dat1=mshiftq21,  dat2=mshiftq22, dat3=mshiftq23, dat4=mshiftq24, dat5=mshiftq25, exposure=moshiftq2);
582        	%MIPAR(dat1=mshiftq31,  dat2=mshiftq32, dat3=mshiftq33, dat4=mshiftq34, dat5=mshiftq35, exposure=moshiftq3);
