138        	/**********************************************************************
139        	RUN THE RR, WITH METANALYSIS BY IMPUTATION
140        	**********************************************************************/
141        
142        	title "HEADER: maternal modifiable factors for &group.";
143        	proc genmod data = &data descending;
144        		by _imputation_ ;
145        	class id momid ;
146        	model chob = &mowestq_ &mocalq_ &mopaq_ mosmk2 mosmk3 &moshiftq_
147        					&covar1
148        		/ dist = Poisson link = log;
149        		repeated subject=id(momid)/type=unstr PRINTMLE ecovb;
150        		ods output GEERCov=covmom GEEEmpPEst = mom;
151        	run;
152        	title "";
153        
154        	proc genmod data = &data descending;
155        		by _imputation_ ;
156        	class id momid ;
157        	model chob = mowest_m mocal_m mopa_m mosmk2 mosmk3
158        					moshift_m
159        					moage &covar1
160        		/ dist = Poisson link = log;
161        		repeated subject=id(momid)/type=unstr PRINTMLE ecovb;
162        		ods output GEEEmpPEst =mom_t;
163        	run;
164        	
165        
166        	TITLE "HEADER: multiple imputation - maternal modifiable factors for &group";
167        	ods output ParameterEstimates=mi_mom;
168        	PROC MIANALYZE parms=mom;
169        	MODELEFFECTS INTERCEPT mowestq1 mowestq2 mowestq3 mocalq1 mocalq2 mocalq3
170        			mopaq0 mopaq1 mopaq2 mosmk2 mosmk3
171        			moshiftq1 moshiftq2 moshiftq3
172        			&covar1  ;
173        	RUN;
174        	title "";
