571        	data dat_lb.mom_&group._par;
572        		set
573        		mowest_PAR 	  mowestq1_PAR      mowestq2_PAR      mowestq3_PAR
574        		mopa_PAR       mopaq0_PAR        mopaq1_PAR        mopaq2_PAR
575        		mosmk_PAR      mosmk2_PAR   	   mosmk3_PAR
576        		moshift_PAR 	  moshiftq1_PAR     moshiftq2_PAR     moshiftq3_PAR
577        		mom_PAR
578        		;
579        
580        		length group $ 40;
581        		group="&group";
582        	run;
583        
584        
585        	title "HEADER: final output for &group";
586        	proc print data=dat_lb.mom_&group._par;
587        	run;
588        	title "";
