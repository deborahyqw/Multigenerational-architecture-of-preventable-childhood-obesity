216        	%metaanal(data=moshiftq3_&group., beta=beta, se_or_var=s, se=SE, studylab=group, loglinear=T,
217        		explabel=moshiftq3, outcomelabel=ob,
218        		outdat= "RR_mom_moshiftq3_&group"); run;
219        
220        	%if "&data" ne "meta_RR_mob" %then %do;
