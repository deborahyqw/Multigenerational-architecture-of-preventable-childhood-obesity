89         
90         /* note that for age and sex we are calling in two datsets, one that calls in all variables except moob and
91         the other moob */
92         
93         /**SEX************************************/
94         
95         data meta_RR_sex;
96            set dat_lb.mom_female_RR  dat_lb.mom_male_RR
97            dat_lb.obmom_female_RR  dat_lb.obmom_male_RR;
98         	length  HRCI2 $ 18;
99         	HRCI2=.;
100        	SE=StdErr*1;
101            beta=Estimate*1;
102        	keep Parm mod group beta SE HRCI2;
103        
104        run;

