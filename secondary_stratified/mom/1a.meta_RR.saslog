127        /**********************************************************************
128        CREATE MACRO TO METANALYZE ALL OF THE EXPOSURES FOR EACH GROUP
129        **********************************************************************/
130        
131        
132        /*have to metaanalyze each exposure separately, will create macro that can be used to run through each of the stratification groups
132      ! (sex/age/materinal BMI)*/
133        
134        
135        %macro metaanal_allexp (data=, group=);
136        
137        
138        	/* mowestq1 exposure */
139        	data mowestq1_&group.; set &data; if Parm = 'mowestq1'; run;
140        	%metaanal(data=mowestq1_&group., beta=beta, se_or_var=s, se=SE, studylab=group, loglinear=T,
141        		explabel=mowestq1, outcomelabel=ob,
142        			outdat= "RR_mom_mowestq1_&group");
143        
144        	/* mowestq2 exposure */
145        	data mowestq2_&group.; set &data; if Parm = 'mowestq2'; run;
146        	%metaanal(data=mowestq2_&group., beta=beta, se_or_var=s, se=SE, studylab=group, loglinear=T,
147        		explabel=mowestq2, outcomelabel=ob,
148        		outdat= "RR_mom_mowestq2_&group");
149        
150        	/* mowestq3 exposure */
151        	data mowestq3_&group.; set &data; if Parm = 'mowestq3'; run;
152        	%metaanal(data=mowestq3_&group., beta=beta, se_or_var=s, se=SE, studylab=group, loglinear=T,
153        		explabel=mowestq3, outcomelabel=ob,
154        		outdat= "RR_mom_mowestq3_&group");
155        
156        
157        	/* mopaq0 exposure */
158        	data mopaq0_&group.; set &data; if Parm = 'mopaq0'; run;
159        	%metaanal(data=mopaq0_&group., beta=beta, se_or_var=s, se=SE, studylab=group, loglinear=T,
160        		explabel=mopaq0, outcomelabel=ob,
161        		outdat= "RR_mom_mopaq0_&group");
162        
163        	/* mopaq1 exposure */
164        	data mopaq1_&group.; set &data; if Parm = 'mopaq1'; run;
165        	%metaanal(data=mopaq1_&group., beta=beta, se_or_var=s, se=SE, studylab=group, loglinear=T,
166        		explabel=mopaq1, outcomelabel=ob,
167        		outdat= "RR_mom_mopaq1_&group");
168        
169        	/* mopaq2 exposure */
170        	data mopaq2_&group.; set &data; if Parm = 'mopaq2'; run;
171        	%metaanal(data=mopaq2_&group., beta=beta, se_or_var=s, se=SE, studylab=group, loglinear=T,
172        		explabel=mopaq2, outcomelabel=ob,
173        		outdat= "RR_mom_mopaq2_&group");	
174        
175        
176        	/* mosmk2 exposure */
177        	data mosmk2_&group.; set &data; if Parm = 'mosmk2'; run;
178        	%metaanal(data=mosmk2_&group., beta=beta, se_or_var=s, se=SE, studylab=group, loglinear=T,
179        		explabel=mosmk2, outcomelabel=ob,
180        		outdat= "RR_mom_mosmk2_&group");
181        
182        	/* mosmk3 exposure */
183        	data mosmk3_&group.; set &data; if Parm = 'mosmk3'; run;
184        	%metaanal(data=mosmk3_&group., beta=beta, se_or_var=s, se=SE, studylab=group, loglinear=T,
185        		explabel=mosmk3, outcomelabel=ob,
4                                                                   The SAS System                                         09:10 Tuesday, July 8, 2025

186        		outdat= "RR_mom_mosmk3_&group");
187        
188        
189        	/* moshiftq1 exposure */
