140        /**********************************************************************
141        CREATE MACRO TO METANALYZE ALL OF THE EXPOSURES FOR EACH GROUP
142        **********************************************************************/
143        
144        
145        /*have to metaanalyze each exposure separately, will create macro that can be used to run through each of the stratification groups
145      ! (sex/age/materinal BMI)*/
146        
147        
148        %macro metaanal_allexp (data=, group=);
149        
150        
151        	/* mowestq1 exposure */
152        	data mowestq1_&group.; set &data; if Parm = 'mowestq1'; run;
153        	%metaanal(data=mowestq1_&group., beta=beta, se_or_var=s, se=SE, studylab=group, loglinear=T,
154        		explabel=mowestq1, outcomelabel=ob,
155        			outdat= "RR_mom_mowestq1_&group");
156        
157        	/* mowestq2 exposure */
158        	data mowestq2_&group.; set &data; if Parm = 'mowestq2'; run;
159        	%metaanal(data=mowestq2_&group., beta=beta, se_or_var=s, se=SE, studylab=group, loglinear=T,
160        		explabel=mowestq2, outcomelabel=ob,
4                                                                   The SAS System                                    19:28 Tuesday, November 18, 2025

161        		outdat= "RR_mom_mowestq2_&group");
162        
163        	/* mowestq3 exposure */
164        	data mowestq3_&group.; set &data; if Parm = 'mowestq3'; run;
165        	%metaanal(data=mowestq3_&group., beta=beta, se_or_var=s, se=SE, studylab=group, loglinear=T,
166        		explabel=mowestq3, outcomelabel=ob,
167        		outdat= "RR_mom_mowestq3_&group");
168        
169        
170        	/* mopaq0 exposure */
171        	data mopaq0_&group.; set &data; if Parm = 'mopaq0'; run;
172        	%metaanal(data=mopaq0_&group., beta=beta, se_or_var=s, se=SE, studylab=group, loglinear=T,
173        		explabel=mopaq0, outcomelabel=ob,
174        		outdat= "RR_mom_mopaq0_&group");
175        
176        	/* mopaq1 exposure */
177        	data mopaq1_&group.; set &data; if Parm = 'mopaq1'; run;
