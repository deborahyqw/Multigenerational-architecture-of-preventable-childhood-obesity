210        	%metaanal(data=moshiftq2_&group., beta=beta, se_or_var=s, se=SE, studylab=group, loglinear=T,
211        		explabel=moshiftq2, outcomelabel=ob,
212        		outdat= "RR_mom_moshiftq2_&group");
213        
