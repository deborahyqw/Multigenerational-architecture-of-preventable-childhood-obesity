77         
78         /* note that for age and sex we are calling in two datsets, one that calls in all variables except moob and
79         the other moob */
80         
81         /**SEX************************************/
82         
83         data meta_RR_sex;
84            set dat_lb.mom_female_RR  dat_lb.mom_male_RR
85            dat_lb.obmom_female_RR  dat_lb.obmom_male_RR;
86         	length  HRCI2 $ 18;
87         	HRCI2=.;
88         	SE=StdErr*1;
89             beta=Estimate*1;
90         	keep Parm mod group beta SE HRCI2;
91         
92         run;

