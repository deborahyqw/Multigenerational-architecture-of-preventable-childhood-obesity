144        
145        	title "HEADER: maternal modifiable factors, &group.";
146        	proc genmod data = &data descending;
147        		by _imputation_ ;
148        	class id momid ;
149        	model chob = &mowestq_ &mocalq_ &mopaq_ mosmk2 mosmk3 &moshiftq_
150        					&covar1
151        		/ dist = Poisson link = log;
152        		repeated subject=id(momid)/type=unstr PRINTMLE ecovb;
153        		ods output GEERCov=covmom GEEEmpPEst = mom;
154        	run;
155        	title "";
156        
157        	proc genmod data = &data descending;
158        		by _imputation_ ;
159        	class id momid ;
160        	model chob = mowest_m mocal_m mopa_m mosmk2 mosmk3
161        					moshift_m
162        					moage &covar1
163        		/ dist = Poisson link = log;
164        		repeated subject=id(momid)/type=unstr PRINTMLE ecovb;
165        		ods output GEEEmpPEst =mom_t;
166        	run;
