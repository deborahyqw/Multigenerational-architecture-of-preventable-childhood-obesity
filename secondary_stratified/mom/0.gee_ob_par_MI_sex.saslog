237        
238        	/*MANUAL SPECIFICATION OF VARIABLES*/
239        	data betas;
240        	set mom ;
241        	by _imputation_;
242        	_type_ = 'PARM';
243        		retain intercept mowestq1 mowestq2 mowestq3 mocalq1 mocalq2 mocalq3
244        						mopaq0 mopaq1 mopaq2 mosmk2 mosmk3
245        						moshiftq1 moshiftq2 moshiftq3
246        						&covar1;
247        		
248        		* 'i' counts rows within each _imputation_ group ;
249        		if first._imputation_ then i=1;
250        		else i+1;
251        		
252        		select (i);
253        		when (1) intercept = estimate;
254        		when (2) mowestq1  = estimate;
255        		when (3) mowestq2  = estimate;
256        		when (4) mowestq3  = estimate;
