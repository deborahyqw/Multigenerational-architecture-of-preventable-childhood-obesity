645        		by _imputation_;
646        		length _type_ $4;
647        		_type_ = 'COV';
648        
649        		rename  Prm1=intercept   Prm2=mowestq1   Prm3=mowestq2   Prm4=mowestq3   Prm5=mocalq1
650        				Prm6=mocalq2     Prm7=mocalq3
651        				Prm8=mopaq0      Prm9=mopaq1     Prm10=mopaq2    Prm11=mosmk2  Prm12=mosmk3
652        				Prm13=moshiftq1  Prm14=moshiftq2  Prm15=moshiftq3 Prm16=moage
653        				Prm17=cohort     Prm18=white     Prm19=chage   Prm20=moob ;
654        
655        		length _name_ $10;
656        		
657        		*i counts rows within each _imputation_;
658        		if first._imputation_ then i=1;
659        			else i+1;
660        
661        		* Assign which row this is (the row "label" in the covariance matrix) ;
662        		select(i);
663        			when(1)  _name_ = 'INTERCEPT';
664        			when(2)  _name_ = 'mowestq1';
665        			when(3)  _name_ = 'mowestq2';
666        			when(4)  _name_ = 'mowestq3';
667        			when(5)  _name_ = 'mocalq1';
668        			when(6)  _name_ = 'mocalq2';
669        			when(7)  _name_ = 'mocalq3';
670        			when(8)  _name_ = 'mopaq0';
671        			when(9)  _name_ = 'mopaq1';
672        			when(10)  _name_ = 'mopaq2';
673        			when(11)  _name_ = 'mosmk2';
674        			when(12)  _name_ = 'mosmk3';
675        			when(13)  _name_ = 'moshiftq1';
676        			when(14)  _name_ = 'moshiftq2';
677        			when(15)  _name_ = 'moshiftq3';
678        			when(16)  _name_ = 'moage';
679        			when(17)  _name_ = 'cohort';
680        			when(18)  _name_ = 'white';
681        			when(19)  _name_ = 'chage';
682        			when(20)  _name_ = 'moob';
683        			otherwise;
684        		end;
