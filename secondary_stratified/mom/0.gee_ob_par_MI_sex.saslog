531        	title "maternal modifiable factors - moob, &group.";
532        	proc genmod data = &data descending;
533        		by _imputation_ ;
534        	class id momid ;
535        	model chob = &mowestq_ &mocalq_ &mopaq_ mosmk2 mosmk3 &moshiftq_
536        					&covar1 moob
537        		/ dist = Poisson link = log;
538        		repeated subject=id(momid)/type=unstr PRINTMLE ecovb;
539        		ods output GEERCov=covmom GEEEmpPEst = mom;
540        	run;
