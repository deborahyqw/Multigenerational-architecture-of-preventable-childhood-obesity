750        	/*************************************************************************************/
751        	/**************** combine using mianalyze ********************************************/
752        
753        	%macro MIPAR(dat1=, dat2=, dat3=, dat4=, dat5=, exposure=);
754        
755        		data temp;
756        			length _Imputation_ 3;
757        			set &dat1(in=a) &dat2(in=b) &dat3(in=c) &dat4(in=d) &dat5(in=e);
758        			if a then _Imputation_=1;
759        				else if b then _Imputation_=2;
760        				else if c then _Imputation_=3;
761        				else if d then _Imputation_=4;
762        				else if e then _Imputation_=5;
763        					
764        			/* approximate standard error from the half-width of the CI */
765        			StdErr = (uclpartialx - lclpartialx) / (2 * 1.96);
766        			Estimate = partlparx;
767        			Parameter = 'PartialPAR';
768        			
769        			keep _Imputation_ Estimate StdErr Parameter;
770        		run;
771        
772        		ods output ParameterEstimates=&exposure._PAR;
773        		proc mianalyze data=temp;
774        			modeleffects Estimate;
775        			stderr StdErr;
776        		run;
777        
778        		data &exposure._PAR;
779        			set &exposure._PAR;
780        			length exposure $ 15;
781        			exposure="&exposure.";
782        		run;
783        			
784        
785        	%mend MIPAR;
