770        	/*************************************************************************************/
771        	/**************** combine using mianalyze ********************************************/
772        
773        	%macro MIPAR(dat1=, dat2=, dat3=, dat4=, dat5=, exposure=);
774        
775        		data temp;
776        			length _Imputation_ 3;
777        			set &dat1(in=a) &dat2(in=b) &dat3(in=c) &dat4(in=d) &dat5(in=e);
778        			if a then _Imputation_=1;
779        				else if b then _Imputation_=2;
780        				else if c then _Imputation_=3;
781        				else if d then _Imputation_=4;
782        				else if e then _Imputation_=5;
783        					
784        			/* approximate standard error from the half-width of the CI */
785        			StdErr = (uclpartialx - lclpartialx) / (2 * 1.96);
786        			Estimate = partlparx;
787        			Parameter = 'PartialPAR';
788        			
789        			keep _Imputation_ Estimate StdErr Parameter;
790        		run;
791        
792        		ods output ParameterEstimates=&exposure._PAR;
793        		proc mianalyze data=temp;
794        			modeleffects Estimate;
795        			stderr StdErr;
796        		run;
797        
798        		data &exposure._PAR;
799        			set &exposure._PAR;
800        			length exposure $ 15;
801        			exposure="&exposure.";
802        		run;
803        			
