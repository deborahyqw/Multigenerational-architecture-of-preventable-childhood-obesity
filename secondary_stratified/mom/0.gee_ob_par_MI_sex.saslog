159        
160        	/**********************************************************************
161        	RUN THE RR, WITH METANALYSIS BY IMPUTATION
162        	**********************************************************************/
163        
164        	title "HEADER: maternal modifiable factors, &group.";
165        	proc genmod data = &data descending;
166        		by _imputation_ ;
167        	class id momid ;
168        	model chob = &mowestq_ &mocalq_ &mopaq_ mosmk2 mosmk3 &moshiftq_
169        					&covar1
170        		/ dist = Poisson link = log;
171        		repeated subject=id(momid)/type=unstr PRINTMLE ecovb;
172        		ods output GEERCov=covmom GEEEmpPEst = mom;
173        	run;
174        	title "";
175        
176        	proc genmod data = &data descending;
177        		by _imputation_ ;
178        	class id momid ;
179        	model chob = mowest_m mocal_m mopa_m mosmk2 mosmk3
180        					moshift_m
181        					moage &covar1
4                                                                   The SAS System                                     12:07 Monday, November 17, 2025

182        		/ dist = Poisson link = log;
183        		repeated subject=id(momid)/type=unstr PRINTMLE ecovb;
184        		ods output GEEEmpPEst =mom_t;
185        	run;
186        	
187        
188        	TITLE "HEADER: multiple imputation - maternal modifiable factors - no moob, &group";
189        	ods output ParameterEstimates=mi_mom;
