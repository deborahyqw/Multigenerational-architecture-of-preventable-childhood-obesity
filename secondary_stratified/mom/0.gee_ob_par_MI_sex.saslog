511        	title "maternal modifiable factors - moob, &group.";
512        	proc genmod data = &data descending;
513        		by _imputation_ ;
514        	class id momid ;
515        	model chob = &mowestq_ &mocalq_ &mopaq_ mosmk2 mosmk3 &moshiftq_
516        					&covar1 moob
517        		/ dist = Poisson link = log;
518        		repeated subject=id(momid)/type=unstr PRINTMLE ecovb;
519        		ods output GEERCov=covmom GEEEmpPEst = mom;
520        	run;
521        	title "";
