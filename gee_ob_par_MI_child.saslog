572        data all;
573          set all end=_end_;
574          cohort=cohort-1;
575        
576        	%indic3(vbl=chwestq, reflev=0, missing=., min=1, max=3, prefix=chwestq, usemiss=0,
577                    label1='Q2',label2='Q3', label3='Q4');
578            %indic3(vbl=chcalq, reflev=0, missing=., min=1, max=3, prefix=chcalq, usemiss=0,
579                    label1='Q2',label2='Q3', label3='Q4');
580            %indic3(vbl=chstq, reflev=0, missing=., min=1, max=3, prefix=chstq, usemiss=0,
581                    label1='Q2',label2='Q3', label3='Q4');
582            %indic3(vbl=chpaq, reflev=3, missing=., min=0, max=2, prefix=chpaq, usemiss=0,
583                    label0='Q1',label1='Q2', label2='Q3');
584        
585        run;

