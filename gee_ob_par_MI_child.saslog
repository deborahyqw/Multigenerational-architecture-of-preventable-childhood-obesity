756        	n_or_p=N,
757        	n_or_pname=FQ,
758        	modvar= &modmod  ,
759        	missvarlist=NONE,
760        	partialpar= T,
761        	outdat= &outpref.&i,
762        	fixedvar= &fixfix );
763        	%end;
764        %mend runPAR;
