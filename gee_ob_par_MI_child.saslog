646        data covparms;
647        	set covchild;
648        	by _imputation_;
649        	length _type_ $4;
650        	 _type_ = 'COV';
651        
652        	rename  Prm1=intercept   Prm2=chwestq1   Prm3=chwestq2   Prm4=chwestq3   Prm5=chstq1
653        			Prm6=chstq2      Prm7=chstq3     Prm8=chpaq0     Prm9=chpaq1     Prm10=chpaq2
654        			Prm11=chcalq1    Prm12=chcalq2   Prm13=chcalq3   Prm14=chbmibase
655        			Prm15=cohort     Prm16=chage     Prm17=white     Prm18=sex   ;
656        
657        	length _name_ $10;
658        	
659        	*i counts rows within each _imputation_;
660        	if first._imputation_ then i=1;
661         		 else i+1;
662        
663        	* Assign which row this is (the row "label" in the covariance matrix) ;
664        	select(i);
665        		when(1)  _name_ = 'INTERCEPT';
666        		when(2)  _name_ = 'chwestq1';
667        		when(3)  _name_ = 'chwestq2';
668        		when(4)  _name_ = 'chwestq3';
669        		when(5)  _name_ = 'chstq1';
670        		when(6)  _name_ = 'chstq2';
671        		when(7)  _name_ = 'chstq3';
672        		when(8)  _name_ = 'chpaq0';
673        		when(9)  _name_ = 'chpaq1';
674        		when(10)  _name_ = 'chpaq2';
675        		when(11)  _name_ = 'chcalq1';
676        		when(12)  _name_ = 'chcalq2';
677        		when(13)  _name_ = 'chcalq3';
678        		when(14)  _name_ = 'chbmibase';
679        		when(15)  _name_ = 'cohort';
680        		when(16)  _name_ = 'chage';
681        		when(17)  _name_ = 'white';
682        		when(18)  _name_ = 'sex';
683        		otherwise;
684        	end;
685        	
686        	* Output EVERY row;
687          	output;
688        
689        keep _imputation_ _type_ _name_ prm1-prm18 ;
690        
691        run;

