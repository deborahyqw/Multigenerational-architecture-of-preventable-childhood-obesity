1054       *Parameter        Estimate      Std Error    95% Confidence Limits        DF        Minimum        Maximum         Theta0
1054     ! Parameter=Theta0   Pr > |t|
1055       Estimate         0.425044       0.079707     0.268560     0.581528   727.05       0.393502       0.445822              0               5.33
1055     !      <.0001
1056       ;
1057       		 		
1058       /*************************************************************************************/
1059       /**************** combine using mianalyze ********************************************/
1060       
1061       %macro MIPAR(dat1=, dat2=, dat3=, dat4=, dat5=);
1062       
1063       data temp;
1064       	length _Imputation_ 3;
1065       	set &dat1(in=a) &dat2(in=b) &dat3(in=c) &dat4(in=d) &dat5(in=e);
1066       	if a then _Imputation_=1;
1067         		else if b then _Imputation_=2;
1068        		else if c then _Imputation_=3;
1069         		else if d then _Imputation_=4;
1070         		else if e then _Imputation_=5;
129                                                                 The SAS System                                         21:59 Friday, June 20, 2025

1071         		  	
1072         	/* approximate standard error from the half-width of the CI */
1073         	StdErr = (uclpartialx - lclpartialx) / (2 * 1.96);
1074         	Estimate = partlparx;
1075         	Parameter = 'PartialPAR';
1076         	
1077         	keep _Imputation_ Estimate StdErr Parameter;
1078       run;
1079       
1080       proc mianalyze data=temp;
1081          modeleffects Estimate;
1082          stderr StdErr;
1083       run;
1084       
1085       %mend MIPAR;
