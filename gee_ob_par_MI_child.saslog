846        		when(7)  _name_ = 'chstq3';
847        		when(8)  _name_ = 'chpaq0';
848        		when(9)  _name_ = 'chpaq1';
849        		when(10)  _name_ = 'chpaq2';
850        		when(11)  _name_ = 'chcalq1';
851        		when(12)  _name_ = 'chcalq2';
852        		when(13)  _name_ = 'chcalq3';
853        		when(14)  _name_ = 'chbmibase';
854        		when(15)  _name_ = 'cohort';
855        		when(16)  _name_ = 'chage';
856        		when(17)  _name_ = 'white';
857        		when(18)  _name_ = 'sex';
858        		otherwise;
859        	end;
860        	
