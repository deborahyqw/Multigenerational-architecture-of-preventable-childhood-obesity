879        *Parameter        Estimate      Std Error    95% Confidence Limits        DF        Minimum        Maximum         Theta0
879      ! Parameter=Theta0   Pr > |t|
880        Estimate         0.425044       0.079707     0.268560     0.581528   727.05       0.393502       0.445822              0               5.33
880      !      <.0001
881        ;
882        		 		
883        /*************************************************************************************/
884        /**************** combine using mianalyze ********************************************/
885        
886        %macro MIPAR(dat1=, dat2=, dat3=, dat4=, dat5=);
887        
888        data temp;
889        	length _Imputation_ 3;
890        	set &dat1(in=a) &dat2(in=b) &dat3(in=c) &dat4(in=d) &dat5(in=e);
891        	if a then _Imputation_=1;
892          		else if b then _Imputation_=2;
893         		else if c then _Imputation_=3;
894          		else if d then _Imputation_=4;
895          		else if e then _Imputation_=5;
896          		  	
897          	/* approximate standard error from the half-width of the CI */
898          	StdErr = (uclpartialx - lclpartialx) / (2 * 1.96);
899          	Estimate = partlparx;
900          	Parameter = 'PartialPAR';
901          	
902          	keep _Imputation_ Estimate StdErr Parameter;
903        run;
904        
905        proc mianalyze data=temp;
906           modeleffects Estimate;
907           stderr StdErr;
908        run;
909        
910        %mend MIPAR;
911        			
