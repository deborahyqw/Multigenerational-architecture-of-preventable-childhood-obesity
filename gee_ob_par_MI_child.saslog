767        
768        /**********************************************************************/
769        title ' personal modifiable factors ';
770        proc genmod data = all descending;
771        	by _imputation_ ;
772         class id momid ;
773           model chob = &chwestq_ &chstq_ &chpaq_ &chcalq_ chbmibase &covar1
774             / dist = Poisson link = log;
775             repeated subject=id(momid)/type=unstr PRINTMLE ecovb;
776             ods output GEERCov=covchild GEEEmpPEst = child;
777         run;

NOTE: The DESCENDING option applies only to the multinomial distribution with ordinal response.
