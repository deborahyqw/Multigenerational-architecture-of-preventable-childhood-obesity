592        
593        /**********************************************************************/
594        title ' personal modifiable factors ';
595        proc genmod data = all descending;
596        	by _imputation_ ;
597         class id momid ;
598           model chob = &chwestq_ &chstq_ &chpaq_ &chcalq_ chbmibase &covar1
599             / dist = Poisson link = log;
600             repeated subject=id(momid)/type=unstr PRINTMLE ecovb;
601             ods output GEERCov=covchild GEEEmpPEst = child;
602         run;

NOTE: The DESCENDING option applies only to the multinomial distribution with ordinal response.
