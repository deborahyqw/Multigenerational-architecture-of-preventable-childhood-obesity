778        
779        data betas;
780          set child ;
781          by _imputation_;
782          _type_ = 'PARM';
783        	retain intercept chwestq1 chwestq2 chwestq3 chstq1 chstq2 chstq3
784        			chpaq0 chpaq1 chpaq2 chcalq1 chcalq2 chcalq3
785        		    chbmibase cohort chage white sex;
786        	
787        	* 'i' counts rows within each _imputation_ group ;
788          	if first._imputation_ then i=1;
789          	else i+1;
790        	
791        	select (i);
792            when (1) intercept = estimate;
793            when (2) chwestq1  = estimate;
794            when (3) chwestq2  = estimate;
795            when (4) chwestq3  = estimate;
796            when (5) chstq1   = estimate;
797            when (6) chstq2   = estimate;
798        	when (7) chstq3   = estimate;
799        	when (8) chpaq0   = estimate;
800        	when (9) chpaq1   = estimate;
801        	when (10) chpaq2  = estimate;
802        	when (11) chcalq1   = estimate;
803        	when (12) chcalq2   = estimate;
804        	when (13) chcalq3   = estimate;
805        	when (14) chbmibase = estimate;
806            when (15) cohort   = estimate;
807            when (16) chage    = estimate;
808            when (17) white    = estimate;
809            when (18) sex      = estimate;
810            otherwise;
811          end;
812        	
813          * Only OUTPUT once per _imputation_, after we've assigned all param columns ;
814          if last._imputation_ then output;
815        
816        	* set negative beta to 0 to avoid errors in PAR -- chpa2 <0 in imputations 1-2;
817        	if chpaq2 <0 then chpaq2=0;
818        run;

