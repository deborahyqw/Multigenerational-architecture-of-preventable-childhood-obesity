603        
604        data betas;
605          set child ;
606          by _imputation_;
607          _type_ = 'PARM';
608        	retain intercept chwestq1 chwestq2 chwestq3 chstq1 chstq2 chstq3
609        			chpaq0 chpaq1 chpaq2 chcalq1 chcalq2 chcalq3
610        		    chbmibase cohort chage white sex;
611        	
612        	* 'i' counts rows within each _imputation_ group ;
613          	if first._imputation_ then i=1;
614          	else i+1;
615        	
616        	select (i);
617            when (1) intercept = estimate;
618            when (2) chwestq1  = estimate;
619            when (3) chwestq2  = estimate;
620            when (4) chwestq3  = estimate;
621            when (5) chstq1   = estimate;
622            when (6) chstq2   = estimate;
623        	when (7) chstq3   = estimate;
624        	when (8) chpaq0   = estimate;
625        	when (9) chpaq1   = estimate;
626        	when (10) chpaq2  = estimate;
627        	when (11) chcalq1   = estimate;
628        	when (12) chcalq2   = estimate;
629        	when (13) chcalq3   = estimate;
630        	when (14) chbmibase = estimate;
631            when (15) cohort   = estimate;
632            when (16) chage    = estimate;
633            when (17) white    = estimate;
634            when (18) sex      = estimate;
635            otherwise;
636          end;
637        	
638          * Only OUTPUT once per _imputation_, after we've assigned all param columns ;
639          if last._imputation_ then output;
640        
641        	* set negative beta to 0 to avoid errors in PAR -- chpa2 <0 in imputations 2,5;
642        	if chpaq2 <0 then chpaq2=0;
643        run;

