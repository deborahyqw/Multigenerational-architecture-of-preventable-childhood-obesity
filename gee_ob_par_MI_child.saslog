821        data covparms;
822        	set covchild;
823        	by _imputation_;
824        	length _type_ $4;
825        	 _type_ = 'COV';
826        
827        	rename  Prm1=intercept   Prm2=chwestq1   Prm3=chwestq2   Prm4=chwestq3   Prm5=chstq1
828        			Prm6=chstq2      Prm7=chstq3     Prm8=chpaq0     Prm9=chpaq1     Prm10=chpaq2
829        			Prm11=chcalq1    Prm12=chcalq2   Prm13=chcalq3   Prm14=chbmibase
830        			Prm15=cohort     Prm16=chage     Prm17=white     Prm18=sex   ;
831        
832        	length _name_ $10;
833        	
834        	*i counts rows within each _imputation_;
835        	if first._imputation_ then i=1;
836         		 else i+1;
837        
838        	* Assign which row this is (the row "label" in the covariance matrix) ;
839        	select(i);
840        		when(1)  _name_ = 'INTERCEPT';
841        		when(2)  _name_ = 'chwestq1';
842        		when(3)  _name_ = 'chwestq2';
843        		when(4)  _name_ = 'chwestq3';
844        		when(5)  _name_ = 'chstq1';
845        		when(6)  _name_ = 'chstq2';
