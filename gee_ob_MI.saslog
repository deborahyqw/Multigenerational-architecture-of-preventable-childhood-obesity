572        data all;
573          set all  end=_end_ ;
574          cohort=cohort-1;
575        
576          /*if agebirth >=35 then oldbirth=1; else oldbirth=0;*/
577        
578             %indic3(vbl=mowestq, reflev=0, missing=., min=1, max=3, prefix=mowestq, usemiss=0,
579                    label1='Q2',label2='Q3', label3='Q4');
580             %indic3(vbl=mocalq, reflev=0, missing=., min=1, max=3, prefix=mocalq, usemiss=0,
581                    label1='Q2',label2='Q3', label3='Q4');
582             %indic3(vbl=mopaq, reflev=3, missing=., min=0, max=2, prefix=mopaq, usemiss=0,
583                    label0='Q1',label1='Q2', label2='Q3');
584             %indic3(vbl=moshiftq, reflev=0, missing=., min=1, max=3, prefix=moshiftq, usemiss=0,
585                    label1='Q2',label2='Q3', label3='Q4');
586        
587            %indic3(vbl=sesq, reflev=3, missing=., min=0, max=2, prefix=sesq, usemiss=0,
588                    label0='Q1',label1='Q2', label2='Q3');
589        
590        	%indic3(vbl=chwestq, reflev=0, missing=., min=1, max=3, prefix=chwestq, usemiss=0,
591                    label1='Q2',label2='Q3', label3='Q4');
592            %indic3(vbl=chcalq, reflev=0, missing=., min=1, max=3, prefix=chcalq, usemiss=0,
593                    label1='Q2',label2='Q3', label3='Q4');
594            %indic3(vbl=chstq, reflev=0, missing=., min=1, max=3, prefix=chstq, usemiss=0,
