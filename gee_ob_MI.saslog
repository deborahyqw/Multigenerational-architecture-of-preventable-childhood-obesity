803        
804        /**********************************************************************/
805        title ' maternal modifiable factors - not adjusting for moob because it may be on the causal pathways ';
806        proc genmod data = all descending;
807        	by _imputation_ ;
808         class id momid ;
809           model chob = &mowestq_ &mocalq_ &mopaq_ mosmk2 mosmk3
810          				&moshiftq_
811          			    moage &covar1
812             / dist = Poisson link = log;
813             repeated subject=id(momid)/type=unstr PRINTMLE ecovb;
814             ods output GEEEmpPEst = mom;
815         run;

