964           	   mi_uter(in=g) mi_pregob(in=h)
965           	   mi_soc(in=i) mi_soct(in=j) mi_edu(in=k) mi_edut(in=l)
966           	   mi_inc(in=m) mi_inct(in=n)  mi_life(in=o) mi_lifet(in=p)
967           	   mi_gweight(in=q) ;
968          	
969          	if a then mod="mom";
970          	if b then mod="mom trend";
971          	if c then mod="mom ob";
972          	if d then mod="mom sensi";
973          	if e then mod="mom sensi trend";
974          	if f then mod="mom ob sensi";
975          	if g then mod="uter";
976          	if h then mod="pregob";
977          	if i then mod="socio";
978          	if j then mod="socio trend";
979          	if k then mod="edu";
980          	if l then mod="edu trend";
981          	if m then mod="income";
982          	if n then mod="income trend";
983          	if o then mod="life";
984          	if p then mod="life trend";
985          	if q then mod="geswtgrain";
986        
987        	RR=exp(Estimate); LCI=exp(LCLMean); UCI=exp(UCLMean);
988        
989        run;

