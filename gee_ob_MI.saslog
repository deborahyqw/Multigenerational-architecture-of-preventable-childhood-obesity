596            %indic3(vbl=chpaq, reflev=3, missing=., min=0, max=2, prefix=chpaq, usemiss=0,
597                    label0='Q1',label1='Q2', label2='Q3');
598        
599        	/*if mosmk2=1 or mosmk3=1 then mosmkever=1; else mosmkever=0;*/
600        run;

