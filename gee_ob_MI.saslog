618        
619        /**********************************************************************/
620        title ' maternal modifiable factors - not adjusting for moob because it may be on the causal pathways ';
621        proc genmod data = all descending;
622        	by _imputation_ ;
623         class id momid ;
624           model chob = &mowestq_ &mocalq_ &mopaq_ mosmk2 mosmk3
625          				&moshiftq_
626          			    moage &covar1
627             / dist = Poisson link = log;
628             repeated subject=id(momid)/type=unstr PRINTMLE ecovb;
629             ods output GEEEmpPEst = mom;
630         run;

