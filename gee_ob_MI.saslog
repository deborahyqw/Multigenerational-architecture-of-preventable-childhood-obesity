1111       *****************************************;
1112       ************** PREPARE DATA FOR TABLE *************************;
1113       data allob;
1114       length Parm $ 15;
1115          set mi_mom(in=a) mi_momt(in=b) mi_mob(in=c)
1116          	   mi_momsensi(in=d) mi_momsensit(in=e) mi_mobsensi(in=f)
1117          	   mi_uter(in=g) mi_pregob(in=h)
1118          	   mi_soc(in=i) mi_soct(in=j) mi_edu(in=k) mi_edut(in=l)
1119          	   mi_inc(in=m) mi_inct(in=n)  mi_life(in=o) mi_lifet(in=p) ;
1120         	
1121         	if a then mod="mom";
1122         	if b then mod="mom trend";
1123         	if c then mod="mom ob";
1124         	if d then mod="mom sensi";
1125         	if e then mod="mom sensi trend";
1126         	if f then mod="mom ob sensi";
1127         	if g then mod="uter";
1128         	if h then mod="pregob";
1129         	if i then mod="socio";
1130         	if j then mod="socio trend";
1131         	if k then mod="edu";
1132         	if l then mod="edu trend";
1133         	if m then mod="income";
1134         	if n then mod="income trend";
1135         	if o then mod="life";
1136         	if p then mod="life trend";
1137       
1138       	RR=exp(Estimate); LCI=exp(LCLMean); UCI=exp(UCLMean);
1139       
1140       run;

