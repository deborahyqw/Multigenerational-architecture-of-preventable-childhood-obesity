604        
605        data betas;
606          set mom ;
607          by _imputation_;
608          _type_ = 'PARM';
609        	retain intercept mowestq1 mowestq2 mowestq3 mocalq1 mocalq2 mocalq3
610        					 mopaq0 mopaq1 mopaq2 mosmk2 mosmk3
611        					moshiftq1 moshiftq2 moshiftq3
612        					moage cohort chage white sex;
613        	
614        	* 'i' counts rows within each _imputation_ group ;
615          	if first._imputation_ then i=1;
616          	else i+1;
617        	
618        	select (i);
619            when (1) intercept = estimate;
620            when (2) mowestq1  = estimate;
621            when (3) mowestq2  = estimate;
622            when (4) mowestq3  = estimate;
623            when (5) mocalq1   = estimate;
624            when (6) mocalq2   = estimate;
625        	when (7) mocalq3   = estimate;
626        	when (8) mopaq0   = estimate;
627        	when (9) mopaq1   = estimate;
628        	when (10) mopaq2   = estimate;
629        	when (11) mosmk2  = estimate;
630        	when (12) mosmk3  = estimate;
631        	when (13) moshiftq1= estimate;
632        	when (14) moshiftq2= estimate;
633        	when (15) moshiftq3= estimate;
634            when (16) moage    = estimate;
635            when (17) cohort   = estimate;
636            when (18) chage    = estimate;
637            when (19) white    = estimate;
638            when (20) sex      = estimate;
639            otherwise;
640          end;
641        	
642          * Only OUTPUT once per _imputation_, after we've assigned all param columns ;
643          if last._imputation_ then output;
644        
645        run;

