1051       
1052       data betas;
1053         set mom ;
1054         by _imputation_;
1055         _type_ = 'PARM';
1056       	retain intercept mowestq1 mowestq2 mowestq3 mocalq1 mocalq2 mocalq3
1057       					 mopaq0 mopaq1 mopaq2 mosmk2 mosmk3
1058       					moshiftq1 moshiftq2 moshiftq3
1059       					moage cohort chage white sex moob;
1060       	
1061       	* 'i' counts rows within each _imputation_ group ;
1062         	if first._imputation_ then i=1;
1063         	else i+1;
1064       	
1065       	select (i);
1066           when (1) intercept = estimate;
1067           when (2) mowestq1  = estimate;
1068           when (3) mowestq2  = estimate;
1069           when (4) mowestq3  = estimate;
1070           when (5) mocalq1   = estimate;
1071           when (6) mocalq2   = estimate;
1072       	when (7) mocalq3   = estimate;
1073       	when (8) mopaq0   = estimate;
1074       	when (9) mopaq1   = estimate;
1075       	when (10) mopaq2   = estimate;
1076       	when (11) mosmk2  = estimate;
1077       	when (12) mosmk3  = estimate;
1078       	when (13) moshiftq1= estimate;
1079       	when (14) moshiftq2= estimate;
1080       	when (15) moshiftq3= estimate;
1081           when (16) moage    = estimate;
1082           when (17) cohort   = estimate;
1083           when (18) chage    = estimate;
1084           when (19) white    = estimate;
1085           when (20) sex      = estimate;
1086           when (21) moob     = estimate;
1087           otherwise;
1088         end;
1089       	
1090         * Only OUTPUT once per _imputation_, after we've assigned all param columns ;
1091         if last._imputation_ then output;
1092       
1093         if mowestq1 <0 then  mowestq1 =0;    if mowestq2 <0 then  mowestq2 =0;
1094       
1095       run;

