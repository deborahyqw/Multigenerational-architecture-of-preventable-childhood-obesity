763        
764        %LET covar1= cohort chage white sex ;
765        
766        run;
767        
768        /**********************************************************************/
769        title ' maternal modifiable factors - not adjusting for moob because it may be on the causal pathways ';
770        proc genmod data = all descending;
771        	by _imputation_ ;
772         class id momid ;
773           model chob = &mowestq_ &mocalq_ &mopaq_ mosmk2 mosmk3 &moshiftq_
774          			    moage &covar1
775             / dist = Poisson link = log;
776             repeated subject=id(momid)/type=unstr PRINTMLE ecovb;
777             ods output GEERCov=covmom GEEEmpPEst = mom;
778         run;

NOTE: The DESCENDING option applies only to the multinomial distribution with ordinal response.
