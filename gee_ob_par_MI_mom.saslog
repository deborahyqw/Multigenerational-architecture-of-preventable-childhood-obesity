646        *proc print data=betas;
647        
648        data covparms;
649        	set covmom;
650        	by _imputation_;
651        	length _type_ $4;
652        	 _type_ = 'COV';
653        
654        	rename  Prm1=intercept   Prm2=mowestq1   Prm3=mowestq2   Prm4=mowestq3   Prm5=mocalq1
13                                                                  The SAS System                                     17:10 Friday, November 14, 2025

655        			Prm6=mocalq2     Prm7=mocalq3
656        			Prm8=mopaq0     Prm9=mopaq1    Prm10=mopaq2    Prm11=mosmk2   Prm12=mosmk3
657        			Prm13=moshiftq1  Prm14=moshiftq2  Prm15=moshiftq3   Prm16=moage
658        			Prm17=cohort     Prm18=chage      Prm19=white       Prm20=sex   ;
659        
660        	length _name_ $10;
661        	
662        	*i counts rows within each _imputation_;
663        	if first._imputation_ then i=1;
664         		 else i+1;
665        
666        	* Assign which row this is (the row "label" in the covariance matrix) ;
667        	select(i);
668        		when(1)  _name_ = 'INTERCEPT';
669        		when(2)  _name_ = 'mowestq1';
670        		when(3)  _name_ = 'mowestq2';
671        		when(4)  _name_ = 'mowestq3';
672        		when(5)  _name_ = 'mocalq1';
673        		when(6)  _name_ = 'mocalq2';
674        		when(7)  _name_ = 'mocalq3';
675        		when(8)  _name_ = 'mopaq0';
676        		when(9)  _name_ = 'mopaq1';
677        		when(10)  _name_ = 'mopaq2';
678        		when(11)  _name_ = 'mosmk2';
679        		when(12)  _name_ = 'mosmk3';
680        		when(13)  _name_ = 'moshiftq1';
681        		when(14)  _name_ = 'moshiftq2';
682        		when(15)  _name_ = 'moshiftq3';
683        		when(16)  _name_ = 'moage';
684        		when(17)  _name_ = 'cohort';
685        		when(18)  _name_ = 'chage';
686        		when(19)  _name_ = 'white';
687        		when(20)  _name_ = 'sex';
688        		otherwise;
689        	end;
690        	
691        	* Output EVERY row;
692          	output;
693        
694        keep _imputation_ _type_ _name_ prm1-prm20 ;
695        
696        run;

