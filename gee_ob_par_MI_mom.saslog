1044       
1045       /*************************************************************************************/
1046       /**************** combine using mianalyze ********************************************/
1047       
149                                                                 The SAS System                                     17:10 Friday, November 14, 2025

1048       %macro MIPAR(dat1=, dat2=, dat3=, dat4=, dat5=);
1049       
1050       data temp;
1051       	length _Imputation_ 3;
1052       	set &dat1(in=a) &dat2(in=b) &dat3(in=c) &dat4(in=d) &dat5(in=e);
1053       	if a then _Imputation_=1;
1054         		else if b then _Imputation_=2;
1055        		else if c then _Imputation_=3;
1056         		else if d then _Imputation_=4;
1057         		else if e then _Imputation_=5;
1058         		  	
1059         	/* approximate standard error from the half-width of the CI */
1060         	StdErr = (uclpartialx - lclpartialx) / (2 * 1.96);
1061         	Estimate = partlparx;
1062         	Parameter = 'PartialPAR';
1063         	
1064         	keep _Imputation_ Estimate StdErr Parameter;
1065       run;
1066       
1067       proc mianalyze data=temp;
1068          modeleffects Estimate;
1069          stderr StdErr;
1070       run;
1071       
1072       %mend MIPAR;
1073       
1074       %MIPAR(dat1=mwest1,   dat2=mwest2,   dat3=mwest3,   dat4=mwest4,   dat5=mwest5 );

