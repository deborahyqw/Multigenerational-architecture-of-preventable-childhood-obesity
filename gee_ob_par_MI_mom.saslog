758        %macro runPAR(prefixBeta=, prefixFreq=, outpref=, modmod=, fixfix=);
759        	%local i;
760          	%do i=1 %to 5;
761        %par(
762        	bdata=&prefixBeta.&i,
763        	pdata=&prefixFreq.&i,
764        	n_or_p=N,
765        	n_or_pname=FQ,
766        	modvar= &modmod  ,
767        	missvarlist=NONE,
768        	partialpar= T,
769        	outdat= &outpref.&i,
770        	fixedvar= &fixfix );
771        	%end;
772        %mend runPAR;
