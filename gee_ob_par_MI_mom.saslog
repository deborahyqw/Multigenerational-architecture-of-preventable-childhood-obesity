571        /**********************************************************************/
572        data all;
573          set all end=_end_;
574          cohort=cohort-1;
575        
576        	%indic3(vbl=mowestq, reflev=0, missing=., min=1, max=3, prefix=mowestq, usemiss=0,
577                    label1='Q2',label2='Q3', label3='Q4');
578             %indic3(vbl=mocalq, reflev=0, missing=., min=1, max=3, prefix=mocalq, usemiss=0,
579                    label1='Q2',label2='Q3', label3='Q4');
580             %indic3(vbl=mopaq, reflev=3, missing=., min=0, max=2, prefix=mopaq, usemiss=0,
581                    label0='Q1',label1='Q2', label2='Q3');
582             %indic3(vbl=moshiftq, reflev=0, missing=., min=1, max=3, prefix=moshiftq, usemiss=0,
583                    label1='Q2',label2='Q3', label3='Q4');
584        
585        run;

