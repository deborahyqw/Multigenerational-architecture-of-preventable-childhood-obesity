779        
780        data betas;
781          set mom ;
782          by _imputation_;
783          _type_ = 'PARM';
784        	retain intercept mowestq1 mowestq2 mowestq3 mocalq1 mocalq2 mocalq3
785        					 mopaq0 mopaq1 mopaq2 mosmk2 mosmk3
786        					moshiftq1 moshiftq2 moshiftq3
787        					moage cohort chage white sex;
788        	
789        	* 'i' counts rows within each _imputation_ group ;
790          	if first._imputation_ then i=1;
791          	else i+1;
792        	
793        	select (i);
794            when (1) intercept = estimate;
795            when (2) mowestq1  = estimate;
796            when (3) mowestq2  = estimate;
797            when (4) mowestq3  = estimate;
798            when (5) mocalq1   = estimate;
799            when (6) mocalq2   = estimate;
800        	when (7) mocalq3   = estimate;
801        	when (8) mopaq0   = estimate;
802        	when (9) mopaq1   = estimate;
803        	when (10) mopaq2   = estimate;
804        	when (11) mosmk2  = estimate;
805        	when (12) mosmk3  = estimate;
806        	when (13) moshiftq1= estimate;
807        	when (14) moshiftq2= estimate;
808        	when (15) moshiftq3= estimate;
809            when (16) moage    = estimate;
810            when (17) cohort   = estimate;
811            when (18) chage    = estimate;
812            when (19) white    = estimate;
813            when (20) sex      = estimate;
814            otherwise;
815          end;
816        	
817          * Only OUTPUT once per _imputation_, after we've assigned all param columns ;
818          if last._imputation_ then output;
819        
820        run;

