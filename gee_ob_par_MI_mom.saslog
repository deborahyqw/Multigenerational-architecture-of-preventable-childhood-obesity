1219       
1220       /*************************************************************************************/
1221       /**************** combine using mianalyze ********************************************/
1222       
1223       %macro MIPAR(dat1=, dat2=, dat3=, dat4=, dat5=);
1224       
1225       data temp;
1226       	length _Imputation_ 3;
1227       	set &dat1(in=a) &dat2(in=b) &dat3(in=c) &dat4(in=d) &dat5(in=e);
1228       	if a then _Imputation_=1;
1229         		else if b then _Imputation_=2;
1230        		else if c then _Imputation_=3;
1231         		else if d then _Imputation_=4;
1232         		else if e then _Imputation_=5;
1233         		  	
1234         	/* approximate standard error from the half-width of the CI */
1235         	StdErr = (uclpartialx - lclpartialx) / (2 * 1.96);
1236         	Estimate = partlparx;
1237         	Parameter = 'PartialPAR';
1238         	
1239         	keep _Imputation_ Estimate StdErr Parameter;
1240       run;
1241       
1242       proc mianalyze data=temp;
1243          modeleffects Estimate;
1244          stderr StdErr;
1245       run;
1246       
1247       %mend MIPAR;
1248       
1249       %MIPAR(dat1=mwest1,   dat2=mwest2,   dat3=mwest3,   dat4=mwest4,   dat5=mwest5 );

