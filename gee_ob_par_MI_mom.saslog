1040       /**********************************************************************/
1041       title ' maternal modifiable factors - moob ';
1042       proc genmod data = all descending;
1043       	by _imputation_ ;
1044        class id momid ;
1045          model chob = &mowestq_ &mocalq_ &mopaq_ mosmk2 mosmk3 &moshiftq_
1046         			    moage &covar1 moob
1047            / dist = Poisson link = log;
1048            repeated subject=id(momid)/type=unstr PRINTMLE ecovb;
1049            ods output GEERCov=covmom GEEEmpPEst = mom;
1050        run;

