876        
877        data betas;
878          set mom ;
879          by _imputation_;
880          _type_ = 'PARM';
881        	retain intercept mowestq1 mowestq2 mowestq3 mocalq1 mocalq2 mocalq3
882        					 mopaq0 mopaq1 mopaq2 mosmk2 mosmk3
883        					moshiftq1 moshiftq2 moshiftq3
884        					moage cohort chage white sex moob;
885        	
886        	* 'i' counts rows within each _imputation_ group ;
887          	if first._imputation_ then i=1;
888          	else i+1;
889        	
890        	select (i);
891            when (1) intercept = estimate;
892            when (2) mowestq1  = estimate;
893            when (3) mowestq2  = estimate;
894            when (4) mowestq3  = estimate;
895            when (5) mocalq1   = estimate;
896            when (6) mocalq2   = estimate;
897        	when (7) mocalq3   = estimate;
898        	when (8) mopaq0   = estimate;
899        	when (9) mopaq1   = estimate;
900        	when (10) mopaq2   = estimate;
901        	when (11) mosmk2  = estimate;
902        	when (12) mosmk3  = estimate;
903        	when (13) moshiftq1= estimate;
904        	when (14) moshiftq2= estimate;
905        	when (15) moshiftq3= estimate;
906            when (16) moage    = estimate;
907            when (17) cohort   = estimate;
908            when (18) chage    = estimate;
909            when (19) white    = estimate;
910            when (20) sex      = estimate;
911            when (21) moob     = estimate;
912            otherwise;
913          end;
914        	
915          * Only OUTPUT once per _imputation_, after we've assigned all param columns ;
916          if last._imputation_ then output;
917        
918          if mowestq1 <0 then  mowestq1 =0;    if mowestq2 <0 then  mowestq2 =0;
919        
920        run;

