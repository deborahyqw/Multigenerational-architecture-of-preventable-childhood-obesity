823        data covparms;
824        	set covmom;
825        	by _imputation_;
826        	length _type_ $4;
827        	 _type_ = 'COV';
828        
829        	rename  Prm1=intercept   Prm2=mowestq1   Prm3=mowestq2   Prm4=mowestq3   Prm5=mocalq1
830        			Prm6=mocalq2     Prm7=mocalq3
831        			Prm8=mopaq0     Prm9=mopaq1    Prm10=mopaq2    Prm11=mosmk2   Prm12=mosmk3
832        			Prm13=moshiftq1  Prm14=moshiftq2  Prm15=moshiftq3   Prm16=moage
833        			Prm17=cohort     Prm18=chage      Prm19=white       Prm20=sex   ;
834        
835        	length _name_ $10;
836        	
837        	*i counts rows within each _imputation_;
838        	if first._imputation_ then i=1;
839         		 else i+1;
840        
841        	* Assign which row this is (the row "label" in the covariance matrix) ;
842        	select(i);
843        		when(1)  _name_ = 'INTERCEPT';
844        		when(2)  _name_ = 'mowestq1';
845        		when(3)  _name_ = 'mowestq2';
846        		when(4)  _name_ = 'mowestq3';
847        		when(5)  _name_ = 'mocalq1';
848        		when(6)  _name_ = 'mocalq2';
849        		when(7)  _name_ = 'mocalq3';
850        		when(8)  _name_ = 'mopaq0';
851        		when(9)  _name_ = 'mopaq1';
852        		when(10)  _name_ = 'mopaq2';
853        		when(11)  _name_ = 'mosmk2';
854        		when(12)  _name_ = 'mosmk3';
855        		when(13)  _name_ = 'moshiftq1';
856        		when(14)  _name_ = 'moshiftq2';
857        		when(15)  _name_ = 'moshiftq3';
858        		when(16)  _name_ = 'moage';
27                                                                  The SAS System                                        16:09 Tuesday, June 24, 2025

859        		when(17)  _name_ = 'cohort';
860        		when(18)  _name_ = 'chage';
861        		when(19)  _name_ = 'white';
862        		when(20)  _name_ = 'sex';
863        		otherwise;
864        	end;
865        	
866        	* Output EVERY row;
867          	output;
