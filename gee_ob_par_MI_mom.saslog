588        
589        %LET covar1= cohort chage white sex ;
590        
591        run;
592        
593        /**********************************************************************/
594        title ' maternal modifiable factors - not adjusting for moob because it may be on the causal pathways ';
595        proc genmod data = all descending;
596        	by _imputation_ ;
597         class id momid ;
598           model chob = &mowestq_ &mocalq_ &mopaq_ mosmk2 mosmk3 &moshiftq_
599          			    moage &covar1
600             / dist = Poisson link = log;
601             repeated subject=id(momid)/type=unstr PRINTMLE ecovb;
602             ods output GEERCov=covmom GEEEmpPEst = mom;
603         run;

NOTE: The DESCENDING option applies only to the multinomial distribution with ordinal response.
