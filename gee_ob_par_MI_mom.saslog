865        /**********************************************************************/
866        title ' maternal modifiable factors - moob ';
867        proc genmod data = all descending;
868        	by _imputation_ ;
869         class id momid ;
870           model chob = &mowestq_ &mocalq_ &mopaq_ mosmk2 mosmk3 &moshiftq_
871          			    moage &covar1 moob
872             / dist = Poisson link = log;
873             repeated subject=id(momid)/type=unstr PRINTMLE ecovb;
874             ods output GEERCov=covmom GEEEmpPEst = mom;
875         run;

NOTE: The DESCENDING option applies only to the multinomial distribution with ordinal response.
