851            when (22) pregcomp2  = estimate;  when (23) bpregow   = estimate;   when (24) sesq0     = estimate;
852            when (25) sesq1     = estimate;
853            when (26) sesq2     = estimate;   when (27) heduc1   = estimate;    when (28) heduc2   = estimate;
854            when (29) fincome1  = estimate;   when (30) fincome2  = estimate;   when (31) fincome3   = estimate;
855            when (32) chwestq1  = estimate;   when (33) chwestq2  = estimate;   when (34) chwestq3  = estimate;
856            when (35) chstq1    = estimate;   when (36) chstq2    = estimate;   when (37) chstq3    = estimate;
857            when (38) chpaq0    = estimate;   when (39) chpaq1    = estimate;   when (40) chpaq2   = estimate;
858            when (41) chcalq1  = estimate;    when (42) chcalq2  = estimate;    when (43) chcalq3  = estimate;
859            when (44) prev_preg1= estimate;   when (45) prev_preg2  = estimate; when (46) prev_preg3  = estimate;
860            when (47) midwest  = estimate;    when (48) south    = estimate;    when (49) west     = estimate;
861            when (50) moage    = estimate;    when (51) cohort   = estimate;    when (52) chage    = estimate;
862            when (53) white    = estimate;    when (54) sex      = estimate;    when (55) chbmibase = estimate;
863            otherwise;
864          end;
865        	
866          * Only OUTPUT once per _imputation_, after we've assigned all param columns ;
867          if last._imputation_ then output;
868        
869          * set negative beta to 0 to 1) avoid errors in PAR and 2) to prevent certain exposures were omitted from PAR calculation;
870          if mowestq1 <0 then  mowestq1 =0;    if mowestq2 <0 then  mowestq2 =0;
871          if mowestq3 <0 then  mowestq3 =0;    if mopaq0 <0 then mopaq0 =0;
872          if mopaq1 <0 then mopaq1 =0;         if mopaq2 <0 then mopaq2 =0;
