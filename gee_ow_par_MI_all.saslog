1084       		       		  		 		 		 		 		 		 			       		  		 		 		 		 		 		
1085       *************************************************************************************
1086       **************** combine using mianalyze ********************************************;
1087       
1088       %macro MIPAR(dat1=, dat2=, dat3=, dat4=, dat5=);
1089       
1090       data temp;
1091       	length _Imputation_ 3;
1092       	set &dat1(in=a) &dat2(in=b) &dat3(in=c) &dat4(in=d) &dat5(in=e);
1093       	if a then _Imputation_=1;
1094         		else if b then _Imputation_=2;
1095        		else if c then _Imputation_=3;
1096         		else if d then _Imputation_=4;
1097         		else if e then _Imputation_=5;
1098         		  	
1099         	/* approximate standard error from the half-width of the CI */
1100         	StdErr = (uclpartialx - lclpartialx) / (2 * 1.96);
1101         	Estimate = partlparx;
1102         	Parameter = 'PartialPAR';
1103         	
1104         	keep _Imputation_ Estimate StdErr Parameter;
1105       run;
1106       
1107       proc mianalyze data=temp;
1108          modeleffects Estimate;
1109          stderr StdErr;
1110       run;
1111       
1112       %mend MIPAR;
1113       
1114       %MIPAR(dat1=comp1,   dat2=comp2,   dat3=comp3,   dat4=comp4,   dat5=comp5 );

