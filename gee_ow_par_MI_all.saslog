832        %macro runPAR(prefixBeta=, prefixFreq=, outpref=, modmod=, fixfix=);
833        	%local i;
834          	%do i=1 %to 5;
835        %par(
836        	bdata=&prefixBeta.&i,
837        	pdata=&prefixFreq.&i,
838        	n_or_p=N,
839        	n_or_pname=FQ,
840        	modvar= &modmod  ,
841        	missvarlist=NONE,
842        	partialpar= T,
843        	outdat= &outpref.&i,
844        	fixedvar= &fixfix );
845        	%end;
846        %mend runPAR;
847        
