826        
827        data betas;
828          set comp ;
829          by _imputation_;
830          _type_ = 'PARM';
831        	retain intercept mowestq1 mowestq2 mowestq3 mocalq1 mocalq2 mocalq3
832        		mopaq0 mopaq1 mopaq2 mosmk2 mosmk3 moow moshiftq1 moshiftq2 moshiftq3
833        		abwt1 abwt3 gweek1 gweek3 Delivery pregcomp2 bpregow
834        		sesq0 sesq1 sesq2 heduc1 heduc2 fincome1 fincome2 fincome3
835        		chwestq1 chwestq2 chwestq3 chstq1 chstq2 chstq3 chpaq0 chpaq1 chpaq2 chcalq1 chcalq2 chcalq3
836        		prev_preg1 prev_preg2 prev_preg3  midwest south west
837        		moage cohort chage white sex chbmibase ;
838        	
839        	* 'i' counts rows within each _imputation_ group ;
840          	if first._imputation_ then i=1;
841          	else i+1;
842        	
843        	select (i);
844            when (1) intercept = estimate;    when (2) mowestq1  = estimate;    when (3) mowestq2  = estimate;
845            when (4) mowestq3  = estimate;    when (5) mocalq1   = estimate;    when (6) mocalq2   = estimate;
846        	when (7) mocalq3   = estimate;    when (8) mopaq0   = estimate;    when (9) mopaq1   = estimate;
847        	when (10) mopaq2   = estimate;    when (11) mosmk2  = estimate;    when (12) mosmk3  = estimate;
848        	when (13) moow     = estimate;    when (14) moshiftq1= estimate;    when (15) moshiftq2= estimate;
849        	when (16) moshiftq3= estimate;    when (17) abwt1     = estimate;   when (18) abwt3     = estimate;
850            when (19) gweek1    = estimate;   when (20) gweek3    = estimate;   when (21) Delivery  = estimate;
