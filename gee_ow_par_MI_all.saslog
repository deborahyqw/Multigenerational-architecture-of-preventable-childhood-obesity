801        
802        %LET covar1= cohort chage white sex ;
803        
804        run;
805        
806        /**********************************************************************/
807        title ' all factors ';
808        proc genmod data = all descending;
809        	by _imputation_ ;
810         class id momid ;
811           model chow = &mowestq_ &mocalq_ &mopaq_ mosmk2 mosmk3 moow &moshiftq_
812          				abwt1 abwt3 gweek1 gweek3 Delivery pregcomp2 bpregow
813          				&sesq_ heduc1 heduc2 fincome1 fincome2 fincome3
814        				&chwestq_ &chstq_ &chpaq_ &chcalq_
815           				prev_preg1 prev_preg2 prev_preg3 midwest south west
816           				moage &covar1 chbmibase
817              / dist = Poisson link = log;
818             repeated subject=id(momid)/type=unstr PRINTMLE ecovb;
819             ods output GEERCov=covcomp GEEEmpPEst = comp;
820         run;

