891        		       		  		 		 		 		 		 		 			       		  		 		 		 		 		 		
892        *************************************************************************************
893        **************** combine using mianalyze ********************************************;
894        
895        %macro MIPAR(dat1=, dat2=, dat3=, dat4=, dat5=);
896        
897        data temp;
898        	length _Imputation_ 3;
899        	set &dat1(in=a) &dat2(in=b) &dat3(in=c) &dat4(in=d) &dat5(in=e);
900        	if a then _Imputation_=1;
901          		else if b then _Imputation_=2;
902         		else if c then _Imputation_=3;
903          		else if d then _Imputation_=4;
904          		else if e then _Imputation_=5;
905          		  	
906          	/* approximate standard error from the half-width of the CI */
907          	StdErr = (uclpartialx - lclpartialx) / (2 * 1.96);
908          	Estimate = partlparx;
909          	Parameter = 'PartialPAR';
910          	
911          	keep _Imputation_ Estimate StdErr Parameter;
912        run;
913        
914        proc mianalyze data=temp;
915           modeleffects Estimate;
916           stderr StdErr;
917        run;
918        
919        %mend MIPAR;
920        
921        %MIPAR(dat1=comp1,   dat2=comp2,   dat3=comp3,   dat4=comp4,   dat5=comp5 );

