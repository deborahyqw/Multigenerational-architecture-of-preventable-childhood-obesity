612        
613        /**********************************************************************/
614        title ' all factors ';
615        proc genmod data = all descending;
616        	by _imputation_ ;
617         class id momid ;
618           model chow = &mowestq_ &mocalq_ &mopaq_ mosmk2 mosmk3 moow &moshiftq_
619          				abwt1 abwt3 gweek1 gweek3 Delivery pregcomp2 bpregow
620          				&sesq_ heduc1 heduc2 fincome1 fincome2 fincome3
621        				&chwestq_ &chstq_ &chpaq_ &chcalq_
622           				prev_preg1 prev_preg2 prev_preg3 midwest south west
623           				moage &covar1 chbmibase
624              / dist = Poisson link = log;
625             repeated subject=id(momid)/type=unstr PRINTMLE ecovb;
626             ods output GEERCov=covcomp GEEEmpPEst = comp;
627         run;

