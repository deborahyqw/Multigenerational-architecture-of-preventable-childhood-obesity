797        
798        /**********************************************************************/
799        title ' all factors ';
800        proc genmod data = all descending;
801        	by _imputation_ ;
802         class id momid ;
803           model chob = &mowestq_ &mocalq_ &mopaq_ mosmk2 mosmk3 moob &moshiftq_
804          				abwt1 abwt3 gweek1 gweek3 Delivery pregcomp2 bpregob
805          				&sesq_ heduc1 heduc2 fincome1 fincome2 fincome3
806        				&chwestq_ &chstq_ &chpaq_ &chcalq_
807           				prev_preg1 prev_preg2 prev_preg3 midwest south west
808           				moage &covar1 chbmibase
809              / dist = Poisson link = log;
810             repeated subject=id(momid)/type=unstr PRINTMLE ecovb;
811             ods output GEERCov=covcomp GEEEmpPEst = comp;
812         run;

NOTE: The DESCENDING option applies only to the multinomial distribution with ordinal response.
