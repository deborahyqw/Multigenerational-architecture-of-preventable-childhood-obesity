1089       		       		  		 		 		 		 		 		 			       		  		 		 		 		 		 		
1090       *************************************************************************************
1091       **************** combine using mianalyze ********************************************;
1092       
1093       %macro MIPAR(dat1=, dat2=, dat3=, dat4=, dat5=);
1094       
1095       data temp;
1096       	length _Imputation_ 3;
1097       	set &dat1(in=a) &dat2(in=b) &dat3(in=c) &dat4(in=d) &dat5(in=e);
1098       	if a then _Imputation_=1;
1099         		else if b then _Imputation_=2;
1100        		else if c then _Imputation_=3;
1101         		else if d then _Imputation_=4;
1102         		else if e then _Imputation_=5;
1103         		  	
1104         	/* approximate standard error from the half-width of the CI */
1105         	StdErr = (uclpartialx - lclpartialx) / (2 * 1.96);
1106         	Estimate = partlparx;
1107         	Parameter = 'PartialPAR';
1108         	
1109         	keep _Imputation_ Estimate StdErr Parameter;
1110       run;
1111       
1112       proc mianalyze data=temp;
1113          modeleffects Estimate;
1114          stderr StdErr;
1115       run;
1116       
1117       %mend MIPAR;
1118       
1119       %MIPAR(dat1=comp1,   dat2=comp2,   dat3=comp3,   dat4=comp4,   dat5=comp5 );

