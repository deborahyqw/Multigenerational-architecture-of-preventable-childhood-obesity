604        
605        /**********************************************************************/
606        title ' all factors ';
607        proc genmod data = all descending;
608        	by _imputation_ ;
609         class id momid ;
610           model chob = &mowestq_ &mocalq_ &mopaq_ mosmk2 mosmk3 moob &moshiftq_
611          				abwt1 abwt3 gweek1 gweek3 Delivery pregcomp2 bpregob
612          				&sesq_ heduc1 heduc2 fincome1 fincome2 fincome3
613        				&chwestq_ &chstq_ &chpaq_ &chcalq_
614           				prev_preg1 prev_preg2 prev_preg3 midwest south west
615           				moage &covar1 chbmibase
616              / dist = Poisson link = log;
617             repeated subject=id(momid)/type=unstr PRINTMLE ecovb;
618             ods output GEERCov=covcomp GEEEmpPEst = comp;
619         run;

