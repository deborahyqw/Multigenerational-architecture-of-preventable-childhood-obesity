837        %macro runPAR(prefixBeta=, prefixFreq=, outpref=, modmod=, fixfix=);
838        	%local i;
839          	%do i=1 %to 5;
840        %par(
841        	bdata=&prefixBeta.&i,
842        	pdata=&prefixFreq.&i,
843        	n_or_p=N,
844        	n_or_pname=FQ,
845        	modvar= &modmod  ,
846        	missvarlist=NONE,
847        	partialpar= T,
848        	outdat= &outpref.&i,
849        	fixedvar= &fixfix );
850        	%end;
851        %mend runPAR;
852        
