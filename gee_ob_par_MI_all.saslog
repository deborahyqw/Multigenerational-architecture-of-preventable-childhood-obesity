711        			Prm51=cohort     Prm52=chage      Prm53=white      Prm54=sex        Prm55=chbmibase   ;
712        
713        	length _name_ $15;
714        	
715        	*i counts rows within each _imputation_;
716        	if first._imputation_ then i=1;
717         		 else i+1;
718        
719        	* Assign which row this is (the row "label" in the covariance matrix) ;
720        	select(i);
721        		when(1)  _name_ = 'INTERCEPT';   when(2)  _name_ = 'mowestq1';   when(3)  _name_ = 'mowestq2';
722        		when(4)  _name_ = 'mowestq3';    when(5)  _name_ = 'mocalq1';    when(6)  _name_ = 'mocalq2';
