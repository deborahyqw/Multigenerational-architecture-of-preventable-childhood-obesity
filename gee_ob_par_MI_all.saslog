641        
642        data betas;
643          set comp ;
644          by _imputation_;
645          _type_ = 'PARM';
646        	retain intercept mowestq1 mowestq2 mowestq3 mocalq1 mocalq2 mocalq3
647        		mopaq0 mopaq1 mopaq2 mosmk2 mosmk3 moob moshiftq1 moshiftq2 moshiftq3
648        		abwt1 abwt3 gweek1 gweek3 Delivery pregcomp2 bpregob
649        		sesq0 sesq1 sesq2 heduc1 heduc2 fincome1 fincome2 fincome3
650        		chwestq1 chwestq2 chwestq3 chstq1 chstq2 chstq3 chpaq0 chpaq1 chpaq2 chcalq1 chcalq2 chcalq3
651        		prev_preg1 prev_preg2 prev_preg3  midwest south west
652        		moage cohort chage white sex chbmibase ;
653        	
654        	* 'i' counts rows within each _imputation_ group ;
655          	if first._imputation_ then i=1;
656          	else i+1;
657        	
658        	select (i);
659            when (1) intercept = estimate;    when (2) mowestq1  = estimate;    when (3) mowestq2  = estimate;
660            when (4) mowestq3  = estimate;    when (5) mocalq1   = estimate;    when (6) mocalq2   = estimate;
661        	when (7) mocalq3   = estimate;    when (8) mopaq0   = estimate;    when (9) mopaq1   = estimate;
662        	when (10) mopaq2   = estimate;    when (11) mosmk2  = estimate;    when (12) mosmk3  = estimate;
663        	when (13) moob     = estimate;    when (14) moshiftq1= estimate;    when (15) moshiftq2= estimate;
664        	when (16) moshiftq3= estimate;    when (17) abwt1     = estimate;   when (18) abwt3     = estimate;
665            when (19) gweek1    = estimate;   when (20) gweek3    = estimate;   when (21) Delivery  = estimate;
666            when (22) pregcomp2  = estimate;  when (23) bpregob   = estimate;   when (24) sesq0     = estimate;
667            when (25) sesq1     = estimate;
668            when (26) sesq2     = estimate;   when (27) heduc1   = estimate;    when (28) heduc2   = estimate;
669            when (29) fincome1  = estimate;   when (30) fincome2  = estimate;   when (31) fincome3   = estimate;
670            when (32) chwestq1  = estimate;   when (33) chwestq2  = estimate;   when (34) chwestq3  = estimate;
671            when (35) chstq1    = estimate;   when (36) chstq2    = estimate;   when (37) chstq3    = estimate;
672            when (38) chpaq0    = estimate;   when (39) chpaq1    = estimate;   when (40) chpaq2   = estimate;
673            when (41) chcalq1  = estimate;    when (42) chcalq2  = estimate;    when (43) chcalq3  = estimate;
674            when (44) prev_preg1= estimate;   when (45) prev_preg2  = estimate; when (46) prev_preg3  = estimate;
675            when (47) midwest  = estimate;    when (48) south    = estimate;    when (49) west     = estimate;
676            when (50) moage    = estimate;    when (51) cohort   = estimate;    when (52) chage    = estimate;
677            when (53) white    = estimate;    when (54) sex      = estimate;    when (55) chbmibase = estimate;
678            otherwise;
679          end;
680        	
681          * Only OUTPUT once per _imputation_, after we've assigned all param columns ;
13                                                                  The SAS System                                     16:50 Friday, November 14, 2025

682          if last._imputation_ then output;
683        
684          * set negative beta to 0 to 1) avoid errors in PAR and 2) to prevent certain exposures were omitted from PAR calculation;
685          if mowestq1 <0 then  mowestq1 =0;    if mowestq2 <0 then  mowestq2 =0;
686          if mowestq3 <0 then  mowestq3 =0;    if mosmk3 <0 then mosmk3 =0;
687          if gweek1 <0 then  gweek1=0;         if fincome1 <0 then fincome1 =0;  if fincome2 <0 then fincome2 =0;
688          if chwestq1 <0 then chwestq1 =0;     if pregcomp2 <0 then pregcomp2=0;
689          if chpaq2 <0 then chpaq2 =0;         if MOSHIFTQ3 <0 then MOSHIFTQ3=0;
690        
691        run;

