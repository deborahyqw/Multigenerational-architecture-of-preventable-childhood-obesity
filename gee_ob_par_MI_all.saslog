896        		       		  		 		 		 		 		 		 			       		  		 		 		 		 		 		
897        *************************************************************************************
898        **************** combine using mianalyze ********************************************;
899        
900        %macro MIPAR(dat1=, dat2=, dat3=, dat4=, dat5=);
901        
902        data temp;
903        	length _Imputation_ 3;
904        	set &dat1(in=a) &dat2(in=b) &dat3(in=c) &dat4(in=d) &dat5(in=e);
905        	if a then _Imputation_=1;
906          		else if b then _Imputation_=2;
907         		else if c then _Imputation_=3;
908          		else if d then _Imputation_=4;
909          		else if e then _Imputation_=5;
910          		  	
911          	/* approximate standard error from the half-width of the CI */
912          	StdErr = (uclpartialx - lclpartialx) / (2 * 1.96);
913          	Estimate = partlparx;
914          	Parameter = 'PartialPAR';
915          	
916          	keep _Imputation_ Estimate StdErr Parameter;
917        run;
918        
919        proc mianalyze data=temp;
920           modeleffects Estimate;
921           stderr StdErr;
922        run;
923        
924        %mend MIPAR;
925        
926        %MIPAR(dat1=comp1,   dat2=comp2,   dat3=comp3,   dat4=comp4,   dat5=comp5 );

