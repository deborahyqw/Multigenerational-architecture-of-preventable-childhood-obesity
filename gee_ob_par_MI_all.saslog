704        			Prm18=abwt3      Prm19=gweek1     Prm20=gweek3     Prm21=Delivery   Prm22=pregcomp2
705        			Prm23=bpregob    Prm24=sesq0      Prm25=sesq1      Prm26=sesq2      Prm27=heduc1
706        			Prm28=heduc2     Prm29=fincome1   Prm30=fincome2   Prm31=fincome3
707        			Prm32=chwestq1   Prm33=chwestq2   Prm34=chwestq3   Prm35=chstq1     Prm36=chstq2
