729                when(23)  _name_ = 'bpregob';    when(24)  _name_ = 'sesq0';     when(25)  _name_ = 'sesq1';
730                when(26)  _name_ = 'sesq2';      when(27)  _name_ = 'heduc1';    when(28)  _name_ = 'heduc2';
731                when(29)  _name_ = 'fincome1';   when(30)  _name_ = 'fincome2';  when(31)  _name_ = 'fincome3';
732                when(32)  _name_ = 'chwestq1';   when(33)  _name_ = 'chwestq2';  when(34)  _name_ = 'chwestq3';
