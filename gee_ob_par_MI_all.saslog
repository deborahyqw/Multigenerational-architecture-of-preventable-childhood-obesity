833        	;
834        
835        data betas;
836          set comp ;
837          by _imputation_;
838          _type_ = 'PARM';
839        	retain intercept mowestq1 mowestq2 mowestq3 mocalq1 mocalq2 mocalq3
840        		mopaq0 mopaq1 mopaq2 mosmk2 mosmk3 moob moshiftq1 moshiftq2 moshiftq3
841        		abwt1 abwt3 gweek1 gweek3 Delivery pregcomp2 bpregob
842        		sesq0 sesq1 sesq2 heduc1 heduc2 fincome1 fincome2 fincome3
843        		chwestq1 chwestq2 chwestq3 chstq1 chstq2 chstq3 chpaq0 chpaq1 chpaq2 chcalq1 chcalq2 chcalq3
844        		prev_preg1 prev_preg2 prev_preg3  midwest south west
845        		moage cohort chage white sex chbmibase ;
846        	
847        	* 'i' counts rows within each _imputation_ group ;
848          	if first._imputation_ then i=1;
849          	else i+1;
850        	
851        	select (i);
852            when (1) intercept = estimate;    when (2) mowestq1  = estimate;    when (3) mowestq2  = estimate;
853            when (4) mowestq3  = estimate;    when (5) mocalq1   = estimate;    when (6) mocalq2   = estimate;
854        	when (7) mocalq3   = estimate;    when (8) mopaq0   = estimate;    when (9) mopaq1   = estimate;
855        	when (10) mopaq2   = estimate;    when (11) mosmk2  = estimate;    when (12) mosmk3  = estimate;
856        	when (13) moob     = estimate;    when (14) moshiftq1= estimate;    when (15) moshiftq2= estimate;
857        	when (16) moshiftq3= estimate;    when (17) abwt1     = estimate;   when (18) abwt3     = estimate;
858            when (19) gweek1    = estimate;   when (20) gweek3    = estimate;   when (21) Delivery  = estimate;
859            when (22) pregcomp2  = estimate;  when (23) bpregob   = estimate;   when (24) sesq0     = estimate;
860            when (25) sesq1     = estimate;
861            when (26) sesq2     = estimate;   when (27) heduc1   = estimate;    when (28) heduc2   = estimate;
862            when (29) fincome1  = estimate;   when (30) fincome2  = estimate;   when (31) fincome3   = estimate;
863            when (32) chwestq1  = estimate;   when (33) chwestq2  = estimate;   when (34) chwestq3  = estimate;
864            when (35) chstq1    = estimate;   when (36) chstq2    = estimate;   when (37) chstq3    = estimate;
865            when (38) chpaq0    = estimate;   when (39) chpaq1    = estimate;   when (40) chpaq2   = estimate;
866            when (41) chcalq1  = estimate;    when (42) chcalq2  = estimate;    when (43) chcalq3  = estimate;
867            when (44) prev_preg1= estimate;   when (45) prev_preg2  = estimate; when (46) prev_preg3  = estimate;
868            when (47) midwest  = estimate;    when (48) south    = estimate;    when (49) west     = estimate;
869            when (50) moage    = estimate;    when (51) cohort   = estimate;    when (52) chage    = estimate;
870            when (53) white    = estimate;    when (54) sex      = estimate;    when (55) chbmibase = estimate;
871            otherwise;
872          end;
873        	
874          * Only OUTPUT once per _imputation_, after we've assigned all param columns ;
875          if last._imputation_ then output;
876        
877          * set negative beta to 0 to 1) avoid errors in PAR and 2) to prevent certain exposures were omitted from PAR calculation;
878          if mowestq1 <0 then  mowestq1 =0;    if mowestq2 <0 then  mowestq2 =0;
879          if mowestq3 <0 then  mowestq3 =0;    if mosmk3 <0 then mosmk3 =0;
880          if gweek1 <0 then  gweek1=0;         if fincome1 <0 then fincome1 =0;
881          if fincome2 <0 then fincome2 =0;     if fincome3 <0 then fincome3 =0;
882          if chpaq2 <0 then chpaq2 =0;         if MOSHIFTQ3 <0 then MOSHIFTQ3=0;
