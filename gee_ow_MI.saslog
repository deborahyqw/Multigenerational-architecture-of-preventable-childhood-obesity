626        
627        /**********************************************************************/
628        title ' maternal modifiable factors - not adjusting for moow because it may be on the causal pathways ';
629        proc genmod data = all descending;
630        	by _imputation_ ;
631         class id momid ;
632           model chow = &mowestq_ &mocalq_ &mopaq_ mosmk2 mosmk3
633          				&moshiftq_
634          			    moage &covar1
635             / dist = Poisson link = log;
636             repeated subject=id(momid)/type=unstr PRINTMLE ecovb;
637             ods output GEEEmpPEst = mom;
638         run;

