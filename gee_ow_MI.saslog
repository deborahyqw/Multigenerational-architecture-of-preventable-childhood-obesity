794        /**********************************************************************/
795        title ' maternal modifiable factors - not adjusting for moow because it may be on the causal pathways ';
796        proc genmod data = all descending;
797        	by _imputation_ ;
798         class id momid ;
799           model chow = &mowestq_ &mocalq_ &mopaq_ mosmk2 mosmk3
800          				&moshiftq_
801          			    moage &covar1
802             / dist = Poisson link = log;
803             repeated subject=id(momid)/type=unstr PRINTMLE ecovb;
804             ods output GEEEmpPEst = mom;
805         run;

