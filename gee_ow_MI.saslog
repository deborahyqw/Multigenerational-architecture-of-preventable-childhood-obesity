590             %indic3(vbl=mopaq, reflev=3, missing=., min=0, max=2, prefix=mopaq, usemiss=0,
591                    label0='Q1',label1='Q2', label2='Q3');
592             %indic3(vbl=moshiftq, reflev=0, missing=., min=1, max=3, prefix=moshiftq, usemiss=0,
593                    label1='Q2',label2='Q3', label3='Q4');
594        
