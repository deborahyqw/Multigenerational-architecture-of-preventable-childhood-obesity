1100       *****************************************;
1101       ************** PREPARE DATA FOR TABLE *************************;
1102       data allow;
1103       length Parm $ 15;
1104          set mi_mom(in=a) mi_momt(in=b) mi_mob(in=c)
1105          	   mi_momsensi(in=d) mi_momsensit(in=e) mi_mobsensi(in=f)
1106          	   mi_uter(in=g) mi_pregob(in=h)
1107          	   mi_soc(in=i) mi_soct(in=j) mi_edu(in=k) mi_edut(in=l)
1108          	   mi_inc(in=m) mi_inct(in=n)  mi_life(in=o) mi_lifet(in=p) ;
1109         	
1110         	if a then mod="mom";
1111         	if b then mod="mom trend";
1112         	if c then mod="mom ow";
1113         	if d then mod="mom sensi";
1114         	if e then mod="mom sensi trend";
1115         	if f then mod="mom ow sensi";
1116         	if g then mod="uter";
1117         	if h then mod="pregow";
1118         	if i then mod="socio";
1119         	if j then mod="socio trend";
1120         	if k then mod="edu";
1121         	if l then mod="edu trend";
1122         	if m then mod="income";
1123         	if n then mod="income trend";
1124         	if o then mod="life";
1125         	if p then mod="life trend";
1126       
1127       	RR=exp(Estimate); LCI=exp(LCLMean); UCI=exp(UCLMean);
1128       
1129       run;

