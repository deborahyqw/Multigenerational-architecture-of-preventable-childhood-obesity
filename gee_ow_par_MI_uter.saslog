778        
779        data betas;
780          set uter ;
781          by _imputation_;
782          _type_ = 'PARM';
783        	retain intercept agebirth abwt1 abwt3 gweek1 gweek3 Delivery pregcomp2
784                        bpregow prev_preg1 prev_preg2 prev_preg3
785          				cohort chage white sex;
786        	
787        	* 'i' counts rows within each _imputation_ group ;
788          	if first._imputation_ then i=1;
789          	else i+1;
790        	
791        	select (i);
792            when (1) intercept = estimate;
793            when (2) agebirth  = estimate;
794            when (3) abwt1     = estimate;
795            when (4) abwt3     = estimate;
796            when (5) gweek1    = estimate;
797            when (6) gweek3    = estimate;
798            when (7) Delivery  = estimate;
799        	when (8) pregcomp2  = estimate;
800        	when (9) bpregow   = estimate;
801        	when (10) prev_preg1= estimate;
802        	when (11) prev_preg2  = estimate;
803        	when (12) prev_preg3  = estimate;
804            when (13) cohort   = estimate;
805            when (14) chage    = estimate;
806            when (15) white    = estimate;
807            when (16) sex      = estimate;
808            otherwise;
809          end;
810        	
811          * Only OUTPUT once per _imputation_, after we've assigned all param columns ;
812          if last._imputation_ then output;
813        
814           if abwt1 <0 then abwt1 =0;   if gweek1 <0 then gweek1 =0;
815        
816        run;

