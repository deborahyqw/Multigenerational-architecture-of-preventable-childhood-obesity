856        *proc print data=betas;
857        
858        data covparms;
859        	set covuter;
860        	by _imputation_;
861        	length _type_ $4;
862        	 _type_ = 'COV';
863        
864        	rename  Prm1=intercept   Prm2=agebirth   Prm3=bpregow   Prm4=prev_preg1   Prm5=prev_preg2
865        			Prm6=prev_preg3  Prm7=cohort     Prm8=chage     Prm9=white        Prm10=sex   ;
866        
867        	length _name_ $10;
868        	
869        	*i counts rows within each _imputation_;
870        	if first._imputation_ then i=1;
871         		 else i+1;
872        
873        	* Assign which row this is (the row "label" in the covariance matrix) ;
874        	select(i);
875        		when(1)  _name_ = 'INTERCEPT';
876        		when(2)  _name_ = 'agebirth';
877        		when(3)  _name_ = 'bpregow';
878        		when(4)  _name_ = 'prev_preg1';
879        		when(5)  _name_ = 'prev_preg2';
880        		when(6)  _name_ = 'prev_preg3';
881        		when(7)  _name_ = 'cohort';
882        		when(8)  _name_ = 'chage';
883        		when(9)  _name_ = 'white';
884        		when(10) _name_ = 'sex';
885        		otherwise;
886        	end;
887        	
888        	* Output EVERY row;
889          	output;
890        
891        keep _imputation_ _type_ _name_ prm1-prm10 ;
892        
893        run;

