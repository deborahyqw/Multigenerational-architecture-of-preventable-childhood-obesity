816        /**********************************************************************/
817        title ' bpregow & agebirth - not adjusting for other in-uterine factors factors because they may be on the causal pathways';
818        proc genmod data = all descending;
819        	by _imputation_ ;
820         class id momid ;
821           model chow = agebirth bpregow prev_preg1 prev_preg2 prev_preg3 &covar1
822             / dist = Poisson link = log;
823             repeated subject=id(momid)/type=unstr PRINTMLE ecovb;
824             ods output GEERCov=covuter GEEEmpPEst = uter;
825         run;

