592        /**********************************************************************/
593        title ' in-uterine factors - adjusting for bpregow & agebirth';
594        proc genmod data = all descending;
595        	by _imputation_ ;
596         class id momid ;
597           model chow = agebirth abwt1 abwt3 gweek1 gweek3 Delivery pregcomp2
598                        bpregow prev_preg1 prev_preg2 prev_preg3 &covar1
599             / dist = Poisson link = log;
600             repeated subject=id(momid)/type=unstr PRINTMLE ecovb;
601             ods output GEERCov=covuter GEEEmpPEst = uter;
602         run;

