1001       
1002       data betas;
1003         set uter ;
1004         by _imputation_;
1005         _type_ = 'PARM';
1006       	retain intercept agebirth  bpregow prev_preg1 prev_preg2 prev_preg3
1007         				cohort chage white sex;
1008       	
1009       	* 'i' counts rows within each _imputation_ group ;
1010         	if first._imputation_ then i=1;
1011         	else i+1;
1012       	
1013       	select (i);
1014           when (1) intercept = estimate;
1015           when (2) agebirth  = estimate;
1016           when (3) bpregow   = estimate;
1017           when (4) prev_preg1  = estimate;
1018           when (5) prev_preg2  = estimate;
1019           when (6) prev_preg3  = estimate;
1020           when (7) cohort   = estimate;
1021           when (8) chage    = estimate;
1022           when (9) white    = estimate;
1023           when (10) sex     = estimate;
1024           otherwise;
1025         end;
1026       	
1027         * Only OUTPUT once per _imputation_, after we've assigned all param columns ;
1028         if last._imputation_ then output;
1029       
1030       run;

