1128       
1129       /*************************************************************************************/
1130       /**************** combine using mianalyze ********************************************/
1131       
1132       %macro MIPAR(dat1=, dat2=, dat3=, dat4=, dat5=);
1133       
1134       data temp;
1135       	length _Imputation_ 3;
1136       	set &dat1(in=a) &dat2(in=b) &dat3(in=c) &dat4(in=d) &dat5(in=e);
1137       	if a then _Imputation_=1;
1138         		else if b then _Imputation_=2;
1139        		else if c then _Imputation_=3;
1140         		else if d then _Imputation_=4;
1141         		else if e then _Imputation_=5;
1142         		  	
1143         	/* approximate standard error from the half-width of the CI */
1144         	StdErr = (uclpartialx - lclpartialx) / (2 * 1.96);
1145         	Estimate = partlparx;
1146         	Parameter = 'PartialPAR';
1147         	
1148         	keep _Imputation_ Estimate StdErr Parameter;
1149       run;
1150       
1151       proc mianalyze data=temp;
111                                                                 The SAS System                                        13:32 Tuesday, June 24, 2025

1152          modeleffects Estimate;
1153          stderr StdErr;
1154       run;
1155       
1156       %mend MIPAR;
1157       
