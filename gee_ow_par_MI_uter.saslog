953        
954        /*************************************************************************************/
955        /**************** combine using mianalyze ********************************************/
956        
957        %macro MIPAR(dat1=, dat2=, dat3=, dat4=, dat5=);
958        
959        data temp;
960        	length _Imputation_ 3;
961        	set &dat1(in=a) &dat2(in=b) &dat3(in=c) &dat4(in=d) &dat5(in=e);
962        	if a then _Imputation_=1;
963          		else if b then _Imputation_=2;
964         		else if c then _Imputation_=3;
965          		else if d then _Imputation_=4;
966          		else if e then _Imputation_=5;
967          		  	
968          	/* approximate standard error from the half-width of the CI */
969          	StdErr = (uclpartialx - lclpartialx) / (2 * 1.96);
970          	Estimate = partlparx;
971          	Parameter = 'PartialPAR';
972          	
973          	keep _Imputation_ Estimate StdErr Parameter;
974        run;
975        
976        proc mianalyze data=temp;
977           modeleffects Estimate;
978           stderr StdErr;
979        run;
980        
981        %mend MIPAR;
982        
983        %MIPAR(dat1=birthw1,   dat2=birthw2,   dat3=birthw3,   dat4=birthw4,   dat5=birthw5 );

