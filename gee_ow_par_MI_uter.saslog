642        *proc print data=betas;
643        
644        data covparms;
645        	set covuter;
646        	by _imputation_;
647        	length _type_ $4;
648        	 _type_ = 'COV';
649        
650        	rename  Prm1=intercept   Prm2=agebirth   Prm3=abwt1      Prm4=abwt3         Prm5=gweek1
651        			Prm6=gweek3      Prm7=Delivery   Prm8=pregcomp2   Prm9=bpregow
652        			Prm10=prev_preg1    Prm11=prev_preg2    Prm12=prev_preg3
653        			Prm13=cohort    Prm14=chage     Prm15=white        Prm16=sex   ;
654        
655        	length _name_ $10;
656        	
657        	*i counts rows within each _imputation_;
658        	if first._imputation_ then i=1;
659         		 else i+1;
660        
661        	* Assign which row this is (the row "label" in the covariance matrix) ;
662        	select(i);
663        		when(1)  _name_ = 'INTERCEPT';
664        		when(2)  _name_ = 'agebirth';
665        		when(3)  _name_ = 'abwt1';
666        		when(4)  _name_ = 'abwt3';
667        		when(5)  _name_ = 'gweek1';
668        		when(6)  _name_ = 'gweek3';
669        		when(7)  _name_ = 'Delivery';
670        		when(8)  _name_ = 'pregcomp2';
671        		when(9)  _name_ = 'bpregow';
672        		when(10)  _name_ = 'prev_preg1';
673        		when(11)  _name_ = 'prev_preg2';
674        		when(12)  _name_ = 'prev_preg3';
675        		when(13)  _name_ = 'cohort';
676        		when(14)  _name_ = 'chage';
677        		when(15)  _name_ = 'white';
678        		when(16)  _name_ = 'sex';
679        		otherwise;
680        	end;
681        	
682        	* Output EVERY row;
683          	output;
684        
685        keep _imputation_ _type_ _name_ prm1-prm16 ;
686        
687        run;

