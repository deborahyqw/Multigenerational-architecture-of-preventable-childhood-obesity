826        
827        data betas;
828          set uter ;
829          by _imputation_;
830          _type_ = 'PARM';
831        	retain intercept agebirth  bpregow prev_preg1 prev_preg2 prev_preg3
832          				cohort chage white sex;
833        	
834        	* 'i' counts rows within each _imputation_ group ;
835          	if first._imputation_ then i=1;
836          	else i+1;
837        	
838        	select (i);
839            when (1) intercept = estimate;
840            when (2) agebirth  = estimate;
841            when (3) bpregow   = estimate;
842            when (4) prev_preg1  = estimate;
843            when (5) prev_preg2  = estimate;
844            when (6) prev_preg3  = estimate;
845            when (7) cohort   = estimate;
846            when (8) chage    = estimate;
847            when (9) white    = estimate;
848            when (10) sex     = estimate;
849            otherwise;
850          end;
851        	
852          * Only OUTPUT once per _imputation_, after we've assigned all param columns ;
853          if last._imputation_ then output;
854        
855        run;

