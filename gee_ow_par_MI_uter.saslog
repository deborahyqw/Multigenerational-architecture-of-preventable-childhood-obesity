1057       		when(8)  _name_ = 'chage';
1058       		when(9)  _name_ = 'white';
1059       		when(10) _name_ = 'sex';
1060       		otherwise;
1061       	end;
1062       	
1063       	* Output EVERY row;
1064         	output;
1065       
1066       keep _imputation_ _type_ _name_ prm1-prm10 ;
1067       
