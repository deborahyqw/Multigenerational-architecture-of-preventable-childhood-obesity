762        
763        %LET covar1= cohort chage white sex ;
764        
765        run;
766        
767        /**********************************************************************/
768        title ' in-uterine factors - adjusting for bpregow & agebirth';
769        proc genmod data = all descending;
770        	by _imputation_ ;
771         class id momid ;
772           model chow = agebirth abwt1 abwt3 gweek1 gweek3 Delivery pregcomp2
773                        bpregow prev_preg1 prev_preg2 prev_preg3 &covar1
774             / dist = Poisson link = log;
775             repeated subject=id(momid)/type=unstr PRINTMLE ecovb;
776             ods output GEERCov=covuter GEEEmpPEst = uter;
777         run;

NOTE: The DESCENDING option applies only to the multinomial distribution with ordinal response.
