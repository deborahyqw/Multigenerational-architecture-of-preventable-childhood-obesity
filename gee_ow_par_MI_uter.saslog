990          		 		 		 		 		
991        /**********************************************************************/
992        title ' bpregow & agebirth - not adjusting for other in-uterine factors factors because they may be on the causal pathways';
993        proc genmod data = all descending;
994        	by _imputation_ ;
995         class id momid ;
996           model chow = agebirth bpregow prev_preg1 prev_preg2 prev_preg3 &covar1
997             / dist = Poisson link = log;
998             repeated subject=id(momid)/type=unstr PRINTMLE ecovb;
999             ods output GEERCov=covuter GEEEmpPEst = uter;
1000        run;

