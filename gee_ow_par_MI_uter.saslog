819        data covparms;
820        	set covuter;
821        	by _imputation_;
822        	length _type_ $4;
823        	 _type_ = 'COV';
824        
825        	rename  Prm1=intercept   Prm2=agebirth   Prm3=abwt1      Prm4=abwt3         Prm5=gweek1
826        			Prm6=gweek3      Prm7=Delivery   Prm8=pregcomp2   Prm9=bpregow
827        			Prm10=prev_preg1    Prm11=prev_preg2    Prm12=prev_preg3
828        			Prm13=cohort    Prm14=chage     Prm15=white        Prm16=sex   ;
829        
830        	length _name_ $10;
27                                                                  The SAS System                                        13:32 Tuesday, June 24, 2025

831        	
832        	*i counts rows within each _imputation_;
833        	if first._imputation_ then i=1;
834         		 else i+1;
835        
836        	* Assign which row this is (the row "label" in the covariance matrix) ;
837        	select(i);
838        		when(1)  _name_ = 'INTERCEPT';
839        		when(2)  _name_ = 'agebirth';
840        		when(3)  _name_ = 'abwt1';
841        		when(4)  _name_ = 'abwt3';
842        		when(5)  _name_ = 'gweek1';
843        		when(6)  _name_ = 'gweek3';
844        		when(7)  _name_ = 'Delivery';
845        		when(8)  _name_ = 'pregcomp2';
846        		when(9)  _name_ = 'bpregow';
847        		when(10)  _name_ = 'prev_preg1';
848        		when(11)  _name_ = 'prev_preg2';
849        		when(12)  _name_ = 'prev_preg3';
850        		when(13)  _name_ = 'cohort';
851        		when(14)  _name_ = 'chage';
852        		when(15)  _name_ = 'white';
853        		when(16)  _name_ = 'sex';
854        		otherwise;
855        	end;
856        	
857        	* Output EVERY row;
858          	output;
859        
860        keep _imputation_ _type_ _name_ prm1-prm16 ;
