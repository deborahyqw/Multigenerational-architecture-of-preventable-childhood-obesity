603        
604        data betas;
605          set uter ;
606          by _imputation_;
607          _type_ = 'PARM';
608        	retain intercept agebirth abwt1 abwt3 gweek1 gweek3 Delivery pregcomp2
609                        bpregow prev_preg1 prev_preg2 prev_preg3
610          				cohort chage white sex;
611        	
612        	* 'i' counts rows within each _imputation_ group ;
613          	if first._imputation_ then i=1;
614          	else i+1;
615        	
616        	select (i);
617            when (1) intercept = estimate;
618            when (2) agebirth  = estimate;
619            when (3) abwt1     = estimate;
620            when (4) abwt3     = estimate;
621            when (5) gweek1    = estimate;
622            when (6) gweek3    = estimate;
623            when (7) Delivery  = estimate;
624        	when (8) pregcomp2  = estimate;
625        	when (9) bpregow   = estimate;
626        	when (10) prev_preg1= estimate;
627        	when (11) prev_preg2  = estimate;
628        	when (12) prev_preg3  = estimate;
629            when (13) cohort   = estimate;
630            when (14) chage    = estimate;
631            when (15) white    = estimate;
632            when (16) sex      = estimate;
633            otherwise;
634          end;
635        	
636          * Only OUTPUT once per _imputation_, after we've assigned all param columns ;
637          if last._imputation_ then output;
638        
639           if abwt1 <0 then abwt1 =0;   if gweek1 <0 then gweek1 =0;
640        
641        run;

