1033       data covparms;
1034       	set covuter;
1035       	by _imputation_;
1036       	length _type_ $4;
1037       	 _type_ = 'COV';
1038       
1039       	rename  Prm1=intercept   Prm2=agebirth   Prm3=bpregow   Prm4=prev_preg1   Prm5=prev_preg2
1040       			Prm6=prev_preg3  Prm7=cohort     Prm8=chage     Prm9=white        Prm10=sex   ;
1041       
1042       	length _name_ $10;
1043       	
1044       	*i counts rows within each _imputation_;
1045       	if first._imputation_ then i=1;
1046        		 else i+1;
1047       
1048       	* Assign which row this is (the row "label" in the covariance matrix) ;
1049       	select(i);
1050       		when(1)  _name_ = 'INTERCEPT';
1051       		when(2)  _name_ = 'agebirth';
1052       		when(3)  _name_ = 'bpregow';
1053       		when(4)  _name_ = 'prev_preg1';
1054       		when(5)  _name_ = 'prev_preg2';
1055       		when(6)  _name_ = 'prev_preg3';
1056       		when(7)  _name_ = 'cohort';
