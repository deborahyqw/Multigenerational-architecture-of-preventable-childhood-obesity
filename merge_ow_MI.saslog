671        %macro quant_med (data, var, quantvar, quantcont);
672        proc means data=&data n nmiss median p25 p75;
673        var &var;
674        class cohort _imputation_ &quantvar;
675        output out=stat MEDIAN=&quantcont;
676        run;
677        proc sort data=&data; by cohort  _imputation_ &quantvar; run;
678        proc sort data=stat; by cohort  _imputation_ &quantvar; run;
679        
680        data &data;
681        merge &data stat;
682        by cohort  _imputation_ &quantvar;
683        if momid = . then delete;
684        if &var=. then &quantcont=.;
685        run;
686        %mend quant_med;
