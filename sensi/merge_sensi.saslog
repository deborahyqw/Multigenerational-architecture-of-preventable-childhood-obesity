155550         if age97=. then age97=moagebase+1; if age98=. then age98=age97+1;
155551     	if age99=. then age99=age98+1; if age00=. then age00=age99+1;
155552     	if age01=. then age01=age00+1; if age03=. then age03=age01+2; if age05=. then age05=age03+2;
155553     				
155554         if Comp_Gesdbg=1 or Comp_prghtng=1 or Comp_peclmpg=1 or Delivery=1 then pregcomp=1;
155555         	else pregcomp=0;
155556     
