155533     data all1;
155534     	merge gutsmoms1 (in=master) grav09guts1 bmibpregdt end=_end_;
155535       	by id; exrec=1;
155536       	if master; if cohort=1 ;
155537       	if chbmi96 >0 ; *keep only children without missing baseline BMI;
155538       	if first.id then exrec=0;
155539       	
155540       	if white=. then white=0; sex = natal_sex - 1 ;
155541       	
155542       	*maternal age at birth - 1980-1987;
155543      	agebirth = age89 - (retmo89 /12 - (chyob-1900));
155544      		
155545     	if chage97=. then chage97=chage96+1; if chage98=. then chage98=chage97+1;
155546     	if chage99=. then chage99=chage98+1; if chage00=. then chage00=chage99+1;
155547     	if chage01=. then chage01=chage00+1; if chage03=. then chage03=chage01+2; if chage05=. then chage05=chage03+2;
155548     
155549         moagebase=age95+1; if moagebase=. then moagebase=age89+7;
