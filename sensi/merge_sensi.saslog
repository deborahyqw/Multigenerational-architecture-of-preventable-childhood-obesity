158758     
158759     data all1;
158760     	merge gutsmoms1 (in=master) grav09guts1 bmibpregdt end=_end_;
158761       	by id; exrec=1;
158762       	if master; if cohort=1 ;
158763       	if chbmi96 >0 ; *keep only children without missing baseline BMI;
158764       	if first.id then exrec=0;
158765       	
158766       	if white=. then white=0; sex = natal_sex - 1 ;
158767       	
158768       	*maternal age at birth - 1980-1987;
158769      	agebirth = age89 - (retmo89 /12 - (chyob-1900));
158770      		
158771     	if chage97=. then chage97=chage96+1; if chage98=. then chage98=chage97+1;
158772     	if chage99=. then chage99=chage98+1; if chage00=. then chage00=chage99+1;
158773     	if chage01=. then chage01=chage00+1; if chage03=. then chage03=chage01+2; if chage05=. then chage05=chage03+2;
158774     
