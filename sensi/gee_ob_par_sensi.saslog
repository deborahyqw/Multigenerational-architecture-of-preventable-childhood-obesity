550        title ' socio-environmental factors ';
551        proc genmod data = all descending;
552         class id momid;
553           model chob = heduc1 heduc2 fincome1 fincome2 fincome3
554        			    region2 region3 region4 &covar1 sesq0 sesq1 sesq2
555             / dist = Poisson link = log;
556             repeated subject=id(momid)/type=unstr PRINTMLE ecovb;
557             ods output GEERCov=covsoc GEEEmpPEst = soc;
558         run;

NOTE: The DESCENDING option applies only to the multinomial distribution with ordinal response.
