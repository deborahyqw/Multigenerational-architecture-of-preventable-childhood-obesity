984                		  		 		 		 		 		 		
985        /**********************************************************************/
986        title ' maternal modifiable factors - moob ';
987        proc genmod data = all descending;
988         class id momid ;
989           model chob = &mowestq_ &mocalq_ &mopaq_ mosmk2 mosmk3 &moshiftq_
990          			    moage &covar1 moob
991             / dist = Poisson link = log;
992             repeated subject=id(momid)/type=unstr PRINTMLE ecovb;
993             ods output GEERCov=covmom GEEEmpPEst = mom;
994         run;

NOTE: The DESCENDING option applies only to the multinomial distribution with ordinal response.
NOTE: Class levels for some variables were not printed due to excessive size.
NOTE: Algorithm converged.
NOTE: The scale parameter was held fixed.
NOTE: Algorithm converged.
