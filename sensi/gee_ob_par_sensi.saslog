      cpu time            2.17 seconds
      

706        
707        data betas;
708          set mom end=_end_ ;
709          _type_ = 'PARM';
710        	retain intercept mowestq1 mowestq2 mowestq3 mocalq1 mocalq2 mocalq3
711        					 mopaq0 mopaq1 mopaq2 mosmk2 mosmk3
712        					moshiftq1 moshiftq2 moshiftq3
713        					moage cohort chage white sex;
714        	
715             if _n_ eq 1 then intercept = estimate;
716            else if _n_ eq 2 then mowestq1  = estimate;
25                                                                  The SAS System                                     14:33 Sunday, November 16, 2025

717            else if _n_ eq 3 then mowestq2  = estimate;
718            else if _n_ eq 4 then mowestq3  = estimate;
719            else if _n_ eq 5 then mocalq1   = estimate;
720            else if _n_ eq 6 then mocalq2   = estimate;
721        	else if _n_ eq 7 then mocalq3   = estimate;
722        	else if _n_ eq 8 then mopaq0   = estimate;
723        	else if _n_ eq 9 then mopaq1   = estimate;
724        	else if _n_ eq 10 then mopaq2   = estimate;
725        	else if _n_ eq 11 then mosmk2  = estimate;
726        	else if _n_ eq 12 then mosmk3  = estimate;
727        	else if _n_ eq 13 then moshiftq1= estimate;
728        	else if _n_ eq 14 then moshiftq2= estimate;
729        	else if _n_ eq 15 then moshiftq3= estimate;
730            else if _n_ eq 16 then moage    = estimate;
731            else if _n_ eq 17 then cohort   = estimate;
732            else if _n_ eq 18 then chage    = estimate;
733            else if _n_ eq 19 then white    = estimate;
734            else if _n_ eq 20 then sex      = estimate;
