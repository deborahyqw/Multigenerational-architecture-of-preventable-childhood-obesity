1592       
1593       title ' in-uterine factors - adjusting for bpregob & agebirth';
1594       proc genmod data = all descending;
1595        class id momid ;
1596          model chob = gotweight agebirth bpregob prev_preg1 prev_preg2 prev_preg3 chage white sex
1597            / dist = Poisson link = log;
1598            repeated subject=id(momid)/type=unstr PRINTMLE ecovb;
1599            ods output GEERCov=covuter GEEEmpPEst = uter;
1600        run;

