130        /**********************************************************************/
131        /**********************************************************************/
132        title ' personal modifiable factors ';
133        proc genmod data = all descending;
134         class id momid ;
135           model chob = &chwestq_ &chstq_ &chpaq_ &chcalq_ chbmibase &covar1
136             / dist = Poisson link = log;
137             repeated subject=id(momid)/type=unstr PRINTMLE ecovb;
138             ods output GEERCov=covchild GEEEmpPEst = child;
139         run;

NOTE: The DESCENDING option applies only to the multinomial distribution with ordinal response.
