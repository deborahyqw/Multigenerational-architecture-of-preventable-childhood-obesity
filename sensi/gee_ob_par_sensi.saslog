1132       data betas;
1133         set uter end=_end_ ;
1134         _type_ = 'PARM';
1135       	retain intercept agebirth abwt1 abwt3 gweek1 gweek3 Delivery pregcomp2
1136                       bpregob prev_preg1 prev_preg2 prev_preg3
1137         				cohort chage white sex;
1138       	
1139                 if _n_ eq 1 then intercept = estimate;
1140           else if _n_ eq 2 then agebirth  = estimate;
1141           else if _n_ eq 3 then abwt1     = estimate;
1142           else if _n_ eq 4 then abwt3     = estimate;
1143           else if _n_ eq 5 then gweek1    = estimate;
1144           else if _n_ eq 6 then gweek3    = estimate;
1145           else if _n_ eq 7 then Delivery  = estimate;
1146       	else if _n_ eq 8 then pregcomp2  = estimate;
