695        /**********************************************************************/
696        /**********************************************************************/
697        title ' maternal modifiable factors - not adjusting for moob because it may be on the causal pathways ';
698        proc genmod data = all descending;
699         class id momid ;
700           model chob = &mowestq_ &mocalq_ &mopaq_ mosmk2 mosmk3 &moshiftq_
701          			    moage &covar1
702             / dist = Poisson link = log;
703             repeated subject=id(momid)/type=unstr PRINTMLE ecovb;
704             ods output GEERCov=covmom GEEEmpPEst = mom;
705         run;

NOTE: The DESCENDING option applies only to the multinomial distribution with ordinal response.
NOTE: Class levels for some variables were not printed due to excessive size.
NOTE: Algorithm converged.
NOTE: The scale parameter was held fixed.
NOTE: Algorithm converged.
