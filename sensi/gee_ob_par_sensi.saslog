381        			
382        /**********************************************************************/
383        /**********************************************************************/
384        title ' education & income ';
385        proc genmod data = all descending;
386         class id momid ;
387           model chob = heduc1 heduc2 fincome1 fincome2 fincome3
388        			    region2 region3 region4 &covar1
389             / dist = Poisson link = log;
390             repeated subject=id(momid)/type=unstr PRINTMLE ecovb;
391             ods output GEERCov=covsoc GEEEmpPEst = soc;
392         run;

NOTE: The DESCENDING option applies only to the multinomial distribution with ordinal response.
NOTE: Class levels for some variables were not printed due to excessive size.
NOTE: Algorithm converged.
NOTE: The scale parameter was held fixed.
NOTE: Algorithm converged.
NOTE: The data set WORK.SOC has 13 observations and 7 variables.
NOTE: The data set WORK.COVSOC has 13 observations and 14 variables.
NOTE: The PROCEDURE GENMOD printed pages 1-2.
NOTE: PROCEDURE GENMOD used (Total process time):
      real time           3.23 seconds
      cpu time            1.82 seconds
      

393        
394        data betas;
395          set soc end=_end_ ;
396          _type_ = 'PARM';
397        	retain intercept  heduc1 heduc2 fincome1 fincome2 fincome3
398        			region2 region3 region4 cohort chage white sex;
399        	
400            if _n_ eq 1 then intercept = estimate;
401         	else if _n_ eq 2 then heduc1   = estimate;
402            else if _n_ eq 3 then heduc2   = estimate;
403            else if _n_ eq 4 then fincome1   = estimate;
