1321       /**********************************************************************/
1322       title ' bpregob & agebirth - not adjusting for other in-uterine factors factors because they may be on the causal pathways';
1323       proc genmod data = all descending;
1324        class id momid ;
1325          model chob = agebirth bpregob prev_preg1 prev_preg2 prev_preg3 &covar1
1326            / dist = Poisson link = log;
1327            repeated subject=id(momid)/type=unstr PRINTMLE ecovb;
1328            ods output GEERCov=covuter GEEEmpPEst = uter;
1329        run;

NOTE: The DESCENDING option applies only to the multinomial distribution with ordinal response.
NOTE: Class levels for some variables were not printed due to excessive size.
NOTE: Algorithm converged.
