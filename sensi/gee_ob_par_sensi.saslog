1120       /**********************************************************************/
1121       /**********************************************************************/
1122       title ' in-uterine factors - adjusting for bpregob & agebirth';
1123       proc genmod data = all descending;
1124        class id momid ;
1125          model chob = agebirth abwt1 abwt3 gweek1 gweek3 Delivery pregcomp2
1126                       bpregob prev_preg1 prev_preg2 prev_preg3 &covar1
1127            / dist = Poisson link = log;
1128            repeated subject=id(momid)/type=unstr PRINTMLE ecovb;
1129            ods output GEERCov=covuter GEEEmpPEst = uter;
1130        run;

NOTE: The DESCENDING option applies only to the multinomial distribution with ordinal response.
NOTE: Class levels for some variables were not printed due to excessive size.
