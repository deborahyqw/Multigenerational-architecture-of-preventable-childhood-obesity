1151           else if _n_ eq 13 then cohort   = estimate;
1152           else if _n_ eq 14 then chage    = estimate;
1153           else if _n_ eq 15 then white    = estimate;
1154           else if _n_ eq 16 then sex      = estimate;
1155       
1156           if _end_ then output;
1157       run;

