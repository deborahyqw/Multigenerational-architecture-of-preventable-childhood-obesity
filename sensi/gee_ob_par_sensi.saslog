707        data betas;
708          set mom end=_end_ ;
709          _type_ = 'PARM';
710        	retain intercept mowestq1 mowestq2 mowestq3 mocalq1 mocalq2 mocalq3
711        					 mopaq0 mopaq1 mopaq2 mosmk2 mosmk3
712        					moshiftq1 moshiftq2 moshiftq3
713        					moage cohort chage white sex;
714        	
715             if _n_ eq 1 then intercept = estimate;
716            else if _n_ eq 2 then mowestq1  = estimate;
