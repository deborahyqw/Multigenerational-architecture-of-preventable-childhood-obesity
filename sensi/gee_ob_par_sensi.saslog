559        
560        data betas;
561          set soc end=_end_ ;
20                                                                  The SAS System                                     14:33 Sunday, November 16, 2025

562          _type_ = 'PARM';
563        	retain intercept heduc1 heduc2 fincome1 fincome2 fincome3
564        			region2 region3 region4 cohort chage white sex  sesq0 sesq1 sesq2 ;
565        	
566            if _n_ eq 1 then intercept = estimate;
567         	else if _n_ eq 2 then heduc1   = estimate;
568            else if _n_ eq 3 then heduc2   = estimate;
569            else if _n_ eq 4 then fincome1   = estimate;
570            else if _n_ eq 5 then fincome2   = estimate;
571            else if _n_ eq 6 then fincome3   = estimate;
572            else if _n_ eq 7 then region2  = estimate;
573            else if _n_ eq 8 then region3  = estimate;
574            else if _n_ eq 9 then region4  = estimate;
575            else if _n_ eq 10 then cohort   = estimate;
576            else if _n_ eq 11 then chage    = estimate;
577            else if _n_ eq 12 then white    = estimate;
578            else if _n_ eq 13 then sex      = estimate;
579            else if _n_ eq 14 then sesq0   = estimate;
580            else if _n_ eq 15 then sesq1   = estimate;
581            else if _n_ eq 16 then sesq2   = estimate;
