654        data covparms;
655        	set covchild;
656        	by _imputation_;
657        	length _type_ $4;
658        	 _type_ = 'COV';
659        
660        	rename  Prm1=intercept   Prm2=chwestq1   Prm3=chwestq2   Prm4=chwestq3   Prm5=chstq1
661        			Prm6=chstq2      Prm7=chstq3     Prm8=chpaq0     Prm9=chpaq1     Prm10=chpaq2
662        			Prm11=chcalq1    Prm12=chcalq2   Prm13=chcalq3   Prm14=chbmibase
663        			Prm15=cohort     Prm16=chage     Prm17=white     Prm18=sex   ;
664        
665        	length _name_ $10;
666        	
667        	*i counts rows within each _imputation_;
668        	if first._imputation_ then i=1;
669         		 else i+1;
670        
671        	* Assign which row this is (the row "label" in the covariance matrix) ;
672        	select(i);
673        		when(1)  _name_ = 'INTERCEPT';
674        		when(2)  _name_ = 'chwestq1';
675        		when(3)  _name_ = 'chwestq2';
676        		when(4)  _name_ = 'chwestq3';
677        		when(5)  _name_ = 'chstq1';
678        		when(6)  _name_ = 'chstq2';
679        		when(7)  _name_ = 'chstq3';
680        		when(8)  _name_ = 'chpaq0';
681        		when(9)  _name_ = 'chpaq1';
682        		when(10)  _name_ = 'chpaq2';
683        		when(11)  _name_ = 'chcalq1';
684        		when(12)  _name_ = 'chcalq2';
685        		when(13)  _name_ = 'chcalq3';
686        		when(14)  _name_ = 'chbmibase';
687        		when(15)  _name_ = 'cohort';
688        		when(16)  _name_ = 'chage';
689        		when(17)  _name_ = 'white';
690        		when(18)  _name_ = 'sex';
691        		otherwise;
692        	end;
693        	
694        	* Output EVERY row;
695          	output;
696        
697        keep _imputation_ _type_ _name_ prm1-prm18 ;
698        
699        run;

