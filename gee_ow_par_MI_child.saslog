853        /*************************************************************************************/
854        /**************** combine using mianalyze ********************************************/
855        
856        %macro MIPAR(dat1=, dat2=, dat3=, dat4=, dat5=);
857        
115                                                                 The SAS System                                     17:23 Friday, November 14, 2025

858        data temp;
859        	length _Imputation_ 3;
860        	set &dat1(in=a) &dat2(in=b) &dat3(in=c) &dat4(in=d) &dat5(in=e);
861        	if a then _Imputation_=1;
862          		else if b then _Imputation_=2;
863         		else if c then _Imputation_=3;
864          		else if d then _Imputation_=4;
865          		else if e then _Imputation_=5;
866          		  	
867          	/* approximate standard error from the half-width of the CI */
868          	StdErr = (uclpartialx - lclpartialx) / (2 * 1.96);
869          	Estimate = partlparx;
870          	Parameter = 'PartialPAR';
871          	
872          	keep _Imputation_ Estimate StdErr Parameter;
873        run;
874        
875        proc mianalyze data=temp;
876           modeleffects Estimate;
877           stderr StdErr;
878        run;
879        
880        %mend MIPAR;
