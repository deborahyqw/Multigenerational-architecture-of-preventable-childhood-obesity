1026       
1027       		 		
1028       /*************************************************************************************/
1029       /**************** combine using mianalyze ********************************************/
1030       
1031       %macro MIPAR(dat1=, dat2=, dat3=, dat4=, dat5=);
1032       
1033       data temp;
1034       	length _Imputation_ 3;
1035       	set &dat1(in=a) &dat2(in=b) &dat3(in=c) &dat4(in=d) &dat5(in=e);
1036       	if a then _Imputation_=1;
1037         		else if b then _Imputation_=2;
1038        		else if c then _Imputation_=3;
1039         		else if d then _Imputation_=4;
1040         		else if e then _Imputation_=5;
1041         		  	
1042         	/* approximate standard error from the half-width of the CI */
1043         	StdErr = (uclpartialx - lclpartialx) / (2 * 1.96);
1044         	Estimate = partlparx;
1045         	Parameter = 'PartialPAR';
1046         	
