775        
776        /**********************************************************************/
777        title ' personal modifiable factors ';
778        proc genmod data = all descending;
779        	by _imputation_ ;
780         class id momid ;
781           model chow = &chwestq_ &chstq_ &chpaq_ &chcalq_ chbmibase &covar1
782             / dist = Poisson link = log;
783             repeated subject=id(momid)/type=unstr PRINTMLE ecovb;
784             ods output GEERCov=covchild GEEEmpPEst = child;
785         run;

NOTE: The DESCENDING option applies only to the multinomial distribution with ordinal response.
