596        
597        %LET covar1= cohort chage white sex ;
598        
599        run;
600        
601        /**********************************************************************/
602        title ' personal modifiable factors ';
603        proc genmod data = all descending;
604        	by _imputation_ ;
605         class id momid ;
606           model chow = &chwestq_ &chstq_ &chpaq_ &chcalq_ chbmibase &covar1
607             / dist = Poisson link = log;
608             repeated subject=id(momid)/type=unstr PRINTMLE ecovb;
609             ods output GEERCov=covchild GEEEmpPEst = child;
610         run;

NOTE: The DESCENDING option applies only to the multinomial distribution with ordinal response.
