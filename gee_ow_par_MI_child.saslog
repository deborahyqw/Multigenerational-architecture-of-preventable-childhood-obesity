611        
612        data betas;
613          set child ;
614          by _imputation_;
615          _type_ = 'PARM';
616        	retain intercept chwestq1 chwestq2 chwestq3 chstq1 chstq2 chstq3
617        			chpaq0 chpaq1 chpaq2 chcalq1 chcalq2 chcalq3
618        		    chbmibase cohort chage white sex;
619        	
620        	* 'i' counts rows within each _imputation_ group ;
621          	if first._imputation_ then i=1;
622          	else i+1;
623        	
624        	select (i);
625            when (1) intercept = estimate;
626            when (2) chwestq1  = estimate;
627            when (3) chwestq2  = estimate;
628            when (4) chwestq3  = estimate;
629            when (5) chstq1   = estimate;
630            when (6) chstq2   = estimate;
631        	when (7) chstq3   = estimate;
632        	when (8) chpaq0   = estimate;
633        	when (9) chpaq1   = estimate;
634        	when (10) chpaq2  = estimate;
635        	when (11) chcalq1   = estimate;
636        	when (12) chcalq2   = estimate;
637        	when (13) chcalq3   = estimate;
638        	when (14) chbmibase = estimate;
639            when (15) cohort   = estimate;
640            when (16) chage    = estimate;
641            when (17) white    = estimate;
642            when (18) sex      = estimate;
643            otherwise;
644          end;
645        	
646          * Only OUTPUT once per _imputation_, after we've assigned all param columns ;
13                                                                  The SAS System                                     17:23 Friday, November 14, 2025

647          if last._imputation_ then output;
648        
649        	* set negative beta to 0 to avoid errors in PAR -- chpa2 <0 in imputations 1-2;
650        	if chpaq1 <0 then chpaq1=0;   if chpaq2 <0 then chpaq2=0;
651        run;

