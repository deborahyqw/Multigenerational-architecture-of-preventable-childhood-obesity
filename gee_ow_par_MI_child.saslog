786        
787        data betas;
788          set child ;
789          by _imputation_;
790          _type_ = 'PARM';
791        	retain intercept chwestq1 chwestq2 chwestq3 chstq1 chstq2 chstq3
792        			chpaq0 chpaq1 chpaq2 chcalq1 chcalq2 chcalq3
793        		    chbmibase cohort chage white sex;
794        	
795        	* 'i' counts rows within each _imputation_ group ;
796          	if first._imputation_ then i=1;
797          	else i+1;
798        	
799        	select (i);
800            when (1) intercept = estimate;
801            when (2) chwestq1  = estimate;
802            when (3) chwestq2  = estimate;
803            when (4) chwestq3  = estimate;
804            when (5) chstq1   = estimate;
805            when (6) chstq2   = estimate;
806        	when (7) chstq3   = estimate;
807        	when (8) chpaq0   = estimate;
808        	when (9) chpaq1   = estimate;
809        	when (10) chpaq2  = estimate;
810        	when (11) chcalq1   = estimate;
811        	when (12) chcalq2   = estimate;
812        	when (13) chcalq3   = estimate;
813        	when (14) chbmibase = estimate;
814            when (15) cohort   = estimate;
815            when (16) chage    = estimate;
816            when (17) white    = estimate;
817            when (18) sex      = estimate;
818            otherwise;
819          end;
820        	
821          * Only OUTPUT once per _imputation_, after we've assigned all param columns ;
822          if last._imputation_ then output;
823        
824        	* set negative beta to 0 to avoid errors in PAR -- chpa2 <0 in imputations 1-2;
825        	if chpaq1 <0 then chpaq1=0;   if chpaq2 <0 then chpaq2=0;
826        run;

