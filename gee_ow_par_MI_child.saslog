829        data covparms;
830        	set covchild;
831        	by _imputation_;
832        	length _type_ $4;
833        	 _type_ = 'COV';
834        
835        	rename  Prm1=intercept   Prm2=chwestq1   Prm3=chwestq2   Prm4=chwestq3   Prm5=chstq1
836        			Prm6=chstq2      Prm7=chstq3     Prm8=chpaq0     Prm9=chpaq1     Prm10=chpaq2
837        			Prm11=chcalq1    Prm12=chcalq2   Prm13=chcalq3   Prm14=chbmibase
838        			Prm15=cohort     Prm16=chage     Prm17=white     Prm18=sex   ;
839        
840        	length _name_ $10;
841        	
842        	*i counts rows within each _imputation_;
843        	if first._imputation_ then i=1;
844         		 else i+1;
845        
846        	* Assign which row this is (the row "label" in the covariance matrix) ;
847        	select(i);
848        		when(1)  _name_ = 'INTERCEPT';
849        		when(2)  _name_ = 'chwestq1';
850        		when(3)  _name_ = 'chwestq2';
851        		when(4)  _name_ = 'chwestq3';
852        		when(5)  _name_ = 'chstq1';
853        		when(6)  _name_ = 'chstq2';
854        		when(7)  _name_ = 'chstq3';
855        		when(8)  _name_ = 'chpaq0';
856        		when(9)  _name_ = 'chpaq1';
857        		when(10)  _name_ = 'chpaq2';
858        		when(11)  _name_ = 'chcalq1';
859        		when(12)  _name_ = 'chcalq2';
860        		when(13)  _name_ = 'chcalq3';
861        		when(14)  _name_ = 'chbmibase';
862        		when(15)  _name_ = 'cohort';
863        		when(16)  _name_ = 'chage';
864        		when(17)  _name_ = 'white';
865        		when(18)  _name_ = 'sex';
866        		otherwise;
867        	end;
868        	
869        	* Output EVERY row;
870          	output;
871        
872        keep _imputation_ _type_ _name_ prm1-prm18 ;
873        
874        run;

