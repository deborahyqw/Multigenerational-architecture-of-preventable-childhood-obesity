993        
994        data betas;
995          set uter ;
996          by _imputation_;
997          _type_ = 'PARM';
998        	retain intercept agebirth  bpregob prev_preg1 prev_preg2 prev_preg3
999          				cohort chage white sex;
1000       	
1001       	* 'i' counts rows within each _imputation_ group ;
1002         	if first._imputation_ then i=1;
1003         	else i+1;
1004       	
1005       	select (i);
1006           when (1) intercept = estimate;
1007           when (2) agebirth  = estimate;
1008           when (3) bpregob   = estimate;
1009           when (4) prev_preg1  = estimate;
1010           when (5) prev_preg2  = estimate;
1011           when (6) prev_preg3  = estimate;
1012           when (7) cohort   = estimate;
1013           when (8) chage    = estimate;
1014           when (9) white    = estimate;
1015           when (10) sex     = estimate;
1016           otherwise;
1017         end;
1018       	
1019         * Only OUTPUT once per _imputation_, after we've assigned all param columns ;
1020         if last._imputation_ then output;
1021       
1022       run;

