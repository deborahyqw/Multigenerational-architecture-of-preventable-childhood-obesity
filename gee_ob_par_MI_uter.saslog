818        
819        data betas;
820          set uter ;
821          by _imputation_;
822          _type_ = 'PARM';
823        	retain intercept agebirth  bpregob prev_preg1 prev_preg2 prev_preg3
824          				cohort chage white sex;
825        	
826        	* 'i' counts rows within each _imputation_ group ;
827          	if first._imputation_ then i=1;
828          	else i+1;
829        	
830        	select (i);
831            when (1) intercept = estimate;
832            when (2) agebirth  = estimate;
833            when (3) bpregob   = estimate;
834            when (4) prev_preg1  = estimate;
835            when (5) prev_preg2  = estimate;
836            when (6) prev_preg3  = estimate;
837            when (7) cohort   = estimate;
838            when (8) chage    = estimate;
839            when (9) white    = estimate;
840            when (10) sex     = estimate;
841            otherwise;
842          end;
843        	
844          * Only OUTPUT once per _imputation_, after we've assigned all param columns ;
845          if last._imputation_ then output;
846        
847        run;

