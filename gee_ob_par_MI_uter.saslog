848        *proc print data=betas;
849        
850        data covparms;
851        	set covuter;
852        	by _imputation_;
853        	length _type_ $4;
85                                                                  The SAS System                                     17:10 Friday, November 14, 2025

854        	 _type_ = 'COV';
855        
856        	rename  Prm1=intercept   Prm2=agebirth   Prm3=bpregob   Prm4=prev_preg1   Prm5=prev_preg2
857        			Prm6=prev_preg3  Prm7=cohort     Prm8=chage     Prm9=white        Prm10=sex   ;
858        
859        	length _name_ $10;
860        	
861        	*i counts rows within each _imputation_;
862        	if first._imputation_ then i=1;
863         		 else i+1;
864        
865        	* Assign which row this is (the row "label" in the covariance matrix) ;
866        	select(i);
867        		when(1)  _name_ = 'INTERCEPT';
868        		when(2)  _name_ = 'agebirth';
869        		when(3)  _name_ = 'bpregob';
870        		when(4)  _name_ = 'prev_preg1';
871        		when(5)  _name_ = 'prev_preg2';
872        		when(6)  _name_ = 'prev_preg3';
873        		when(7)  _name_ = 'cohort';
874        		when(8)  _name_ = 'chage';
875        		when(9)  _name_ = 'white';
876        		when(10) _name_ = 'sex';
877        		otherwise;
878        	end;
879        	
880        	* Output EVERY row;
881          	output;
882        
883        keep _imputation_ _type_ _name_ prm1-prm10 ;
884        
885        run;

