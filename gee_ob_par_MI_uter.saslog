809        *proc print data=betas;
810        
811        data covparms;
812        	set covuter;
813        	by _imputation_;
814        	length _type_ $4;
815        	 _type_ = 'COV';
816        
817        	rename  Prm1=intercept   Prm2=agebirth   Prm3=abwt1      Prm4=abwt3         Prm5=gweek1
818        			Prm6=gweek3      Prm7=Delivery   Prm8=pregcomp2   Prm9=bpregob
819        			Prm10=prev_preg1    Prm11=prev_preg2    Prm12=prev_preg3
820        			Prm13=cohort    Prm14=chage     Prm15=white        Prm16=sex   ;
821        
822        	length _name_ $10;
823        	
824        	*i counts rows within each _imputation_;
825        	if first._imputation_ then i=1;
826         		 else i+1;
827        
828        	* Assign which row this is (the row "label" in the covariance matrix) ;
829        	select(i);
830        		when(1)  _name_ = 'INTERCEPT';
831        		when(2)  _name_ = 'agebirth';
832        		when(3)  _name_ = 'abwt1';
833        		when(4)  _name_ = 'abwt3';
834        		when(5)  _name_ = 'gweek1';
835        		when(6)  _name_ = 'gweek3';
836        		when(7)  _name_ = 'Delivery';
837        		when(8)  _name_ = 'pregcomp2';
838        		when(9)  _name_ = 'bpregob';
839        		when(10)  _name_ = 'prev_preg1';
840        		when(11)  _name_ = 'prev_preg2';
841        		when(12)  _name_ = 'prev_preg3';
842        		when(13)  _name_ = 'cohort';
843        		when(14)  _name_ = 'chage';
844        		when(15)  _name_ = 'white';
845        		when(16)  _name_ = 'sex';
846        		otherwise;
847        	end;
848        	
849        	* Output EVERY row;
850          	output;
851        
852        keep _imputation_ _type_ _name_ prm1-prm16 ;
853        
854        run;

