1120       
1121       /*************************************************************************************/
1122       /**************** combine using mianalyze ********************************************/
1123       
1124       %macro MIPAR(dat1=, dat2=, dat3=, dat4=, dat5=);
1125       
1126       data temp;
1127       	length _Imputation_ 3;
1128       	set &dat1(in=a) &dat2(in=b) &dat3(in=c) &dat4(in=d) &dat5(in=e);
1129       	if a then _Imputation_=1;
1130         		else if b then _Imputation_=2;
1131        		else if c then _Imputation_=3;
1132         		else if d then _Imputation_=4;
1133         		else if e then _Imputation_=5;
1134         		  	
1135         	/* approximate standard error from the half-width of the CI */
1136         	StdErr = (uclpartialx - lclpartialx) / (2 * 1.96);
1137         	Estimate = partlparx;
1138         	Parameter = 'PartialPAR';
1139         	
1140         	keep _Imputation_ Estimate StdErr Parameter;
1141       run;
1142       
1143       proc mianalyze data=temp;
1144          modeleffects Estimate;
1145          stderr StdErr;
1146       run;
1147       
1148       %mend MIPAR;
