982          		 		 		 		 		
983        /**********************************************************************/
984        title ' bpregob & agebirth - not adjusting for other in-uterine factors factors because they may be on the causal pathways';
985        proc genmod data = all descending;
986        	by _imputation_ ;
987         class id momid ;
988           model chob = agebirth bpregob prev_preg1 prev_preg2 prev_preg3 &covar1
989             / dist = Poisson link = log;
990             repeated subject=id(momid)/type=unstr PRINTMLE ecovb;
991             ods output GEERCov=covuter GEEEmpPEst = uter;
992         run;

NOTE: The DESCENDING option applies only to the multinomial distribution with ordinal response.
