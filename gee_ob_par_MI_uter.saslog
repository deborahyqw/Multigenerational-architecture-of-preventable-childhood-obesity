1023       *proc print data=betas;
1024       
1025       data covparms;
1026       	set covuter;
1027       	by _imputation_;
1028       	length _type_ $4;
1029       	 _type_ = 'COV';
1030       
1031       	rename  Prm1=intercept   Prm2=agebirth   Prm3=bpregob   Prm4=prev_preg1   Prm5=prev_preg2
1032       			Prm6=prev_preg3  Prm7=cohort     Prm8=chage     Prm9=white        Prm10=sex   ;
1033       
1034       	length _name_ $10;
1035       	
1036       	*i counts rows within each _imputation_;
1037       	if first._imputation_ then i=1;
1038        		 else i+1;
1039       
1040       	* Assign which row this is (the row "label" in the covariance matrix) ;
1041       	select(i);
1042       		when(1)  _name_ = 'INTERCEPT';
1043       		when(2)  _name_ = 'agebirth';
1044       		when(3)  _name_ = 'bpregob';
1045       		when(4)  _name_ = 'prev_preg1';
1046       		when(5)  _name_ = 'prev_preg2';
1047       		when(6)  _name_ = 'prev_preg3';
1048       		when(7)  _name_ = 'cohort';
1049       		when(8)  _name_ = 'chage';
1050       		when(9)  _name_ = 'white';
1051       		when(10) _name_ = 'sex';
1052       		otherwise;
1053       	end;
1054       	
1055       	* Output EVERY row;
1056         	output;
1057       
