595        
596        data betas;
597          set uter ;
598          by _imputation_;
599          _type_ = 'PARM';
600        	retain intercept agebirth abwt1 abwt3 gweek1 gweek3 Delivery pregcomp2
601                        bpregob prev_preg1 prev_preg2 prev_preg3
602          				cohort chage white sex;
603        	
604        	* 'i' counts rows within each _imputation_ group ;
605          	if first._imputation_ then i=1;
606          	else i+1;
607        	
608        	select (i);
609            when (1) intercept = estimate;
610            when (2) agebirth  = estimate;
611            when (3) abwt1     = estimate;
612            when (4) abwt3     = estimate;
613            when (5) gweek1    = estimate;
614            when (6) gweek3    = estimate;
615            when (7) Delivery  = estimate;
616        	when (8) pregcomp2  = estimate;
617        	when (9) bpregob   = estimate;
618        	when (10) prev_preg1= estimate;
619        	when (11) prev_preg2  = estimate;
620        	when (12) prev_preg3  = estimate;
621            when (13) cohort   = estimate;
622            when (14) chage    = estimate;
623            when (15) white    = estimate;
624            when (16) sex      = estimate;
625            otherwise;
626          end;
627        	
628          * Only OUTPUT once per _imputation_, after we've assigned all param columns ;
629          if last._imputation_ then output;
630        
631          if gweek1 <0 then  gweek1 =0;
632        
633        run;

