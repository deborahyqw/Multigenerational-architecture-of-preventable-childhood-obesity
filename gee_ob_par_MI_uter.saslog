755        %LET covar1= cohort chage white sex ;
756        
757        run;
758        
759        /**********************************************************************/
760        title ' in-uterine factors - adjusting for bpregob & agebirth';
761        proc genmod data = all descending;
762        	by _imputation_ ;
763         class id momid ;
764           model chob = agebirth abwt1 abwt3 gweek1 gweek3 Delivery pregcomp2
765                        bpregob prev_preg1 prev_preg2 prev_preg3 &covar1
766             / dist = Poisson link = log;
767             repeated subject=id(momid)/type=unstr PRINTMLE ecovb;
768             ods output GEERCov=covuter GEEEmpPEst = uter;
769         run;

