636        data covparms;
637        	set covuter;
638        	by _imputation_;
639        	length _type_ $4;
640        	 _type_ = 'COV';
641        
642        	rename  Prm1=intercept   Prm2=agebirth   Prm3=abwt1      Prm4=abwt3         Prm5=gweek1
643        			Prm6=gweek3      Prm7=Delivery   Prm8=pregcomp2   Prm9=bpregob
644        			Prm10=prev_preg1    Prm11=prev_preg2    Prm12=prev_preg3
645        			Prm13=cohort    Prm14=chage     Prm15=white        Prm16=sex   ;
646        
647        	length _name_ $10;
648        	
649        	*i counts rows within each _imputation_;
650        	if first._imputation_ then i=1;
651         		 else i+1;
652        
653        	* Assign which row this is (the row "label" in the covariance matrix) ;
654        	select(i);
