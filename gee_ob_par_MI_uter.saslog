580        %LET covar1= cohort chage white sex ;
581        
582        run;
583        
584        /**********************************************************************/
585        title ' in-uterine factors - adjusting for bpregob & agebirth';
586        proc genmod data = all descending;
587        	by _imputation_ ;
588         class id momid ;
589           model chob = agebirth abwt1 abwt3 gweek1 gweek3 Delivery pregcomp2
590                        bpregob prev_preg1 prev_preg2 prev_preg3 &covar1
591             / dist = Poisson link = log;
592             repeated subject=id(momid)/type=unstr PRINTMLE ecovb;
593             ods output GEERCov=covuter GEEEmpPEst = uter;
594         run;

