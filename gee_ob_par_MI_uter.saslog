808        /**********************************************************************/
809        title ' bpregob & agebirth - not adjusting for other in-uterine factors factors because they may be on the causal pathways';
810        proc genmod data = all descending;
811        	by _imputation_ ;
812         class id momid ;
813           model chob = agebirth bpregob prev_preg1 prev_preg2 prev_preg3 &covar1
814             / dist = Poisson link = log;
815             repeated subject=id(momid)/type=unstr PRINTMLE ecovb;
816             ods output GEERCov=covuter GEEEmpPEst = uter;
817         run;
