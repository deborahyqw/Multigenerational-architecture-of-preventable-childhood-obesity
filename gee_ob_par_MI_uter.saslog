771        data betas;
772          set uter ;
773          by _imputation_;
774          _type_ = 'PARM';
775        	retain intercept agebirth abwt1 abwt3 gweek1 gweek3 Delivery pregcomp2
776                        bpregob prev_preg1 prev_preg2 prev_preg3
777          				cohort chage white sex;
778        	
779        	* 'i' counts rows within each _imputation_ group ;
780          	if first._imputation_ then i=1;
781          	else i+1;
782        	
783        	select (i);
784            when (1) intercept = estimate;
785            when (2) agebirth  = estimate;
786            when (3) abwt1     = estimate;
787            when (4) abwt3     = estimate;
788            when (5) gweek1    = estimate;
789            when (6) gweek3    = estimate;
790            when (7) Delivery  = estimate;
791        	when (8) pregcomp2  = estimate;
792        	when (9) bpregob   = estimate;
793        	when (10) prev_preg1= estimate;
794        	when (11) prev_preg2  = estimate;
795        	when (12) prev_preg3  = estimate;
796            when (13) cohort   = estimate;
797            when (14) chage    = estimate;
798            when (15) white    = estimate;
799            when (16) sex      = estimate;
800            otherwise;
801          end;
802        	
803          * Only OUTPUT once per _imputation_, after we've assigned all param columns ;
804          if last._imputation_ then output;
805        
806          if gweek1 <0 then  gweek1 =0;
807        
808        run;

