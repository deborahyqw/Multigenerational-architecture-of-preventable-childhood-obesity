913        %macro runPAR(prefixBeta=, prefixFreq=, outpref=, modmod=, fixfix=);
914        	%local i;
915          	%do i=1 %to 5;
916        %par(
917        	bdata=&prefixBeta.&i,
918        	pdata=&prefixFreq.&i,
919        	n_or_p=N,
920        	n_or_pname=FQ,
921        	modvar= &modmod  ,
922        	missvarlist=NONE,
923        	partialpar= T,
924        	outdat= &outpref.&i,
925        	fixedvar= &fixfix );
926        	%end;
927        %mend runPAR;
