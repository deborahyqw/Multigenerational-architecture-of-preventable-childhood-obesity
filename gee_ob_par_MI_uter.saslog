945        
946        /*************************************************************************************/
947        /**************** combine using mianalyze ********************************************/
948        
95                                                                  The SAS System                                     17:10 Friday, November 14, 2025

949        %macro MIPAR(dat1=, dat2=, dat3=, dat4=, dat5=);
950        
951        data temp;
952        	length _Imputation_ 3;
953        	set &dat1(in=a) &dat2(in=b) &dat3(in=c) &dat4(in=d) &dat5(in=e);
954        	if a then _Imputation_=1;
955          		else if b then _Imputation_=2;
956         		else if c then _Imputation_=3;
957          		else if d then _Imputation_=4;
958          		else if e then _Imputation_=5;
959          		  	
960          	/* approximate standard error from the half-width of the CI */
961          	StdErr = (uclpartialx - lclpartialx) / (2 * 1.96);
962          	Estimate = partlparx;
963          	Parameter = 'PartialPAR';
964          	
965          	keep _Imputation_ Estimate StdErr Parameter;
966        run;
967        
968        proc mianalyze data=temp;
969           modeleffects Estimate;
970           stderr StdErr;
971        run;
972        
973        %mend MIPAR;
974        
