779        TITLE ' Swamp ';
780        proc genmod data = all descending;
781         by _imputation_ ;
782         class id momid;
783           model chob = &foodswampq_ &sesq_ heduc1 heduc2 fincome1 fincome2 fincome3
784           				midwest south west cohort chage white sex
785             / dist = Poisson link = log;
786             repeated subject=id(momid)/type=unstr PRINTMLE ecovb;
787             ods output GEEEmpPEst = swamp;
788         run;

