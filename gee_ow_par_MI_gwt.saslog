777        
778        data betas;
779          set uter ;
780          by _imputation_;
781          _type_ = 'PARM';
782        	retain intercept gotweight agebirth bpregow prev_preg1 prev_preg2 prev_preg3
783          				chage white sex;
784        	
785        	* 'i' counts rows within each _imputation_ group ;
786          	if first._imputation_ then i=1;
787          	else i+1;
788        	
789        	select (i);
790            when (1) intercept = estimate;
791            when (2) gotweight  = estimate;
792            when (3) agebirth  = estimate;
793        	when (4) bpregow   = estimate;
794        	when (5) prev_preg1= estimate;
795        	when (6) prev_preg2  = estimate;
796        	when (7) prev_preg3  = estimate;
797            when (8) chage    = estimate;
798            when (9) white    = estimate;
799            when (10) sex      = estimate;
800            otherwise;
801          end;
802        	
803          * Only OUTPUT once per _imputation_, after we've assigned all param columns ;
804          if last._imputation_ then output;
805        
806        run;

