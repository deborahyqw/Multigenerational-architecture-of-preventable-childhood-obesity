920        
921        /*************************************************************************************/
922        /**************** combine using mianalyze ********************************************/
923        
924        %macro MIPAR(dat1=, dat2=, dat3=, dat4=, dat5=);
925        
926        data temp;
927        	length _Imputation_ 3;
928        	set &dat1(in=a) &dat2(in=b) &dat3(in=c) &dat4(in=d) &dat5(in=e);
929        	if a then _Imputation_=1;
930          		else if b then _Imputation_=2;
931         		else if c then _Imputation_=3;
932          		else if d then _Imputation_=4;
933          		else if e then _Imputation_=5;
934          		  	
935          	/* approximate standard error from the half-width of the CI */
936          	StdErr = (uclpartialx - lclpartialx) / (2 * 1.96);
937          	Estimate = partlparx;
938          	Parameter = 'PartialPAR';
939          	
940          	keep _Imputation_ Estimate StdErr Parameter;
941        run;
942        
943        proc mianalyze data=temp;
944           modeleffects Estimate;
945           stderr StdErr;
946        run;
947        
948        %mend MIPAR;
949        
950        %MIPAR(dat1=gwt1,   dat2=gwt2,   dat3=gwt3,   dat4=gwt4,   dat5=gwt5 );

