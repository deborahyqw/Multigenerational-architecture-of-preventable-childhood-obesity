768        title ' in-uterine factors - adjusting for bpregow & agebirth';
769        proc genmod data = all descending;
770        	by _imputation_ ;
771         class id momid ;
772           model chow = gotweight agebirth bpregow prev_preg1 prev_preg2 prev_preg3 chage white sex
773             / dist = Poisson link = log;
26                                                                  The SAS System                                        12:53 Tuesday, June 24, 2025

774             repeated subject=id(momid)/type=unstr PRINTMLE ecovb;
775             ods output GEERCov=covuter GEEEmpPEst = uter;
776         run;

