602        
603        data betas;
604          set uter ;
605          by _imputation_;
606          _type_ = 'PARM';
607        	retain intercept gotweight agebirth bpregow prev_preg1 prev_preg2 prev_preg3
608          				chage white sex;
609        	
610        	* 'i' counts rows within each _imputation_ group ;
611          	if first._imputation_ then i=1;
612          	else i+1;
613        	
614        	select (i);
615            when (1) intercept = estimate;
616            when (2) gotweight  = estimate;
617            when (3) agebirth  = estimate;
618        	when (4) bpregow   = estimate;
619        	when (5) prev_preg1= estimate;
620        	when (6) prev_preg2  = estimate;
621        	when (7) prev_preg3  = estimate;
622            when (8) chage    = estimate;
623            when (9) white    = estimate;
624            when (10) sex      = estimate;
625            otherwise;
13                                                                  The SAS System                                     17:23 Friday, November 14, 2025

626          end;
627        	
628          * Only OUTPUT once per _imputation_, after we've assigned all param columns ;
629          if last._imputation_ then output;
630        
631        run;

