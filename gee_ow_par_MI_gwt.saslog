632        *proc print data=betas;
633        
634        data covparms;
635        	set covuter;
636        	by _imputation_;
637        	length _type_ $4;
638        	 _type_ = 'COV';
639        
640        	rename  Prm1=intercept   Prm2=gotweight  Prm3=agebirth   Prm4=bpregow    Prm5=prev_preg1    Prm6=prev_preg2
641        			Prm7=prev_preg3  Prm8=chage     Prm9=white        Prm10=sex   ;
642        
643        	length _name_ $10;
644        	
645        	*i counts rows within each _imputation_;
646        	if first._imputation_ then i=1;
647         		 else i+1;
648        
649        	* Assign which row this is (the row "label" in the covariance matrix) ;
650        	select(i);
651        		when(1)  _name_ = 'INTERCEPT';
652        		when(2)  _name_ = 'gotweight';
653        		when(3)  _name_ = 'agebirth';
654        		when(4)  _name_ = 'bpregow';
655        		when(5)  _name_ = 'prev_preg1';
656        		when(6)  _name_ = 'prev_preg2';
657        		when(7)  _name_ = 'prev_preg3';
658        		when(8)  _name_ = 'chage';
659        		when(9)  _name_ = 'white';
660        		when(10)  _name_ = 'sex';
661        		otherwise;
662        	end;
663        	
664        	* Output EVERY row;
665          	output;
666        
667        keep _imputation_ _type_ _name_ prm1-prm10 ;
668        
669        run;

