809        data covparms;
27                                                                  The SAS System                                        12:53 Tuesday, June 24, 2025

810        	set covuter;
811        	by _imputation_;
812        	length _type_ $4;
813        	 _type_ = 'COV';
814        
815        	rename  Prm1=intercept   Prm2=gotweight  Prm3=agebirth   Prm4=bpregow    Prm5=prev_preg1    Prm6=prev_preg2
816        			Prm7=prev_preg3  Prm8=chage     Prm9=white        Prm10=sex   ;
817        
818        	length _name_ $10;
819        	
820        	*i counts rows within each _imputation_;
821        	if first._imputation_ then i=1;
822         		 else i+1;
823        
824        	* Assign which row this is (the row "label" in the covariance matrix) ;
825        	select(i);
826        		when(1)  _name_ = 'INTERCEPT';
827        		when(2)  _name_ = 'gotweight';
828        		when(3)  _name_ = 'agebirth';
829        		when(4)  _name_ = 'bpregow';
830        		when(5)  _name_ = 'prev_preg1';
831        		when(6)  _name_ = 'prev_preg2';
832        		when(7)  _name_ = 'prev_preg3';
833        		when(8)  _name_ = 'chage';
834        		when(9)  _name_ = 'white';
835        		when(10)  _name_ = 'sex';
836        		otherwise;
837        	end;
838        	
839        	* Output EVERY row;
840          	output;
841        
842        keep _imputation_ _type_ _name_ prm1-prm10 ;
843        
844        run;

