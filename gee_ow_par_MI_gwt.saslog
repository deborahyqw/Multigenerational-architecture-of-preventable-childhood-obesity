592        /**********************************************************************/
593        title ' in-uterine factors - adjusting for bpregow & agebirth';
594        proc genmod data = all descending;
595        	by _imputation_ ;
596         class id momid ;
597           model chow = gotweight agebirth bpregow prev_preg1 prev_preg2 prev_preg3 chage white sex
598             / dist = Poisson link = log;
599             repeated subject=id(momid)/type=unstr PRINTMLE ecovb;
600             ods output GEERCov=covuter GEEEmpPEst = uter;
601         run;

