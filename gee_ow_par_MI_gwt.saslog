745        
746        /*************************************************************************************/
747        /**************** combine using mianalyze ********************************************/
748        
749        %macro MIPAR(dat1=, dat2=, dat3=, dat4=, dat5=);
750        
751        data temp;
752        	length _Imputation_ 3;
753        	set &dat1(in=a) &dat2(in=b) &dat3(in=c) &dat4(in=d) &dat5(in=e);
754        	if a then _Imputation_=1;
755          		else if b then _Imputation_=2;
756         		else if c then _Imputation_=3;
757          		else if d then _Imputation_=4;
758          		else if e then _Imputation_=5;
759          		  	
760          	/* approximate standard error from the half-width of the CI */
761          	StdErr = (uclpartialx - lclpartialx) / (2 * 1.96);
762          	Estimate = partlparx;
763          	Parameter = 'PartialPAR';
764          	
765          	keep _Imputation_ Estimate StdErr Parameter;
766        run;
767        
768        proc mianalyze data=temp;
769           modeleffects Estimate;
770           stderr StdErr;
771        run;
772        
773        %mend MIPAR;
