2591       	
2591     !  data dat.life_RR_adj;
2592       		length Parm $ 15;
2593       		length mod $ 40;
2594       		length group $ 40;
2595           	length analysis $ 40;
2596       
2597       
2598       		set mi_life_ch(in=a) mi_life_ch_t(in=b) mi_life_adol(in=c) mi_life_adol_t(in=d) ;
2599       		
2600       		if a OR b then mod="ch";
2601       		if c OR d then mod="adol";
2602       
2603       		if Parm in (
2604       
2605               "chchwestq1", "chchwestq2", "chchwestq3", "chchstq1", "chchstq2", "chchstq3",
2606       		"chchpaq0", "chchpaq1", "chchpaq2",
2607       
2608               "adolchwestq1", "adolchwestq2", "adolchwestq3", "adolchstq1", "adolchstq2", "adolchstq3",
2609       		"adolchpaq0", "adolchpaq1", "adolchpaq2",
2610       		
2611       		"chwestv_chm", "chstv_chm", "chpav_chm",
2612       		"chwestv_adolm", "chstv_adolm", "chpav_adolm"
2613       		
2614       		); *only keep main exposures when exporting;
2615       
2616       		group="life";
2617       		analysis="adjusted";
2618       
2619       		RR=exp(Estimate); LCI=exp(LCLMean); UCI=exp(UCLMean);
2620       	run;

