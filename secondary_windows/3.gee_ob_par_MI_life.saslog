2264       RUN THE RR, WITH METANALYSIS BY IMPUTATION - NOT SIMULTANEOSLY ADJUSTING FOR PRIOR
2265       EXPOSURE WINDOWS
2266       **********************************************************************/
2267       
2268       /*childhood exposures data will remain the same as before since
2269       it wasn't adjusted by prior windows*/
2270       
2271       /***************************************************************************************/
2272       
2273       
2274       title "HEADER: personal modifiable factors - ADOLESCENCE ";
2275       proc genmod data = all descending;
2276       	by _imputation_ ;
2277       class id momid ;
2278       model chobv_adol = &adolchwestq_ &adolchstq_ &adolchpaq_ &adolchcalq_
2279                   cohort chage_adol white sex chbmi_adol
2280       
2281       	/ dist = Poisson link = log;
2282       	repeated subject=id(momid)/type=unstr PRINTMLE ecovb; /*note that our data no longer has repeated subjects, it is one row/id so might not
2282     ! have to do this*/
2283       	ods output GEERCov=covlife GEEEmpPEst = life_adol;
2284       run;

