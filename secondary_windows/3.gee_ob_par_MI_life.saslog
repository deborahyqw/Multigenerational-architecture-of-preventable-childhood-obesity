2446       
2447       	%indic3(vbl=chwestv_chq, reflev=0, missing=., min=1, max=3, prefix=chchwestq, usemiss=0,
2448                   label1='Q2',label2='Q3', label3='Q4');
2449           %indic3(vbl=chcalv_chq, reflev=0, missing=., min=1, max=3, prefix=chchcalq, usemiss=0,
2450                   label1='Q2',label2='Q3', label3='Q4');
2451           %indic3(vbl=chstv_chq, reflev=0, missing=., min=1, max=3, prefix=chchstq, usemiss=0,
2452                   label1='Q2',label2='Q3', label3='Q4');
2453           %indic3(vbl=chpav_chq, reflev=3, missing=., min=0, max=2, prefix=chchpaq, usemiss=0,
2454                   label0='Q1',label1='Q2', label2='Q3');
2455       
2456       	%indic3(vbl=chwestv_adolq, reflev=0, missing=., min=1, max=3, prefix=adolchwestq, usemiss=0,
2457                   label1='Q2',label2='Q3', label3='Q4');
2458           %indic3(vbl=chcalv_adolq, reflev=0, missing=., min=1, max=3, prefix=adolchcalq, usemiss=0,
2459                   label1='Q2',label2='Q3', label3='Q4');
2460           %indic3(vbl=chstv_adolq, reflev=0, missing=., min=1, max=3, prefix=adolchstq, usemiss=0,
2461                   label1='Q2',label2='Q3', label3='Q4');
2462           %indic3(vbl=chpav_adolq, reflev=3, missing=., min=0, max=2, prefix=adolchpaq, usemiss=0,
2463                   label0='Q1',label1='Q2', label2='Q3');
2464       
2465       	/*note that we only want to keep participants without missing exposure data for both windows
2466       	so that adjusted and unadjusted effect estimates are more comparable*/
2467       
2468       	if not missing(chwestv_chq) AND not missing(chstv_chq) AND not missing(chpav_chq);
2469       	*AND not missing(chwestv_adolq) AND not missing(chstv_adolq) AND not missing(chpav_adolq);
2470       	
2471       run;

