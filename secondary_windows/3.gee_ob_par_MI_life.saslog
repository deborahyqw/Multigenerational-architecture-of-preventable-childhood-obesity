2118       
2119       
2120       /**********************************************************************
2121       RUN THE RR, WITH METANALYSIS BY IMPUTATION - SIMULTANEOSLY ADJUSTING FOR PRIOR
2122       EXPOSURE WINDOWS
2123       **********************************************************************/
2124       
2125       title "HEADER: personal modifiable factors - CHILDHOOD ";
2126       proc genmod data = all descending;
2127       	by _imputation_ ;
2128       	class id momid ;
2129       	model chobv_adol = &chchwestq_ &chchstq_ &chchpaq_ &chchcalq_
2130                   cohort chage_ch white sex chbmi_ch
2131       	/ dist = Poisson link = log;
2132       	repeated subject=id(momid)/type=unstr PRINTMLE ecovb; /*note that our data no longer has repeated subjects, it is one row/id so might not
2132     ! have to do this*/
2133       	ods output GEERCov=covlife GEEEmpPEst = life_ch;
2134       run;

