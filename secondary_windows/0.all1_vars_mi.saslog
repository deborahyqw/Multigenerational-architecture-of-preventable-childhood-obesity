117936     /****************************** GUTS1 ********************************************/
117937     data all1;
117938     	merge gutsmoms1 (in=master) grav09guts1 bmibpregdt end=_end_;
117939       	by id; exrec=1;
117940       	if master; if cohort=1 ;
117941       	if chbmi96 >0 ; *keep only children without missing baseline BMI;
117942       	if first.id then exrec=0;
117943       	
117944       	if white=. then white=0;
117945       	
117946       	*maternal age at birth - 1980-1987;
117947      	agebirth = age89 - (retmo89 /12 - (chyob-1900));
117948      		
117949     	if chage97=. then chage97=chage96+1; if chage98=. then chage98=chage97+1;
117950     	if chage99=. then chage99=chage98+1; if chage00=. then chage00=chage99+1;
117951     	if chage01=. then chage01=chage00+1; if chage03=. then chage03=chage01+2; if chage05=. then chage05=chage03+2;
117952     
117953         moagebase=age95+1; if moagebase=. then moagebase=age89+7;
117954         if age97=. then age97=moagebase+1; if age98=. then age98=age97+1;
117955     	if age99=. then age99=age98+1; if age00=. then age00=age99+1;
117956     	if age01=. then age01=age00+1; if age03=. then age03=age01+2; if age05=. then age05=age03+2;
117957     				
117958     	/*exposure window update, array needs to cover data from 1989*/
117959     	array region{9} region10_89 region10_91 region10_93 region10_95 region10_97 region10_99 region10_01 region10_03 region10_05;
117960     	array mid{9} midwest89 midwest91 midwest93 midwest95 midwest97 midwest99 midwest01 midwest03 midwest05;
117961     	array south{9} south89 south91 south93 south95 south97 south99 south01 south03 south05;
117962     	array west{9} west89 west91 west93 west95 west97 west99 west01 west03 west05;
117963     	
117964     	do i = 1 to 9;
117965       	if missing(region{i}) then do;
117966        		 mid{i}   = .;
117967         	south{i} = .;
117968         	west{i}  = .;
117969       	end;
117970       	else do;
117971       	  mid{i}   = (region{i} = 2);  /* => 1 if region{i}=2, else 0 */
117972        	  south{i} = (region{i} = 3);  /* => 1 if region{i}=3, else 0 */
117973           west{i}  = (region{i} = 4);  /* => 1 if region{i}=4, else 0 */
117974       	end;
117975     	end; drop i;
117976     	
117977     	keep  id momid cohort ch_birthday natal_sex birthday
117978     			retmo95 retmo97 retmo99 retmo01 retmo03 retmo05
117979     			irt96   irt97   irt98   irt99   irt00 irt01    irt03  irt05
117980     			agebirth moagebase age97 age98 age99 age00 age01 age03 age05
117981     			bmi89    bmi91    bmi93    bmi95   bmi97   bmi99   bmi01   bmi03  bmi05 /*exposure window addition*/
117982     			/*bmi95v bmi97v bmi99v bmi01v bmi03v bmi05v*/
117983     			smk89    smk91   smk93 smk95 smk97 smk99 smk01 smk03 smk05  white  husbeduc 	/*exposure window addition; added in 1989, 1991 and 1993*/
117984     			/*ahei95v ahei99v  ahei03v*/
117985     			f291 f295  f299  f203 /*exposure window addition*/
117986     			/*f295v  f299v  f203v*/
