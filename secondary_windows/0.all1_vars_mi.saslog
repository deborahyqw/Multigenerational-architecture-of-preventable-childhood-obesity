120943     /****************************** GUTS1 ********************************************/
120944     data all1;
120945     	merge gutsmoms1 (in=master) grav09guts1 bmibpregdt end=_end_;
120946       	by id; exrec=1;
120947       	if master; if cohort=1 ;
120948       	if chbmi96 >0 ; *keep only children without missing baseline BMI;
120949       	if first.id then exrec=0;
120950       	
120951       	if white=. then white=0;
120952       	
120953       	*maternal age at birth - 1980-1987;
120954      	agebirth = age89 - (retmo89 /12 - (chyob-1900));
120955      		
120956     	if chage97=. then chage97=chage96+1; if chage98=. then chage98=chage97+1;
120957     	if chage99=. then chage99=chage98+1; if chage00=. then chage00=chage99+1;
120958     	if chage01=. then chage01=chage00+1; if chage03=. then chage03=chage01+2; if chage05=. then chage05=chage03+2;
120959     
120960         moagebase=age95+1; if moagebase=. then moagebase=age89+7;
120961         if age97=. then age97=moagebase+1; if age98=. then age98=age97+1;
120962     	if age99=. then age99=age98+1; if age00=. then age00=age99+1;
120963     	if age01=. then age01=age00+1; if age03=. then age03=age01+2; if age05=. then age05=age03+2;
120964     				
120965     	/*exposure window update, array needs to cover data from 1989*/
120966     	array region{9} region10_89 region10_91 region10_93 region10_95 region10_97 region10_99 region10_01 region10_03 region10_05;
120967     	array mid{9} midwest89 midwest91 midwest93 midwest95 midwest97 midwest99 midwest01 midwest03 midwest05;
120968     	array south{9} south89 south91 south93 south95 south97 south99 south01 south03 south05;
120969     	array west{9} west89 west91 west93 west95 west97 west99 west01 west03 west05;
120970     	
120971     	do i = 1 to 9;
120972       	if missing(region{i}) then do;
120973        		 mid{i}   = .;
120974         	south{i} = .;
120975         	west{i}  = .;
120976       	end;
120977       	else do;
120978       	  mid{i}   = (region{i} = 2);  /* => 1 if region{i}=2, else 0 */
120979        	  south{i} = (region{i} = 3);  /* => 1 if region{i}=3, else 0 */
120980           west{i}  = (region{i} = 4);  /* => 1 if region{i}=4, else 0 */
120981       	end;
120982     	end; drop i;
120983     	
120984     	keep  id momid cohort ch_birthday natal_sex birthday
120985     			retmo95 retmo97 retmo99 retmo01 retmo03 retmo05
120986     			irt96   irt97   irt98   irt99   irt00 irt01    irt03  irt05
120987     			agebirth moagebase age97 age98 age99 age00 age01 age03 age05
120988     			bmi89    bmi91    bmi93    bmi95   bmi97   bmi99   bmi01   bmi03  bmi05 /*exposure window addition*/
