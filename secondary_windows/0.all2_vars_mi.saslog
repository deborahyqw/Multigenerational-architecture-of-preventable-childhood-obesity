84                                                                  The SAS System                                     12:59 Monday, September 1, 2025

108333       	by id; exrec=1;
108334       	if master; if cohort=2 ;
108335       	if chbmi04 >0 ; *keep only children without missing baseline BMI;
108336       	if first.id then exrec=0;
108337       	
108338       	if white=. then white=0;
108339       	
108340       	if chyob < 1990 then bmibpreg = .; *chyob 1987-1996;
108341       		else if chyob >= 1990 & chyob < 1992 then bmibpreg = bmi89v;
108342       		else if chyob >= 1992 & chyob < 1994 then bmibpreg = bmi91v;
108343       		else if chyob >= 1994 & chyob < 1996 then bmibpreg = bmi93v;
108344       		else bmibpreg = bmi95v;
108345       		                        	
108346      	*maternal age at birth ;
108347      	agebirth = age89 - (retmo89 /12 - (chyob-1900));
108348      	
108349      	moagebase=age03+1; if moagebase=. then moagebase=age89+15;
108350     	age06=age05+1; age08=age07+1;
108351      		
108352     	if chage06=. then chage06=chage04+2; if chage08=. then chage08=chage06+2;
108353     	if chage11=. then chage11=chage08+3; if chage13=. then chage13=chage11+2;
108354         if age06=. then age06=moagebase+2; if age08=. then age08=age06+2;
108355     	if age11=. then age11=age08+3; if age13=. then age13=age11+2;
108356     
108357     	/*exposure window update, array needs to cover data from 1989*/
108358     	array region{12} region10_89 region10_91 region10_93 region10_95 region10_97 region10_99 region10_01 region10_03 region10_05 region10_07
108358   ! region10_11 region10_13;
108359     	array mid{12} midwest89 midwest91 midwest93 midwest95 midwest97 midwest99 midwest01 midwest03 midwest05 midwest07 midwest11 midwest13 ;
108360     	array south{12} south89 south91 south93 south95 south97 south99 south01 south03 south05 south07 south11 south13 ;
108361     	array west{12} west89 west91 west93 west95 west97 west99 west01 west03 west05 west07 west11 west13 ;
108362     	
108363     	do i = 1 to 12;
108364       	if missing(region{i}) then do;
108365        		mid{i}   = .;
108366         	south{i} = .;
108367         	west{i}  = .;
108368       	end;
108369       	else do;
108370       	  mid{i}   = (region{i} = 2);  /* => 1 if region{i}=2, else 0 */
108371        	  south{i} = (region{i} = 3);  /* => 1 if region{i}=3, else 0 */
108372           west{i}  = (region{i} = 4);  /* => 1 if region{i}=4, else 0 */
108373       	end;
108374     	end; drop i;
