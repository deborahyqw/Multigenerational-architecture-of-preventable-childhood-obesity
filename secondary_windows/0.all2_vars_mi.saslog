111337     /****************************** GUTS 2 ********************************************/
111338     data all2;
111339       merge gutsmoms2 (in=master) grav09guts2 bmibpregdt end=_end_;
111340       	by id; exrec=1;
111341       	if master; if cohort=2 ;
111342       	if chbmi04 >0 ; *keep only children without missing baseline BMI;
111343       	if first.id then exrec=0;
111344       	
111345       	if white=. then white=0;
111346       	
111347       	if chyob < 1990 then bmibpreg = .; *chyob 1987-1996;
111348       		else if chyob >= 1990 & chyob < 1992 then bmibpreg = bmi89v;
111349       		else if chyob >= 1992 & chyob < 1994 then bmibpreg = bmi91v;
111350       		else if chyob >= 1994 & chyob < 1996 then bmibpreg = bmi93v;
111351       		else bmibpreg = bmi95v;
111352       		                        	
111353      	*maternal age at birth ;
111354      	agebirth = age89 - (retmo89 /12 - (chyob-1900));
111355      	
111356      	moagebase=age03+1; if moagebase=. then moagebase=age89+15;
111357     	age06=age05+1; age08=age07+1;
85                                                                  The SAS System                                     11:29 Monday, November 17, 2025

111358      		
111359     	if chage06=. then chage06=chage04+2; if chage08=. then chage08=chage06+2;
111360     	if chage11=. then chage11=chage08+3; if chage13=. then chage13=chage11+2;
111361         if age06=. then age06=moagebase+2; if age08=. then age08=age06+2;
111362     	if age11=. then age11=age08+3; if age13=. then age13=age11+2;
111363     
111364     	/*exposure window update, array needs to cover data from 1989*/
111365     	array region{12} region10_89 region10_91 region10_93 region10_95 region10_97 region10_99 region10_01 region10_03 region10_05 region10_07
111365   ! region10_11 region10_13;
111366     	array mid{12} midwest89 midwest91 midwest93 midwest95 midwest97 midwest99 midwest01 midwest03 midwest05 midwest07 midwest11 midwest13 ;
111367     	array south{12} south89 south91 south93 south95 south97 south99 south01 south03 south05 south07 south11 south13 ;
111368     	array west{12} west89 west91 west93 west95 west97 west99 west01 west03 west05 west07 west11 west13 ;
111369     	
111370     	do i = 1 to 12;
111371       	if missing(region{i}) then do;
111372        		mid{i}   = .;
111373         	south{i} = .;
111374         	west{i}  = .;
111375       	end;
111376       	else do;
111377       	  mid{i}   = (region{i} = 2);  /* => 1 if region{i}=2, else 0 */
111378        	  south{i} = (region{i} = 3);  /* => 1 if region{i}=3, else 0 */
111379           west{i}  = (region{i} = 4);  /* => 1 if region{i}=4, else 0 */
111380       	end;
111381     	end; drop i;
