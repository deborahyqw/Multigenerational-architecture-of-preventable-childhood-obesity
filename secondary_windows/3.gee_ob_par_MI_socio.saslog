2697       /**********************************************************************/
2698       /*NOW COMBINE ALL DATASETS TOGETHER FOR EXPORT*/
2699       
2700       /*MANUAL SPECIFICATION OF DATASET NAME AND GROUP*/
2701       	
2701     !  data dat.socio_RR_adj;
2702       		length Parm $ 15;
2703       		length mod $ 40;
2704       		length group $ 40;
2705           length analysis $ 40;
2706       
2707       		set mi_nses_preg(in=a) mi_nses_earlych(in=b) mi_nses_ch(in=c) mi_nses_adol(in=d)
2708               mi_nses_preg_t(in=e) mi_nses_earlych_t(in=f) mi_nses_ch_t(in=g) mi_nses_adol_t(in=h) ;
61                                                                  The SAS System                                    13:53 Tuesday, November 18, 2025

2709       		
2710       		if a or e then mod="preg";
2711       		if b or f then mod="earlych";
2712           if c or g then mod="ch";
2713       		if d or h then mod="adol";
2714       
2715       		if Parm in (
2716       
2717             "sesv_pregm", "sesv_earlychm", "sesv_chm", "sesv_adolm",
2718       
2719             "pregsesq0", "pregsesq1", "pregsesq2",
2720             "earlychsesq0", "earlychsesq1", "earlychsesq2",
2721             "chsesq0", "chsesq1", "chsesq2",
2722             "adolsesq0", "adolsesq1", "adolsesq2"
2723               ); *only keep main exposures when exporting;
2724       
2725       		group="socio";
2726           analysis="adjusted";
2727       
2728       		RR=exp(Estimate); LCI=exp(LCLMean); UCI=exp(UCLMean);
2729       	run;

