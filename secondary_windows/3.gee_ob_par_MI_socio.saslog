2900       		length Parm $ 15;
2901       		length mod $ 40;
2902       		length group $ 40;
2903           length analysis $ 40;
2904       
2905       
2906       		set mi_nses_preg(in=a) mi_nses_earlych(in=b) mi_nses_ch(in=c) mi_nses_adol(in=d)
2907               mi_nses_preg_t(in=e) mi_nses_earlych_t(in=f) mi_nses_ch_t(in=g) mi_nses_adol_t(in=h) ;
2908       		
2909       		if a or e then mod="preg";
2910       		if b or f then mod="earlych";
2911           if c or g then mod="ch";
2912       		if d or h then mod="adol";
2913       
2914       		if Parm in (
2915       
2916             "sesv_pregm", "sesv_earlychm", "sesv_chm", "sesv_adolm",
2917             "pregsesq0", "pregsesq1", "pregsesq2",
2918             "earlychsesq0", "earlychsesq1", "earlychsesq2",
2919             "chsesq0", "chsesq1", "chsesq2",
2920             "adolsesq0", "adolsesq1", "adolsesq2"
2921               ); *only keep main exposures when exporting;
2922       
2923       		group="socio";
2924           analysis="unadjusted";
2925       
2926       		RR=exp(Estimate); LCI=exp(LCLMean); UCI=exp(UCLMean);
2927       	run;

