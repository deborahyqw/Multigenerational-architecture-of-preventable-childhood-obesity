2125       title "HEADER: nSES - PREGNANCY";
2126       proc genmod data = all descending;
2127           by _imputation_ ;
2128           class id momid ;
2129           model chobv_adol = heduc1 heduc2 fincome1 fincome2 fincome3
2130                       pregsesq0 pregsesq1 pregsesq2
2131                     midwest_preg south_preg west_preg chage_preg white sex
2132           / dist = Poisson link = log;
2133           repeated subject=id(momid)/type=unstr PRINTMLE ecovb;
2134           ods output GEERCov=covnses GEEEmpPEst = nses_preg;
2135       run;

