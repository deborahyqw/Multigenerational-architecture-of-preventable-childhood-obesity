2324       
2325       /**********************************************************************/
2326       /*NOW COMBINE ALL DATASETS TOGETHER FOR EXPORT*/
2327       
2328       /*MANUAL SPECIFICATION OF DATASET NAME AND GROUP*/
2329       	
2329     !  data dat.socio_RR_adj;
2330       		length Parm $ 15;
2331       		length mod $ 40;
2332       		length group $ 40;
2333           length analysis $ 40;
2334       
2335       		set mi_nses_preg(in=a) mi_nses_earlych(in=b) mi_nses_ch(in=c) mi_nses_adol(in=d)
2336               mi_nses_preg_t(in=e) mi_nses_earlych_t(in=f) mi_nses_ch_t(in=g) mi_nses_adol_t(in=h) ;
2337       		
2338       		if a or e then mod="preg";
2339       		if b or f then mod="earlych";
2340           if c or g then mod="ch";
2341       		if d or h then mod="adol";
2342       
2343       		if Parm in (
2344       
2345             "sesv_pregm", "sesv_earlychm", "sesv_chm", "sesv_adolm",
2346       
2347             "pregsesq0", "pregsesq1", "pregsesq2",
2348             "earlychsesq0", "earlychsesq1", "earlychsesq2",
2349             "chsesq0", "chsesq1", "chsesq2",
2350             "adolsesq0", "adolsesq1", "adolsesq2"
2351               ); *only keep main exposures when exporting;
2352       
2353       		group="socio";
2354           analysis="adjusted";
2355       
2356       		RR=exp(Estimate); LCI=exp(LCLMean); UCI=exp(UCLMean);
2357       	run;

