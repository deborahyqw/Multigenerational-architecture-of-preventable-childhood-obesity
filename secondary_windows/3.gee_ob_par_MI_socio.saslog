2450           %indic3(vbl=sesv_pregq, reflev=3, missing=., min=0, max=2, prefix=pregsesq, usemiss=0,
2451                   label0='Q1',label1='Q2', label2='Q3');
2452       
2453           %indic3(vbl=sesv_earlychq, reflev=3, missing=., min=0, max=2, prefix=earlychsesq, usemiss=0,
2454                   label0='Q1',label1='Q2', label2='Q3');
2455       
2456           %indic3(vbl=sesv_chq, reflev=3, missing=., min=0, max=2, prefix=chsesq, usemiss=0,
2457                   label0='Q1',label1='Q2', label2='Q3');
2458       
2459           %indic3(vbl=sesv_adolq, reflev=3, missing=., min=0, max=2, prefix=adolsesq, usemiss=0,
2460                   label0='Q1',label1='Q2', label2='Q3');
2461       
2462       
2463       	/*note that we only want to keep participants without missing exposure data for the earliest window
2464       	okay if missing for later windows because they might have developed outcome*/
2465       
2466           if not missing(sesv_pregq);
2467           *AND not missing(sesv_earlych) AND not missing(sesv_chq) AND not missing(sesv_adolq);
2468       
2469       run;

