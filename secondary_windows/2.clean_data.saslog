1092       /***************************************************************************
1093       Calculate exposure averages
1094       ****************************************************************************/
1095       
1096       /* within each age indicator, take the average of all the exposure windows
1097       personal: chwest chst chpa chcal / chbmibase
1098       mom: mowest mocal mopa moshift moob (measured with mombmi) [mosmk - this is categorical]
1099       social: ses
1100       */
1101       
1102       
1103       
1104       proc means data=all noprint;
1105         class cohort _imputation_ id momid age_ind; /*group by variables that aren't changing and we want to keep*/
1106         var chwest chst chpa chcal mowest mocal mopa moshift mosmk ses; /*variables we want to take the average or sum of*/
1107         output out=summarized_means
1108           mean(chwest)=chwestv
1109           mean(chst)=chstv
1110           mean(chpa)=chpav
1111           mean(chcal)=chcalv
1112           mean(mowest)=mowestv
1113           mean(mocal)=mocalv
1114           mean(mopa)=mopav
1115           mean(moshift)=moshiftv
1116           mean(mobmi)=mobmiv
1117           mean(mosmk)=mosmkv
1118           mean(ses)=sesv
1119           sum(chob)=chobv
1120           ;
1121       run;

