1349       
1350       
1351       /*transpose from long to wide*/
1352       
1353       
1354       /*transpose the means based on the age indicators*/
1355       
1356       %let covariate_list = chage chbmi moage region; /*list of covariates to run through*/
1357       
1358       %macro run_all_covariates;
1359         %let n = 1;
1360         %let this_covariate = %scan(&covariate_list, &n);
1361       
1362         %do %while(%length(&this_covariate));
1363       
1364           proc transpose data=earliest out=wide_&this_covariate. prefix=&this_covariate._;
1365             by cohort _imputation_ id momid;
1366             id age_ind;
1367             var &this_covariate;
1368           run;
1369       
1370           %let n = %eval(&n + 1);
1371           %let this_covariate = %scan(&covariate_list, &n);
1372         %end;
1373       
1374       %mend run_all_covariates;
1375       
1376       
1377       %run_all_covariates;

