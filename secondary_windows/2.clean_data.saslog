1284       data earliest;
1285           set all;
1286           by cohort _imputation_ id momid age_ind;
1287       
1288           retain chage_keep chbmi_keep moage_keep region_keep
1289                   chage_year chbmi_year moage_year region_year
1290                  ;
1291       
1292           /* Initialize retained vars at start of each group */
1293           if first.age_ind then do;
1294               call missing(chage_keep, chbmi_keep, moage_keep, region_keep,
1295                           chage_year, chbmi_year, moage_year, region_year);
1296           end;
1297       
1298           /* Keep first non-missing value (from earliest year) */
1299           if missing(chage_keep) and not missing(chage) then do;
1300               chage_keep = chage;
1301               chage_year = year;
1302           end;
1303       
1304           if missing(chbmi_keep) and not missing(chbmi) then do;
1305               chbmi_keep = chbmi;
1306               chbmi_year = year;
1307           end;
1308       
