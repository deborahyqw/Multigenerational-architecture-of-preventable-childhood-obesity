1435       /***************************************************************************
1436       FINALLY MERGE ALL DATASETS AND ADJUST FURTHER FOR ANALYSIS
1437       ****************************************************************************/
1438       
1439       data exwindows;
1440         merge
1441           nonvarying summarized_outcome
1442           wide_chwestv wide_chstv wide_chpav wide_chcalv wide_mowestv wide_mocalv
1443           wide_mopav wide_moshiftv wide_mobmiv wide_mosmkv wide_sesv wide_chobv
1444           wide_chage wide_chbmi wide_moage wide_region
1445       
1446         end=_end_;
1447       
1448         by cohort _imputation_ id momid;
1449       
1450         /*note maternal smoking is 0 (never) or 1 (ever/never) when we took the average within exposure periods, a average that is not 0 will
1450     ! indicate a change
1451         between status*/
1452         if mosmkv_preg = 0 then mosmkv_preg = 0; else if mosmkv_preg > 0 then mosmkv_preg =1;
1453         if mosmkv_earlych = 0 then mosmkv_earlych = 0; else if mosmkv_earlych > 0 then mosmkv_earlych =1;
1454         if mosmkv_ch = 0 then mosmkv_ch = 0; else if mosmkv_ch > 0 then mosmkv_ch =1;
1455         if mosmkv_adol = 0 then mosmkv_adol = 0; else if mosmkv_adol > 0 then mosmkv_adol =1;
1456       
1457         /*recode mombmi to binary obese/not obese variable. will be using the average of each exposure window*/
1458         *#PPP# I worry that mom obesity during peri-pregnancy is susceptible for misclassification.
1459         	BMI during the 3 trimester can fall under the obesity category even among mothers who are normal weight before pregnancy.
1460           I think we can focus on the pre-pregnancy obesity for this reason. ;  	
1461         /*BC: good point! So for the "the peri-pregnancy period", I will use the pre-pregnancy bmi instead, we will have to make a note of
1462         this in the methods or somewhere in the figure description*/
1463       
1464         if bpregob = 1 then moob_preg=1; else if bpregob = 0 then moob_preg=0;
1465         if mobmiv_earlych >= 30 then moob_earlych=1; else if not missing(mobmiv_earlych) AND mobmiv_earlych<30 then moob_earlych=0;
1466         if mobmiv_ch >= 30 then moob_ch=1; else if not missing(mobmiv_ch) AND mobmiv_ch<30 then moob_ch=0;
1467         if mobmiv_adol >= 30 then moob_adol=1; else if not missing(mobmiv_adol) AND mobmiv_adol<30 then moob_adol=0;
1468       
1469       
1470         /*will redefine shiftwork to be binary, some shiftwork versus no shiftwork, so that regressions can converge (funky distributions
1470     ! otherwise)*/
1471           if moshiftv_preg > 0 then moshiftb_preg=1; else if not missing(moshiftv_preg) AND moshiftv_preg<=0 then moshiftb_preg=0;
1472           if moshiftv_earlych > 0 then moshiftb_earlych=1; else if not missing(moshiftv_earlych) AND moshiftv_earlych<=0 then moshiftb_earlych=0;
1473           if moshiftv_ch > 0 then moshiftb_ch=1; else if not missing(moshiftv_ch) AND moshiftv_ch<=0 then moshiftb_ch=0;
1474           if moshiftv_adol > 0 then moshiftb_adol=1; else if not missing(moshiftv_adol) AND moshiftv_adol<=0 then moshiftb_adol=0;
1475       
1476         /*refine region to dummy variables*/
1477         midwest_preg = .; south_preg = .;  west_preg = .;
1478         if region_preg = 1 then do; midwest_preg = 0; south_preg  = 0; west_preg   = 0; end;
1479           else if region_preg = 2 then do; midwest_preg = 1; south_preg  = 0; west_preg   = 0; end;
1480           else if region_preg = 3 then do; midwest_preg = 0; south_preg  = 1; west_preg   = 0; end;
1481           else if region_preg = 4 then do; midwest_preg = 0; south_preg  = 0; west_preg   = 1; end;
1482       
1483         midwest_earlych=.; south_earlych=.; west_earlych=.;
1484         if region_earlych = 1 then do; midwest_earlych = 0; south_earlych  = 0; west_earlych   = 0; end;
18                                                                  The SAS System                                 14:56 Wednesday, September 10, 2025

1485           else if region_earlych = 2 then do; midwest_earlych = 1; south_earlych  = 0; west_earlych   = 0; end;
1486           else if region_earlych = 3 then do; midwest_earlych = 0; south_earlych  = 1; west_earlych   = 0; end;
1487           else if region_earlych = 4 then do; midwest_earlych = 0; south_earlych  = 0; west_earlych   = 1; end;
1488       
1489         midwest_ch=.; south_ch=.; west_ch=.;
1490         if region_ch = 1 then do; midwest_ch = 0; south_ch  = 0; west_ch   = 0; end;
1491           else if region_ch = 2 then do; midwest_ch = 1; south_ch  = 0; west_ch   = 0; end;
1492           else if region_ch = 3 then do; midwest_ch = 0; south_ch  = 1; west_ch   = 0; end;
1493           else if region_ch = 4 then do; midwest_ch = 0; south_ch  = 0; west_ch   = 1; end;
1494       
1495         midwest_adol=.; south_adol=.; west_adol=.;
1496         if region_adol = 1 then do; midwest_adol = 0; south_adol  = 0; west_adol   = 0; end;
1497           else if region_adol = 2 then do; midwest_adol = 1; south_adol  = 0; west_adol   = 0; end;
1498           else if region_adol = 3 then do; midwest_adol = 0; south_adol  = 1; west_adol   = 0; end;
1499           else if region_adol = 4 then do; midwest_adol = 0; south_adol  = 0; west_adol   = 1; end;
1500       
1501         %indic3(vbl=husbeduc, reflev=3, missing=., min=1, max=2, prefix=heduc, usemiss=0,
1502                 label1='<college',label2='college');
1503         %indic3(vbl=income, reflev=4, missing=., min=1, max=3, prefix=fincome, usemiss=0,
1504                 label1='<50k',label2='50-99k',label3='100-149k');
1505       
1506       run;

