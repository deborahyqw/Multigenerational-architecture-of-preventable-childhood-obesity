794        /***************************************************************************
795        MERGE GUTS1 AND GUTS2 ; ADJUST DATASET FURTHER
796        ****************************************************************************/
797        
798        data all;
799        	set all1_tidy all2_tidy;
800        
801        	if mobmi >= 30 then moob=1; else moob=0;
802        	if bmibpreg >= 30 then bpregob=1; else bpregob=0;
803        	
804        	/*create indicators for age*/
805        	length age_ind $ 20;
806        	if chage >=-1 and chage <1 then age_ind="preg";
807        	if chage >=1 and chage <5 then age_ind="earlych";
808        	if chage >=5 and chage <11 then age_ind="ch";
809        	if chage >=11 and chage <= 18 then age_ind="adol";
810        
811          /*change smoking to ever/never from past/current/never*/
812          if mosmk=1 then mosmk=0;
813            else if mosmk in (2,3) then mosmk=1;
814        
815          /*for now will change region from indicator variables into one variable*/
816          region=.;
817          if midwest=0 AND south=0 and west=0 then region=1;
818          if midwest=1 AND south=0 and west=0 then region=2;
819          if midwest=0 AND south=1 and west=0 then region=3;
820          if midwest=0 AND south=0 and west=1 then region=4;
821        
822          /*only keep if age_ind isn't missing: should only be missing if age is < -1*/
823          if not missing(age_ind);
824        
825        run;

