1564       
1565       /*calculate the median value of each quartile to then apply regression models to obtain
1566       the p for trend */
1567       
1568       %macro quant_med (data, var, quantvar, quantcont);
1569         proc means data=&data n nmiss median p25 p75;
1570           var &var;
1571           class cohort _imputation_ &quantvar;
1572           output out=stat MEDIAN=&quantcont;
1573         run;
1574         proc sort data=&data; by cohort  _imputation_ &quantvar; run;
1575         proc sort data=stat; by cohort  _imputation_ &quantvar; run;
1576       
1577         data &data;
1578           merge &data stat;
1579           by cohort  _imputation_ &quantvar;
1580           if momid = . then delete;
1581           if &var=. then &quantcont=.;
1582         run;
1583       
1584       %mend quant_med;
1585       
1586       
1587       %let exposure_m_list = chwestv chstv chpav mowestv mopav moshiftv mobmiv sesv; /*list of exposures to run through*/
1588       
1589       
1590       %macro run_medians(data, var, quantvar, quantcont);
1591         %let n = 1;
1592         %let this_exposure = %scan(&exposure_m_list, &n);
1593       
1594         %do %while(%length(&this_exposure));
1595       
1596           %quant_med (data=exwindows, var=&this_exposure._preg, quantvar=&this_exposure._pregq, quantcont=&this_exposure._pregm);
1597           %quant_med (data=exwindows, var=&this_exposure._earlych, quantvar=&this_exposure._earlychq, quantcont=&this_exposure._earlychm);
1598           %quant_med (data=exwindows, var=&this_exposure._ch, quantvar=&this_exposure._chq, quantcont=&this_exposure._chm);
1599           %quant_med (data=exwindows, var=&this_exposure._adol, quantvar=&this_exposure._adolq, quantcont=&this_exposure._adolm);
1600       
1601           %let n = %eval(&n + 1);
1602           %let this_exposure = %scan(&exposure_m_list, &n);
1603         %end;
1604       
1605       %mend run_medians;
1606       
