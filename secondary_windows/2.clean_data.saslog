1312           end;
1313       
1314           if missing(region_keep) and not missing(region) then do;
1315               region_keep = region;
1316               region_year = year;
1317           end;
1318       
1319           /* Output once per group, at the last obs */
1320           if last.age_ind then do;
1321               output;
1322           end;
1323       
1324           keep cohort _imputation_ id momid age_ind
1325                chage_keep chage_year
1326                chbmi_keep chbmi_year
1327                moage_keep moage_year
1328                region_keep region_year;
