1240       
1241       %let exposure_list = chwestv chstv chpav chcalv mowestv mocalv mopav moshiftv mobmiv mosmkv sesv chobv; /*list of exposures to run
1241     ! through*/
1242       
1243       %macro run_all_exposures;
1244         %let n = 1;
1245         %let this_exposure = %scan(&exposure_list, &n);
1246       
1247         %do %while(%length(&this_exposure));
1248       
1249           proc transpose data=summarized_means out=wide_&this_exposure. prefix=&this_exposure._;
1250             by cohort _imputation_ id momid;
1251             id age_ind;
1252             var &this_exposure;
1253           run;
1254       
1255           %let n = %eval(&n + 1);
1256           %let this_exposure = %scan(&exposure_list, &n);
1257         %end;
1258       
