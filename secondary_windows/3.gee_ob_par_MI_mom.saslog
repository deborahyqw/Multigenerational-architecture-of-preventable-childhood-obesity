2484       	/*note that we only want to keep participants without missing exposure data for the earliest window
2485       	okay if missing for later windows because they might have developed outcome*/
2486       
2487       	if not missing(moob_preg) AND not missing(mowestv_pregq) AND not missing(mocalv_pregq) AND not missing(mopav_pregq);
2488       	    *AND not missing(moob_earlych) AND not missing(mowestv_earlychq) AND not missing(mocalv_earlychq) AND not missing(mopav_earlychq) AND
2489       		not missing(moob_ch) AND not missing(mowestv_chq) AND not missing(mocalv_chq) AND not missing(mopav_chq) AND
2490       		not missing(moob_adol) AND not missing(mowestv_adolq) AND not missing(mocalv_adolq) AND not missing(mopav_adolq);
2491       run;

