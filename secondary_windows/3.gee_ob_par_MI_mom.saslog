2759       
2760       title "HEADER: maternal modifiable factors subject adjustment moob - ADOLESCENCE";
2761       proc genmod data = all descending;
2762       	by _imputation_ ;
2763       class id momid ;
2764       model chobv_adol = &adolmowestq_ &adolmocalq_ &adolmopaq_ mosmkv_adol moshiftb_adol
2765       				moage_adol chage_adol white sex
2766       				moob_adol
2767       
2768       	/ dist = Poisson link = log;
2769       	repeated subject=id(momid)/type=unstr PRINTMLE ecovb;
2770       	ods output GEERCov=covmom GEEEmpPEst = mom_adol_mob;
2771       run;

