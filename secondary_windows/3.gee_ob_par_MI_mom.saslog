2794     !  data dat.mom_RR;
2795       		length Parm $ 20;
2796       		length mod $ 40;
2797       		length group $ 40;
2798       		length analysis $ 40;
2799       
2800       		set mi_mom_preg(in=a) mi_mom_earlych(in=b) mi_mom_ch(in=c) mi_mom_adol(in=d)
2801       			mi_mom_preg_t(in=e) mi_mom_earlych_t(in=f) mi_mom_ch_t(in=g) mi_mom_adol_t(in=h)
2802       		
2803       		;
2804       		
2805       		if a or e then mod="preg";
2806       		if b or f then mod="earlych";
2807               if c or g then mod="ch";
2808       		if d or h then mod="adol";
2809       
2810       		if Parm in (
2811       			"mowestv_pregm", "mopav_pregm",
2812       			"mowestv_earlychm", "mopav_earlychm",
2813       			"mowestv_chm", "mopav_chm",
2814       			"mowestv_adolm", "mopav_adolm")
2815       
2816       		OR ((a or b or c or d) AND Parm in ("pregmowestq1", "pregmowestq2", "pregmowestq3",
2817       		"pregmopaq0", "pregmopaq1", "pregmopaq2", "mosmkv_preg",
2818       
2819               "earlychmowestq1", "earlychmowestq2", "earlychmowestq3",
2820       		"earlychmopaq0", "earlychmopaq1", "earlychmopaq2", "mosmkv_earlych",
2821               "chmowestq1", "chmowestq2", "chmowestq3",
2822       		"chmopaq0", "chmopaq1", "chmopaq2", "mosmkv_ch",
2823       
2824               "adolmowestq1", "adolmowestq2", "adolmowestq3",
2825       		"adolmopaq0", "adolmopaq1", "adolmopaq2", "mosmkv_adol"))
2826       
2827               OR (a and Parm="moshiftb_preg")
2828               OR (b and Parm="moshiftb_earlych")
2829               OR (c and Parm="moshiftb_ch")
2830               OR (d and Parm="moshiftb_adol")
2831       
2832               ; *only keep main exposures when exporting;
2833       
2834       
2835       		group="mom";
2836       		analysis="unadjusted";
2837       
2838       		RR=exp(Estimate); LCI=exp(LCLMean); UCI=exp(UCLMean);
