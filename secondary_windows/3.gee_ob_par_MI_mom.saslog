2471       /**********************************************************************/
2472       /*NOW COMBINE ALL DATASETS TOGETHER FOR EXPORT*/
2473       
2474       /*MANUAL SPECIFICATION OF DATASET NAME AND GROUP*/
2475       	
2475     !  data dat.mom_RR_adj;
2476       		length Parm $ 20;
2477       		length mod $ 40;
2478       		length group $ 40;
2479       		length analysis $ 40;
2480       
2481       
2482       		set mi_mom_preg(in=a) mi_mom_earlych(in=b) mi_mom_ch(in=c) mi_mom_adol(in=d)
2483       			mi_mom_preg_t(in=e) mi_mom_earlych_t(in=f) mi_mom_ch_t(in=g) mi_mom_adol_t(in=h)
2484       		
2485       		;
2486       		
2487       		if a or e then mod="preg";
2488       		if b or f then mod="earlych";
2489               if c or g then mod="ch";
2490       		if d or h then mod="adol";
2491       
2492       		if Parm in (
2493       			"mowestv_pregm", "mopav_pregm",
2494       			"mowestv_earlychm", "mopav_earlychm",
2495       			"mowestv_chm", "mopav_chm",
2496       			"mowestv_adolm", "mopav_adolm")
2497       
2498       		OR ((a or b or c or d) AND Parm in ("pregmowestq1", "pregmowestq2", "pregmowestq3",
2499       		"pregmopaq0", "pregmopaq1", "pregmopaq2", "mosmkv_preg",
2500       
2501               "earlychmowestq1", "earlychmowestq2", "earlychmowestq3",
2502       		"earlychmopaq0", "earlychmopaq1", "earlychmopaq2", "mosmkv_earlych",
2503               "chmowestq1", "chmowestq2", "chmowestq3",
2504       		"chmopaq0", "chmopaq1", "chmopaq2", "mosmkv_ch",
2505       
2506               "adolmowestq1", "adolmowestq2", "adolmowestq3",
2507       		"adolmopaq0", "adolmopaq1", "adolmopaq2", "mosmkv_adol"))
2508       
2509               OR (a and Parm="moshiftb_preg")
2510               OR (b and Parm="moshiftb_earlych")
2511               OR (c and Parm="moshiftb_ch")
2512               OR (d and Parm="moshiftb_adol")
2513       
2514               ; *only keep main exposures when exporting;
2515       
2516       
2517       		group="mom";
2518       		analysis="adjusted";
2519       
2520       		RR=exp(Estimate); LCI=exp(LCLMean); UCI=exp(UCLMean);
2521       	run;

