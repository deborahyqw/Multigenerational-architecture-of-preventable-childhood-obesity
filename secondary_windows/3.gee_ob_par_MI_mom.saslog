2465            %indic3(vbl=mocalv_earlychq, reflev=0, missing=., min=1, max=3, prefix=earlychmocalq, usemiss=0,
2466                   label1='Q2',label2='Q3', label3='Q4');
2467            %indic3(vbl=mopav_earlychq, reflev=3, missing=., min=0, max=2, prefix=earlychmopaq, usemiss=0,
2468                   label0='Q1',label1='Q2', label2='Q3');
2469       
