2838       /*MANUAL SPECIFICATION OF DATASET NAME AND GROUP*/
2839       	
2839     !  data dat.mom_RR_adj;
2840       		length Parm $ 20;
2841       		length mod $ 40;
2842       		length group $ 40;
2843       		length analysis $ 40;
2844       
2845       
2846       		set mi_mom_preg(in=a) mi_mom_earlych(in=b) mi_mom_ch(in=c) mi_mom_adol(in=d)
2847       			mi_mom_preg_t(in=e) mi_mom_earlych_t(in=f) mi_mom_ch_t(in=g) mi_mom_adol_t(in=h)
2848       		
2849       		;
2850       		
2851       		if a or e then mod="preg";
2852       		if b or f then mod="earlych";
2853               if c or g then mod="ch";
2854       		if d or h then mod="adol";
2855       
2856       		if Parm in (
2857       			"mowestv_pregm", "mopav_pregm",
2858       			"mowestv_earlychm", "mopav_earlychm",
2859       			"mowestv_chm", "mopav_chm",
2860       			"mowestv_adolm", "mopav_adolm")
2861       
2862       		OR ((a or b or c or d) AND Parm in ("pregmowestq1", "pregmowestq2", "pregmowestq3",
2863       		"pregmopaq0", "pregmopaq1", "pregmopaq2", "mosmkv_preg",
2864       
2865               "earlychmowestq1", "earlychmowestq2", "earlychmowestq3",
2866       		"earlychmopaq0", "earlychmopaq1", "earlychmopaq2", "mosmkv_earlych",
2867               "chmowestq1", "chmowestq2", "chmowestq3",
2868       		"chmopaq0", "chmopaq1", "chmopaq2", "mosmkv_ch",
2869       
2870               "adolmowestq1", "adolmowestq2", "adolmowestq3",
2871       		"adolmopaq0", "adolmopaq1", "adolmopaq2", "mosmkv_adol"))
2872       
2873               OR (a and Parm="moshiftb_preg")
65                                                                  The SAS System                                    13:45 Tuesday, November 18, 2025

2874               OR (b and Parm="moshiftb_earlych")
2875               OR (c and Parm="moshiftb_ch")
2876               OR (d and Parm="moshiftb_adol")
2877       
2878               ; *only keep main exposures when exporting;
2879       
2880       
2881       		group="mom";
2882       		analysis="adjusted";
2883       
2884       		RR=exp(Estimate); LCI=exp(LCLMean); UCI=exp(UCLMean);
2885       	run;

