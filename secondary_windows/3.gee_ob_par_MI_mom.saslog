2518       title "HEADER: maternal modifiable factors subject adjustment - Pregnancy";
2519       proc genmod data = all descending;
2520       	by _imputation_ ;
2521       	class id momid ;
2522       	model chobv_adol = &pregmowestq_ &pregmopaq_ mosmkv_preg moshiftb_preg
2523       				&pregmocalq_ moage_preg chage_preg white sex
2524       	/ dist = Poisson link = log;
2525       	repeated subject=id(momid)/type=unstr PRINTMLE ecovb;
2526       	ods output GEERCov=covmom GEEEmpPEst = mom_preg;
2527       run;

