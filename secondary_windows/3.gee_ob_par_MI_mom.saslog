2471                   label1='Q2',label2='Q3', label3='Q4');
2472            %indic3(vbl=mocalv_chq, reflev=0, missing=., min=1, max=3, prefix=chmocalq, usemiss=0,
2473                   label1='Q2',label2='Q3', label3='Q4');
2474            %indic3(vbl=mopav_chq, reflev=3, missing=., min=0, max=2, prefix=chmopaq, usemiss=0,
2475                   label0='Q1',label1='Q2', label2='Q3');
2476       
