2479            %indic3(vbl=mocalv_adolq, reflev=0, missing=., min=1, max=3, prefix=adolmocalq, usemiss=0,
2480                   label1='Q2',label2='Q3', label3='Q4');
2481            %indic3(vbl=mopav_adolq, reflev=3, missing=., min=0, max=2, prefix=adolmopaq, usemiss=0,
2482                   label0='Q1',label1='Q2', label2='Q3');
