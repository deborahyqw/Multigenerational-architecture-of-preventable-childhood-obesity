3154       /**********************************************************************/
3155       /*NOW COMBINE ALL DATASETS TOGETHER FOR EXPORT*/
3156       
3157       /*MANUAL SPECIFICATION OF DATASET NAME AND GROUP*/
3158       	
3158     !  data dat.mom_RR;
3159       		length Parm $ 20;
3160       		length mod $ 40;
3161       		length group $ 40;
3162       		length analysis $ 40;
3163       
3164       		set mi_mom_preg(in=a) mi_mom_earlych(in=b) mi_mom_ch(in=c) mi_mom_adol(in=d)
3165       			mi_mom_preg_t(in=e) mi_mom_earlych_t(in=f) mi_mom_ch_t(in=g) mi_mom_adol_t(in=h)
3166       		
3167       		;
3168       		
3169       		if a or e then mod="preg";
3170       		if b or f then mod="earlych";
3171               if c or g then mod="ch";
3172       		if d or h then mod="adol";
3173       
3174       		if Parm in (
3175       			"mowestv_pregm", "mopav_pregm",
3176       			"mowestv_earlychm", "mopav_earlychm",
3177       			"mowestv_chm", "mopav_chm",
3178       			"mowestv_adolm", "mopav_adolm")
3179       
3180       		OR ((a or b or c or d) AND Parm in ("pregmowestq1", "pregmowestq2", "pregmowestq3",
3181       		"pregmopaq0", "pregmopaq1", "pregmopaq2", "mosmkv_preg",
3182       
3183               "earlychmowestq1", "earlychmowestq2", "earlychmowestq3",
3184       		"earlychmopaq0", "earlychmopaq1", "earlychmopaq2", "mosmkv_earlych",
3185               "chmowestq1", "chmowestq2", "chmowestq3",
3186       		"chmopaq0", "chmopaq1", "chmopaq2", "mosmkv_ch",
3187       
3188               "adolmowestq1", "adolmowestq2", "adolmowestq3",
3189       		"adolmopaq0", "adolmopaq1", "adolmopaq2", "mosmkv_adol"))
3190       
3191               OR (a and Parm="moshiftb_preg")
3192               OR (b and Parm="moshiftb_earlych")
3193               OR (c and Parm="moshiftb_ch")
3194               OR (d and Parm="moshiftb_adol")
3195       
3196               ; *only keep main exposures when exporting;
3197       
3198       
3199       		group="mom";
3200       		analysis="unadjusted";
3201       
3202       		RR=exp(Estimate); LCI=exp(LCLMean); UCI=exp(UCLMean);
3203       	run;

