2143       %LET covar1= moage_preg chage_preg white sex ; run; /*MANUAL SPECIFICATION OF VARIABLES, NOT ADJUSTING FOR COHORT*/
2144       
2145       
2146       /**********************************************************************
2147       RUN THE RR, WITH METANALYSIS BY IMPUTATION - SIMULTANEOSLY ADJUSTING FOR PRIOR
2148       EXPOSURE WINDOWS
2149       **********************************************************************/
2150       
2151       /*note that I cannot seem to adjust by maternal smoking in previous exposure windows, might be due to the high correlation
2152       between windows*/
2153       
2154       title "HEADER: maternal modifiable factors subject adjustment - Pregnancy";
2155       proc genmod data = all descending;
2156       	by _imputation_ ;
2157       	class id momid ;
2158       	model chobv_adol = &pregmowestq_ &pregmopaq_ mosmkv_preg moshiftb_preg
2159       				&pregmocalq_ moage_preg chage_preg white sex
2160       	/ dist = Poisson link = log;
2161       	repeated subject=id(momid)/type=unstr PRINTMLE ecovb;
2162       	ods output GEERCov=covmom GEEEmpPEst = mom_preg;
2163       run;

