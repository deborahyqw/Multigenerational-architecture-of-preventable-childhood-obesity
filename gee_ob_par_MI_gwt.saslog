573        data all; set all end=_end_;
574          by _imputation_ id;
575        
576          if cohort=1; *only available in GUTS1;
577          /*
578            retain baselineYear . removeID 0;
579            if first.ID then do;
580               baselineYear = .;
581               removeID = 0;
582            end;  	 	
583            if missing(baselineYear) and not missing(gotweight) then baselineYear = year;
584            if missing(baselineYear) then delete;
585            if year = baselineYear then do;
586               if chob=1 or chbmi=. or lastq=chirt then removeID=1;
587            end;
588            if removeID=1 then delete;
589            if year > baselineYear and missing(gotweight) then delete;
590            */
591        run;

