751          if cohort=1; *only available in GUTS1;
752          /*
753            retain baselineYear . removeID 0;
754            if first.ID then do;
755               baselineYear = .;
756               removeID = 0;
757            end;  	 	
758            if missing(baselineYear) and not missing(gotweight) then baselineYear = year;
759            if missing(baselineYear) then delete;
760            if year = baselineYear then do;
761               if chob=1 or chbmi=. or lastq=chirt then removeID=1;
762            end;
763            if removeID=1 then delete;
764            if year > baselineYear and missing(gotweight) then delete;
765            */
766        run;

