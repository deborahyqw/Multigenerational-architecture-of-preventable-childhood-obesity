637        *proc print data=betas;
638        
639        data covparms;
640        	set covuter;
641        	by _imputation_;
642        	length _type_ $4;
643        	 _type_ = 'COV';
644        
645        	rename  Prm1=intercept   Prm2=gotweight  Prm3=agebirth   Prm4=bpregob    Prm5=prev_preg1    Prm6=prev_preg2
646        			Prm7=prev_preg3  Prm8=chage     Prm9=white        Prm10=sex   ;
647        
648        	length _name_ $10;
649        	
650        	*i counts rows within each _imputation_;
651        	if first._imputation_ then i=1;
652         		 else i+1;
653        
654        	* Assign which row this is (the row "label" in the covariance matrix) ;
655        	select(i);
656        		when(1)  _name_ = 'INTERCEPT';
657        		when(2)  _name_ = 'gotweight';
658        		when(3)  _name_ = 'agebirth';
659        		when(4)  _name_ = 'bpregob';
660        		when(5)  _name_ = 'prev_preg1';
661        		when(6)  _name_ = 'prev_preg2';
662        		when(7)  _name_ = 'prev_preg3';
663        		when(8)  _name_ = 'chage';
664        		when(9)  _name_ = 'white';
665        		when(10)  _name_ = 'sex';
666        		otherwise;
667        	end;
668        	
669        	* Output EVERY row;
670          	output;
671        
672        keep _imputation_ _type_ _name_ prm1-prm10 ;
673        
674        run;

