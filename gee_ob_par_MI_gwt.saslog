782        
783        data betas;
784          set uter ;
785          by _imputation_;
786          _type_ = 'PARM';
787        	retain intercept gotweight agebirth bpregob prev_preg1 prev_preg2 prev_preg3
788          				chage white sex;
789        	
790        	* 'i' counts rows within each _imputation_ group ;
791          	if first._imputation_ then i=1;
792          	else i+1;
793        	
794        	select (i);
795            when (1) intercept = estimate;
796            when (2) gotweight  = estimate;
797            when (3) agebirth  = estimate;
798        	when (4) bpregob   = estimate;
799        	when (5) prev_preg1= estimate;
800        	when (6) prev_preg2  = estimate;
801        	when (7) prev_preg3  = estimate;
802            when (8) chage    = estimate;
803            when (9) white    = estimate;
804            when (10) sex      = estimate;
805            otherwise;
806          end;
807        	
808          * Only OUTPUT once per _imputation_, after we've assigned all param columns ;
809          if last._imputation_ then output;
810        
811        run;

