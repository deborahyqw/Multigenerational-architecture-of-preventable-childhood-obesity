926      !      0.1018
927        ;
928        
929        /*************************************************************************************/
930        /**************** combine using mianalyze ********************************************/
931        
932        %macro MIPAR(dat1=, dat2=, dat3=, dat4=, dat5=);
933        
934        data temp;
935        	length _Imputation_ 3;
936        	set &dat1(in=a) &dat2(in=b) &dat3(in=c) &dat4(in=d) &dat5(in=e);
937        	if a then _Imputation_=1;
938          		else if b then _Imputation_=2;
939         		else if c then _Imputation_=3;
940          		else if d then _Imputation_=4;
941          		else if e then _Imputation_=5;
942          		  	
943          	/* approximate standard error from the half-width of the CI */
944          	StdErr = (uclpartialx - lclpartialx) / (2 * 1.96);
945          	Estimate = partlparx;
946          	Parameter = 'PartialPAR';
947          	
948          	keep _Imputation_ Estimate StdErr Parameter;
949        run;
950        
951        proc mianalyze data=temp;
952           modeleffects Estimate;
953           stderr StdErr;
954        run;
955        
956        %mend MIPAR;
957        
958        %MIPAR(dat1=gwt1,   dat2=gwt2,   dat3=gwt3,   dat4=gwt4,   dat5=gwt5 );

