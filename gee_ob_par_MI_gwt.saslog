608        data betas;
609          set uter ;
610          by _imputation_;
611          _type_ = 'PARM';
612        	retain intercept gotweight agebirth bpregob prev_preg1 prev_preg2 prev_preg3
613          				chage white sex;
614        	
615        	* 'i' counts rows within each _imputation_ group ;
616          	if first._imputation_ then i=1;
617          	else i+1;
618        	
619        	select (i);
620            when (1) intercept = estimate;
621            when (2) gotweight  = estimate;
622            when (3) agebirth  = estimate;
623        	when (4) bpregob   = estimate;
624        	when (5) prev_preg1= estimate;
625        	when (6) prev_preg2  = estimate;
626        	when (7) prev_preg3  = estimate;
627            when (8) chage    = estimate;
628            when (9) white    = estimate;
629            when (10) sex      = estimate;
630            otherwise;
631          end;
632        	
633          * Only OUTPUT once per _imputation_, after we've assigned all param columns ;
634          if last._imputation_ then output;
635        
636        run;

