750        *Parameter        Estimate      Std Error    95% Confidence Limits        DF        Minimum        Maximum         Theta0
750      ! Parameter=Theta0   Pr > |t|
751        Estimate         0.022237       0.013590     -0.00440     0.048874    14719       0.019860       0.023820              0               1.64
751      !      0.1018
752        ;
753        
754        /*************************************************************************************/
755        /**************** combine using mianalyze ********************************************/
756        
757        %macro MIPAR(dat1=, dat2=, dat3=, dat4=, dat5=);
758        
759        data temp;
760        	length _Imputation_ 3;
761        	set &dat1(in=a) &dat2(in=b) &dat3(in=c) &dat4(in=d) &dat5(in=e);
762        	if a then _Imputation_=1;
763          		else if b then _Imputation_=2;
764         		else if c then _Imputation_=3;
765          		else if d then _Imputation_=4;
766          		else if e then _Imputation_=5;
767          		  	
768          	/* approximate standard error from the half-width of the CI */
769          	StdErr = (uclpartialx - lclpartialx) / (2 * 1.96);
770          	Estimate = partlparx;
771          	Parameter = 'PartialPAR';
772          	
773          	keep _Imputation_ Estimate StdErr Parameter;
774        run;
775        
776        proc mianalyze data=temp;
777           modeleffects Estimate;
778           stderr StdErr;
779        run;
780        
781        %mend MIPAR;
782        
783        %MIPAR(dat1=gwt1,   dat2=gwt2,   dat3=gwt3,   dat4=gwt4,   dat5=gwt5 );

