598        title ' in-uterine factors - adjusting for bpregob & agebirth';
599        proc genmod data = all descending;
600        	by _imputation_ ;
601         class id momid ;
602           model chob = gotweight agebirth bpregob prev_preg1 prev_preg2 prev_preg3 chage white sex
603             / dist = Poisson link = log;
604             repeated subject=id(momid)/type=unstr PRINTMLE ecovb;
605             ods output GEERCov=covuter GEEEmpPEst = uter;
606         run;

