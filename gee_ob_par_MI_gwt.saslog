772        /**********************************************************************/
773        title ' in-uterine factors - adjusting for bpregob & agebirth';
774        proc genmod data = all descending;
775        	by _imputation_ ;
776         class id momid ;
777           model chob = gotweight agebirth bpregob prev_preg1 prev_preg2 prev_preg3 chage white sex
778             / dist = Poisson link = log;
779             repeated subject=id(momid)/type=unstr PRINTMLE ecovb;
780             ods output GEERCov=covuter GEEEmpPEst = uter;
781         run;

NOTE: The DESCENDING option applies only to the multinomial distribution with ordinal response.
