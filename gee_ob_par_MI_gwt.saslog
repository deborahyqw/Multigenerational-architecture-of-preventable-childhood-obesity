812        *proc print data=betas;
813        
814        data covparms;
815        	set covuter;
816        	by _imputation_;
817        	length _type_ $4;
818        	 _type_ = 'COV';
819        
820        	rename  Prm1=intercept   Prm2=gotweight  Prm3=agebirth   Prm4=bpregob    Prm5=prev_preg1    Prm6=prev_preg2
821        			Prm7=prev_preg3  Prm8=chage     Prm9=white        Prm10=sex   ;
822        
823        	length _name_ $10;
824        	
825        	*i counts rows within each _imputation_;
826        	if first._imputation_ then i=1;
827         		 else i+1;
828        
829        	* Assign which row this is (the row "label" in the covariance matrix) ;
830        	select(i);
831        		when(1)  _name_ = 'INTERCEPT';
832        		when(2)  _name_ = 'gotweight';
833        		when(3)  _name_ = 'agebirth';
834        		when(4)  _name_ = 'bpregob';
835        		when(5)  _name_ = 'prev_preg1';
836        		when(6)  _name_ = 'prev_preg2';
837        		when(7)  _name_ = 'prev_preg3';
27                                                                  The SAS System                                         21:54 Monday, June 23, 2025

838        		when(8)  _name_ = 'chage';
839        		when(9)  _name_ = 'white';
840        		when(10)  _name_ = 'sex';
841        		otherwise;
842        	end;
843        	
844        	* Output EVERY row;
845          	output;
846        
847        keep _imputation_ _type_ _name_ prm1-prm10 ;
848        
849        run;

