111377     	array west{5} west03 west05 west07 west11 west13 ;
111378     	
111379     	do i = 1 to 5;
111380       	if missing(region{i}) then do;
111381        		 mid{i}   = .;
111382         	south{i} = .;
111383         	west{i}  = .;
111384       	end;
111385       	else do;
