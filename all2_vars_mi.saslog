111348     data all2;
111349       merge gutsmoms2 (in=master) grav09guts2 bmibpregdt end=_end_;
111350       	by id; exrec=1;
111351       	if master; if cohort=2 ;
111352       	if chbmi04 >0 ; *keep only children without missing baseline BMI;
111353       	if first.id then exrec=0;
111354       	
85                                                                  The SAS System                                   17:03 Thursday, November 13, 2025

111355       	if white=. then white=0;
111356       	
111357       	if chyob < 1990 then bmibpreg = .; *chyob 1987-1996;
111358       		else if chyob >= 1990 & chyob < 1992 then bmibpreg = bmi89v;
111359       		else if chyob >= 1992 & chyob < 1994 then bmibpreg = bmi91v;
111360       		else if chyob >= 1994 & chyob < 1996 then bmibpreg = bmi93v;
111361       		else bmibpreg = bmi95v;
111362       		                        	
111363      	*maternal age at birth ;
111364      	agebirth = age89 - (retmo89 /12 - (chyob-1900));
111365      	
111366      	moagebase=age03+1; if moagebase=. then moagebase=age89+15;
111367     	age06=age05+1; age08=age07+1;
111368      		
