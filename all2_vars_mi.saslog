108138     /****************************** GUTS 2 ********************************************/
108139     data all2;
108140       merge gutsmoms2 (in=master) grav09guts2 bmibpregdt end=_end_;
108141       	by id; exrec=1;
108142       	if master; if cohort=2 ;
108143       	if chbmi04 >0 ; *keep only children without missing baseline BMI;
108144       	if first.id then exrec=0;
108145       	
108146       	if white=. then white=0;
108147       	
108148       	if chyob < 1990 then bmibpreg = .; *chyob 1987-1996;
108149       		else if chyob >= 1990 & chyob < 1992 then bmibpreg = bmi89v;
108150       		else if chyob >= 1992 & chyob < 1994 then bmibpreg = bmi91v;
108151       		else if chyob >= 1994 & chyob < 1996 then bmibpreg = bmi93v;
108152       		else bmibpreg = bmi95v;
108153       		                        	
108154      	*maternal age at birth ;
108155      	agebirth = age89 - (retmo89 /12 - (chyob-1900));
108156      	
108157      	moagebase=age03+1; if moagebase=. then moagebase=age89+15;
108158     	age06=age05+1; age08=age07+1;
108159      		
84                                                                  The SAS System                                       21:57 Thursday, June 12, 2025

108160     	if chage06=. then chage06=chage04+2; if chage08=. then chage08=chage06+2;
108161     	if chage11=. then chage11=chage08+3; if chage13=. then chage13=chage11+2;
108162         if age06=. then age06=moagebase+2; if age08=. then age08=age06+2;
108163     	if age11=. then age11=age08+3; if age13=. then age13=age11+2;
108164     				
108165     	array region{5} region10_03 region10_05 region10_07 region10_11 region10_13;
108166     	array mid{5} midwest03 midwest05 midwest07 midwest11 midwest13 ;
108167     	array south{5} south03 south05 south07 south11 south13 ;
108168     	array west{5} west03 west05 west07 west11 west13 ;
108169     	
108170     	do i = 1 to 5;
108171       	if missing(region{i}) then do;
108172        		 mid{i}   = .;
108173         	south{i} = .;
108174         	west{i}  = .;
108175       	end;
108176       	else do;
