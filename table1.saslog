634        
635        * Put the statistics into MIANALYZE-friendly format (one row per imputation) ;
636        proc transpose data=cont_stats out=cont_t prefix=imp_;
637           by _Imputation_;
638           id _STAT_;
639           var age bmi;
640        run;
641        
642        * Pool means and (optionally) SDs with PROC MIANALYZE       ;
643        proc mianalyze data=cont_t;
