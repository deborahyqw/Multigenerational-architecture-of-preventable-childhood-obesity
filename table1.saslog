574        
575        /* Offspring */
576        data offspring; set imp1;
577        	if year=1996 or year=2004;
578        	
579        	if fl_sch98 ne 1 then fl_sch98=0;
580        	if fl_sch99 ne 1 then fl_sch99=0;
581        	if fl_not_mom9698 ne 1 then fl_not_mom9698=0;
582        	
583        	if abwt1=1 then abwt=1;
584        		else if abwt3=1 then abwt=3;
585        		else abwt=2;
586        	if gweek1=1 then gweek=1;
587        		else if gweek3=1 then gweek=3;
588        		else gweek=2;
589        	if prev_preg1=1 then prev_preg=1;
590        		else if prev_preg2=1 then prev_preg=2;
591        		else if prev_preg3=1 then prev_preg=3;
592        		else prev_preg=0;
593        	if mosmk2=1 then mosmk=2;
594        		else if mosmk3=1 then mosmk=3;
595        		else mosmk=1;
596        run;

