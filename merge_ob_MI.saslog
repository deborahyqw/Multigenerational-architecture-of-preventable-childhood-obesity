670        proc sort data=stat; by cohort  _imputation_ &quantvar; run;
671        
672        data &data;
673        merge &data stat;
674        by cohort  _imputation_ &quantvar;
675        if momid = . then delete;
676        if &var=. then &quantcont=.;
677        run;
678        %mend quant_med;
