324            	else if incom01=8 then income=3; /*100000-149+*/
325            	else income=4; /*150+*/
326            /*$label 1.less than 15,000; 2.15,000-19; 3.20,000-29; 4.30,000-39; 5.40,000-49;\
327                6.50,000-74; 7.75,000-99; 8.100,000-149; 9.150,000+; ..pt */
328            %indic3(vbl=income, reflev=4, missing=., min=1, max=3, prefix=fincome, usemiss=0,
329                    label1='<50k',label2='50-99k',label3='100-149k');
