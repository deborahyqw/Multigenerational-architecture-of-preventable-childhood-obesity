773        
774        data betas;
775          set soc ;
776          by _imputation_;
777          _type_ = 'PARM';
778        	retain intercept  heduc1 heduc2 fincome1 fincome2 fincome3
779        			midwest south west cohort chage white sex;
780        	
781        	* 'i' counts rows within each _imputation_ group ;
782          	if first._imputation_ then i=1;
783          	else i+1;
784        	
785        	select (i);
786            when (1) intercept = estimate;
787         	when (2) heduc1   = estimate;
788            when (3) heduc2   = estimate;
789            when (4) fincome1   = estimate;
790            when (5) fincome2   = estimate;
791            when (6) fincome3   = estimate;
792            when (7) midwest  = estimate;
793            when (8) south    = estimate;
794            when (9) west     = estimate;
795            when (10) cohort   = estimate;
796            when (11) chage    = estimate;
797            when (12) white    = estimate;
798            when (13) sex      = estimate;
799            otherwise;
800          end;
801        	
802          * Only OUTPUT once per _imputation_, after we've assigned all param columns ;
803          if last._imputation_ then output;
804        
805          if fincome3 <0 then  fincome3 =0;
806        
807        run;

