994        					 		 		 		 		 		 		
995        /*************************************************************************************/
996        /**************** combine using mianalyze ********************************************/
997        
998        %macro MIPAR(dat1=, dat2=, dat3=, dat4=, dat5=);
999        
1000       data temp;
1001       	length _Imputation_ 3;
1002       	set &dat1(in=a) &dat2(in=b) &dat3(in=c) &dat4(in=d) &dat5(in=e);
1003       	if a then _Imputation_=1;
1004         		else if b then _Imputation_=2;
1005        		else if c then _Imputation_=3;
1006         		else if d then _Imputation_=4;
1007         		else if e then _Imputation_=5;
1008         		  	
1009         	/* approximate standard error from the half-width of the CI */
1010         	StdErr = (uclpartialx - lclpartialx) / (2 * 1.96);
1011         	Estimate = partlparx;
1012         	Parameter = 'PartialPAR';
1013         	
1014         	keep _Imputation_ Estimate StdErr Parameter;
1015       run;
1016       
1017       proc mianalyze data=temp;
1018          modeleffects Estimate;
1019          stderr StdErr;
1020       run;
1021       
1022       %mend MIPAR;
1023       
1024       %MIPAR(dat1=educ1,     dat2=educ2,     dat3=educ3,     dat4=educ4,     dat5=educ5 );

