912        %macro runPAR(prefixBeta=, prefixFreq=, outpref=, modmod=, fixfix=);
913        	%local i;
914          	%do i=1 %to 5;
915        %par(
916        	bdata=&prefixBeta.&i,
917        	pdata=&prefixFreq.&i,
918        	n_or_p=N,
919        	n_or_pname=FQ,
920        	modvar= &modmod  ,
921        	missvarlist=NONE,
922        	partialpar= T,
923        	outdat= &outpref.&i,
924        	fixedvar= &fixfix );
925        	%end;
926        %mend runPAR;
