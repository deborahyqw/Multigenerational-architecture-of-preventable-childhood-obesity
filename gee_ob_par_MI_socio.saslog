846        data covparms;
847        	set covsoc;
848        	by _imputation_;
849        	length _type_ $4;
850        	 _type_ = 'COV';
851        
852        	rename  Prm1=intercept   Prm2=heduc1    Prm3=heduc2
853        			Prm4=fincome1    Prm5=fincome2     Prm6=fincome3
854        			Prm7=midwest     Prm8=south     Prm9=west
855        			Prm10=cohort     Prm11=chage     Prm12=white    Prm13=sex
856        			Prm14=sesq0      Prm15=sesq1     Prm16=sesq2;
857        
858        	length _name_ $10;
859        	
860        	*i counts rows within each _imputation_;
861        	if first._imputation_ then i=1;
862         		 else i+1;
863        
70                                                                  The SAS System                                     17:13 Friday, November 14, 2025

864        	* Assign which row this is (the row "label" in the covariance matrix) ;
865        	select(i);
866        		when(1)  _name_ = 'INTERCEPT';
867        		when(2)  _name_ = 'heduc1';
868        		when(3)  _name_ = 'heduc2';
869        		when(4)  _name_ = 'fincome1';
870        		when(5)  _name_ = 'fincome2';
871        		when(6)  _name_ = 'fincome3';
872        		when(7)  _name_ = 'midwest';
873        		when(8)  _name_ = 'south';
874        		when(9)  _name_ = 'west';
875        		when(10)  _name_ = 'cohort';
876        		when(11)  _name_ = 'chage';
877        		when(12)  _name_ = 'white';
878        		when(13)  _name_ = 'sex';
879        		when(14)  _name_ = 'sesq0';
880        		when(15)  _name_ = 'sesq1';
881        		when(16)  _name_ = 'sesq2';
882        		otherwise;
883        	end;
884        	
885        	* Output EVERY row;
886          	output;
887        
888        keep _imputation_ _type_ _name_ prm1-prm16 ;
889        
