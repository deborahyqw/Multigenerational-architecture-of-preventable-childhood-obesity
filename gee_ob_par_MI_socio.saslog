761        
762        /**********************************************************************/
763        title ' education & income ';
764        proc genmod data = all descending;
765        	by _imputation_ ;
766         class id momid ;
767           model chob = heduc1 heduc2 fincome1 fincome2 fincome3
768        			    midwest south west &covar1
769             / dist = Poisson link = log;
770             repeated subject=id(momid)/type=unstr PRINTMLE ecovb;
771             ods output GEERCov=covsoc GEEEmpPEst = soc;
772         run;

