1023       *proc print data=betas;
1024       
1025       data covparms;
1026       	set covsoc;
1027       	by _imputation_;
1028       	length _type_ $4;
1029       	 _type_ = 'COV';
1030       
1031       	rename  Prm1=intercept   Prm2=heduc1    Prm3=heduc2
1032       			Prm4=fincome1    Prm5=fincome2     Prm6=fincome3
1033       			Prm7=midwest     Prm8=south     Prm9=west
1034       			Prm10=cohort     Prm11=chage     Prm12=white    Prm13=sex
1035       			Prm14=sesq0      Prm15=sesq1     Prm16=sesq2;
1036       
1037       	length _name_ $10;
1038       	
1039       	*i counts rows within each _imputation_;
1040       	if first._imputation_ then i=1;
1041        		 else i+1;
1042       
1043       	* Assign which row this is (the row "label" in the covariance matrix) ;
1044       	select(i);
1045       		when(1)  _name_ = 'INTERCEPT';
1046       		when(2)  _name_ = 'heduc1';
1047       		when(3)  _name_ = 'heduc2';
1048       		when(4)  _name_ = 'fincome1';
1049       		when(5)  _name_ = 'fincome2';
1050       		when(6)  _name_ = 'fincome3';
1051       		when(7)  _name_ = 'midwest';
1052       		when(8)  _name_ = 'south';
1053       		when(9)  _name_ = 'west';
1054       		when(10)  _name_ = 'cohort';
1055       		when(11)  _name_ = 'chage';
1056       		when(12)  _name_ = 'white';
1057       		when(13)  _name_ = 'sex';
1058       		when(14)  _name_ = 'sesq0';
1059       		when(15)  _name_ = 'sesq1';
1060       		when(16)  _name_ = 'sesq2';
1061       		otherwise;
1062       	end;
1063       	
1064       	* Output EVERY row;
1065         	output;
1066       
1067       keep _imputation_ _type_ _name_ prm1-prm16 ;
