808        data betas;
809          set soc ;
810          by _imputation_;
811          _type_ = 'PARM';
812        	retain intercept heduc1 heduc2 fincome1 fincome2 fincome3
813        			midwest south west cohort chage white sex
814        			sesq0 sesq1 sesq2 ;
815        	
816        	* 'i' counts rows within each _imputation_ group ;
817          	if first._imputation_ then i=1;
818          	else i+1;
819        	
820        	select (i);
821            when (1) intercept = estimate;
822         	when (2) heduc1   = estimate;
823            when (3) heduc2   = estimate;
824            when (4) fincome1   = estimate;
825            when (5) fincome2   = estimate;
826            when (6) fincome3   = estimate;
827            when (7) midwest  = estimate;
828            when (8) south    = estimate;
829            when (9) west     = estimate;
830            when (10) cohort   = estimate;
831            when (11) chage    = estimate;
832            when (12) white    = estimate;
833            when (13) sex      = estimate;
834            when (14) sesq0   = estimate;
835            when (15) sesq1   = estimate;
836            when (16) sesq2   = estimate;
837            otherwise;
838          end;
839        	
840          * Only OUTPUT once per _imputation_, after we've assigned all param columns ;
841          if last._imputation_ then output;
842        
843        run;

