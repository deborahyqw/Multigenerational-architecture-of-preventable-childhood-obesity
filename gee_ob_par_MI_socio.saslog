795        /**********************************************************************/
796        /**********************************************************************/
797        title ' socio-environmental factors ';
798        proc genmod data = all descending;
799        	by _imputation_ ;
800         class id momid ;
801           model chob = heduc1 heduc2 fincome1 fincome2 fincome3
802        			    midwest south west &covar1 sesq0 sesq1 sesq2
803             / dist = Poisson link = log;
804             repeated subject=id(momid)/type=unstr PRINTMLE ecovb;
805             ods output GEERCov=covsoc GEEEmpPEst = soc;
806         run;

NOTE: The DESCENDING option applies only to the multinomial distribution with ordinal response.
