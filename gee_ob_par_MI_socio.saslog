631        *proc print data=betas;
632        
633        data covparms;
634        	set covsoc;
635        	by _imputation_;
636        	length _type_ $4;
637        	 _type_ = 'COV';
638        
639        	rename  Prm1=intercept   Prm2=heduc1    Prm3=heduc2
640        			Prm4=fincome1    Prm5=fincome2     Prm6=fincome3
641        			Prm7=midwest     Prm8=south     Prm9=west
642        			Prm10=cohort     Prm11=chage     Prm12=white    Prm13=sex   ;
643        
644        	length _name_ $10;
645        	
646        	*i counts rows within each _imputation_;
647        	if first._imputation_ then i=1;
648         		 else i+1;
649        
650        	* Assign which row this is (the row "label" in the covariance matrix) ;
651        	select(i);
652        		when(1)  _name_ = 'INTERCEPT';
653        		when(2)  _name_ = 'heduc1';
654        		when(3)  _name_ = 'heduc2';
13                                                                  The SAS System                                     17:13 Friday, November 14, 2025

655        		when(4)  _name_ = 'fincome1';
656        		when(5)  _name_ = 'fincome2';
657        		when(6)  _name_ = 'fincome3';
658        		when(7)  _name_ = 'midwest';
659        		when(8)  _name_ = 'south';
660        		when(9)  _name_ = 'west';
661        		when(10)  _name_ = 'cohort';
662        		when(11)  _name_ = 'chage';
663        		when(12)  _name_ = 'white';
664        		when(13)  _name_ = 'sex';
665        		otherwise;
666        	end;
667        	
668        	* Output EVERY row;
669          	output;
670        
671        keep _imputation_ _type_ _name_ prm1-prm13 ;
672        
673        run;

