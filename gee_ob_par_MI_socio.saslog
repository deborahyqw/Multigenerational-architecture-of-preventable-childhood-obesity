808        *proc print data=betas;
809        
810        data covparms;
811        	set covsoc;
812        	by _imputation_;
813        	length _type_ $4;
814        	 _type_ = 'COV';
815        
816        	rename  Prm1=intercept   Prm2=heduc1    Prm3=heduc2
817        			Prm4=fincome1    Prm5=fincome2     Prm6=fincome3
818        			Prm7=midwest     Prm8=south     Prm9=west
819        			Prm10=cohort     Prm11=chage     Prm12=white    Prm13=sex   ;
820        
821        	length _name_ $10;
822        	
823        	*i counts rows within each _imputation_;
824        	if first._imputation_ then i=1;
825         		 else i+1;
826        
827        	* Assign which row this is (the row "label" in the covariance matrix) ;
828        	select(i);
829        		when(1)  _name_ = 'INTERCEPT';
830        		when(2)  _name_ = 'heduc1';
831        		when(3)  _name_ = 'heduc2';
832        		when(4)  _name_ = 'fincome1';
833        		when(5)  _name_ = 'fincome2';
834        		when(6)  _name_ = 'fincome3';
835        		when(7)  _name_ = 'midwest';
836        		when(8)  _name_ = 'south';
837        		when(9)  _name_ = 'west';
838        		when(10)  _name_ = 'cohort';
839        		when(11)  _name_ = 'chage';
840        		when(12)  _name_ = 'white';
841        		when(13)  _name_ = 'sex';
842        		otherwise;
843        	end;
844        	
845        	* Output EVERY row;
846          	output;
847        
848        keep _imputation_ _type_ _name_ prm1-prm13 ;
849        
850        run;

