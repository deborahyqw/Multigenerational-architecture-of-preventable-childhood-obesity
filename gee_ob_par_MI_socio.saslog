586        
587        /**********************************************************************/
588        title ' education & income ';
589        proc genmod data = all descending;
590        	by _imputation_ ;
591         class id momid ;
592           model chob = heduc1 heduc2 fincome1 fincome2 fincome3
593        			    midwest south west &covar1
594             / dist = Poisson link = log;
595             repeated subject=id(momid)/type=unstr PRINTMLE ecovb;
596             ods output GEERCov=covsoc GEEEmpPEst = soc;
597         run;

