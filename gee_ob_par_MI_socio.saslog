1173       					 		 		 		 		 		 		
1174       /*************************************************************************************/
1175       /**************** combine using mianalyze ********************************************/
1176       
1177       %macro MIPAR(dat1=, dat2=, dat3=, dat4=, dat5=);
1178       
1179       data temp;
1180       	length _Imputation_ 3;
1181       	set &dat1(in=a) &dat2(in=b) &dat3(in=c) &dat4(in=d) &dat5(in=e);
1182       	if a then _Imputation_=1;
1183         		else if b then _Imputation_=2;
1184        		else if c then _Imputation_=3;
1185         		else if d then _Imputation_=4;
1186         		else if e then _Imputation_=5;
1187         		  	
1188         	/* approximate standard error from the half-width of the CI */
1189         	StdErr = (uclpartialx - lclpartialx) / (2 * 1.96);
1190         	Estimate = partlparx;
1191         	Parameter = 'PartialPAR';
1192         	
1193         	keep _Imputation_ Estimate StdErr Parameter;
1194       run;
1195       
1196       proc mianalyze data=temp;
1197          modeleffects Estimate;
1198          stderr StdErr;
1199       run;
1200       
1201       %mend MIPAR;
1202       
1203       %MIPAR(dat1=educ1,     dat2=educ2,     dat3=educ3,     dat4=educ4,     dat5=educ5 );

