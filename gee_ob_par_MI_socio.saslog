598        
599        data betas;
600          set soc ;
601          by _imputation_;
602          _type_ = 'PARM';
603        	retain intercept  heduc1 heduc2 fincome1 fincome2 fincome3
604        			midwest south west cohort chage white sex;
605        	
606        	* 'i' counts rows within each _imputation_ group ;
607          	if first._imputation_ then i=1;
608          	else i+1;
609        	
610        	select (i);
611            when (1) intercept = estimate;
612         	when (2) heduc1   = estimate;
613            when (3) heduc2   = estimate;
614            when (4) fincome1   = estimate;
615            when (5) fincome2   = estimate;
616            when (6) fincome3   = estimate;
617            when (7) midwest  = estimate;
618            when (8) south    = estimate;
619            when (9) west     = estimate;
620            when (10) cohort   = estimate;
621            when (11) chage    = estimate;
622            when (12) white    = estimate;
623            when (13) sex      = estimate;
624            otherwise;
625          end;
626        	
627          * Only OUTPUT once per _imputation_, after we've assigned all param columns ;
628          if last._imputation_ then output;
629        
630        run;

