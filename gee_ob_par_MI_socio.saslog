984        
985        data betas;
986          set soc ;
987          by _imputation_;
988          _type_ = 'PARM';
989        	retain intercept heduc1 heduc2 fincome1 fincome2 fincome3
990        			midwest south west cohort chage white sex
991        			sesq0 sesq1 sesq2 ;
992        	
993        	* 'i' counts rows within each _imputation_ group ;
994          	if first._imputation_ then i=1;
995          	else i+1;
996        	
997        	select (i);
998            when (1) intercept = estimate;
999         	when (2) heduc1   = estimate;
1000           when (3) heduc2   = estimate;
1001           when (4) fincome1   = estimate;
1002           when (5) fincome2   = estimate;
1003           when (6) fincome3   = estimate;
1004           when (7) midwest  = estimate;
1005           when (8) south    = estimate;
1006           when (9) west     = estimate;
1007           when (10) cohort   = estimate;
1008           when (11) chage    = estimate;
1009           when (12) white    = estimate;
1010           when (13) sex      = estimate;
1011           when (14) sesq0   = estimate;
1012           when (15) sesq1   = estimate;
1013           when (16) sesq2   = estimate;
1014           otherwise;
1015         end;
1016       	
1017         * Only OUTPUT once per _imputation_, after we've assigned all param columns ;
1018         if last._imputation_ then output;
1019       
1020         if fincome3 <0 then  fincome3 =0;
1021       
1022       run;

