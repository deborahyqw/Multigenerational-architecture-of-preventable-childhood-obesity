971        
972        /**********************************************************************/
973        /**********************************************************************/
974        title ' socio-environmental factors ';
975        proc genmod data = all descending;
976        	by _imputation_ ;
977         class id momid ;
978           model chob = heduc1 heduc2 fincome1 fincome2 fincome3
979        			    midwest south west &covar1 sesq0 sesq1 sesq2
980             / dist = Poisson link = log;
981             repeated subject=id(momid)/type=unstr PRINTMLE ecovb;
982             ods output GEERCov=covsoc GEEEmpPEst = soc;
983         run;

