606        
607        data betas;
608          set soc ;
609          by _imputation_;
610          _type_ = 'PARM';
611        	retain intercept  heduc1 heduc2 fincome1 fincome2 fincome3
612        			midwest south west cohort chage white sex;
613        	
614        	* 'i' counts rows within each _imputation_ group ;
615          	if first._imputation_ then i=1;
616          	else i+1;
617        	
618        	select (i);
619            when (1) intercept = estimate;
620         	when (2) heduc1   = estimate;
621            when (3) heduc2   = estimate;
622            when (4) fincome1   = estimate;
623            when (5) fincome2   = estimate;
624            when (6) fincome3   = estimate;
625            when (7) midwest  = estimate;
626            when (8) south    = estimate;
627            when (9) west     = estimate;
628            when (10) cohort   = estimate;
629            when (11) chage    = estimate;
630            when (12) white    = estimate;
631            when (13) sex      = estimate;
632            otherwise;
633          end;
634        	
635          * Only OUTPUT once per _imputation_, after we've assigned all param columns ;
636          if last._imputation_ then output;
637        
638          if fincome3 <0 then  fincome3 =0;
639        
640        run;

