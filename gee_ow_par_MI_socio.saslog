804        
805        /**********************************************************************/
806        /**********************************************************************/
807        title ' socio-environmental factors ';
808        proc genmod data = all descending;
809        	by _imputation_ ;
810         class id momid ;
811           model chow = heduc1 heduc2 fincome1 fincome2 fincome3
812        			    midwest south west &covar1 sesq0 sesq1 sesq2
813             / dist = Poisson link = log;
814             repeated subject=id(momid)/type=unstr PRINTMLE ecovb;
815             ods output GEERCov=covsoc GEEEmpPEst = soc;
816         run;

NOTE: The DESCENDING option applies only to the multinomial distribution with ordinal response.
