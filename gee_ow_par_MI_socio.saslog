594        
595        /**********************************************************************/
596        title ' education & income ';
597        proc genmod data = all descending;
598        	by _imputation_ ;
599         class id momid ;
600           model chow = heduc1 heduc2 fincome1 fincome2 fincome3
601        			    midwest south west &covar1
602             / dist = Poisson link = log;
603             repeated subject=id(momid)/type=unstr PRINTMLE ecovb;
604             ods output GEERCov=covsoc GEEEmpPEst = soc;
605         run;

