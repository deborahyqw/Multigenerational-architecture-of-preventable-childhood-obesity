641        *proc print data=betas;
642        
643        data covparms;
644        	set covsoc;
645        	by _imputation_;
646        	length _type_ $4;
647        	 _type_ = 'COV';
648        
649        	rename  Prm1=intercept   Prm2=heduc1    Prm3=heduc2
650        			Prm4=fincome1    Prm5=fincome2     Prm6=fincome3
651        			Prm7=midwest     Prm8=south     Prm9=west
652        			Prm10=cohort     Prm11=chage     Prm12=white    Prm13=sex   ;
653        
654        	length _name_ $10;
655        	
656        	*i counts rows within each _imputation_;
657        	if first._imputation_ then i=1;
658         		 else i+1;
659        
660        	* Assign which row this is (the row "label" in the covariance matrix) ;
661        	select(i);
662        		when(1)  _name_ = 'INTERCEPT';
663        		when(2)  _name_ = 'heduc1';
664        		when(3)  _name_ = 'heduc2';
665        		when(4)  _name_ = 'fincome1';
666        		when(5)  _name_ = 'fincome2';
667        		when(6)  _name_ = 'fincome3';
668        		when(7)  _name_ = 'midwest';
669        		when(8)  _name_ = 'south';
670        		when(9)  _name_ = 'west';
671        		when(10)  _name_ = 'cohort';
672        		when(11)  _name_ = 'chage';
673        		when(12)  _name_ = 'white';
674        		when(13)  _name_ = 'sex';
675        		otherwise;
676        	end;
677        	
678        	* Output EVERY row;
679          	output;
680        
681        keep _imputation_ _type_ _name_ prm1-prm13 ;
682        
683        run;

