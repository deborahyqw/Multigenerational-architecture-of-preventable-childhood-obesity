1004       					 		 		 		 		 		 		
1005       /*************************************************************************************/
1006       /**************** combine using mianalyze ********************************************/
1007       
1008       %macro MIPAR(dat1=, dat2=, dat3=, dat4=, dat5=);
1009       
1010       data temp;
1011       	length _Imputation_ 3;
1012       	set &dat1(in=a) &dat2(in=b) &dat3(in=c) &dat4(in=d) &dat5(in=e);
1013       	if a then _Imputation_=1;
1014         		else if b then _Imputation_=2;
1015        		else if c then _Imputation_=3;
1016         		else if d then _Imputation_=4;
1017         		else if e then _Imputation_=5;
1018         		  	
1019         	/* approximate standard error from the half-width of the CI */
1020         	StdErr = (uclpartialx - lclpartialx) / (2 * 1.96);
1021         	Estimate = partlparx;
1022         	Parameter = 'PartialPAR';
1023         	
1024         	keep _Imputation_ Estimate StdErr Parameter;
1025       run;
1026       
1027       proc mianalyze data=temp;
1028          modeleffects Estimate;
1029          stderr StdErr;
1030       run;
1031       
1032       %mend MIPAR;
