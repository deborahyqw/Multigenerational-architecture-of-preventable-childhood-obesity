769        
770        /**********************************************************************/
771        title ' education & income ';
772        proc genmod data = all descending;
773        	by _imputation_ ;
774         class id momid ;
775           model chow = heduc1 heduc2 fincome1 fincome2 fincome3
776        			    midwest south west &covar1
777             / dist = Poisson link = log;
778             repeated subject=id(momid)/type=unstr PRINTMLE ecovb;
779             ods output GEERCov=covsoc GEEEmpPEst = soc;
780         run;

