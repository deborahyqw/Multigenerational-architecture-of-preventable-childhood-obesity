781        
782        data betas;
783          set soc ;
784          by _imputation_;
785          _type_ = 'PARM';
786        	retain intercept  heduc1 heduc2 fincome1 fincome2 fincome3
787        			midwest south west cohort chage white sex;
788        	
789        	* 'i' counts rows within each _imputation_ group ;
790          	if first._imputation_ then i=1;
791          	else i+1;
792        	
793        	select (i);
794            when (1) intercept = estimate;
795         	when (2) heduc1   = estimate;
796            when (3) heduc2   = estimate;
797            when (4) fincome1   = estimate;
798            when (5) fincome2   = estimate;
799            when (6) fincome3   = estimate;
800            when (7) midwest  = estimate;
801            when (8) south    = estimate;
802            when (9) west     = estimate;
803            when (10) cohort   = estimate;
804            when (11) chage    = estimate;
805            when (12) white    = estimate;
806            when (13) sex      = estimate;
807            otherwise;
808          end;
809        	
810          * Only OUTPUT once per _imputation_, after we've assigned all param columns ;
811          if last._imputation_ then output;
812        
813          if fincome3 <0 then  fincome3 =0;
814        
815        run;

