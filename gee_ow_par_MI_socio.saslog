816        *proc print data=betas;
817        
818        data covparms;
819        	set covsoc;
820        	by _imputation_;
821        	length _type_ $4;
822        	 _type_ = 'COV';
823        
824        	rename  Prm1=intercept   Prm2=heduc1    Prm3=heduc2
825        			Prm4=fincome1    Prm5=fincome2     Prm6=fincome3
826        			Prm7=midwest     Prm8=south     Prm9=west
827        			Prm10=cohort     Prm11=chage     Prm12=white    Prm13=sex   ;
828        
829        	length _name_ $10;
830        	
27                                                                  The SAS System                                        13:23 Tuesday, June 24, 2025

831        	*i counts rows within each _imputation_;
832        	if first._imputation_ then i=1;
833         		 else i+1;
834        
835        	* Assign which row this is (the row "label" in the covariance matrix) ;
836        	select(i);
837        		when(1)  _name_ = 'INTERCEPT';
838        		when(2)  _name_ = 'heduc1';
839        		when(3)  _name_ = 'heduc2';
840        		when(4)  _name_ = 'fincome1';
841        		when(5)  _name_ = 'fincome2';
842        		when(6)  _name_ = 'fincome3';
843        		when(7)  _name_ = 'midwest';
844        		when(8)  _name_ = 'south';
845        		when(9)  _name_ = 'west';
846        		when(10)  _name_ = 'cohort';
847        		when(11)  _name_ = 'chage';
848        		when(12)  _name_ = 'white';
849        		when(13)  _name_ = 'sex';
850        		otherwise;
851        	end;
852        	
853        	* Output EVERY row;
854          	output;
855        
856        keep _imputation_ _type_ _name_ prm1-prm13 ;
857        
858        run;

