744        
745        %macro runPAR(prefixBeta=, prefixFreq=, outpref=, modmod=, fixfix=);
746        	%local i;
747          	%do i=1 %to 5;
748        %par(
749        	bdata=&prefixBeta.&i,
750        	pdata=&prefixFreq.&i,
751        	n_or_p=N,
752        	n_or_pname=FQ,
753        	modvar= &modmod  ,
754        	missvarlist=NONE,
755        	partialpar= T,
756        	outdat= &outpref.&i,
757        	fixedvar= &fixfix );
758        	%end;
759        %mend runPAR;
