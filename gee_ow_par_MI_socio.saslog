1181       					 		 		 		 		 		 		
1182       /*************************************************************************************/
1183       /**************** combine using mianalyze ********************************************/
1184       
1185       %macro MIPAR(dat1=, dat2=, dat3=, dat4=, dat5=);
1186       
1187       data temp;
1188       	length _Imputation_ 3;
1189       	set &dat1(in=a) &dat2(in=b) &dat3(in=c) &dat4(in=d) &dat5(in=e);
1190       	if a then _Imputation_=1;
1191         		else if b then _Imputation_=2;
1192        		else if c then _Imputation_=3;
