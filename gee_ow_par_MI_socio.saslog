1000       	
1001       	* 'i' counts rows within each _imputation_ group ;
1002         	if first._imputation_ then i=1;
1003         	else i+1;
1004       	
1005       	select (i);
1006           when (1) intercept = estimate;
1007        	when (2) heduc1   = estimate;
1008           when (3) heduc2   = estimate;
1009           when (4) fincome1   = estimate;
1010           when (5) fincome2   = estimate;
