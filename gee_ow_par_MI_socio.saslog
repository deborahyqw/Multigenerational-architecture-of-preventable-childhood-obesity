979        
980        /**********************************************************************/
981        /**********************************************************************/
982        title ' socio-environmental factors ';
983        proc genmod data = all descending;
984        	by _imputation_ ;
985         class id momid ;
986           model chow = heduc1 heduc2 fincome1 fincome2 fincome3
987        			    midwest south west &covar1 sesq0 sesq1 sesq2
988             / dist = Poisson link = log;
989             repeated subject=id(momid)/type=unstr PRINTMLE ecovb;
990             ods output GEERCov=covsoc GEEEmpPEst = soc;
991         run;

NOTE: The DESCENDING option applies only to the multinomial distribution with ordinal response.
